+package io.papermc.paper.plugin.manager.compat;
+
+import io.papermc.paper.plugin.configuration.PluginMeta;
+import java.util.List;
+import java.util.logging.Logger;
+import org.bukkit.event.Event;
+import org.bukkit.event.EventPriority;
+import org.bukkit.event.HandlerList;
+import org.bukkit.event.Listener;
+import org.bukkit.plugin.EventExecutor;
+import org.bukkit.plugin.Plugin;
+import org.bukkit.plugin.RegisteredListener;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Assertions;
+import org.junit.jupiter.api.Test;
+import org.mockito.Mockito;
+
+@Normal
+class CompatibilityKernelRoutingTest {
+
+    @Test
+    void pathLocalDegradationDoesNotImmediatelyGlobalize() {
+        final Plugin plugin = mockPlugin("LegacyNormal", "com.example.LegacyNormal", List.of(), List.of());
+        final PluginCompatibilityProfile profile = new PluginCompatibilityProfile(plugin);
+
+        final String hotPath = "event:BlockPlaceEvent#priority:NORMAL#ignoreCancelled:false";
+        final String coldPath = "event:PlayerJoinEvent#priority:NORMAL#ignoreCancelled:false";
+
+        profile.noteUnsafeInternalAccess(hotPath, "reflection");
+
+        Assertions.assertEquals(PluginCompatibilityProfile.State.LEGACY_DEGRADED, profile.stateForPath(hotPath));
+        Assertions.assertEquals(PluginCompatibilityProfile.State.LEGACY_OBSERVED_SAFE, profile.stateForPath(coldPath));
+    }
+
+    private static RegisteredListener listenerFor(final Plugin plugin) {
+        final Listener listener = new Listener() {
+        };
+        final EventExecutor executor = (ignoredListener, ignoredEvent) -> {
+        };
+        return new RegisteredListener(listener, executor, EventPriority.NORMAL, plugin, false);
+    }
+
+    private static Plugin mockPlugin(
+        final String name,
+        final String mainClass,
+        final List<String> dependencies,
+        final List<String> softDependencies
+    ) {
+        final PluginMeta meta = Mockito.mock(PluginMeta.class);
+        Mockito.when(meta.getName()).thenReturn(name);
+        Mockito.when(meta.getMainClass()).thenReturn(mainClass);
+        Mockito.when(meta.getPluginDependencies()).thenReturn(dependencies);
+        Mockito.when(meta.getPluginSoftDependencies()).thenReturn(softDependencies);
+        Mockito.when(meta.getVersion()).thenReturn("1.0.0");
+
+        final Plugin plugin = Mockito.mock(Plugin.class);
+        Mockito.when(plugin.getPluginMeta()).thenReturn(meta);
+        Mockito.when(plugin.getLogger()).thenReturn(Logger.getLogger(name));
+        Mockito.when(plugin.isEnabled()).thenReturn(true);
+        return plugin;
+    }
+
+    private static final class DummyEvent extends Event {
+        private static final HandlerList HANDLERS = new HandlerList();
+
+        @Override
+        public HandlerList getHandlers() {
+            return HANDLERS;
+        }
+
+        public static HandlerList getHandlerList() {
+            return HANDLERS;
+        }
+    }
+}
