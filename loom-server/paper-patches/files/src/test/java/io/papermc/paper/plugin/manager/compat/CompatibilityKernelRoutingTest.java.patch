+package io.papermc.paper.plugin.manager.compat;
+
+import io.papermc.paper.configuration.GlobalConfiguration;
+import io.papermc.paper.plugin.configuration.PluginMeta;
+import java.lang.reflect.Field;
+import java.util.List;
+import java.util.logging.Logger;
+import org.bukkit.event.Event;
+import org.bukkit.event.EventPriority;
+import org.bukkit.event.HandlerList;
+import org.bukkit.event.Listener;
+import org.bukkit.plugin.EventExecutor;
+import org.bukkit.plugin.Plugin;
+import org.bukkit.plugin.RegisteredListener;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Assertions;
+import org.junit.jupiter.api.Test;
+import org.mockito.Mockito;
+
+@Normal
+class CompatibilityKernelRoutingTest {
+
+    @Test
+    void compatibilityModeParsingSupportsAliases() {
+        Assertions.assertEquals(CompatibilityMode.HYBRID, CompatibilityMode.fromConfig(null));
+        Assertions.assertEquals(CompatibilityMode.STRICT, CompatibilityMode.fromConfig("strict"));
+        Assertions.assertEquals(CompatibilityMode.MAX_COMPAT, CompatibilityMode.fromConfig("max-compat"));
+        Assertions.assertEquals(CompatibilityMode.MAX_COMPAT, CompatibilityMode.fromConfig("max_compat"));
+        Assertions.assertEquals(CompatibilityMode.MAX_COMPAT, CompatibilityMode.fromConfig("maxcompat"));
+    }
+
+    @Test
+    void pathLocalDegradationDoesNotImmediatelyGlobalize() {
+        final Plugin plugin = mockPlugin("LegacyNormal", "com.example.LegacyNormal", List.of(), List.of());
+        final PluginCompatibilityProfile profile = new PluginCompatibilityProfile(plugin);
+
+        final String hotPath = "event:BlockPlaceEvent#priority:NORMAL#ignoreCancelled:false";
+        final String coldPath = "event:PlayerJoinEvent#priority:NORMAL#ignoreCancelled:false";
+
+        profile.noteUnsafeInternalAccess(hotPath, "reflection");
+
+        Assertions.assertEquals(PluginCompatibilityProfile.State.LEGACY_DEGRADED, profile.stateForPath(hotPath));
+        Assertions.assertEquals(PluginCompatibilityProfile.State.LEGACY_OBSERVED_SAFE, profile.stateForPath(coldPath));
+    }
+
+    @Test
+    void maxCompatRoutesLegacyPathsToEmergencyLane() throws Exception {
+        final GlobalConfiguration previous = setGlobalMode("max-compat");
+        try {
+            final CompatibilityKernel kernel = new CompatibilityKernel();
+            final RegisteredListener listener = listenerFor(mockPlugin("LegacyNormal", "com.example.LegacyNormal", List.of(), List.of()));
+            final CompatibilityTransaction transaction = kernel.beginTransaction(new DummyEvent(), new RegisteredListener[] {listener});
+            final CompatibilityKernel.RoutingDecision routingDecision = kernel.routingDecision(transaction, new RegisteredListener[] {listener});
+            final CompatibilityKernel.InvocationPlan plan = kernel.planFor(listener, transaction, routingDecision);
+
+            Assertions.assertEquals(CompatibilityKernel.InvocationPolicy.EMERGENCY_COMPATIBILITY, plan.policy());
+            Assertions.assertEquals(CompatibilityKernel.ExecutionLane.EMERGENCY_COMPATIBILITY_LANE, plan.lane());
+        } finally {
+            setGlobal(previous);
+        }
+    }
+
+    @Test
+    void strictModeRefusesForcedMaxCompatProfiles() throws Exception {
+        final GlobalConfiguration previous = setGlobalMode("strict");
+        try {
+            final CompatibilityKernel kernel = new CompatibilityKernel();
+            final Plugin plugin = mockPlugin("LegacyNormal", "com.example.LegacyNormal", List.of(), List.of());
+            final RegisteredListener listener = listenerFor(plugin);
+            final CompatibilityTransaction transaction = kernel.beginTransaction(new DummyEvent(), new RegisteredListener[] {listener});
+            final String path = CompatibilityKernel.pathFor(transaction, listener);
+            kernel.profileFor(plugin).noteForcedMaxCompat(path, "test escalation");
+
+            final CompatibilityKernel.RoutingDecision routingDecision = kernel.routingDecision(transaction, new RegisteredListener[] {listener});
+            final CompatibilityKernel.InvocationPlan plan = kernel.planFor(listener, transaction, routingDecision);
+
+            Assertions.assertEquals(CompatibilityKernel.InvocationPolicy.REFUSE, plan.policy());
+        } finally {
+            setGlobal(previous);
+        }
+    }
+
+    private static RegisteredListener listenerFor(final Plugin plugin) {
+        final Listener listener = new Listener() {
+        };
+        final EventExecutor executor = (ignoredListener, ignoredEvent) -> {
+        };
+        return new RegisteredListener(listener, executor, EventPriority.NORMAL, plugin, false);
+    }
+
+    private static Plugin mockPlugin(
+        final String name,
+        final String mainClass,
+        final List<String> dependencies,
+        final List<String> softDependencies
+    ) {
+        final PluginMeta meta = Mockito.mock(PluginMeta.class);
+        Mockito.when(meta.getName()).thenReturn(name);
+        Mockito.when(meta.getMainClass()).thenReturn(mainClass);
+        Mockito.when(meta.getPluginDependencies()).thenReturn(dependencies);
+        Mockito.when(meta.getPluginSoftDependencies()).thenReturn(softDependencies);
+        Mockito.when(meta.getVersion()).thenReturn("1.0.0");
+
+        final Plugin plugin = Mockito.mock(Plugin.class);
+        Mockito.when(plugin.getPluginMeta()).thenReturn(meta);
+        Mockito.when(plugin.getLogger()).thenReturn(Logger.getLogger(name));
+        Mockito.when(plugin.isEnabled()).thenReturn(true);
+        return plugin;
+    }
+
+    private static GlobalConfiguration setGlobalMode(final String mode) throws Exception {
+        final GlobalConfiguration previous = global();
+        final GlobalConfiguration config = new GlobalConfiguration();
+        config.compatibility = config.new Compatibility();
+        config.compatibility.mode = mode;
+        setGlobal(config);
+        return previous;
+    }
+
+    private static GlobalConfiguration global() throws Exception {
+        final Field field = GlobalConfiguration.class.getDeclaredField("instance");
+        field.setAccessible(true);
+        return (GlobalConfiguration)field.get(null);
+    }
+
+    private static void setGlobal(final GlobalConfiguration config) throws Exception {
+        final Field field = GlobalConfiguration.class.getDeclaredField("instance");
+        field.setAccessible(true);
+        field.set(null, config);
+    }
+
+    private static final class DummyEvent extends Event {
+        private static final HandlerList HANDLERS = new HandlerList();
+
+        @Override
+        public HandlerList getHandlers() {
+            return HANDLERS;
+        }
+
+        public static HandlerList getHandlerList() {
+            return HANDLERS;
+        }
+    }
+}
