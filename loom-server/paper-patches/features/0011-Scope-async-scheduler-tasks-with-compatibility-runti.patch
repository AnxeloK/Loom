From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: anxelok <anxelok@localhost>
Date: Mon, 1 Jun 2026 12:10:11 +0000
Subject: [PATCH] Scope async scheduler tasks with compatibility runtime
 context


diff --git a/src/main/java/org/bukkit/craftbukkit/scheduler/CraftAsyncTask.java b/src/main/java/org/bukkit/craftbukkit/scheduler/CraftAsyncTask.java
index e4e2e42d0ca25df7fe9f2dd4275610e45fcb2c84..79d8f93b00918d578e9451b9b03731d1df9b982d 100644
--- a/src/main/java/org/bukkit/craftbukkit/scheduler/CraftAsyncTask.java
+++ b/src/main/java/org/bukkit/craftbukkit/scheduler/CraftAsyncTask.java
@@ -1,5 +1,6 @@
 package org.bukkit.craftbukkit.scheduler;
 
+import io.papermc.paper.plugin.manager.compat.CompatibilityRuntimeContext;
 import java.util.Iterator;
 import java.util.LinkedList;
 import java.util.Map;
@@ -54,7 +55,10 @@ class CraftAsyncTask extends CraftTask {
         }
         Throwable thrown = null;
         try {
-            super.run();
+            final long transactionId = CompatibilityRuntimeContext.syntheticTransactionId();
+            try (CompatibilityRuntimeContext.Scope ignored = CompatibilityRuntimeContext.enter(this.getOwner(), transactionId, false)) {
+                super.run();
+            }
         } catch (final Throwable t) {
             thrown = t;
             this.getOwner().getLogger().log(
