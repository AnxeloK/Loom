+package net.minecraft.world.level;
+
+import ca.spottedleaf.moonrise.common.util.TickThread;
+import ca.spottedleaf.concurrentutil.util.Priority;
+import java.lang.reflect.Constructor;
+import java.lang.reflect.InvocationTargetException;
+import java.lang.reflect.Method;
+import java.util.List;
+import java.util.concurrent.atomic.AtomicBoolean;
+import java.util.concurrent.atomic.AtomicReference;
+import java.util.function.Consumer;
+import net.minecraft.core.BlockPos;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.server.level.ServerChunkCache;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.server.threading.RegionTickStaging;
+import net.minecraft.server.threading.TickRegions;
+import net.minecraft.server.threading.runtime.OwnerDomainExecutor;
+import net.minecraft.world.entity.item.ItemEntity;
+import net.minecraft.world.level.chunk.ChunkAccess;
+import net.minecraft.world.level.chunk.LevelChunk;
+import net.minecraft.world.level.block.entity.BlockEntity;
+import org.bukkit.TreeType;
+import org.bukkit.craftbukkit.block.CraftBlockState;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Assertions;
+import org.junit.jupiter.api.Test;
+import org.mockito.Mockito;
+
+@Normal
+public class LevelCaptureContextTest {
+
+    @Test
+    public void nestedFramesAndFrozenBarrierIsolateOperations() throws InterruptedException {
+        final ServerLevel firstLevel = mockLevel();
+        final ServerLevel secondLevel = mockLevel();
+        final CraftBlockState firstState = Mockito.mock(CraftBlockState.class);
+        final CraftBlockState secondState = Mockito.mock(CraftBlockState.class);
+        final BlockEntity blockEntity = Mockito.mock(BlockEntity.class);
+        final ItemEntity item = Mockito.mock(ItemEntity.class);
+        final BlockPos firstPos = new BlockPos(1, 64, 2);
+        final BlockPos secondPos = new BlockPos(3, 65, 4);
+
+        final Throwable failure = runOnTickThread(() -> {
+            try (OwnerDomainExecutor.Scope ignored = OwnerDomainExecutor.enterRegion(firstLevel, 0, 0, 0, 0, "capture-test-first")) {
+                final int modes = LevelCaptureContext.BLOCK_STATES | LevelCaptureContext.TREE | LevelCaptureContext.DROPS;
+                try (LevelCaptureContext.Scope outer = LevelCaptureContext.begin(firstLevel, modes)) {
+                    final LevelCaptureContext.Frame outerFrame = outer.frame();
+                    outerFrame.putCapturedBlockState(firstPos, firstState);
+                    outerFrame.putCapturedBlockState(secondPos, secondState);
+                    outerFrame.putCapturedBlockEntity(firstPos, blockEntity);
+                    outerFrame.captureDrop(item);
+                    outerFrame.setTreeType(TreeType.TREE);
+                    outerFrame.setOpenSign(secondPos);
+
+                    Assertions.assertSame(outerFrame, LevelCaptureContext.current(firstLevel));
+                    Assertions.assertNull(LevelCaptureContext.current(secondLevel));
+
+                    try (OwnerDomainExecutor.Scope ignoredSecond = OwnerDomainExecutor.enterRegion(secondLevel, 1, 1, 1, 1, "capture-test-second")) {
+                        try (LevelCaptureContext.Scope inner = LevelCaptureContext.begin(secondLevel, LevelCaptureContext.TREE)) {
+                            Assertions.assertSame(inner.frame(), LevelCaptureContext.current(secondLevel));
+                            Assertions.assertNull(LevelCaptureContext.current(firstLevel));
+                        }
+                    }
+                    Assertions.assertSame(outerFrame, LevelCaptureContext.current(firstLevel));
+
+                    final LevelCaptureContext.Result result = outer.freeze();
+                    Assertions.assertNull(LevelCaptureContext.current(firstLevel), "A frozen frame must hide its parent chain");
+
+                    try (LevelCaptureContext.Scope nested = LevelCaptureContext.begin(firstLevel, LevelCaptureContext.TREE)) {
+                        Assertions.assertSame(nested.frame(), LevelCaptureContext.current(firstLevel));
+                    }
+                    Assertions.assertNull(LevelCaptureContext.current(firstLevel), "Closing a child must restore the frozen barrier");
+
+                    Assertions.assertSame(firstLevel, result.level());
+                    Assertions.assertEquals(List.of(firstPos, secondPos), List.copyOf(result.blockStates().keySet()));
+                    Assertions.assertSame(firstState, result.blockStates().get(firstPos));
+                    Assertions.assertSame(blockEntity, result.blockEntities().get(firstPos));
+                    Assertions.assertEquals(List.of(item), result.drops());
+                    Assertions.assertEquals(TreeType.TREE, result.treeType());
+                    Assertions.assertEquals(secondPos, result.openSign());
+                }
+                Assertions.assertNull(LevelCaptureContext.current(firstLevel));
+            }
+        });
+
+        if (failure != null) {
+            Assertions.fail(failure);
+        }
+    }
+
+    @Test
+    public void stagingAllowsOnlyVirtualTreeCapture() throws InterruptedException {
+        final ServerLevel level = mockLevel();
+        final Throwable failure = runOnTickThread(() -> {
+            try (OwnerDomainExecutor.Scope ignored = OwnerDomainExecutor.enterRegion(level, 0, 0, 0, 0, "capture-test-staging")) {
+                final RegionTickStaging.Session session = RegionTickStaging.newSession();
+                RegionTickStaging.begin(session);
+                try {
+                    Assertions.assertThrows(
+                        IllegalStateException.class,
+                        () -> LevelCaptureContext.begin(level, LevelCaptureContext.BLOCK_STATES)
+                    );
+                    Assertions.assertThrows(
+                        IllegalStateException.class,
+                        () -> LevelCaptureContext.begin(level, LevelCaptureContext.DROPS)
+                    );
+                    try (LevelCaptureContext.Scope tree = LevelCaptureContext.begin(level, LevelCaptureContext.TREE)) {
+                        Assertions.assertSame(tree.frame(), LevelCaptureContext.current(level));
+                    }
+                } finally {
+                    RegionTickStaging.end();
+                }
+                Assertions.assertNull(LevelCaptureContext.current(level));
+            }
+        });
+
+        if (failure != null) {
+            Assertions.fail(failure);
+        }
+    }
+
+    @Test
+    public void unloadedTreeCommitResumesAfterTheChunkOwnerIsReady() throws InterruptedException {
+        final ServerLevel level = mockLevel();
+        final ServerChunkCache chunkSource = Mockito.mock(ServerChunkCache.class);
+        final LevelChunk loadedChunk = Mockito.mock(LevelChunk.class);
+        final CraftBlockState state = Mockito.mock(CraftBlockState.class);
+        final BlockPos position = new BlockPos(32, 80, 48);
+        final AtomicReference<Consumer<List<ChunkAccess>>> loadCallback = new AtomicReference<>();
+        final AtomicBoolean completed = new AtomicBoolean();
+
+        Mockito.when(level.getChunkSource()).thenReturn(chunkSource);
+        Mockito.when(state.isPlaced()).thenReturn(true);
+        Mockito.when(state.getWorldHandle()).thenReturn(level);
+        Mockito.when(state.getX()).thenReturn(position.getX());
+        Mockito.when(state.getY()).thenReturn(position.getY());
+        Mockito.when(state.getZ()).thenReturn(position.getZ());
+        Mockito.doAnswer(invocation -> {
+            loadCallback.set(invocation.getArgument(5));
+            return null;
+        }).when(level).loadChunks(
+            Mockito.anyInt(),
+            Mockito.anyInt(),
+            Mockito.anyInt(),
+            Mockito.anyInt(),
+            Mockito.any(Priority.class),
+            Mockito.any()
+        );
+
+        final Throwable failure = runOnTickThread(() -> {
+            final Object decision = newTreeDecision(List.of(state), level, position);
+            Assertions.assertFalse(commitTreeStates(decision, level, () -> completed.set(true)));
+            Assertions.assertNotNull(loadCallback.get());
+            Mockito.verify(state, Mockito.never()).place(Mockito.anyInt());
+
+            Mockito.when(chunkSource.getChunkAtIfLoadedImmediately(2, 3)).thenReturn(loadedChunk);
+            final TickRegions.RegionContext context = TickRegions.pushRegionContext(level, 2, 3, 2, 3);
+            try {
+                loadCallback.get().accept(List.of(loadedChunk));
+            } finally {
+                TickRegions.popContext(context);
+            }
+
+            Assertions.assertTrue(completed.get());
+            Mockito.verify(state).place(Mockito.anyInt());
+            Mockito.verify(level).checkCapturedTreeStateForObserverNotify(position, state);
+        });
+
+        if (failure != null) {
+            Assertions.fail(failure);
+        }
+    }
+
+    @Test
+    public void fullLevelContinuationsWaitForTheFullWorldOwner() throws InterruptedException {
+        final ServerLevel level = mockLevel();
+        final AtomicBoolean ran = new AtomicBoolean();
+        final Throwable failure = runOnTickThread(() -> {
+            OwnerDomainExecutor.execute(
+                OwnerDomainExecutor.region(
+                    level,
+                    Integer.MIN_VALUE,
+                    Integer.MIN_VALUE,
+                    Integer.MAX_VALUE,
+                    Integer.MAX_VALUE,
+                    "full-level-continuation-test"
+                ),
+                () -> ran.set(true)
+            );
+            Assertions.assertFalse(ran.get());
+
+            final TickRegions.RegionContext context = TickRegions.pushLevelContext(level);
+            try {
+                TickRegions.runFullLevelContinuations(level);
+            } finally {
+                TickRegions.popContext(context);
+            }
+            Assertions.assertTrue(ran.get());
+        });
+
+        if (failure != null) {
+            Assertions.fail(failure);
+        }
+    }
+
+    private static Object newTreeDecision(
+        final List<org.bukkit.block.BlockState> states,
+        final ServerLevel level,
+        final BlockPos observerPos
+    ) {
+        try {
+            final Class<?> decisionClass = Class.forName("net.minecraft.server.threading.RegionTickStaging$StagedTreeDecision");
+            final Constructor<?> constructor = decisionClass.getDeclaredConstructor(
+                org.bukkit.event.world.StructureGrowEvent.class,
+                org.bukkit.event.block.BlockFertilizeEvent.class,
+                int.class,
+                int.class,
+                int.class,
+                List.class,
+                ServerLevel.class,
+                BlockPos.class
+            );
+            constructor.setAccessible(true);
+            return constructor.newInstance(null, null, 0, 0, 0, states, level, observerPos);
+        } catch (final ReflectiveOperationException exception) {
+            throw new AssertionError(exception);
+        }
+    }
+
+    private static boolean commitTreeStates(
+        final Object decision,
+        final ServerLevel level,
+        final Runnable completion
+    ) {
+        try {
+            final Method method = RegionTickStaging.class.getDeclaredMethod(
+                "commitTreeStates",
+                decision.getClass(),
+                ServerLevel.class,
+                int.class,
+                Runnable.class
+            );
+            method.setAccessible(true);
+            return (boolean) method.invoke(null, decision, level, 0, completion);
+        } catch (final InvocationTargetException exception) {
+            final Throwable cause = exception.getCause();
+            if (cause instanceof Error error) {
+                throw error;
+            }
+            if (cause instanceof RuntimeException runtimeException) {
+                throw runtimeException;
+            }
+            throw new AssertionError(cause);
+        } catch (final ReflectiveOperationException exception) {
+            throw new AssertionError(exception);
+        }
+    }
+
+    private static ServerLevel mockLevel() {
+        final ServerLevel level = Mockito.mock(ServerLevel.class);
+        Mockito.when(level.getServer()).thenReturn(Mockito.mock(MinecraftServer.class));
+        return level;
+    }
+
+    private static Throwable runOnTickThread(final Runnable action) throws InterruptedException {
+        final AtomicReference<Throwable> failure = new AtomicReference<>();
+        final Thread thread = new TickThread(() -> {
+            try {
+                action.run();
+            } catch (final Throwable throwable) {
+                failure.set(throwable);
+            }
+        }, "level-capture-context-test");
+        thread.start();
+        thread.join();
+        return failure.get();
+    }
+}
