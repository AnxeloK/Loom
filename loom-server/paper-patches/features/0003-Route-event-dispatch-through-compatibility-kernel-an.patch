+    private void callThroughApartment(
+        final RegisteredListener registration,
+        final Event event,
+        final CompatibilityTransaction transaction,
+        final PluginCompatibilityProfile profile,
+        final boolean strictFallback
+    ) throws Throwable {
+        final CompatibilityApartment apartment = this.compatibilityKernel.apartmentFor(registration.getPlugin());
+        try (CompatibilityApartment.Scope scope = apartment.enter(transaction, strictFallback)) {
+            if (!scope.acquired()) {
+                profile.noteApartmentContention("contention in " + event.getEventName() + " lane=" + registration.getPriority());
+                this.compatibilityKernel.diagnostics().recordStrictFallback(
+                    profile,
+                    "apartment busy in " + event.getEventName() + " owner=" + scope.busyLease()
+                );
+                this.callListener(registration, event, transaction.id(), true);
+                return;
+            }
+            this.callListener(registration, event, transaction.id(), strictFallback);
+        }
+    }
+
+    private void callListener(
+        final RegisteredListener registration,
+        final Event event,
+        final long transactionId,
+        final boolean strictFallback
+    ) throws Throwable {
+        try (CompatibilityRuntimeContext.Scope ignored = CompatibilityRuntimeContext.enter(registration.getPlugin(), transactionId, strictFallback)) {
+            registration.callEvent(event);
+        }
+    }
