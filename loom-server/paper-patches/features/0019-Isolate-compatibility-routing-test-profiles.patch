From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: anxelok <anxelok@localhost>
Date: Tue, 2 Jun 2026 14:57:48 +0000
Subject: [PATCH] Isolate compatibility routing test profiles


diff --git a/src/test/java/io/papermc/paper/plugin/manager/compat/CompatibilityKernelRoutingTest.java b/src/test/java/io/papermc/paper/plugin/manager/compat/CompatibilityKernelRoutingTest.java
index 8dd11b78741c672f1239c117c3dbe33aab1f9469..b3c1b7c20c4bc2c94d9fd89ea4313d0634d730cd 100644
--- a/src/test/java/io/papermc/paper/plugin/manager/compat/CompatibilityKernelRoutingTest.java
+++ b/src/test/java/io/papermc/paper/plugin/manager/compat/CompatibilityKernelRoutingTest.java
@@ -55,7 +55,7 @@ class CompatibilityKernelRoutingTest {
         LoomConfiguration.setModeForTesting(LoomConfiguration.Mode.COMPATIBILITY);
 
         final CompatibilityKernel kernel = new CompatibilityKernel();
-        final RegisteredListener listener = listenerFor(mockPlugin("LegacyNormal", "com.example.LegacyNormal", List.of(), List.of()));
+        final RegisteredListener listener = listenerFor(mockPlugin("ObservedSafeLegacy", "com.example.ObservedSafeLegacy", List.of(), List.of()));
         final CompatibilityTransaction transaction = kernel.beginTransaction(new DummyEvent(), new RegisteredListener[] {listener});
         final CompatibilityKernel.RoutingDecision routingDecision = kernel.routingDecision(transaction, new RegisteredListener[] {listener});
         final CompatibilityKernel.InvocationPlan plan = kernel.planFor(listener, transaction, routingDecision);
@@ -69,7 +69,7 @@ class CompatibilityKernelRoutingTest {
         LoomConfiguration.setModeForTesting(LoomConfiguration.Mode.COMPATIBILITY);
 
         final CompatibilityKernel kernel = new CompatibilityKernel();
-        final Plugin plugin = mockPlugin("LegacyNormal", "com.example.LegacyNormal", List.of(), List.of());
+        final Plugin plugin = mockPlugin("ForcedCompatLegacy", "com.example.ForcedCompatLegacy", List.of(), List.of());
         final RegisteredListener listener = listenerFor(plugin);
         final CompatibilityTransaction transaction = kernel.beginTransaction(new DummyEvent(), new RegisteredListener[] {listener});
         final String path = CompatibilityKernel.pathFor(transaction, listener);
@@ -88,7 +88,7 @@ class CompatibilityKernelRoutingTest {
         LoomConfiguration.setModeForTesting(LoomConfiguration.Mode.PERFORMANCE);
 
         final CompatibilityKernel kernel = new CompatibilityKernel();
-        final Plugin plugin = mockPlugin("LegacyNormal", "com.example.LegacyNormal", List.of(), List.of());
+        final Plugin plugin = mockPlugin("PerformanceForcedLegacy", "com.example.PerformanceForcedLegacy", List.of(), List.of());
         final RegisteredListener listener = listenerFor(plugin);
         final CompatibilityTransaction transaction = kernel.beginTransaction(new DummyEvent(), new RegisteredListener[] {listener});
         final String path = CompatibilityKernel.pathFor(transaction, listener);
