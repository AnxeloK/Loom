+    @Test
+    public void boundedOwnerHandoffRetainsEveryRequestedChunk() {
+        final MinecraftServer server = Mockito.mock(MinecraftServer.class);
+        final ServerLevel level = Mockito.mock(ServerLevel.class);
+        Mockito.when(level.getServer()).thenReturn(server);
+        final AtomicInteger executions = new AtomicInteger();
+
+        try {
+            OwnerDomainExecutor.execute(
+                OwnerDomainExecutor.region(level, -2, 3, 4, 8, "bounded-continuation-test"),
+                executions::incrementAndGet
+            );
+
+            final Object state = ((Map<?, ?>) get(SCHEDULER_STATES, null)).get(level);
+            Assertions.assertNotNull(state);
+            final ArrayDeque<?> continuations = (ArrayDeque<?>) get(REGION_CONTINUATIONS, state);
+            Assertions.assertEquals(1, continuations.size());
+            final TickRegions.RegionBoundTask continuation = (TickRegions.RegionBoundTask)continuations.getFirst();
+            Assertions.assertAll(
+                () -> Assertions.assertEquals(-2, continuation.minChunkX()),
+                () -> Assertions.assertEquals(3, continuation.minChunkZ()),
+                () -> Assertions.assertEquals(4, continuation.maxChunkX()),
+                () -> Assertions.assertEquals(8, continuation.maxChunkZ()),
+                () -> Assertions.assertEquals(0, executions.get())
+            );
+        } finally {
+            TickRegions.clearWorldState(level);
+        }
+    }
+
+    @Test
+    public void boundedContinuationsRunWithMatchingTokenAndLease() throws InterruptedException {
+        runOnTickThread(() -> {
+            final MinecraftServer server = Mockito.mock(MinecraftServer.class);
+            final ServerLevel level = Mockito.mock(ServerLevel.class);
+            Mockito.when(level.getServer()).thenReturn(server);
+            Mockito.when(level.dimension()).thenReturn(Level.OVERWORLD);
+            final AtomicInteger executions = new AtomicInteger();
+
+            TickRegions.sendRegionContinuation(level, -5, 7, 2, 11, () -> {
+                Assertions.assertTrue(OwnerDomainExecutor.isRegionOwner(level, -5, 7, 2, 11));
+                Assertions.assertTrue(TickRegions.isCurrentThreadOwnerQuiet(level, -5, 7, 2, 11));
+                executions.incrementAndGet();
+            });
+
+            final TickRegions.RegionContext context = TickRegions.pushLevelContext(level);
+            try {
+                TickRegions.runRegionContinuations(level);
+            } finally {
+                TickRegions.popContext(context);
+                TickRegions.clearWorldState(level);
+            }
+            Assertions.assertEquals(1, executions.get());
+        });
+    }
+
