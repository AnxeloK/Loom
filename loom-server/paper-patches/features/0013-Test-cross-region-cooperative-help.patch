+    @Test
+    void cooperativeWaitRunsCompletingTaskOwnedByAnIdleRegion() throws InterruptedException {
+        final MinecraftServer server = Mockito.mock(MinecraftServer.class);
+        final ServerLevel level = Mockito.mock(ServerLevel.class);
+        Mockito.when(level.getServer()).thenReturn(server);
+        Mockito.when(level.dimension()).thenReturn(Level.OVERWORLD);
+
+        // Nothing is ticking this region, so only the waiting thread can make its queued task run.
+        final OwnerDomainExecutor.Owner outer = OwnerDomainExecutor.region(level, 11, -7, "waiting-region");
+        final OwnerDomainExecutor.Owner remote = OwnerDomainExecutor.region(level, 512, 512, "cross-region-read");
+        final AtomicReference<Thread> ranOn = new AtomicReference<>();
+        final CompletableFuture<String> queued = OwnerDomainExecutor.supply(remote, () -> {
+            Assertions.assertTrue(OwnerDomainExecutor.isRegionOwner(level, 512, 512));
+            Assertions.assertFalse(OwnerDomainExecutor.isOwner(outer), "paused owner remained logically visible");
+            Assertions.assertFalse(
+                TickRegions.isCurrentThreadOwnerQuiet(level, 11, -7),
+                "paused physical lease was exposed as the active owner"
+            );
+            ranOn.set(Thread.currentThread());
+            return "cross-region";
+        });
+        Assertions.assertFalse(queued.isDone());
+
+        final AtomicReference<String> result = new AtomicReference<>();
+        final AtomicReference<Throwable> failure = new AtomicReference<>();
+        final Thread ownerThread = new TickThread(() -> {
+            final TickRegions.RegionContext context = TickRegions.pushRegionContext(level, 11, -7, 11, -7);
+            try {
+                result.set(OwnerDomainExecutor.awaitCooperatively(queued, "cross-region-read"));
+                Assertions.assertTrue(OwnerDomainExecutor.isRegionOwner(level, 11, -7));
+                Assertions.assertFalse(OwnerDomainExecutor.isRegionOwner(level, 512, 512), "helped lease outlived the task");
+            } catch (final Throwable throwable) {
+                failure.set(throwable);
+            } finally {
+                TickRegions.popContext(context);
+            }
+        }, "cross-region-owner");
+        ownerThread.setDaemon(true);
+        ownerThread.start();
+        ownerThread.join(TimeUnit.SECONDS.toMillis(10L));
+
+        Assertions.assertFalse(ownerThread.isAlive(), "cross-region owner task was never run");
+        Assertions.assertNull(failure.get());
+        Assertions.assertEquals("cross-region", result.get());
+        Assertions.assertSame(ownerThread, ranOn.get(), "the waiting owner did not run the task itself");
+        Assertions.assertEquals(0, OwnerDomainExecutor.activeCooperativeWaits());
+    }
+
+    @Test
+    void cooperativeWaitPreservesQueuedOwnerTaskOrder() throws InterruptedException {
+        final MinecraftServer server = Mockito.mock(MinecraftServer.class);
+        final ServerLevel level = Mockito.mock(ServerLevel.class);
+        Mockito.when(level.getServer()).thenReturn(server);
+        Mockito.when(level.dimension()).thenReturn(Level.OVERWORLD);
+
+        final OwnerDomainExecutor.Owner remote = OwnerDomainExecutor.region(level, 512, 512, "ordered-cross-region-read");
+        final List<String> order = new ArrayList<>();
+        final CompletableFuture<String> first = OwnerDomainExecutor.supply(remote, () -> {
+            order.add("first");
+            return "first";
+        });
+        final CompletableFuture<String> second = OwnerDomainExecutor.supply(remote, () -> {
+            order.add("second");
+            return "second";
+        });
+
+        final AtomicReference<String> result = new AtomicReference<>();
+        final AtomicReference<Throwable> failure = new AtomicReference<>();
+        final Thread ownerThread = new TickThread(() -> {
+            final TickRegions.RegionContext context = TickRegions.pushRegionContext(level, 11, -7, 11, -7);
+            try {
+                result.set(OwnerDomainExecutor.awaitCooperatively(second, "ordered-cross-region-read"));
+            } catch (final Throwable throwable) {
+                failure.set(throwable);
+            } finally {
+                TickRegions.popContext(context);
+            }
+        }, "ordered-cross-region-owner");
+        ownerThread.setDaemon(true);
+        ownerThread.start();
+        ownerThread.join(TimeUnit.SECONDS.toMillis(10L));
+
+        Assertions.assertFalse(ownerThread.isAlive(), "ordered cross-region owner task was never run");
+        Assertions.assertNull(failure.get());
+        Assertions.assertEquals("second", result.get());
+        Assertions.assertEquals("first", first.getNow(null));
+        Assertions.assertEquals(List.of("first", "second"), order);
+    }
