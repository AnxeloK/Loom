+    @Test
+    void cooperativeWaitFollowsDeclaredFutureDependency() throws InterruptedException {
+        final MinecraftServer server = Mockito.mock(MinecraftServer.class);
+        final ServerLevel level = Mockito.mock(ServerLevel.class);
+        Mockito.when(level.getServer()).thenReturn(server);
+        Mockito.when(level.dimension()).thenReturn(Level.OVERWORLD);
+
+        final OwnerDomainExecutor.Owner remote = OwnerDomainExecutor.region(level, 512, 512, "dependent-cross-region-read");
+        final CompletableFuture<String> prerequisite = OwnerDomainExecutor.supply(remote, () -> "dependency-result");
+        final CompletableFuture<String> outward = new CompletableFuture<>();
+        OwnerDomainExecutor.linkWaitDependency(outward, prerequisite);
+        prerequisite.whenComplete((value, throwable) -> {
+            if (throwable == null) {
+                outward.complete(value);
+            } else {
+                outward.completeExceptionally(throwable);
+            }
+        });
+
+        final AtomicReference<String> result = new AtomicReference<>();
+        final AtomicReference<Throwable> failure = new AtomicReference<>();
+        final Thread ownerThread = new TickThread(() -> {
+            final TickRegions.RegionContext context = TickRegions.pushRegionContext(level, 11, -7, 11, -7);
+            try {
+                result.set(OwnerDomainExecutor.awaitCooperatively(outward, "dependent-cross-region-read"));
+            } catch (final Throwable throwable) {
+                failure.set(throwable);
+            } finally {
+                TickRegions.popContext(context);
+            }
+        }, "dependent-cross-region-owner");
+        ownerThread.setDaemon(true);
+        ownerThread.start();
+        ownerThread.join(TimeUnit.SECONDS.toMillis(10L));
+
+        Assertions.assertFalse(ownerThread.isAlive(), "declared dependency was not used for cooperative progress");
+        Assertions.assertNull(failure.get());
+        Assertions.assertEquals("dependency-result", result.get());
+    }
