+    @Test
+    void cooperativeWaitLeavesTasksOwnedByALiveRegionAlone() throws InterruptedException {
+        final MinecraftServer server = Mockito.mock(MinecraftServer.class);
+        final ServerLevel level = Mockito.mock(ServerLevel.class);
+        Mockito.when(level.getServer()).thenReturn(server);
+        Mockito.when(level.dimension()).thenReturn(Level.OVERWORLD);
+
+        final OwnerDomainExecutor.Owner remote = OwnerDomainExecutor.region(level, 512, 512, "held-region-read");
+        final CountDownLatch remoteHeld = new CountDownLatch(1);
+        final CountDownLatch releaseRemote = new CountDownLatch(1);
+        final AtomicReference<Thread> ranOn = new AtomicReference<>();
+        final AtomicReference<Throwable> holderFailure = new AtomicReference<>();
+
+        // The real owner keeps its lease while the waiter looks for work, then runs the task itself.
+        final Thread remoteThread = new TickThread(() -> {
+            final TickRegions.RegionContext context = TickRegions.pushRegionContext(level, 512, 512, 512, 512);
+            try {
+                remoteHeld.countDown();
+                Assertions.assertTrue(releaseRemote.await(10L, TimeUnit.SECONDS));
+                while (!TickRegions.runQueuedOwnerTask(level, task -> true)) {
+                    Thread.onSpinWait();
+                }
+            } catch (final Throwable throwable) {
+                holderFailure.set(throwable);
+            } finally {
+                TickRegions.popContext(context);
+            }
+        }, "held-region-owner");
+        remoteThread.setDaemon(true);
+        remoteThread.start();
+        Assertions.assertTrue(remoteHeld.await(10L, TimeUnit.SECONDS));
+
+        final CompletableFuture<String> queued = OwnerDomainExecutor.supply(remote, () -> {
+            ranOn.set(Thread.currentThread());
+            return "held-region";
+        });
+
+        final AtomicReference<String> result = new AtomicReference<>();
+        final AtomicReference<Throwable> failure = new AtomicReference<>();
+        final Thread ownerThread = new TickThread(() -> {
+            final TickRegions.RegionContext context = TickRegions.pushRegionContext(level, 11, -7, 11, -7);
+            try {
+                releaseRemote.countDown();
+                result.set(OwnerDomainExecutor.awaitCooperatively(queued, "held-region-read"));
+            } catch (final Throwable throwable) {
+                failure.set(throwable);
+            } finally {
+                TickRegions.popContext(context);
+            }
+        }, "held-region-waiter");
+        ownerThread.setDaemon(true);
+        ownerThread.start();
+        ownerThread.join(TimeUnit.SECONDS.toMillis(10L));
+        remoteThread.join(TimeUnit.SECONDS.toMillis(10L));
+
+        Assertions.assertFalse(ownerThread.isAlive(), "waiter did not complete");
+        Assertions.assertNull(failure.get());
+        Assertions.assertNull(holderFailure.get());
+        Assertions.assertEquals("held-region", result.get());
+        Assertions.assertSame(remoteThread, ranOn.get(), "a live region owner's task was stolen by the waiter");
+    }
+
+    private static boolean runOrderedMatchingTask(
+        final Queue<Runnable> queue,
+        final java.util.function.Predicate<Runnable> predicate
+    ) {
+        Runnable target = null;
+        for (final Runnable candidate : queue) {
+            if (predicate.test(candidate)) {
+                target = candidate;
+                break;
+            }
+        }
+        if (target == null) {
+            return false;
+        }
+
+        Runnable predecessor = null;
+        for (final Runnable candidate : queue) {
+            if (candidate == target) {
+                break;
+            }
+            if (predecessor == null && OwnerDomainExecutor.mustRunBefore(candidate, target)) {
+                predecessor = candidate;
+            }
+        }
+
+        final Runnable selected = predecessor == null ? target : predecessor;
+        for (final java.util.Iterator<Runnable> iterator = queue.iterator(); iterator.hasNext(); ) {
+            if (iterator.next() == selected) {
+                iterator.remove();
+                selected.run();
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private static final class TestEventLoop extends BlockableEventLoop<Runnable> {
+        private final Thread runningThread;
+
+        private TestEventLoop() {
+            super("ordered-owner-task-test", false);
+            this.runningThread = Thread.currentThread();
+        }
+
+        @Override
+        protected boolean shouldRun(final Runnable task) {
+            return true;
+        }
+
+        @Override
+        protected Thread getRunningThread() {
+            return this.runningThread;
+        }
+
+        @Override
+        public Runnable wrapRunnable(final Runnable runnable) {
+            return runnable;
+        }
+    }
+
     private static CompletableFuture<String> nestedWait(final int remaining) {
         if (remaining == 0) {
             return CompletableFuture.completedFuture("done");
