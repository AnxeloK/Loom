diff --git a/src/test/java/com/destroystokyo/paper/LoomUpdateCheckerTest.java b/src/test/java/com/destroystokyo/paper/LoomUpdateCheckerTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..076e410d9c226a72878fecdd36884fa04d1e0564
--- /dev/null
+++ b/src/test/java/com/destroystokyo/paper/LoomUpdateCheckerTest.java
@@ -0,0 +1,145 @@
+package com.destroystokyo.paper;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonNull;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Optional;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class LoomUpdateCheckerTest {
+    @Test
+    void releaseUpdatesMatchMinecraftVersionAndUseLoomDownload() {
+        final JsonArray releases = releases(
+            release("v2.3.0", "26.4", false, false),
+            release("v2.2.1", "26.3", false, false),
+            release("v2.2.0", "26.3", true, false)
+        );
+        final var result = published(releases, "2.2.0", true);
+        assertEquals(LoomUpdateChecker.Status.OUTDATED, result.status());
+        assertEquals("https://github.com/AnxeloK/Loom/releases/tag/v2.2.1", result.downloadUrl());
+        assertTrue(result.message().contains("Minecraft 26.3"));
+    }
+
+    @Test
+    void stableBuildsIgnorePrereleasesAndDrafts() {
+        final JsonArray releases = releases(
+            release("v2.4.0", "26.3", false, true),
+            release("v2.3.0", "26.3", true, false),
+            release("v2.2.0", "26.3", false, false)
+        );
+        assertEquals(LoomUpdateChecker.Status.CURRENT, published(releases, "2.2.0", false).status());
+        assertTrue(published(releases, "2.2.0", true).message().contains("2.3.0 (prerelease)"));
+    }
+
+    @Test
+    void versionsAreComparedNumerically() {
+        final JsonArray releases = releases(release("v2.9.9", "26.3", false, false), release("v2.10.0", "26.3", false, false));
+        assertTrue(published(releases, "2.9.9", false).downloadUrl().endsWith("v2.10.0"));
+    }
+
+    @Test
+    void releaseWithoutRuntimeIsNotAnUpdate() {
+        final JsonObject incomplete = release("v2.3.0", "26.3", false, false);
+        incomplete.add("assets", new JsonArray());
+        final var result = published(releases(incomplete, release("v2.2.0", "26.3", false, false)), "2.2.0", false);
+        assertEquals(LoomUpdateChecker.Status.CURRENT, result.status());
+    }
+
+    @Test
+    void noCompatibleReleaseDoesNotClaimCurrent() {
+        assertEquals(LoomUpdateChecker.Status.UNAVAILABLE, published(releases(release("v2.3.0", "26.30", false, false)), "2.2.0", false).status());
+    }
+
+    @Test
+    void newerUnpublishedBuildDoesNotGetDowngradeAdvice() {
+        assertEquals(LoomUpdateChecker.Status.CUSTOM, published(releases(release("v2.2.0", "26.3", false, false)), "2.3.0", false).status());
+    }
+
+    @Test
+    void releaseSearchContinuesOntoNextPage() {
+        final JsonArray first = new JsonArray();
+        for (int index = 0; index < 100; index++) first.add(release("v2.3.0", "26.4", false, false));
+        final List<String> requests = new ArrayList<>();
+        final var checker = new LoomUpdateChecker(endpoint -> {
+            requests.add(endpoint);
+            return endpoint.endsWith("page=1") ? first : releases(release("v2.2.1", "26.3", false, false));
+        });
+        assertEquals(LoomUpdateChecker.Status.OUTDATED, checker.check("26.3", Optional.of("2.2.0"), false, Optional.empty()).status());
+        assertEquals(List.of("releases?per_page=100&page=1", "releases?per_page=100&page=2"), requests);
+    }
+
+    @Test
+    void developmentBuildUsesCommitAndMinecraftBranchInsteadOfDetachedHead() {
+        final List<String> requests = new ArrayList<>();
+        final var checker = new LoomUpdateChecker(endpoint -> {
+            requests.add(endpoint);
+            return JsonParser.parseString("{\"status\":\"ahead\",\"ahead_by\":3}");
+        });
+        final var result = checker.check("26.3", Optional.empty(), true, Optional.of("abcdef0"));
+        assertEquals(LoomUpdateChecker.Status.OUTDATED, result.status());
+        assertTrue(result.message().contains("3 commit(s) behind"));
+        assertEquals(List.of("compare/abcdef0...ver%2F26.3.x"), requests);
+        assertEquals("https://github.com/AnxeloK/Loom/actions", result.downloadUrl());
+    }
+
+    @Test
+    void identicalDevelopmentBuildIsLabelledDevelopment() {
+        final var checker = new LoomUpdateChecker(endpoint -> JsonParser.parseString("{\"status\":\"identical\"}"));
+        final var result = checker.check("26.3", Optional.empty(), true, Optional.of("abcdef0"));
+        assertEquals(LoomUpdateChecker.Status.CURRENT, result.status());
+        assertTrue(result.message().contains("development build"));
+    }
+
+    @Test
+    void privateOrDivergedBuildDoesNotReceivePublicUpdateDistance() {
+        for (final String status : List.of("behind", "diverged")) {
+            final var checker = new LoomUpdateChecker(endpoint -> JsonParser.parseString("{\"status\":\"" + status + "\"}"));
+            assertEquals(LoomUpdateChecker.Status.CUSTOM, checker.check("26.3", Optional.empty(), true, Optional.of("abcdef0")).status());
+        }
+        final var unknown = new LoomUpdateChecker(endpoint -> JsonNull.INSTANCE);
+        assertEquals(LoomUpdateChecker.Status.CUSTOM, unknown.check("26.3", Optional.empty(), true, Optional.of("abcdef0")).status());
+    }
+
+    @Test
+    void missingCommitDoesNotQueryAnotherProject() {
+        final var checker = new LoomUpdateChecker(endpoint -> fail("No network request expected"));
+        assertEquals(LoomUpdateChecker.Status.CUSTOM, checker.check("26.3", Optional.empty(), true, Optional.empty()).status());
+    }
+
+    @Test
+    void failedOrMalformedResponseNeverClaimsCurrent() {
+        final var failed = new LoomUpdateChecker(endpoint -> { throw new IOException("rate limited"); });
+        assertEquals(LoomUpdateChecker.Status.UNAVAILABLE, failed.check("26.3", Optional.of("2.2.0"), true, Optional.empty()).status());
+        final var malformed = new LoomUpdateChecker(endpoint -> JsonParser.parseString("[{}]"));
+        assertEquals(LoomUpdateChecker.Status.UNAVAILABLE, malformed.check("26.3", Optional.of("2.2.0"), true, Optional.empty()).status());
+    }
+
+    private static LoomUpdateChecker.Result published(final JsonArray releases, final String version, final boolean prereleases) {
+        return new LoomUpdateChecker(endpoint -> releases).check("26.3", Optional.of(version), prereleases, Optional.empty());
+    }
+
+    private static JsonArray releases(final JsonObject... values) {
+        final JsonArray result = new JsonArray();
+        for (final JsonObject value : values) result.add(value);
+        return result;
+    }
+
+    private static JsonObject release(final String tag, final String minecraftVersion, final boolean prerelease, final boolean draft) {
+        final JsonObject result = new JsonObject();
+        result.addProperty("tag_name", tag);
+        result.addProperty("prerelease", prerelease);
+        result.addProperty("draft", draft);
+        final JsonObject asset = new JsonObject();
+        asset.addProperty("name", "loom-" + tag.substring(1) + "-mc" + minecraftVersion + ".jar");
+        final JsonArray assets = new JsonArray();
+        assets.add(asset);
+        result.add("assets", assets);
+        return result;
+    }
+}
