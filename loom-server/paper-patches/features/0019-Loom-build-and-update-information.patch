+    }
+
+    static LoomBuildInfo fromManifest(final Manifest manifest) {
+        if (manifest == null) {
+            return new LoomBuildInfo(Optional.empty(), "DEVELOPMENT");
+        }
+        final String version = manifest.getMainAttributes().getValue("Loom-Version");
+        final String channel = manifest.getMainAttributes().getValue("Loom-Channel");
+        return new LoomBuildInfo(
+            Optional.ofNullable(version).map(String::trim).filter(value -> value.matches("[0-9]+\\.[0-9]+\\.[0-9]+")),
+            channel == null ? "DEVELOPMENT" : channel.trim().toUpperCase(Locale.ROOT)
+        );
+    }
+
+    public boolean includesPrereleases() {
+        return !this.channel.equals("STABLE");
+    }
+
+    String describe(final String minecraftVersion, final OptionalInt buildNumber,
+                    final Optional<String> branch, final Optional<String> commit, final Instant buildTime) {
+        final String channelName = switch (this.channel) {
+            case "STABLE" -> "Stable";
+            case "BETA" -> "Beta";
+            case "ALPHA" -> "Alpha";
+            default -> "Development";
+        };
+        final StringBuilder result = new StringBuilder(this.releaseVersion.orElse("Development"));
+        result.append(" (Minecraft ").append(minecraftVersion).append(", ").append(channelName).append(')');
+        if (buildNumber.isPresent()) {
+            result.append(" build ").append(buildNumber.getAsInt());
+        }
+        if (branch.isPresent() || commit.isPresent()) {
+            result.append(" [");
+            branch.ifPresent(result::append);
+            if (branch.isPresent() && commit.isPresent()) {
+                result.append('@');
+            }
+            commit.ifPresent(result::append);
+            result.append(']');
+        }
+        result.append(" (").append(buildTime.truncatedTo(ChronoUnit.SECONDS)).append(')');
+        return result.toString();
+    }
+
+    private static final class Holder {
+        private static final LoomBuildInfo INSTANCE = fromManifest(JarManifests.manifest(CraftServer.class));
+    }
+}
