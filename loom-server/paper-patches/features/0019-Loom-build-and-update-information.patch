index 0000000000000000000000000000000000000000..be20b163a534d997f0eee5afbdd2cd2f546516fc
--- /dev/null
+++ b/src/main/java/com/destroystokyo/paper/LoomUpdateChecker.java
@@ -0,0 +1,186 @@
+package com.destroystokyo.paper;
+
+import com.google.gson.Gson;
+import com.google.gson.JsonArray;
+import com.google.gson.JsonElement;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParseException;
+import java.io.IOException;
+import java.io.InputStreamReader;
+import java.net.HttpURLConnection;
+import java.net.URI;
+import java.net.URLEncoder;
+import java.nio.charset.StandardCharsets;
+import java.util.Optional;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+final class LoomUpdateChecker {
+    static final String REPOSITORY = "https://github.com/AnxeloK/Loom";
+    static final String DOWNLOADS = REPOSITORY + "/releases";
+    private static final String API = "https://api.github.com/repos/AnxeloK/Loom/";
+    private static final Pattern VERSION = Pattern.compile("v?([0-9]+)\\.([0-9]+)\\.([0-9]+)");
+    private static final Gson GSON = new Gson();
+    private final JsonSource source;
+
+    LoomUpdateChecker() {
+        this(LoomUpdateChecker::readJson);
+    }
+
+    LoomUpdateChecker(final JsonSource source) {
+        this.source = source;
+    }
+
+    Result check(final String minecraftVersion, final Optional<String> releaseVersion,
+                 final boolean includePrereleases, final Optional<String> gitCommit) {
+        try {
+            if (releaseVersion.isPresent()) {
+                return this.checkRelease(minecraftVersion, Version.parse(releaseVersion.get()).orElseThrow(), includePrereleases);
+            }
+            return this.checkDevelopment(minecraftVersion, gitCommit);
+        } catch (final IOException | IllegalArgumentException | IllegalStateException | JsonParseException exception) {
+            return new Result(Status.UNAVAILABLE, "Unable to check Loom updates right now.", DOWNLOADS);
+        }
+    }
+
+    private Result checkRelease(final String minecraftVersion, final Version current, final boolean includePrereleases) throws IOException {
+        Release latest = null;
+        for (int page = 1; page <= 10; page++) {
+            final JsonElement response = this.source.read("releases?per_page=100&page=" + page);
+            if (response == null || !response.isJsonArray()) {
+                throw new IllegalStateException("Invalid Loom releases response");
+            }
+            final JsonArray releases = response.getAsJsonArray();
+            for (final JsonElement element : releases) {
+                final JsonObject release = element.getAsJsonObject();
+                if (required(release, "draft").getAsBoolean() || (!includePrereleases && required(release, "prerelease").getAsBoolean())) {
+                    continue;
+                }
+                final Optional<Version> version = Version.parse(required(release, "tag_name").getAsString());
+                if (version.isEmpty()) {
+                    continue;
+                }
+                final String expectedAsset = "loom-" + version.get() + "-mc" + minecraftVersion + ".jar";
+                boolean hasRuntime = false;
+                for (final JsonElement asset : required(release, "assets").getAsJsonArray()) {
+                    if (expectedAsset.equals(required(asset.getAsJsonObject(), "name").getAsString())) {
+                        hasRuntime = true;
+                        break;
+                    }
+                }
+                if (hasRuntime && (latest == null || version.get().compareTo(latest.version) > 0)) {
+                    latest = new Release(version.get(), required(release, "prerelease").getAsBoolean());
+                }
+            }
+            if (releases.size() < 100) {
+                if (latest == null) {
+                    return new Result(Status.UNAVAILABLE, "No published Loom release matches Minecraft " + minecraftVersion + " and this release channel.", DOWNLOADS);
+                }
+                final int comparison = latest.version.compareTo(current);
+                final String downloads = DOWNLOADS + "/tag/v" + latest.version;
+                if (comparison > 0) {
+                    return new Result(Status.OUTDATED, "Loom " + latest.version + (latest.prerelease ? " (prerelease)" : "") + " is available for Minecraft " + minecraftVersion + ".", downloads);
+                }
+                if (comparison == 0) {
+                    return new Result(Status.CURRENT, "You are running the latest published Loom release for Minecraft " + minecraftVersion + ".", downloads);
+                }
+                return new Result(Status.CUSTOM, "This Loom build is newer than the published releases for Minecraft " + minecraftVersion + ".", DOWNLOADS);
+            }
+        }
+        return new Result(Status.UNAVAILABLE, "Unable to check the complete Loom release history right now.", DOWNLOADS);
+    }
+
+    private Result checkDevelopment(final String minecraftVersion, final Optional<String> gitCommit) throws IOException {
+        if (gitCommit.isEmpty() || !gitCommit.get().matches("[0-9a-fA-F]{7,40}")) {
+            return new Result(Status.CUSTOM, "This Loom development build has no public commit metadata.", DOWNLOADS);
+        }
+        if (!minecraftVersion.matches("[0-9]+\\.[0-9]+(?:\\.[0-9]+)?")) {
+            return new Result(Status.UNAVAILABLE, "No public Loom version line matches Minecraft " + minecraftVersion + ".", DOWNLOADS);
+        }
+        final String[] version = minecraftVersion.split("\\.");
+        final String branch = "ver/" + version[0] + "." + version[1] + ".x";
+        final JsonElement response = this.source.read("compare/" + gitCommit.get() + "..." + URLEncoder.encode(branch, StandardCharsets.UTF_8));
+        if (response != null && response.isJsonNull()) {
+            return new Result(Status.CUSTOM, "This build is outside the public Loom source line; update status is unavailable.", DOWNLOADS);
+        }
+        if (response == null || !response.isJsonObject()) {
+            throw new IllegalStateException("Invalid Loom comparison response");
+        }
+        final JsonObject comparison = response.getAsJsonObject();
+        return switch (required(comparison, "status").getAsString()) {
+            case "identical" -> new Result(Status.CURRENT, "You are running the latest Loom development build for Minecraft " + minecraftVersion + ".", DOWNLOADS);
+            case "ahead" -> new Result(Status.OUTDATED, "This Loom development build is " + required(comparison, "ahead_by").getAsInt() + " commit(s) behind " + branch + ".", REPOSITORY + "/actions");
+            case "behind", "diverged" -> new Result(Status.CUSTOM, "This build differs from the public Loom source line; check its source before updating.", DOWNLOADS);
+            default -> new Result(Status.UNAVAILABLE, "Unable to determine this Loom build's update status.", DOWNLOADS);
+        };
+    }
+
+    private static JsonElement required(final JsonObject object, final String field) {
+        final JsonElement value = object.get(field);
+        if (value == null || value.isJsonNull()) {
+            throw new IllegalStateException("Missing GitHub response field " + field);
+        }
+        return value;
+    }
+
+    private static JsonElement readJson(final String endpoint) throws IOException {
+        final HttpURLConnection connection = (HttpURLConnection) URI.create(API + endpoint).toURL().openConnection();
+        connection.setConnectTimeout(5000);
+        connection.setReadTimeout(5000);
+        connection.setRequestProperty("User-Agent", "Loom-update-checker (" + REPOSITORY + ")");
+        connection.setRequestProperty("Accept", "application/vnd.github+json");
+        connection.setRequestProperty("X-GitHub-Api-Version", "2022-11-28");
+        try {
+            final int status = connection.getResponseCode();
+            if (status == HttpURLConnection.HTTP_NOT_FOUND && endpoint.startsWith("compare/")) {
+                return com.google.gson.JsonNull.INSTANCE;
+            }
+            if (status != HttpURLConnection.HTTP_OK) {
+                throw new IOException("GitHub returned HTTP " + status);
+            }
+            try (final InputStreamReader reader = new InputStreamReader(connection.getInputStream(), StandardCharsets.UTF_8)) {
+                return GSON.fromJson(reader, JsonElement.class);
+            }
+        } finally {
+            connection.disconnect();
+        }
+    }
+
+    enum Status {
+        CURRENT, OUTDATED, CUSTOM, UNAVAILABLE
+    }
+
+    record Result(Status status, String message, String downloadUrl) {
+    }
+
+    private record Release(Version version, boolean prerelease) {
+    }
+
+    private record Version(int major, int minor, int patch) implements Comparable<Version> {
+        static Optional<Version> parse(final String value) {
+            final Matcher matcher = VERSION.matcher(value);
+            if (!matcher.matches()) {
+                return Optional.empty();
+            }
+            return Optional.of(new Version(Integer.parseInt(matcher.group(1)), Integer.parseInt(matcher.group(2)), Integer.parseInt(matcher.group(3))));
+        }
+
+        @Override
+        public int compareTo(final Version other) {
+            int comparison = Integer.compare(this.major, other.major);
+            if (comparison == 0) comparison = Integer.compare(this.minor, other.minor);
+            if (comparison == 0) comparison = Integer.compare(this.patch, other.patch);
+            return comparison;
+        }
+
+        @Override
+        public String toString() {
+            return this.major + "." + this.minor + "." + this.patch;
+        }
+    }
+
+    @FunctionalInterface
+    interface JsonSource {
+        JsonElement read(String endpoint) throws IOException;
+    }
+}
