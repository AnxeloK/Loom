diff --git a/src/test/java/io/papermc/paper/LoomBuildInfoTest.java b/src/test/java/io/papermc/paper/LoomBuildInfoTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..f7cf21ebf2649fbd3cce641f8da4fa02dd57446e
--- /dev/null
+++ b/src/test/java/io/papermc/paper/LoomBuildInfoTest.java
@@ -0,0 +1,47 @@
+package io.papermc.paper;
+
+import java.time.Instant;
+import java.util.Optional;
+import java.util.OptionalInt;
+import java.util.jar.Manifest;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+public class LoomBuildInfoTest {
+    @Test
+    void releaseOutputSeparatesLoomMinecraftAndChannel() {
+        final Manifest manifest = new Manifest();
+        manifest.getMainAttributes().putValue("Loom-Version", "2.2.0");
+        manifest.getMainAttributes().putValue("Loom-Channel", "BETA");
+        final LoomBuildInfo info = LoomBuildInfo.fromManifest(manifest);
+        final String output = info.describe("26.3", OptionalInt.of(42), Optional.of("ver/26.3.x"), Optional.of("abcdef0"), Instant.parse("2026-09-30T12:00:00Z"));
+        assertEquals("2.2.0 (Minecraft 26.3, Beta) build 42 [ver/26.3.x@abcdef0] (2026-09-30T12:00:00Z)", output);
+        assertTrue(info.includesPrereleases());
+    }
+
+    @Test
+    void untaggedBuildDoesNotClaimToBeARelease() {
+        final Manifest manifest = new Manifest();
+        manifest.getMainAttributes().putValue("Loom-Version", "");
+        manifest.getMainAttributes().putValue("Loom-Channel", "BETA");
+        final LoomBuildInfo info = LoomBuildInfo.fromManifest(manifest);
+        assertTrue(info.releaseVersion().isEmpty());
+        assertTrue(info.describe("26.3", OptionalInt.empty(), Optional.empty(), Optional.of("abcdef0"), Instant.EPOCH).startsWith("Development (Minecraft 26.3, Beta) [abcdef0]"));
+    }
+
+    @Test
+    void stableChannelExcludesPrereleases() {
+        final Manifest manifest = new Manifest();
+        manifest.getMainAttributes().putValue("Loom-Channel", " stable ");
+        assertFalse(LoomBuildInfo.fromManifest(manifest).includesPrereleases());
+    }
+
+    @Test
+    void missingManifestAndInvalidReleaseRemainDevelopment() {
+        assertEquals(Optional.empty(), LoomBuildInfo.fromManifest(null).releaseVersion());
+        final Manifest manifest = new Manifest();
+        manifest.getMainAttributes().putValue("Loom-Version", "unknown");
+        assertEquals(Optional.empty(), LoomBuildInfo.fromManifest(manifest).releaseVersion());
+    }
+}
