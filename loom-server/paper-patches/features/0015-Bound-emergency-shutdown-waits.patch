diff --git a/src/main/java/org/bukkit/craftbukkit/util/ServerShutdownThread.java b/src/main/java/org/bukkit/craftbukkit/util/ServerShutdownThread.java
index def2e3c1960d41d8d72c32d36a256350ce3448f1..5fef5c0ee290326c810ca907aea8646952b31310 100644
--- a/src/main/java/org/bukkit/craftbukkit/util/ServerShutdownThread.java
+++ b/src/main/java/org/bukkit/craftbukkit/util/ServerShutdownThread.java
@@ -1,9 +1,15 @@
 package org.bukkit.craftbukkit.util;
 
 import io.papermc.paper.log.LoggerShutdown;
+import java.util.concurrent.RejectedExecutionException;
 import net.minecraft.server.MinecraftServer;
+import net.minecraft.server.threading.runtime.OwnerDomainExecutor;
 
 public class ServerShutdownThread extends Thread {
+    private static final long SHUTDOWN_GRACE_MILLIS = Math.max(
+        1_000L,
+        Long.getLong("loom.shutdownHook.graceMillis", 600_000L)
+    );
     private final MinecraftServer server;
 
     public ServerShutdownThread(MinecraftServer server) {
@@ -13,24 +19,54 @@ public class ServerShutdownThread extends Thread {
     @Override
     public void run() {
         try {
-            // Paper start - try to shutdown on main
-            server.halt(false, false);
-            for (int i = 1000; i > 0 && !server.hasStopped(); i -= 100) {
-                Thread.sleep(100);
+            // Loom - request shutdown from the lifecycle owner and wait only for a bounded grace period.
+            // Stealing stopServer onto this hook thread races every mutable owner domain; waiting on the
+            // stalled server's processQueue deadlocks. If the owner cannot finish, terminate abnormally
+            // instead of pretending that an unsafe partial save is possible.
+            if (!requestShutdown(this.server, false)) {
+                haltStalledServer(this.server, "JVM shutdown hook could not reach the server lifecycle owner");
             }
-            if (server.hasStopped()) {
-                while (!server.hasFullyShutdown) Thread.sleep(1000);
-                return;
+            if (!awaitFullShutdown(this.server, SHUTDOWN_GRACE_MILLIS)) {
+                haltStalledServer(this.server, "JVM shutdown hook timed out waiting for the server lifecycle owner");
             }
-            // Looks stalled, close async
-            server.forceTicks = true;
-            this.server.close();
-            while (!server.hasFullyShutdown) Thread.sleep(1000);
         } catch (InterruptedException e) {
-            e.printStackTrace();
-            // Paper end
+            Thread.currentThread().interrupt();
+            haltStalledServer(this.server, "JVM shutdown hook was interrupted before shutdown completed");
         } finally {
             LoggerShutdown.shutdownLogging();
         }
     }
+
+    public static boolean requestShutdown(final MinecraftServer server, final boolean restarting) {
+        if (server.hasFullyShutdown || server.hasStopped() || server.isStopped()) {
+            return true;
+        }
+        try {
+            OwnerDomainExecutor.execute(
+                OwnerDomainExecutor.global(server, "server-shutdown-request"),
+                () -> server.halt(false, restarting)
+            );
+            return true;
+        } catch (final RejectedExecutionException rejected) {
+            return server.hasFullyShutdown || server.hasStopped() || server.isStopped();
+        }
+    }
+
+    public static boolean awaitFullShutdown(final MinecraftServer server, final long timeoutMillis) throws InterruptedException {
+        final long deadline = System.nanoTime() + java.util.concurrent.TimeUnit.MILLISECONDS.toNanos(timeoutMillis);
+        while (!server.hasFullyShutdown) {
+            final long remainingNanos = deadline - System.nanoTime();
+            if (remainingNanos <= 0L) {
+                return false;
+            }
+            Thread.sleep(Math.min(100L, Math.max(1L, java.util.concurrent.TimeUnit.NANOSECONDS.toMillis(remainingNanos))));
+        }
+        return true;
+    }
+
+    public static void haltStalledServer(final MinecraftServer server, final String reason) {
+        server.abnormalExit = true;
+        MinecraftServer.LOGGER.error("{}; forcing abnormal termination without an off-owner save", reason);
+        Runtime.getRuntime().halt(70);
+    }
 }
