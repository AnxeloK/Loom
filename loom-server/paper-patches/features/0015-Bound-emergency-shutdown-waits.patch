diff --git a/src/test/java/org/bukkit/craftbukkit/util/ServerShutdownThreadTest.java b/src/test/java/org/bukkit/craftbukkit/util/ServerShutdownThreadTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..08c4f83335cde1c7b88b9dd0bce05831a89c053a
--- /dev/null
+++ b/src/test/java/org/bukkit/craftbukkit/util/ServerShutdownThreadTest.java
@@ -0,0 +1,63 @@
+package org.bukkit.craftbukkit.util;
+
+import java.time.Duration;
+import java.util.concurrent.atomic.AtomicReference;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.server.threading.runtime.OwnerDomainExecutor;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Assertions;
+import org.junit.jupiter.api.Test;
+import org.mockito.Mockito;
+
+@Normal
+public class ServerShutdownThreadTest {
+
+    @Test
+    public void shutdownRequestRunsInsideTheLifecycleOwner() {
+        final MinecraftServer server = Mockito.mock(MinecraftServer.class);
+        final AtomicReference<Runnable> queued = new AtomicReference<>();
+        Mockito.doAnswer(invocation -> {
+            queued.set(invocation.getArgument(0));
+            return true;
+        }).when(server).enqueueGlobalOwnerTask(Mockito.any(Runnable.class));
+        Mockito.doAnswer(invocation -> {
+            Assertions.assertTrue(OwnerDomainExecutor.isGlobalOwner(server));
+            return null;
+        }).when(server).safeShutdown(false, true);
+
+        Assertions.assertTrue(ServerShutdownThread.requestShutdown(server, true));
+
+        Mockito.verify(server, Mockito.never()).safeShutdown(false, true);
+        Assertions.assertNotNull(queued.get());
+        queued.get().run();
+        Mockito.verify(server).safeShutdown(false, true);
+    }
+
+    @Test
+    public void shutdownTransitionRejectsWithoutRunningOnTheCaller() {
+        final MinecraftServer server = Mockito.mock(MinecraftServer.class);
+        Mockito.when(server.isStopped()).thenReturn(false, true);
+
+        Assertions.assertTrue(ServerShutdownThread.requestShutdown(server, false));
+
+        Mockito.verify(server, Mockito.never()).safeShutdown(Mockito.anyBoolean(), Mockito.anyBoolean());
+    }
+
+    @Test
+    public void completedShutdownReturnsImmediately() throws InterruptedException {
+        final MinecraftServer server = Mockito.mock(MinecraftServer.class);
+        server.hasFullyShutdown = true;
+
+        Assertions.assertTrue(ServerShutdownThread.awaitFullShutdown(server, 1_000L));
+    }
+
+    @Test
+    public void stalledShutdownStopsWaitingAtTheDeadline() {
+        final MinecraftServer server = Mockito.mock(MinecraftServer.class);
+
+        Assertions.assertTimeoutPreemptively(
+            Duration.ofSeconds(1L),
+            () -> Assertions.assertFalse(ServerShutdownThread.awaitFullShutdown(server, 1L))
+        );
+    }
+}
