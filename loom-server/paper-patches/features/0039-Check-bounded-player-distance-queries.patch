From: anxelok <anxelok@localhost>
Date: Tue, 3 Nov 2026 00:23:23 +0200
Subject: [PATCH] Check bounded player distance queries


diff --git a/src/test/java/net/minecraft/server/level/ChunkMapPlayerDistanceTest.java b/src/test/java/net/minecraft/server/level/ChunkMapPlayerDistanceTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..02d18ff359caacf34b3264c68a79bf49c10472e5
--- /dev/null
+++ b/src/test/java/net/minecraft/server/level/ChunkMapPlayerDistanceTest.java
@@ -0,0 +1,165 @@
+package net.minecraft.server.level;
+
+import ca.spottedleaf.moonrise.common.list.ReferenceList;
+import ca.spottedleaf.moonrise.common.misc.NearbyPlayers;
+import java.lang.reflect.Field;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Random;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.concurrent.atomic.AtomicReference;
+import net.minecraft.core.BlockPos;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.world.phys.Vec3;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+@Normal
+class ChunkMapPlayerDistanceTest {
+    @BeforeAll
+    static void prepareTypes() {
+        mock(MinecraftServer.class);
+        mock(ServerLevel.class);
+        mock(ServerPlayer.class);
+        mock(ChunkMap.class);
+        mock(NearbyPlayers.class);
+    }
+
+    @Test
+    void nearbyFireQueriesDoNotVisitDistantPlayers() throws Exception {
+        final Fixture f = new Fixture();
+        for (int i = 0; i < 100; i++) f.player(new Vec3(10_000 + i, 64, 10_000), false);
+        f.player(new Vec3(0, 201, 0), false);
+        assertFalse(f.map.anyPlayerCloseEnoughTo(new BlockPos(0, 64, 0), 128));
+        assertEquals(1, f.spectatorChecks.get(), "visit only the indexed candidate, including its vertical distance");
+    }
+
+    @Test
+    void anEmptyNearbyIndexAvoidsTheGlobalScan() throws Exception {
+        final Fixture f = new Fixture();
+        f.player(new Vec3(10_000, 64, 10_000), false);
+        assertFalse(f.map.anyPlayerCloseEnoughTo(new BlockPos(0, 64, 0), 128));
+        assertEquals(0, f.spectatorChecks.get());
+    }
+
+    @Test
+    void distanceIsStrictAndIncludesHeightAndCurrentSpectatorState() throws Exception {
+        final Fixture f = new Fixture();
+        final Actor edge = f.player(new Vec3(128, 64, 0), false);
+        final Actor above = f.player(new Vec3(0, 192, 0), false);
+        f.player(new Vec3(0, 64, 0), true);
+        final BlockPos pos = new BlockPos(0, 64, 0);
+        assertFalse(f.map.anyPlayerCloseEnoughTo(pos, 128));
+        edge.position.set(new Vec3(127.99, 64, 0));
+        assertTrue(f.map.anyPlayerCloseEnoughTo(pos, 128));
+        edge.spectator = true;
+        assertFalse(f.map.anyPlayerCloseEnoughTo(pos, 128));
+        above.position.set(new Vec3(0, 191.99, 0));
+        assertTrue(f.map.anyPlayerCloseEnoughTo(pos, 128));
+    }
+
+    @Test
+    void wideCustomRadiiRetainTheGlobalFallback() throws Exception {
+        final Fixture f = new Fixture();
+        f.player(new Vec3(999.9, 64, 0), false);
+        assertTrue(f.map.anyPlayerCloseEnoughTo(new BlockPos(0, 64, 0), 1000));
+        verifyNoInteractions(f.nearby);
+    }
+
+    @Test
+    void nonpositiveRadiiDoNotInspectPlayers() throws Exception {
+        final Fixture f = new Fixture();
+        f.player(new Vec3(0, 64, 0), false);
+        for (int radius : new int[]{0, -1, Integer.MIN_VALUE}) {
+            assertFalse(f.map.anyPlayerCloseEnoughTo(new BlockPos(0, 64, 0), radius));
+        }
+        assertEquals(0, f.spectatorChecks.get());
+        verifyNoInteractions(f.nearby);
+    }
+
+    @Test
+    void indexedQueriesMatchTheFullScanAcrossChunkEdgesAndRadii() throws Exception {
+        final Fixture f = new Fixture();
+        final Random random = new Random(49123L);
+        for (int i = 0; i < 100; i++) {
+            f.player(new Vec3(random.nextDouble() * 2000 - 1000, random.nextDouble() * 320 - 64,
+                random.nextDouble() * 2000 - 1000), i % 5 == 0);
+        }
+        f.player(new Vec3(-16.001, 64, -16.001), false);
+        f.player(new Vec3(16.001, 64, 16.001), false);
+        for (BlockPos pos : List.of(new BlockPos(-17, 64, -17), new BlockPos(16, 64, 16), new BlockPos(-161, 200, 511))) {
+            for (int radius : new int[]{1, 32, 48, 49, 128, 160, 161, 300, 528, 529, 1000, Integer.MAX_VALUE}) {
+                final double squared = (double)radius * radius;
+                final boolean expected = f.actors.stream().anyMatch(p -> !p.spectator
+                    && p.position.get().distanceToSqr(new Vec3(pos.getX(), pos.getY(), pos.getZ())) < squared);
+                assertEquals(expected, f.map.anyPlayerCloseEnoughTo(pos, radius), pos + " radius=" + radius);
+            }
+        }
+    }
+
+    private static final class Actor {
+        final ServerPlayer player = mock(ServerPlayer.class);
+        final AtomicReference<Vec3> position;
+        boolean spectator;
+        Actor(final Vec3 position, final boolean spectator) {
+            this.position = new AtomicReference<>(position);
+            this.spectator = spectator;
+        }
+    }
+
+    private static final class Fixture {
+        final ServerLevel level = mock(ServerLevel.class);
+        final ChunkMap map = mock(ChunkMap.class, CALLS_REAL_METHODS);
+        final PlayerMap players = new PlayerMap();
+        final NearbyPlayers nearby = mock(NearbyPlayers.class);
+        final List<Actor> actors = new ArrayList<>();
+        final AtomicInteger spectatorChecks = new AtomicInteger();
+
+        Fixture() throws Exception {
+            set(map, "level", level);
+            set(map, "playerMap", players);
+            when(level.moonrise$getNearbyPlayers()).thenReturn(nearby);
+            when(nearby.getPlayers(any(BlockPos.class), any(NearbyPlayers.NearbyMapType.class))).thenAnswer(call -> {
+                final BlockPos target = call.getArgument(0);
+                final NearbyPlayers.NearbyMapType type = call.getArgument(1);
+                final int range = switch (type) {
+                    case GENERAL_REALLY_SMALL -> NearbyPlayers.GENERAL_REALLY_SMALL_AREA_VIEW_DISTANCE_BLOCKS >> 4;
+                    case GENERAL_SMALL -> NearbyPlayers.GENERAL_SMALL_AREA_VIEW_DISTANCE_BLOCKS >> 4;
+                    case GENERAL -> NearbyPlayers.GENERAL_AREA_VIEW_DISTANCE_BLOCKS >> 4;
+                    default -> throw new AssertionError("Distance queries require an index independent of view/spawn settings");
+                };
+                final ReferenceList<ServerPlayer> result = new ReferenceList<>(new ServerPlayer[0]);
+                for (Actor actor : actors) {
+                    final BlockPos block = BlockPos.containing(actor.position.get());
+                    if (Math.abs((block.getX() >> 4) - (target.getX() >> 4)) <= range
+                        && Math.abs((block.getZ() >> 4) - (target.getZ() >> 4)) <= range) result.add(actor.player);
+                }
+                return result.size() == 0 ? null : result;
+            });
+        }
+
+        Actor player(final Vec3 pos, final boolean spectator) {
+            final Actor actor = new Actor(pos, spectator);
+            actors.add(actor);
+            doAnswer(call -> { spectatorChecks.incrementAndGet(); return actor.spectator; }).when(actor.player).isSpectator();
+            when(actor.player.position()).thenAnswer(call -> actor.position.get());
+            players.addPlayer(actor.player, false);
+            return actor;
+        }
+    }
+
+    private static void set(final Object target, final String name, final Object value) throws Exception {
+        for (Class<?> type = target.getClass(); type != null; type = type.getSuperclass()) {
+            try {
+                final Field field = type.getDeclaredField(name);
+                field.setAccessible(true);
+                field.set(target, value);
+                return;
+            } catch (NoSuchFieldException ignored) { }
+        }
+        throw new NoSuchFieldException(name);
+    }
+}
