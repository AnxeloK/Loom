diff --git a/src/test/java/net/minecraft/world/level/chunk/EmptyChunkPostProcessingTest.java b/src/test/java/net/minecraft/world/level/chunk/EmptyChunkPostProcessingTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..6b578e2a6beb2eba92fc2aec6c76076e62859dc3
--- /dev/null
+++ b/src/test/java/net/minecraft/world/level/chunk/EmptyChunkPostProcessingTest.java
@@ -0,0 +1,189 @@
+package net.minecraft.world.level.chunk;
+
+import ca.spottedleaf.moonrise.common.util.TickThread;
+import ca.spottedleaf.moonrise.patches.chunk_system.scheduling.NewChunkHolder;
+import it.unimi.dsi.fastutil.shorts.ShortArrayList;
+import it.unimi.dsi.fastutil.shorts.ShortList;
+import java.lang.reflect.Field;
+import java.util.HashMap;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.atomic.AtomicReference;
+import net.minecraft.core.BlockPos;
+import net.minecraft.nbt.CompoundTag;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.server.level.ServerChunkCache;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.server.threading.TickRegions;
+import net.minecraft.server.threading.runtime.OwnerDomainExecutor;
+import net.minecraft.world.level.ChunkPos;
+import net.minecraft.world.level.Level;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+@Normal
+class EmptyChunkPostProcessingTest {
+    @BeforeAll
+    static void prepareTypes() {
+        mock(MinecraftServer.class);
+        mock(ServerLevel.class);
+        mock(ServerChunkCache.class);
+        mock(LevelChunk.class);
+        mock(NewChunkHolder.class);
+    }
+
+    @Test
+    void emptyLoadedChunkCompletesWithoutLoadingNeighbors() throws Exception {
+        Fixture f = new Fixture();
+        f.sections[0] = new ShortArrayList();
+        f.owned(f.level, () -> {
+            assertTrue(f.chunk.moonrise$ensurePostProcessing(f.level));
+            assertTrue(f.chunk.moonrise$isPostProcessingDone());
+            assertSame(f.completion, f.chunk.moonrise$awaitPostProcessing(f.level));
+            assertTrue(f.completion.isDone());
+            assertFalse(f.completion.isCompletedExceptionally());
+        });
+        verify(f.holder).moonrise$requeueFullStatusChange();
+        assertEquals(0, f.neighborLoads());
+    }
+
+    @Test
+    void completionCallbacksKeepTheChunkOwner() throws Exception {
+        Fixture f = new Fixture();
+        AtomicReference<Boolean> owned = new AtomicReference<>();
+        f.completion.thenRun(() -> owned.set(TickRegions.isCurrentThreadOwnerQuiet(f.level, 2, -3)));
+        f.owned(f.level, () -> assertTrue(f.chunk.moonrise$ensurePostProcessing(f.level)));
+        assertEquals(Boolean.TRUE, owned.get());
+    }
+
+    @Test
+    void queuedBlockUpdatesKeepTheExistingReadinessPath() throws Exception {
+        Fixture f = new Fixture();
+        f.sections[0] = ShortArrayList.of((short) 1);
+        f.assertReadinessRequired();
+        assertEquals(1, f.sections[0].size());
+    }
+
+    @Test
+    void pendingBlockEntitiesKeepTheExistingReadinessPath() throws Exception {
+        Fixture f = new Fixture();
+        f.pending.put(BlockPos.ZERO, new CompoundTag());
+        f.assertReadinessRequired();
+        assertEquals(1, f.pending.size());
+    }
+
+    @Test
+    void upgradeDataIsNotSkippedEvenWhenItsIndexIsEmpty() throws Exception {
+        Fixture f = new Fixture();
+        UpgradeData upgrade = mock(UpgradeData.class);
+        when(upgrade.isEmpty()).thenReturn(true);
+        set(f.chunk, "upgradeData", upgrade);
+        f.assertReadinessRequired();
+        verifyNoInteractions(upgrade);
+    }
+
+    @Test
+    void aReplacedChunkCannotBeCompleted() throws Exception {
+        Fixture f = new Fixture();
+        when(f.chunks.getChunkAtIfLoadedImmediately(2, -3)).thenReturn(mock(LevelChunk.class));
+        f.assertReadinessRequired();
+    }
+
+    @Test
+    void anotherWorldsOwnerCannotCompleteTheChunk() throws Exception {
+        Fixture f = new Fixture();
+        ServerLevel other = mock(ServerLevel.class);
+        when(other.getServer()).thenReturn(f.server);
+        when(other.dimension()).thenReturn(Level.NETHER);
+        f.owned(other, () -> assertFalse(f.chunk.moonrise$ensurePostProcessing(f.level)));
+        assertFalse(f.completion.isDone());
+        assertEquals(1, f.neighborLoads());
+    }
+
+    @Test
+    void anOwnerTokenWithoutALeaseCannotCompleteTheChunk() throws Exception {
+        Fixture f = new Fixture();
+        try (var owner = OwnerDomainExecutor.enterRegion(f.level, 2, -3, 2, -3, "missing-lease")) {
+            assertFalse(f.chunk.moonrise$ensurePostProcessing(f.level));
+        }
+        assertFalse(f.completion.isDone());
+        assertEquals(1, f.neighborLoads());
+    }
+
+    @Test
+    void anAlreadyScheduledPassKeepsItsCompletion() throws Exception {
+        Fixture f = new Fixture();
+        set(f.chunk, "postProcessingScheduled", 1);
+        f.owned(f.level, () -> assertFalse(f.chunk.moonrise$ensurePostProcessing(f.level)));
+        assertFalse(f.completion.isDone());
+        assertEquals(0, f.neighborLoads());
+        verifyNoInteractions(f.holder);
+    }
+
+    private static final class Fixture {
+        final MinecraftServer server = mock(MinecraftServer.class);
+        final ServerLevel level = mock(ServerLevel.class);
+        final ServerChunkCache chunks = mock(ServerChunkCache.class);
+        final LevelChunk chunk = mock(LevelChunk.class, CALLS_REAL_METHODS);
+        final NewChunkHolder holder = mock(NewChunkHolder.class);
+        final CompletableFuture<Void> completion = new CompletableFuture<>();
+        final ShortList[] sections = new ShortList[2];
+        final HashMap<BlockPos, CompoundTag> pending = new HashMap<>();
+
+        Fixture() throws Exception {
+            when(level.getServer()).thenReturn(server);
+            when(level.dimension()).thenReturn(Level.OVERWORLD);
+            when(level.getChunkSource()).thenReturn(chunks);
+            when(chunks.getChunkAtIfLoadedImmediately(2, -3)).thenReturn(chunk);
+            doReturn(new ChunkPos(2, -3)).when(chunk).getPos();
+            set(chunk, "postProcessingCompletion", completion);
+            set(chunk, "postProcessing", sections);
+            set(chunk, "pendingBlockEntities", pending);
+            set(chunk, "upgradeData", UpgradeData.EMPTY);
+            set(chunk, "chunkAndHolder", holder);
+        }
+
+        long neighborLoads() {
+            return mockingDetails(level).getInvocations().stream()
+                .filter(call -> call.getMethod().getName().equals("moonrise$loadChunksAsync")).count();
+        }
+
+        void assertReadinessRequired() throws Exception {
+            owned(level, () -> assertFalse(chunk.moonrise$ensurePostProcessing(level)));
+            assertFalse(chunk.moonrise$isPostProcessingDone());
+            assertFalse(completion.isDone());
+            assertEquals(1, neighborLoads());
+            verifyNoInteractions(holder);
+        }
+
+        void owned(ServerLevel owner, Runnable action) throws Exception {
+            AtomicReference<Throwable> failure = new AtomicReference<>();
+            Thread thread = new TickThread(() -> {
+                var context = TickRegions.pushRegionContext(owner, 2, -3, 2, -3);
+                try { action.run(); }
+                catch (Throwable error) { failure.set(error); }
+                finally { TickRegions.popContext(context); }
+            }, "empty-post-processing-test");
+            thread.setDaemon(true);
+            thread.start();
+            thread.join(10_000);
+            assertFalse(thread.isAlive(), "Chunk owner did not return");
+            if (failure.get() != null) throw new AssertionError(failure.get());
+        }
+    }
+
+    private static void set(Object target, String name, Object value) throws Exception {
+        for (Class<?> type = target.getClass(); type != null; type = type.getSuperclass()) {
+            try {
+                Field field = type.getDeclaredField(name);
+                field.setAccessible(true);
+                field.set(target, value);
+                return;
+            } catch (NoSuchFieldException ignored) { }
+        }
+        throw new NoSuchFieldException(name);
+    }
+}
