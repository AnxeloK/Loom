+    @Test
+    void oneEntityRegionRecordsItsElapsedTime() throws Exception {
+        final Fixture f = new Fixture();
+        final LoomTickSectionDiagnostics diagnostics = f.enableTickDiagnostics();
+        f.assertEntityTicks(f.entities(0, 1));
+        verify(diagnostics).record(eq(LoomTickSectionDiagnostics.ENTITY_TICK), longThat(value -> value > 0L));
+    }
+
+    @Test
+    void mergedEntityRegionsRecordTheirElapsedTime() throws Exception {
+        final Fixture f = new Fixture();
+        final LoomTickSectionDiagnostics diagnostics = f.enableTickDiagnostics();
+        f.assertEntityTicks(f.entities(-1, 0));
+        verify(diagnostics).record(eq(LoomTickSectionDiagnostics.ENTITY_TICK), longThat(value -> value > 0L));
+    }
