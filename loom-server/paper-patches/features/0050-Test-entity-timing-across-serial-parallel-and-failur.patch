         final Fixture f = new Fixture();
+        final LoomTickSectionDiagnostics diagnostics = f.enableTickDiagnostics();
         final List<Entity> entities = f.entities(-1, 128);
         final List<Entity> seen = Collections.synchronizedList(new ArrayList<>());
         doAnswer(call -> {
@@ -164,11 +183,13 @@ class SerialSimulationFallbackTest {
         assertEquals(3, seen.size());
         assertTrue(seen.containsAll(entities));
         assertSame(entities.get(1), seen.getLast());
+        verify(diagnostics).record(eq(LoomTickSectionDiagnostics.ENTITY_TICK), longThat(value -> value > 0L));
     }
 
     @Test
     void parallelFailureRestoresTheWorldContext() throws Exception {
         final Fixture f = new Fixture();
