diff --git a/src/test/java/net/minecraft/server/players/PlayerSaveQueueTest.java b/src/test/java/net/minecraft/server/players/PlayerSaveQueueTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..844168b3dd495b5be60af727667da004d342c9a8
--- /dev/null
+++ b/src/test/java/net/minecraft/server/players/PlayerSaveQueueTest.java
@@ -0,0 +1,117 @@
+package net.minecraft.server.players;
+
+import java.io.IOException;
+import java.util.UUID;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.atomic.AtomicBoolean;
+import java.util.concurrent.atomic.AtomicReference;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+@Normal
+class PlayerSaveQueueTest {
+    @Test
+    void laterSnapshotCannotOvertakeAnUnfinishedWrite() {
+        final PlayerSaveQueue queue = new PlayerSaveQueue();
+        final UUID player = UUID.randomUUID();
+        final CompletableFuture<Void> firstWrite = new CompletableFuture<>();
+        final AtomicBoolean secondStarted = new AtomicBoolean();
+
+        final CompletableFuture<Void> first = queue.submit(player, () -> firstWrite);
+        final CompletableFuture<Void> second = queue.submit(player, () -> {
+            secondStarted.set(true);
+            return CompletableFuture.completedFuture(null);
+        });
+        assertFalse(secondStarted.get());
+        assertFalse(second.isDone());
+
+        firstWrite.complete(null);
+        assertTrue(first.isDone());
+        assertTrue(secondStarted.get());
+        assertTrue(second.isDone());
+    }
+
+    @Test
+    void failedWriteDoesNotPreventTheNextSnapshot() {
+        final PlayerSaveQueue queue = new PlayerSaveQueue();
+        final UUID player = UUID.randomUUID();
+        final CompletableFuture<Void> firstWrite = new CompletableFuture<>();
+        final CompletableFuture<Void> first = queue.submit(player, () -> firstWrite);
+        final AtomicBoolean secondStarted = new AtomicBoolean();
+        final CompletableFuture<Void> second = queue.submit(player, () -> {
+            secondStarted.set(true);
+            return CompletableFuture.completedFuture(null);
+        });
+
+        firstWrite.completeExceptionally(new IOException("disk failed"));
+        assertTrue(first.isCompletedExceptionally());
+        assertTrue(secondStarted.get());
+        assertFalse(second.isCompletedExceptionally());
+    }
+
+    @Test
+    void logoutReservationHoldsLaterAutosavesUntilItCompletes() {
+        final PlayerSaveQueue queue = new PlayerSaveQueue();
+        final UUID player = UUID.randomUUID();
+        final PlayerSaveQueue.Reservation logout = queue.reserve(player);
+        final AtomicBoolean autosaveStarted = new AtomicBoolean();
+        final CompletableFuture<Void> autosave = queue.submit(player, () -> {
+            autosaveStarted.set(true);
+            return CompletableFuture.completedFuture(null);
+        });
+        assertFalse(autosaveStarted.get());
+        logout.completion().complete(null);
+        assertTrue(autosaveStarted.get());
+        assertTrue(autosave.isDone());
+    }
+
+    @Test
+    void reconnectReadsTheFinalLogoutStateAfterTheWriteCompletes() {
+        final PlayerSaveQueue queue = new PlayerSaveQueue();
+        final UUID player = UUID.randomUUID();
+        final AtomicReference<String> disk = new AtomicReference<>("old inventory");
+        final CompletableFuture<Void> write = new CompletableFuture<>();
+        queue.submit(player, () -> write.thenRun(() -> disk.set("final inventory")));
+
+        final CompletableFuture<String> reconnect = queue.submit(player,
+            () -> CompletableFuture.completedFuture(disk.get()));
+        assertFalse(reconnect.isDone(), "a reconnect must not read the old file while logout is writing");
+        final CompletableFuture<Void> shutdown = queue.drain();
+        assertFalse(shutdown.isDone(), "shutdown must retain saves for players already removed");
+
+        write.complete(null);
+        assertEquals("final inventory", reconnect.join());
+        assertTrue(shutdown.isDone());
+    }
+
+    @Test
+    void cancelledLoginDoesNotStrandLaterSaves() {
+        final PlayerSaveQueue queue = new PlayerSaveQueue();
+        final UUID player = UUID.randomUUID();
+        final CompletableFuture<String> read = new CompletableFuture<>();
+        final CompletableFuture<String> login = queue.submit(player, () -> read);
+        login.cancel(false);
+        final AtomicBoolean saved = new AtomicBoolean();
+        final CompletableFuture<Void> laterSave = queue.submit(player, () -> {
+            saved.set(true);
+            return CompletableFuture.completedFuture(null);
+        });
+
+        assertFalse(saved.get());
+        read.complete("discarded login data");
+        assertTrue(saved.get());
+        assertTrue(laterSave.isDone());
+        assertTrue(queue.drain().isDone());
+    }
+
+    @Test
+    void onePlayersSlowDiskOperationDoesNotHoldAnotherPlayer() {
+        final PlayerSaveQueue queue = new PlayerSaveQueue();
+        queue.submit(UUID.randomUUID(), CompletableFuture<Void>::new);
+        final CompletableFuture<String> otherLogin = queue.submit(UUID.randomUUID(),
+            () -> CompletableFuture.completedFuture("ready"));
+        assertEquals("ready", otherLogin.join());
+    }
+}
