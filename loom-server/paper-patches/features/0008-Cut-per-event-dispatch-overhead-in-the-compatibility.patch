From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: anxelok <anxelok@localhost>
Date: Mon, 6 Jul 2026 10:48:02 +0000
Subject: [PATCH] Cut per-event dispatch overhead in the compatibility kernel

Every event dispatch resolved each listener's plugin profile three
times through a name-keyed map (routing scan, plan, main loop) and
concatenated a fresh path string per listener. Profiles are resolved
once per dispatch and passed through; path strings are cached by
(event name, priority, ignoreCancelled), which they are pure
functions of. The per-listener scope also allocated a facade cache
map that almost no listener touches; it is lazy now.

diff --git a/src/main/java/io/papermc/paper/plugin/manager/PaperEventManager.java b/src/main/java/io/papermc/paper/plugin/manager/PaperEventManager.java
index 6dc33a90876efe448401e4bdc8c2e689b1d6a73b..990f92eb9c33957941c6594b17b269486b68f31e 100644
--- a/src/main/java/io/papermc/paper/plugin/manager/PaperEventManager.java
+++ b/src/main/java/io/papermc/paper/plugin/manager/PaperEventManager.java
@@ -87,17 +87,24 @@ class PaperEventManager {
         }
 
         final CompatibilityTransaction transaction = this.compatibilityKernel.beginTransaction(event, listeners);
-        final CompatibilityKernel.RoutingDecision routingDecision = this.compatibilityKernel.routingDecision(transaction, listeners);
+        // Resolve each listener's plugin profile once for the whole dispatch; routingDecision and planFor
+        // used to re-resolve it via a name-keyed map lookup per listener (three lookups per listener per event).
+        final PluginCompatibilityProfile[] profiles = new PluginCompatibilityProfile[listeners.length];
+        for (int i = 0; i < listeners.length; ++i) {
+            profiles[i] = this.compatibilityKernel.profileFor(listeners[i].getPlugin());
+        }
+        final CompatibilityKernel.RoutingDecision routingDecision = this.compatibilityKernel.routingDecision(transaction, listeners, profiles);
 
         try {
-            for (final RegisteredListener registration : listeners) {
+            for (int listenerIndex = 0; listenerIndex < listeners.length; ++listenerIndex) {
+                final RegisteredListener registration = listeners[listenerIndex];
                 if (!registration.getPlugin().isEnabled()) {
                     continue;
                 }
 
                 final Plugin plugin = registration.getPlugin();
-                final PluginCompatibilityProfile profile = this.compatibilityKernel.profileFor(plugin);
-                final CompatibilityKernel.InvocationPlan plan = this.compatibilityKernel.planFor(registration, transaction, routingDecision);
+                final PluginCompatibilityProfile profile = profiles[listenerIndex];
+                final CompatibilityKernel.InvocationPlan plan = this.compatibilityKernel.planFor(registration, transaction, routingDecision, profile);
                 final EventSemanticIndex.Lane lane = EventSemanticIndex.lane(registration.getPriority());
                 profile.noteLaneUsage(plan.lane());
 
