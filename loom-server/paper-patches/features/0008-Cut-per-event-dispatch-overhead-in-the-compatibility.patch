+
+    public InvocationPlan planFor(
+        final RegisteredListener listener,
+        final CompatibilityTransaction transaction,
+        final RoutingDecision routingDecision,
+        final PluginCompatibilityProfile profile
+    ) {
         final String path = pathFor(transaction, listener);
         final PluginCompatibilityProfile.State state = profile.stateForPath(path);
 
@@ -160,10 +177,24 @@ public final class CompatibilityKernel {
         return new InvocationPlan(policy, lane, path, "loom default path: " + routingDecision.reason());
     }
 
+    // Path strings are pure functions of (event name, priority, ignoreCancelled) and events fire thousands
+    // of times a second, so cache them instead of concatenating a fresh string per listener per event.
+    // Plain array-slot writes are a benign race: the value is idempotent.
+    private static final int PATH_SLOTS = org.bukkit.event.EventPriority.values().length * 2;
+    private static final java.util.concurrent.ConcurrentHashMap<String, String[]> PATH_CACHE = new java.util.concurrent.ConcurrentHashMap<>();
+
     public static String pathFor(final CompatibilityTransaction transaction, final RegisteredListener listener) {
-        return "event:" + transaction.event().getEventName()
-            + "#priority:" + listener.getPriority().name()
-            + "#ignoreCancelled:" + listener.isIgnoringCancelled();
+        final String eventName = transaction.event().getEventName();
+        final String[] slots = PATH_CACHE.computeIfAbsent(eventName, ignored -> new String[PATH_SLOTS]);
+        final int index = listener.getPriority().ordinal() * 2 + (listener.isIgnoringCancelled() ? 1 : 0);
+        String path = slots[index];
+        if (path == null) {
+            path = "event:" + eventName
+                + "#priority:" + listener.getPriority().name()
+                + "#ignoreCancelled:" + listener.isIgnoringCancelled();
+            slots[index] = path;
+        }
+        return path;
     }
 
     public void finishTransaction(final CompatibilityTransaction transaction) {
