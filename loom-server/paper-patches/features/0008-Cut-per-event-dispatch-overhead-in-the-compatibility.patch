@@ -10,15 +10,69 @@ import org.jspecify.annotations.Nullable;
 
 public final class CompatibilityRuntimeContext {
 
-    public record ScopeState(
-        Plugin plugin,
-        @Nullable CompatibilityTransaction transaction,
-        long transactionId,
