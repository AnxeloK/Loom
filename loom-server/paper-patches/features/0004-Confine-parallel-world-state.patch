+    @Test
+    public void unloadedTreeCommitResumesAfterTheChunkOwnerIsReady() throws InterruptedException {
+        final ServerLevel level = mockLevel();
+        final ServerChunkCache chunkSource = Mockito.mock(ServerChunkCache.class);
+        final LevelChunk loadedChunk = Mockito.mock(LevelChunk.class);
+        final CraftBlockState state = Mockito.mock(CraftBlockState.class);
+        final BlockPos position = new BlockPos(32, 80, 48);
+        final AtomicReference<Consumer<List<ChunkAccess>>> loadCallback = new AtomicReference<>();
+        final AtomicBoolean completed = new AtomicBoolean();
+
+        Mockito.when(level.getChunkSource()).thenReturn(chunkSource);
+        Mockito.when(loadedChunk.getPos()).thenReturn(new ChunkPos(2, 3));
+        Mockito.when(state.isPlaced()).thenReturn(true);
+        Mockito.when(state.getWorldHandle()).thenReturn(level);
+        Mockito.when(state.getX()).thenReturn(position.getX());
+        Mockito.when(state.getY()).thenReturn(position.getY());
+        Mockito.when(state.getZ()).thenReturn(position.getZ());
+        Mockito.doAnswer(invocation -> {
+            loadCallback.set(invocation.getArgument(6));
+            return null;
+        }).when(level).moonrise$loadChunksAsync(
+            Mockito.anyInt(),
+            Mockito.anyInt(),
+            Mockito.anyInt(),
+            Mockito.anyInt(),
+            Mockito.eq(ChunkStatus.FULL),
+            Mockito.any(Priority.class),
+            Mockito.any()
+        );
+
+        final Throwable failure = runOnTickThread(() -> {
+            final Object decision = newTreeDecision(List.of(state), level, position);
+            Assertions.assertFalse(commitTreeStates(decision, level, () -> completed.set(true)));
+            Assertions.assertNotNull(loadCallback.get());
+            Mockito.verify(state, Mockito.never()).place(Mockito.anyInt());
+
+            Mockito.when(chunkSource.getChunkAtIfLoadedImmediately(2, 3)).thenReturn(loadedChunk);
+            final TickRegions.RegionContext context = TickRegions.pushRegionContext(level, 2, 3, 2, 3);
+            try {
+                loadCallback.get().accept(List.of(loadedChunk));
+            } finally {
+                TickRegions.popContext(context);
+            }
+
+            Assertions.assertTrue(completed.get());
+            Mockito.verify(state).place(Mockito.anyInt());
+            Mockito.verify(level).checkCapturedTreeStateForObserverNotify(position, state);
+        });
+
+        if (failure != null) {
+            Assertions.fail(failure);
+        }
+    }
