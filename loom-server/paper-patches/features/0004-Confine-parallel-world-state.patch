+    @Test
+    public void stagingAllowsOnlyVirtualTreeCapture() throws InterruptedException {
+        final ServerLevel level = mockLevel();
+        final Throwable failure = runOnTickThread(() -> {
+            try (OwnerDomainExecutor.Scope ignored = OwnerDomainExecutor.enterRegion(level, 0, 0, 0, 0, "capture-test-staging")) {
+                final RegionTickStaging.Session session = RegionTickStaging.newSession();
+                RegionTickStaging.begin(session);
+                try {
+                    Assertions.assertThrows(
+                        IllegalStateException.class,
+                        () -> LevelCaptureContext.begin(level, LevelCaptureContext.BLOCK_STATES)
+                    );
+                    Assertions.assertThrows(
+                        IllegalStateException.class,
+                        () -> LevelCaptureContext.begin(level, LevelCaptureContext.DROPS)
+                    );
+                    try (LevelCaptureContext.Scope tree = LevelCaptureContext.begin(level, LevelCaptureContext.TREE)) {
+                        Assertions.assertSame(tree.frame(), LevelCaptureContext.current(level));
+                    }
+                } finally {
+                    RegionTickStaging.end();
+                }
+                Assertions.assertNull(LevelCaptureContext.current(level));
+            }
+        });
+
+        if (failure != null) {
+            Assertions.fail(failure);
+        }
+    }
