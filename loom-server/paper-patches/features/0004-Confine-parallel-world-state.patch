+    @Test
+    public void fullLevelContinuationsWaitForTheFullWorldOwner() throws InterruptedException {
+        final ServerLevel level = mockLevel();
+        final AtomicBoolean ran = new AtomicBoolean();
+        final Throwable failure = runOnTickThread(() -> {
+            OwnerDomainExecutor.execute(
+                OwnerDomainExecutor.region(
+                    level,
+                    Integer.MIN_VALUE,
+                    Integer.MIN_VALUE,
+                    Integer.MAX_VALUE,
+                    Integer.MAX_VALUE,
+                    "full-level-continuation-test"
+                ),
+                () -> ran.set(true)
+            );
+            Assertions.assertFalse(ran.get());
+
+            final TickRegions.RegionContext context = TickRegions.pushLevelContext(level);
+            try {
+                TickRegions.runFullLevelContinuations(level);
+            } finally {
+                TickRegions.popContext(context);
+            }
+            Assertions.assertTrue(ran.get());
+        });
+
+        if (failure != null) {
+            Assertions.fail(failure);
+        }
+    }
+
+    private static Object newTreeDecision(
+        final List<org.bukkit.block.BlockState> states,
+        final ServerLevel level,
+        final BlockPos observerPos
+    ) {
+        try {
+            final Class<?> decisionClass = Class.forName("net.minecraft.server.threading.RegionTickStaging$StagedTreeDecision");
+            final Constructor<?> constructor = decisionClass.getDeclaredConstructor(
+                org.bukkit.event.world.StructureGrowEvent.class,
+                org.bukkit.event.block.BlockFertilizeEvent.class,
+                int.class,
+                int.class,
+                int.class,
+                List.class,
+                ServerLevel.class,
+                BlockPos.class
+            );
+            constructor.setAccessible(true);
+            return constructor.newInstance(null, null, 0, 0, 0, states, level, observerPos);
+        } catch (final ReflectiveOperationException exception) {
+            throw new AssertionError(exception);
+        }
+    }
+
+    private static boolean commitTreeStates(
+        final Object decision,
+        final ServerLevel level,
+        final Runnable completion
+    ) {
+        try {
+            final Method method = RegionTickStaging.class.getDeclaredMethod(
+                "commitTreeStates",
+                decision.getClass(),
+                ServerLevel.class,
+                int.class,
+                Runnable.class
+            );
+            method.setAccessible(true);
+            return (boolean) method.invoke(null, decision, level, 0, completion);
+        } catch (final InvocationTargetException exception) {
+            final Throwable cause = exception.getCause();
+            if (cause instanceof Error error) {
+                throw error;
+            }
+            if (cause instanceof RuntimeException runtimeException) {
+                throw runtimeException;
+            }
+            throw new AssertionError(cause);
+        } catch (final ReflectiveOperationException exception) {
+            throw new AssertionError(exception);
+        }
+    }
+
+    private static ServerLevel mockLevel() {
+        final ServerLevel level = Mockito.mock(ServerLevel.class);
+        Mockito.when(level.getServer()).thenReturn(Mockito.mock(MinecraftServer.class));
+        return level;
+    }
+
+    private static Throwable runOnTickThread(final Runnable action) throws InterruptedException {
+        final AtomicReference<Throwable> failure = new AtomicReference<>();
+        final Thread thread = new TickThread(() -> {
+            try {
+                action.run();
+            } catch (final Throwable throwable) {
+                failure.set(throwable);
+            }
+        }, "level-capture-context-test");
+        thread.start();
+        thread.join();
+        return failure.get();
+    }
+}
