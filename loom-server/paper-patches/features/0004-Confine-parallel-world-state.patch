From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: anxelok <anxelok@localhost>
Date: Sat, 11 Jul 2026 00:17:59 +0000
Subject: [PATCH] Confine parallel world state

Move hopper, entity, transient, and captured-mutation state out of shared process fields so parallel world work remains isolated.

diff --git a/src/main/java/ca/spottedleaf/moonrise/common/util/TickThread.java b/src/main/java/ca/spottedleaf/moonrise/common/util/TickThread.java
index d149bf927c61b7844443cd67c9863aa529d218e4..2ba82e076f30359585a4c76a272a9634c9e053d4 100644
--- a/src/main/java/ca/spottedleaf/moonrise/common/util/TickThread.java
+++ b/src/main/java/ca/spottedleaf/moonrise/common/util/TickThread.java
@@ -4,6 +4,7 @@ import net.minecraft.core.BlockPos;
 import net.minecraft.world.entity.Entity;
 import net.minecraft.world.level.ChunkPos;
 import net.minecraft.world.level.Level;
+import net.minecraft.world.level.LevelCaptureContext;
 import net.minecraft.world.phys.AABB;
 import net.minecraft.world.phys.Vec3;
 import org.slf4j.Logger;
@@ -116,6 +117,22 @@ public class TickThread extends Thread {
     // line in the hottest entity path.
     public volatile Entity currentlyTickingEntity;
 
+    // Loom - transient hopper state is confined to the tick thread running the operation. Upstream's
+    // process-wide flags race when independent owner regions move items concurrently.
+    public boolean skipHopperPullEvents;
+    public boolean skipHopperPushEvents;
+    public boolean suppressBlockEntityUpdates;
+
+    // Loom - the top world-mutation capture operation for this physical tick thread. Frames carry their
+    // exact level identity and form a reentrant stack, so independent owner domains never share capture state.
+    public LevelCaptureContext.Frame levelCaptureContext;
+
+    // Loom - one entity RNG per physical tick thread keeps Paper's shared-per-thread memory profile without
+    // racing every parallel entity on one ThreadUnsafeRandom seed and Gaussian cache.
+    public final ThreadUnsafeRandom entityRandom = new ThreadUnsafeRandom(
+        net.minecraft.world.level.levelgen.RandomSupport.generateUniqueSeed()
+    );
+
     public TickThread(final String name) {
         this(null, name);
     }
