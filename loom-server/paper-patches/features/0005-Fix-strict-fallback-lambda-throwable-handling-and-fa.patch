From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: anxelok <anxelok@localhost>
Date: Sun, 31 May 2026 17:45:10 +0000
Subject: [PATCH] Fix strict fallback lambda throwable handling and facade
 generic casting


diff --git a/src/main/java/io/papermc/paper/plugin/manager/PaperEventManager.java b/src/main/java/io/papermc/paper/plugin/manager/PaperEventManager.java
index 4b5ddeee3c8c7925810930f6b731f468724bb621..e62a32d6bdc17afe656a9f0e3a2949ed47b55625 100644
--- a/src/main/java/io/papermc/paper/plugin/manager/PaperEventManager.java
+++ b/src/main/java/io/papermc/paper/plugin/manager/PaperEventManager.java
@@ -175,7 +175,14 @@ class PaperEventManager {
                             if (!handoffScope.acquired()) {
                                 throw new IllegalStateException("Strict fallback apartment handoff failed: " + handoffScope.busyLease());
                             }
-                            this.callListener(registration, event, transaction, true);
+                            try {
+                                this.callListener(registration, event, transaction, true);
+                            } catch (final Throwable throwable) {
+                                if (throwable instanceof Exception exception) {
+                                    throw exception;
+                                }
+                                throw new RuntimeException(throwable);
+                            }
                         }
                         return null;
                     }).join();
diff --git a/src/main/java/io/papermc/paper/plugin/manager/compat/BukkitFacadeRegistry.java b/src/main/java/io/papermc/paper/plugin/manager/compat/BukkitFacadeRegistry.java
index a05326f87cfba3b6bc86840b5e759d086903caea..23acf5b4f4de7e92f6074f9a069d2d57708df91c 100644
--- a/src/main/java/io/papermc/paper/plugin/manager/compat/BukkitFacadeRegistry.java
+++ b/src/main/java/io/papermc/paper/plugin/manager/compat/BukkitFacadeRegistry.java
@@ -41,7 +41,7 @@ public final class BukkitFacadeRegistry {
             return (T)scoped;
         }
 
-        return CompatibilityRuntimeContext.scopeComputeIfAbsent(key, () -> {
+        final Object resolved = CompatibilityRuntimeContext.scopeComputeIfAbsent(key, () -> {
             final WeakReference<Object> existingRef = this.facades.get(key);
             final Object existing = existingRef == null ? null : existingRef.get();
             if (existing != null) {
@@ -50,6 +50,7 @@ public final class BukkitFacadeRegistry {
             this.facades.put(key, new WeakReference<>(candidate));
             return candidate;
         });
+        return (T)resolved;
     }
 
     public Location normalizeLocation(final @Nullable Location location) {
