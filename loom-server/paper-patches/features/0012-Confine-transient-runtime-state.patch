From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: anxelok <anxelok@localhost>
Date: Sat, 11 Jul 2026 10:36:12 +0000
Subject: [PATCH] Confine transient runtime state


diff --git a/src/main/java/org/bukkit/craftbukkit/block/CraftBlockEntityState.java b/src/main/java/org/bukkit/craftbukkit/block/CraftBlockEntityState.java
index 2857d6144afe092e2870d12f48d944c771136871..944355af01e7df4c6869068c004b9a54f07a34ac 100644
--- a/src/main/java/org/bukkit/craftbukkit/block/CraftBlockEntityState.java
+++ b/src/main/java/org/bukkit/craftbukkit/block/CraftBlockEntityState.java
@@ -33,6 +33,26 @@ public abstract class CraftBlockEntityState<T extends BlockEntity> extends Craft
     private final T snapshot;
     public boolean snapshotDisabled; // Paper
     public static boolean DISABLE_SNAPSHOT = false; // Paper
+    private static final ThreadLocal<Boolean> SCOPED_SNAPSHOT_DISABLED = new ThreadLocal<>(); // Loom - confine internal snapshot scopes
+
+    static @Nullable Boolean setScopedSnapshotDisabled(final boolean disabled) {
+        final Boolean previous = SCOPED_SNAPSHOT_DISABLED.get();
+        SCOPED_SNAPSHOT_DISABLED.set(disabled);
+        return previous;
+    }
+
+    static void restoreScopedSnapshotDisabled(final @Nullable Boolean previous) {
+        if (previous == null) {
+            SCOPED_SNAPSHOT_DISABLED.remove();
+        } else {
+            SCOPED_SNAPSHOT_DISABLED.set(previous);
+        }
+    }
+
+    private static boolean isSnapshotDisabled() {
+        final Boolean scoped = SCOPED_SNAPSHOT_DISABLED.get();
+        return scoped != null ? scoped : DISABLE_SNAPSHOT;
+    }
 
     public CraftBlockEntityState(World world, T blockEntity) {
         super(world, blockEntity.getBlockPos(), blockEntity.getBlockState());
@@ -41,8 +61,9 @@ public abstract class CraftBlockEntityState<T extends BlockEntity> extends Craft
 
         try { // Paper - Show blockstate location if we failed to read it
         // Paper start
-        this.snapshotDisabled = DISABLE_SNAPSHOT;
-        if (DISABLE_SNAPSHOT) {
+        final boolean snapshotDisabled = isSnapshotDisabled(); // Loom - one consistent scoped read
+        this.snapshotDisabled = snapshotDisabled;
+        if (snapshotDisabled) {
             this.snapshot = this.blockEntity;
         } else {
             this.snapshot = this.createSnapshot(blockEntity);
diff --git a/src/main/java/org/bukkit/craftbukkit/block/CraftBlockStates.java b/src/main/java/org/bukkit/craftbukkit/block/CraftBlockStates.java
index e3fbe9d9a4fdf6590f7d0635fb7b930311a2a5a3..14a12ce4f3bd5667338f2a5ad56c7ba10f7b3bee 100644
--- a/src/main/java/org/bukkit/craftbukkit/block/CraftBlockStates.java
+++ b/src/main/java/org/bukkit/craftbukkit/block/CraftBlockStates.java
@@ -196,14 +196,13 @@ public final class CraftBlockStates {
         BlockPos pos = craftBlock.getPosition();
         net.minecraft.world.level.block.state.BlockState state = craftBlock.getBlockState();
         BlockEntity blockEntity = craftBlock.getLevel().getBlockEntity(pos);
-        boolean prev = CraftBlockEntityState.DISABLE_SNAPSHOT;
-        CraftBlockEntityState.DISABLE_SNAPSHOT = !useSnapshot;
+        final Boolean previous = CraftBlockEntityState.setScopedSnapshotDisabled(!useSnapshot);
         try {
             CraftBlockState blockState = CraftBlockStates.getBlockState(world, pos, state, blockEntity);
             blockState.setWorldHandle(craftBlock.getLevel()); // Inject the block's level accessor
             return blockState;
         } finally {
-            CraftBlockEntityState.DISABLE_SNAPSHOT = prev;
+            CraftBlockEntityState.restoreScopedSnapshotDisabled(previous);
         }
     }
 
