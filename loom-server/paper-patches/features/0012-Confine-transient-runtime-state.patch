diff --git a/src/main/java/org/spigotmc/SpigotWorldConfig.java b/src/main/java/org/spigotmc/SpigotWorldConfig.java
index 9e63995af22bb3cd60200282179be73ade70077f..e9262074e99d27df8c49ad415271fef783b0fcfa 100644
--- a/src/main/java/org/spigotmc/SpigotWorldConfig.java
+++ b/src/main/java/org/spigotmc/SpigotWorldConfig.java
@@ -1,6 +1,7 @@
 package org.spigotmc;
 
 import java.util.List;
+import java.util.concurrent.atomic.AtomicInteger;
 import org.bukkit.Bukkit;
 import org.bukkit.configuration.file.YamlConfiguration;
 
@@ -393,8 +394,26 @@ public class SpigotWorldConfig {
         this.otherMultiplier = (float) this.getDouble("hunger.other-multiplier", 0.0);
     }
 
-    public int currentPrimedTnt = 0;
+    public final AtomicInteger currentPrimedTnt = new AtomicInteger();
     public int maxTntTicksPerTick;
+
+    // Loom - the TNT budget is consumed concurrently by region-owned entity ticks. Saturating at the limit
+    // preserves the exact cap without continuing to write one contended cache line after the budget is gone.
+    public boolean acquirePrimedTntTick() {
+        final int limit = this.maxTntTicksPerTick;
+        if (limit <= 0) {
+            return true;
+        }
+
+        int used;
+        while ((used = this.currentPrimedTnt.get()) < limit) {
+            if (this.currentPrimedTnt.compareAndSet(used, used + 1)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
     private void maxTntPerTick() {
         if (SpigotConfig.version < 7) {
             this.set("max-tnt-per-tick", 100);
