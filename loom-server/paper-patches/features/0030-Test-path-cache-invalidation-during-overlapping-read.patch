+
+import org.junit.platform.suite.api.*;
+
+@Suite
+@IncludeTags("Normal")
+@SelectClasses(PathTypeCacheConcurrencyTest.class)
+@ConfigurationParameter(key = "TestSuite", value = "Normal")
+public class PathTypeCacheConcurrencyTestSuite {}
