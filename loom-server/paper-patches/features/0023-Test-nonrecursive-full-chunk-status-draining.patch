+    @Test
+    void recursiveHaloLoadsLeaveFullStatusDrainingToTheOuterLoop() throws InterruptedException {
+        final MinecraftServer server = Mockito.mock(MinecraftServer.class);
+        final ServerLevel level = Mockito.mock(ServerLevel.class);
+        Mockito.when(level.getServer()).thenReturn(server);
+        final ChunkHolderManager manager = new ChunkHolderManager(level, Mockito.mock(ChunkTaskScheduler.class));
+        final NewChunkHolder first = Mockito.mock(NewChunkHolder.class);
+        final NewChunkHolder second = Mockito.mock(NewChunkHolder.class);
+        final java.util.List<String> order = new java.util.ArrayList<>();
+        Mockito.when(first.handleFullStatusChange(Mockito.anyList())).thenAnswer(call -> {
+            order.add("first-start");
+            manager.addChangedStatuses(java.util.List.of(second));
+            Assertions.assertFalse(manager.processTicketUpdates(), "A halo load must not recursively drain other holders");
+            Mockito.verifyNoInteractions(second);
+            order.add("first-end");
+            return true;
+        });
+        Mockito.when(second.handleFullStatusChange(Mockito.anyList())).thenAnswer(call -> {
+            order.add("second");
+            return true;
+        });
+        runOnTickThread(() -> {
+            try (OwnerDomainExecutor.Scope ignored = OwnerDomainExecutor.enterGlobal(server, "recursive-full-status-test")) {
+                manager.addChangedStatuses(java.util.List.of(first));
+                Assertions.assertTrue(manager.processTicketUpdates());
+                Assertions.assertEquals(java.util.List.of("first-start", "first-end", "second"), order);
+                Assertions.assertFalse(manager.processTicketUpdates());
+                Mockito.verify(first).handleFullStatusChange(Mockito.anyList());
+                Mockito.verify(second).handleFullStatusChange(Mockito.anyList());
+            }
+        });
+    }
+
+    @Test
+    void failedFullTransitionReleasesTheDrainForSubsequentWork() throws InterruptedException {
+        final MinecraftServer server = Mockito.mock(MinecraftServer.class);
+        final ServerLevel level = Mockito.mock(ServerLevel.class);
+        Mockito.when(level.getServer()).thenReturn(server);
+        final ChunkHolderManager manager = new ChunkHolderManager(level, Mockito.mock(ChunkTaskScheduler.class));
+        final NewChunkHolder first = Mockito.mock(NewChunkHolder.class);
+        final NewChunkHolder second = Mockito.mock(NewChunkHolder.class);
+        Mockito.when(first.handleFullStatusChange(Mockito.anyList())).thenThrow(new IllegalStateException("transition failed"));
+        Mockito.when(second.handleFullStatusChange(Mockito.anyList())).thenReturn(true);
+        runOnTickThread(() -> {
+            try (OwnerDomainExecutor.Scope ignored = OwnerDomainExecutor.enterGlobal(server, "failed-full-status-test")) {
+                manager.addChangedStatuses(java.util.List.of(first, second));
+                Assertions.assertThrows(IllegalStateException.class, manager::processTicketUpdates);
+                Assertions.assertTrue(manager.processTicketUpdates(), "The remaining transition must still drain");
+                Mockito.verify(second).handleFullStatusChange(Mockito.anyList());
+                Assertions.assertFalse(manager.processTicketUpdates());
+            }
+        });
+    }
+
