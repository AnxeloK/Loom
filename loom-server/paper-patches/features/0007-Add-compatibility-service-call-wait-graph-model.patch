Subject: [PATCH] Add compatibility service call wait graph model


diff --git a/src/main/java/io/papermc/paper/plugin/manager/compat/CompatibilityServiceCallGraph.java b/src/main/java/io/papermc/paper/plugin/manager/compat/CompatibilityServiceCallGraph.java
new file mode 100644
index 0000000000000000000000000000000000000000..bd95d70291bf7a6f04af6e550657e3a63f2935d6
--- /dev/null
+++ b/src/main/java/io/papermc/paper/plugin/manager/compat/CompatibilityServiceCallGraph.java
@@ -0,0 +1,74 @@
+package io.papermc.paper.plugin.manager.compat;
+
+import java.util.ArrayDeque;
+import java.util.Deque;
+import java.util.Objects;
+
+public final class CompatibilityServiceCallGraph {
+
+    public record Frame(String caller, String provider, String service, String method) {
+    }
+
+    public record EnterResult(boolean cycleDetected, String cyclePath) {
+    }
+
+    private static final ThreadLocal<Deque<Frame>> STACK = ThreadLocal.withInitial(ArrayDeque::new);
+
+    public EnterResult enter(final String caller, final String provider, final String service, final String method) {
+        Objects.requireNonNull(caller, "caller");
+        Objects.requireNonNull(provider, "provider");
+        Objects.requireNonNull(service, "service");
+        Objects.requireNonNull(method, "method");
+
+        final Deque<Frame> stack = STACK.get();
+        final boolean cycleDetected = stack.stream().anyMatch(frame -> frame.provider().equals(provider) && !caller.equals(provider));
+        final String cyclePath = cycleDetected ? this.describeCycle(stack, caller, provider, service, method) : "";
+        stack.addLast(new Frame(caller, provider, service, method));
+        return new EnterResult(cycleDetected, cyclePath);
+    }
+
+    public void exit() {
+        final Deque<Frame> stack = STACK.get();
+        if (!stack.isEmpty()) {
+            stack.removeLast();
+        }
+        if (stack.isEmpty()) {
+            STACK.remove();
+        }
+    }
+
+    private String describeCycle(
+        final Deque<Frame> stack,
+        final String caller,
+        final String provider,
+        final String service,
+        final String method
+    ) {
+        final StringBuilder builder = new StringBuilder();
+        for (final Frame frame : stack) {
+            if (!builder.isEmpty()) {
+                builder.append(" -> ");
+            }
+            builder.append(frame.caller())
+                .append("=>")
+                .append(frame.provider())
+                .append("[")
+                .append(frame.service())
+                .append("#")
+                .append(frame.method())
+                .append("]");
+        }
+        if (!builder.isEmpty()) {
+            builder.append(" -> ");
+        }
+        builder.append(caller)
+            .append("=>")
+            .append(provider)
+            .append("[")
+            .append(service)
+            .append("#")
+            .append(method)
+            .append("]");
+        return builder.toString();
+    }
+}
