diff --git a/src/test/java/net/minecraft/world/level/storage/SavedDataCloseAsyncTest.java b/src/test/java/net/minecraft/world/level/storage/SavedDataCloseAsyncTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..afdeaf5a3ef9981ad7729003a5fb43ea5ea40af1
--- /dev/null
+++ b/src/test/java/net/minecraft/world/level/storage/SavedDataCloseAsyncTest.java
@@ -0,0 +1,58 @@
+package net.minecraft.world.level.storage;
+
+import com.mojang.datafixers.DataFixer;
+import io.papermc.paper.world.saveddata.PaperWorldMetadata;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.UUID;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.CompletionException;
+import net.minecraft.core.HolderLookup;
+import net.minecraft.nbt.NbtOps;
+import net.minecraft.resources.RegistryOps;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+@Normal
+class SavedDataCloseAsyncTest {
+    @TempDir Path temporary;
+
+    @Test
+    void closeReturnsWhileTheStorageWriteIsStillPending() {
+        final SavedDataStorage storage = spy(new SavedDataStorage(temporary, mock(DataFixer.class), mock(HolderLookup.Provider.class)));
+        final CompletableFuture<Void> write = new CompletableFuture<>();
+        doReturn(write).when(storage).scheduleSave();
+        final CompletableFuture<?> closed = storage.closeAsync();
+        assertFalse(closed.isDone());
+        verify(storage).scheduleSave();
+        write.complete(null);
+        assertDoesNotThrow(closed::join);
+        // The write was captured once, before the storage stopped accepting captures.
+        doCallRealMethod().when(storage).scheduleSave();
+        assertThrows(IllegalStateException.class, storage::scheduleSave);
+    }
+
+    @Test
+    void cancellingAnObserverDoesNotCancelTheStorageWrite() {
+        final SavedDataStorage storage = spy(new SavedDataStorage(temporary, mock(DataFixer.class), mock(HolderLookup.Provider.class)));
+        final CompletableFuture<Void> write = new CompletableFuture<>();
+        doReturn(write).when(storage).scheduleSave();
+        storage.closeAsync().cancel(false);
+        assertFalse(write.isCancelled());
+        assertFalse(write.isDone());
+    }
+
+    @Test
+    void asynchronousWriteFailureReachesTheCloseCaller() throws Exception {
+        final Path blockedDirectory = temporary.resolve("not-a-directory");
+        Files.writeString(blockedDirectory, "occupied");
+        final HolderLookup.Provider registries = mock(HolderLookup.Provider.class);
+        when(registries.createSerializationContext(NbtOps.INSTANCE)).thenReturn(RegistryOps.create(NbtOps.INSTANCE, registries));
+        final SavedDataStorage storage = new SavedDataStorage(blockedDirectory, mock(DataFixer.class), registries);
+        storage.set(PaperWorldMetadata.TYPE, new PaperWorldMetadata(UUID.randomUUID()));
+        assertThrows(CompletionException.class, () -> storage.closeAsync().join());
+    }
+}
