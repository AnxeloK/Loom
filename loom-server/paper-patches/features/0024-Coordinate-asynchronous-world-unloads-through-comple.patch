index 0000000000000000000000000000000000000000..a8da959d941c5ab7c742d8f2a97c666e24ae48c9
--- /dev/null
+++ b/src/test/java/net/minecraft/server/level/WorldUnloadRoutingTest.java
@@ -0,0 +1,55 @@
+package net.minecraft.server.level;
+
+import java.util.concurrent.CompletionException;
+import java.util.concurrent.RejectedExecutionException;
+import java.util.concurrent.atomic.AtomicBoolean;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.server.threading.TickRegions;
+import org.bukkit.plugin.Plugin;
+import net.minecraft.server.threading.runtime.OwnerDomainExecutor;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+@Normal
+class WorldUnloadRoutingTest {
+    @Test void newRegionWorkFailsInsteadOfWaitingOnARetiredWorldQueue() {
+        final MinecraftServer server = mock(MinecraftServer.class);
+        final ServerLevel world = mock(ServerLevel.class);
+        when(world.getServer()).thenReturn(server);
+        when(world.isUnloading()).thenReturn(true);
+        final var owner = OwnerDomainExecutor.region(world, 0, 0, "retired-world-test");
+        final AtomicBoolean mutated = new AtomicBoolean();
+        final var result = OwnerDomainExecutor.supply(owner, () -> { mutated.set(true); return true; });
+        assertTrue(result.isDone());
+        assertInstanceOf(RejectedExecutionException.class, assertThrows(CompletionException.class, result::join).getCause());
+        assertThrows(RejectedExecutionException.class, () -> OwnerDomainExecutor.execute(owner, () -> mutated.set(true)));
+        assertFalse(mutated.get());
+    }
+
+    @Test void possessingAnOldOwnerDoesNotAdmitNewWorkAfterRetirement() {
+        final MinecraftServer server = mock(MinecraftServer.class);
+        final ServerLevel world = mock(ServerLevel.class);
+        when(world.getServer()).thenReturn(server);
+        when(world.isUnloading()).thenReturn(true);
+        final var owner = OwnerDomainExecutor.region(world, 0, 0, "retired-inline-test");
+        try (var ignored = OwnerDomainExecutor.enter(owner)) {
+            final var result = OwnerDomainExecutor.supply(owner, () -> fail("Mutated a retiring world"));
+            assertInstanceOf(RejectedExecutionException.class, assertThrows(CompletionException.class, result::join).getCause());
+        }
+    }
+    @Test void retiringAWorldCancelsItsDelayedTasksAndRejectsNewOnes() {
+        final ServerLevel world = mock(ServerLevel.class);
+        final Plugin plugin = mock(Plugin.class);
+        when(plugin.isEnabled()).thenReturn(true);
+        final var delayed = TickRegions.runDelayed(plugin, world, 0, 0, task -> fail("Retired task ran"), 100);
+        assertFalse(delayed.isCancelled());
+        when(world.isUnloading()).thenReturn(true);
+        TickRegions.clearWorldState(world);
+        assertTrue(delayed.isCancelled());
+        assertThrows(RejectedExecutionException.class, () -> TickRegions.run(plugin, world, 0, 0, task -> {}));
+        assertFalse(TickRegions.hasWorldUnloadWork(world));
+    }
+
+}
diff --git a/src/test/java/net/minecraft/world/level/storage/SavedDataCloseAsyncTest.java b/src/test/java/net/minecraft/world/level/storage/SavedDataCloseAsyncTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..afdeaf5a3ef9981ad7729003a5fb43ea5ea40af1
--- /dev/null
+++ b/src/test/java/net/minecraft/world/level/storage/SavedDataCloseAsyncTest.java
@@ -0,0 +1,58 @@
+package net.minecraft.world.level.storage;
+
+import com.mojang.datafixers.DataFixer;
+import io.papermc.paper.world.saveddata.PaperWorldMetadata;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.UUID;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.CompletionException;
+import net.minecraft.core.HolderLookup;
+import net.minecraft.nbt.NbtOps;
+import net.minecraft.resources.RegistryOps;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+@Normal
+class SavedDataCloseAsyncTest {
+    @TempDir Path temporary;
+
+    @Test
+    void closeReturnsWhileTheStorageWriteIsStillPending() {
+        final SavedDataStorage storage = spy(new SavedDataStorage(temporary, mock(DataFixer.class), mock(HolderLookup.Provider.class)));
+        final CompletableFuture<Void> write = new CompletableFuture<>();
+        doReturn(write).when(storage).scheduleSave();
+        final CompletableFuture<?> closed = storage.closeAsync();
+        assertFalse(closed.isDone());
+        verify(storage).scheduleSave();
+        write.complete(null);
+        assertDoesNotThrow(closed::join);
+        // The write was captured once, before the storage stopped accepting captures.
+        doCallRealMethod().when(storage).scheduleSave();
+        assertThrows(IllegalStateException.class, storage::scheduleSave);
+    }
+
+    @Test
+    void cancellingAnObserverDoesNotCancelTheStorageWrite() {
+        final SavedDataStorage storage = spy(new SavedDataStorage(temporary, mock(DataFixer.class), mock(HolderLookup.Provider.class)));
+        final CompletableFuture<Void> write = new CompletableFuture<>();
+        doReturn(write).when(storage).scheduleSave();
+        storage.closeAsync().cancel(false);
+        assertFalse(write.isCancelled());
+        assertFalse(write.isDone());
+    }
+
+    @Test
+    void asynchronousWriteFailureReachesTheCloseCaller() throws Exception {
+        final Path blockedDirectory = temporary.resolve("not-a-directory");
+        Files.writeString(blockedDirectory, "occupied");
+        final HolderLookup.Provider registries = mock(HolderLookup.Provider.class);
+        when(registries.createSerializationContext(NbtOps.INSTANCE)).thenReturn(RegistryOps.create(NbtOps.INSTANCE, registries));
+        final SavedDataStorage storage = new SavedDataStorage(blockedDirectory, mock(DataFixer.class), registries);
+        storage.set(PaperWorldMetadata.TYPE, new PaperWorldMetadata(UUID.randomUUID()));
+        assertThrows(CompletionException.class, () -> storage.closeAsync().join());
+    }
+}
