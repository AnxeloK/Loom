@@ -1317,6 +1321,81 @@ public final class CraftServer implements Server {
         return serverLevel.getWorld();
     }
 
+    private final java.util.Map<ServerLevel, net.minecraft.server.level.WorldUnloadOperation> worldUnloads = new java.util.IdentityHashMap<>();
+
+    @Override
+    public java.util.concurrent.CompletableFuture<Boolean> unloadWorldAsync(final World world, final boolean save) {
+        java.util.Objects.requireNonNull(world, "world");
+        return net.minecraft.server.threading.runtime.OwnershipRouter.supplyOnServer(this.console,
+            () -> this.beginWorldUnload(world, save)).thenCompose(future -> future);
+    }
+
+    private java.util.concurrent.CompletableFuture<Boolean> beginWorldUnload(final World world, final boolean save) {
+        final ServerLevel handle = ((CraftWorld) world).getHandle();
+        final var existing = this.worldUnloads.get(handle);
+        if (existing != null) {
+            if (existing.savesChunks() != save) return java.util.concurrent.CompletableFuture.failedFuture(
+                new IllegalStateException("World unload already has a different save policy"));
+            return existing.result();
+        }
+        if (this.console.hasStopped() || this.console.getLevel(handle.dimension()) != handle
+            || handle.dimension() == net.minecraft.world.level.Level.OVERWORLD || !handle.players().isEmpty()) {
+            return java.util.concurrent.CompletableFuture.completedFuture(false);
+        }
+        final var operation = new net.minecraft.server.level.WorldUnloadOperation(handle, save);
+        this.worldUnloads.put(handle, operation);
+        try {
+            if (!new WorldUnloadEvent(world).callEvent() || !handle.players().isEmpty()
+                || this.console.getLevel(handle.dimension()) != handle) {
+                this.worldUnloads.remove(handle);
+                operation.refuse();
+                return operation.result();
+            }
+            this.worlds.remove(world.getName().toLowerCase(Locale.ROOT));
+            this.console.detachLevel(handle);
+            operation.start();
+        } catch (final Throwable failure) {
+            if (!handle.unloading) this.worldUnloads.remove(handle);
+            operation.fail(failure);
+            return operation.result();
+        }
+        return operation.result();
+    }
+
+    public void tickWorldUnloads() {
+        for (final var entry : java.util.List.copyOf(this.worldUnloads.entrySet())) {
+            final var operation = entry.getValue();
+            operation.tick();
+            if (operation.isDone()) {
+                try {
+                    if (operation.result().getNow(false)) this.worldUnloads.remove(entry.getKey());
+                } catch (final java.util.concurrent.CompletionException failure) {
+                    // Keep a failed retirement reserved; callers must not overwrite its world files.
+                }
+            }
+        }
+    }
+
+    public java.util.concurrent.CompletableFuture<Void> pendingWorldUnloads() {
+        return java.util.concurrent.CompletableFuture.allOf(this.worldUnloads.values().stream()
+            .map(net.minecraft.server.level.WorldUnloadOperation::result).toArray(java.util.concurrent.CompletableFuture[]::new));
+    }
+
+    public void awaitWorldUnloadsOnShutdown() {
+        try (var ignored = net.minecraft.server.threading.runtime.OwnerDomainExecutor.enterGlobal(this.console, "shutdown-world-unloads")) {
+            final long deadline = System.nanoTime() + java.util.concurrent.TimeUnit.SECONDS.toNanos(130);
+            while (!this.pendingWorldUnloads().isDone()) {
+                this.console.executeAllRecentInternalTasks();
+                this.tickWorldUnloads();
+                if (System.nanoTime() >= deadline) {
+                    this.getLogger().severe("Timed out awaiting retiring worlds during shutdown");
+                    break;
+                }
+                java.util.concurrent.locks.LockSupport.parkNanos(1_000_000L);
+            }
+        }
+    }
+
     @Override
     public boolean unloadWorld(String name, boolean save) {
         return this.unloadWorld(this.getWorld(name), save);
