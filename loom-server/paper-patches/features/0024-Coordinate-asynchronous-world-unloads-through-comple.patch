diff --git a/src/test/java/net/minecraft/server/level/WorldLifecycleTest.java b/src/test/java/net/minecraft/server/level/WorldLifecycleTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..ac792ffdafd859f48031aad80984b8b21e296bb2
--- /dev/null
+++ b/src/test/java/net/minecraft/server/level/WorldLifecycleTest.java
@@ -0,0 +1,70 @@
+package net.minecraft.server.level;
+
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.CountDownLatch;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+class WorldLifecycleTest {
+    @Test void unloadRefusesAnInFlightTransferAndCanStartAfterItFinishes() {
+        final WorldLifecycle lifecycle = new WorldLifecycle();
+        final var first = lifecycle.tryBeginTransfer();
+        final var second = lifecycle.tryBeginTransfer();
+        assertNotNull(first); assertNotNull(second);
+        assertFalse(lifecycle.tryBeginUnload());
+        first.close(); first.close();
+        assertFalse(lifecycle.tryBeginUnload());
+        second.close();
+        assertTrue(lifecycle.tryBeginUnload());
+        assertNull(lifecycle.tryBeginTransfer());
+        assertFalse(lifecycle.tryBeginUnload());
+    }
+
+    @Test void aRedirectRetainsTheNewDestinationBeforeReleasingTheOldOne() {
+        final WorldLifecycle original = new WorldLifecycle(), redirected = new WorldLifecycle();
+        try (var transfer = original.tryBeginTransfer()) {
+            assertNotNull(transfer);
+            assertTrue(transfer.retarget(redirected));
+            assertTrue(original.tryBeginUnload());
+            assertFalse(redirected.tryBeginUnload());
+        }
+        assertTrue(redirected.tryBeginUnload());
+    }
+
+    @Test void redirectToARetiringWorldFailsWithoutDroppingTheOriginalReservation() {
+        final WorldLifecycle original = new WorldLifecycle(), retiring = new WorldLifecycle();
+        assertTrue(retiring.tryBeginUnload());
+        try (var transfer = original.tryBeginTransfer()) {
+            assertNotNull(transfer);
+            assertFalse(transfer.retarget(retiring));
+            assertFalse(original.tryBeginUnload());
+        }
+        assertTrue(original.tryBeginUnload());
+    }
+
+    @Test void departureStaysProtectedAfterAnEventRedirectsTheDestination() {
+        final WorldLifecycle original = new WorldLifecycle(), destination = new WorldLifecycle();
+        try (var departure = original.tryBeginTransfer(); var transfer = original.tryBeginTransfer()) {
+            assertNotNull(departure); assertNotNull(transfer);
+            assertTrue(transfer.retarget(destination));
+            assertFalse(original.tryBeginUnload());
+            assertFalse(destination.tryBeginUnload());
+        }
+        assertTrue(original.tryBeginUnload());
+        assertTrue(destination.tryBeginUnload());
+    }
+
+    @Test void racingTransferAndUnloadCannotBothAcquireTheWorld() throws Exception {
+        final WorldLifecycle lifecycle = new WorldLifecycle();
+        final CountDownLatch start = new CountDownLatch(1);
+        final var entered = CompletableFuture.supplyAsync(() -> {
+            try { start.await(); } catch (InterruptedException failure) { throw new RuntimeException(failure); }
+            return lifecycle.tryBeginTransfer();
+        });
+        start.countDown();
+        final boolean retiring = lifecycle.tryBeginUnload();
+        final var transfer = entered.get(5, java.util.concurrent.TimeUnit.SECONDS);
+        assertNotEquals(retiring, transfer != null);
+        if (transfer != null) transfer.close();
+    }
+}
diff --git a/src/test/java/net/minecraft/server/level/WorldUnloadRoutingTest.java b/src/test/java/net/minecraft/server/level/WorldUnloadRoutingTest.java
