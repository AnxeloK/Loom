@@ -1,10 +1,16 @@
 package org.bukkit.craftbukkit.scheduler;
 
+import io.papermc.paper.configuration.LoomConfiguration;
+import io.papermc.paper.plugin.manager.compat.CompatibilityDiagnostics;
 import io.papermc.paper.plugin.manager.compat.CompatibilityRuntimeContext;
 import java.util.Iterator;
 import java.util.LinkedList;
 import java.util.Map;
+import java.util.concurrent.CompletableFuture;
 import java.util.logging.Level;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.server.threading.runtime.OwnerDomainExecutor;
+import net.minecraft.server.threading.runtime.ThreadedRegionsBlockingBarrier;
 import org.bukkit.plugin.Plugin;
 import org.bukkit.scheduler.BukkitWorker;
 
@@ -55,19 +61,18 @@ class CraftAsyncTask extends CraftTask {
         }
         Throwable thrown = null;
         try {
-            final long transactionId = CompatibilityRuntimeContext.syntheticTransactionId();
-            try (CompatibilityRuntimeContext.Scope ignored = CompatibilityRuntimeContext.enter(this.getOwner(), transactionId, false)) {
-                super.run();
+            this.runTaskWithContext(false, "scheduler:async-task");
+        } catch (final Throwable initialFailure) {
+            if (!this.tryCompatibilitySyncReroute(initialFailure)) {
+                thrown = initialFailure;
+                this.getOwner().getLogger().log(
+                        Level.WARNING,
+                        String.format(
+                            "Plugin %s generated an exception while executing task %s",
+                            this.getOwner().getDescription().getFullName(),
+                            this.getTaskId()),
+                        thrown);
             }
-        } catch (final Throwable t) {
-            thrown = t;
-            this.getOwner().getLogger().log(
-                    Level.WARNING,
-                    String.format(
-                        "Plugin %s generated an exception while executing task %s",
-                        this.getOwner().getDescription().getFullName(),
-                        this.getTaskId()),
-                    thrown);
         } finally {
             // Cleanup is important for any async task, otherwise ghost tasks are everywhere
             synchronized (this.workers) {
@@ -102,6 +107,54 @@ class CraftAsyncTask extends CraftTask {
         } finally { thread.setName(nameBefore); } // Paper - name threads according to running plugin
     }
 
+    private void runTaskWithContext(final boolean strictFallback, final String path) {
+        final long transactionId = CompatibilityRuntimeContext.syntheticTransactionId();
+        try (CompatibilityRuntimeContext.Scope ignored = CompatibilityRuntimeContext.enter(this.getOwner(), transactionId, strictFallback, path)) {
+            super.run();
+        }
+    }
+
+    private boolean tryCompatibilitySyncReroute(final Throwable initialFailure) {
+        if (!isCompatibilityAsyncViolation(initialFailure)) {
+            return false;
+        }
+        if (LoomConfiguration.mode() != LoomConfiguration.Mode.COMPATIBILITY) {
+            return false;
+        }
+
+        final MinecraftServer server = MinecraftServer.getServer();
+        if (server == null || server.hasStopped()) {
+            return false;
+        }
+
+        final CompatibilityDiagnostics diagnostics = CompatibilityDiagnostics.global();
+        diagnostics.recordStrictFallback(
+            diagnostics.profileFor(this.getOwner()),
+            "async scheduler reroute after " + initialFailure.getMessage()
+        );
+
+        final CompletableFuture<Void> rerouted = OwnerDomainExecutor.submit(
+            OwnerDomainExecutor.global(server, "compat-async-task-reroute"),
+            () -> this.runTaskWithContext(true, "scheduler:async-reroute")
+        );
+
+        try {
+            ThreadedRegionsBlockingBarrier.awaitNonOwnerFuture(rerouted, "compatibility async scheduler reroute");
+            return true;
+        } catch (final RuntimeException | Error rerouteFailure) {
+            initialFailure.addSuppressed(rerouteFailure);
+            return false;
+        }
+    }
+
+    private static boolean isCompatibilityAsyncViolation(final Throwable throwable) {
+        if (!(throwable instanceof IllegalStateException illegalStateException)) {
+            return false;
+        }
+        final String message = illegalStateException.getMessage();
+        return message != null && message.startsWith("Asynchronous ");
+    }
+
     LinkedList<BukkitWorker> getWorkers() {
         return this.workers;
     }
