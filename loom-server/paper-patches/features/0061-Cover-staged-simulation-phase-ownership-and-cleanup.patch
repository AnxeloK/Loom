+    @Test
+    void aConnectedStripCanTickItsSeparatedEndsTogether() throws Exception {
+        final Fixture f = new Fixture();
+        assertTrue(parallel(plan(f.world, chunks(0, 7, 8, 15, 16, 23))));
+    }
