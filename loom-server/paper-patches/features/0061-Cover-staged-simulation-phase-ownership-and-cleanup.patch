+    @Test
+    void connectedEntityRegionsStageBeforeOwnerEntities() throws Exception {
+        final Fixture f = new Fixture();
+        final Entity owner = entity(1, true);
+        final List<Entity> entities = List.of(entity(0, false), owner, entity(8, false), entity(16, false));
+        final EntityTickList ticking = new EntityTickList();
+        entities.forEach(ticking::add);
+        set(f.world, "entityTickList", ticking);
+        final List<Entity> seen = Collections.synchronizedList(new ArrayList<>());
+        doAnswer(call -> {
+            final Entity current = call.getArgument(1);
+            if (current == owner) {
+                f.assertSerialOwner();
+                assertEquals(3, seen.size());
+            } else {
+                assertTrue(RegionTickStaging.isStaging());
+                final ChunkPos pos = current.chunkPosition();
+                assertTrue(TickRegions.isCurrentThreadOwnerQuiet(f.world, pos.x(), pos.z(), pos.x(), pos.z()));
+            }
+            seen.add(current);
+            return null;
+        }).when(f.world).guardEntityTick(any(), any());
+        f.owned(() -> {
+            invoke(f.world, "tickEntitiesInParallel", new Class<?>[0]);
+            f.assertSerialOwner();
+        });
+        assertEquals(4, seen.size());
+        assertTrue(seen.containsAll(entities));
+        assertSame(owner, seen.getLast());
+    }
+
