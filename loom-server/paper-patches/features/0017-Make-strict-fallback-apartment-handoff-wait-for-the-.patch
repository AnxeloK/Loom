+    // Loom - same budget as the event-dispatch handoff (PaperEventManager): the plugin's dedicated
+    // strict-fallback thread waits out a busy lease instead of failing on the first try. A service call
+    // must produce a return value, so on budget exhaustion this path still throws — but only after the
+    // wait, which converts routine transient contention into a delayed successful call.
+    private static final long HANDOFF_WAIT_NANOS = java.util.concurrent.TimeUnit.MILLISECONDS.toNanos(
+        Math.max(0L, Long.getLong("Loom.CompatApartmentHandoffWaitMillis", 10_000L))
+    );
