From: AnxeloK <95703440+AnxeloK@users.noreply.github.com>
Date: Sun, 21 Jun 2026 20:32:23 +0000
Subject: [PATCH] Quiet compatibility diagnostic logging


diff --git a/src/main/java/io/papermc/paper/plugin/manager/compat/CompatibilityDiagnostics.java b/src/main/java/io/papermc/paper/plugin/manager/compat/CompatibilityDiagnostics.java
index e7498fd873bfa16fc84d3e1f8cda85d272c11d96..b742b626ad6d4797b13feb620ae9fc4094e39168 100644
--- a/src/main/java/io/papermc/paper/plugin/manager/compat/CompatibilityDiagnostics.java
+++ b/src/main/java/io/papermc/paper/plugin/manager/compat/CompatibilityDiagnostics.java
@@ -67,6 +67,7 @@ public final class CompatibilityDiagnostics {
     private final LongAdder barrierWaitNanos = new LongAdder();
     private final ConcurrentMap<String, BarrierCounter> barriers = new ConcurrentHashMap<>();
     private final Set<String> strictFallbackLogKeys = ConcurrentHashMap.newKeySet();
+    private final Set<String> loggedEventKeys = ConcurrentHashMap.newKeySet();
 
     public static CompatibilityDiagnostics global() {
         return GLOBAL;
@@ -467,11 +468,20 @@ public final class CompatibilityDiagnostics {
     }
 
     private void logStructured(final String type, final Map<String, Object> payload) {
+        // Log each distinct event once. A plugin hitting the same call site repeatedly (e.g. a metrics
+        // timer) would otherwise flood the console; the underlying counters still increment every time.
+        final String dedupKey = type + new java.util.TreeMap<>(payload);
+        if (!this.loggedEventKeys.add(dedupKey)) {
+            return;
+        }
+        if (this.loggedEventKeys.size() > 4096) {
+            this.loggedEventKeys.clear();
+        }
         final Map<String, Object> event = new LinkedHashMap<>();
         event.put("type", type);
         event.put("timestamp", System.currentTimeMillis());
         event.putAll(payload);
-        LOGGER.info("[loom.compat] {}", toJson(event));
+        LOGGER.debug("[loom.compat] {}", toJson(event));
     }
 
     private static String formatNanos(final long nanos) {
