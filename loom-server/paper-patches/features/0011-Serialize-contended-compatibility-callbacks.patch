+    @Test
+    void serializedEntriesResumeOnTheirCallingThreadsWithoutLoss() throws Exception {
+        final Plugin plugin = mockPlugin("OrderedPlugin");
+        final CompatibilityApartment apartment = new CompatibilityApartment(plugin);
+        final CompatibilityTransaction holderTransaction = transactionFor(plugin);
+        final List<Integer> order = Collections.synchronizedList(new ArrayList<>());
+        final List<Thread> callbackThreads = Collections.synchronizedList(new ArrayList<>());
+        final AtomicReference<Throwable> failure = new AtomicReference<>();
+        final CountDownLatch leaseHeld = new CountDownLatch(1);
+        final CountDownLatch release = new CountDownLatch(1);
+
+        final Thread holder = new Thread(() -> {
+            try (CompatibilityApartment.Scope ignored = apartment.enter(holderTransaction, false)) {
+                leaseHeld.countDown();
+                release.await();
+            } catch (final Throwable throwable) {
+                failure.compareAndSet(null, throwable);
+            }
+        }, "ordered-apartment-holder");
+        holder.setDaemon(true);
+        holder.start();
+        Assertions.assertTrue(leaseHeld.await(5L, TimeUnit.SECONDS));
+
+        final List<Thread> contenders = new ArrayList<>();
+        for (int index = 0; index < 3; ++index) {
+            final int queuedIndex = index;
+            final CompatibilityTransaction transaction = transactionFor(plugin);
+            final Thread contender = new Thread(() -> {
+                try (CompatibilityApartment.Scope ignored = apartment.enterSerialized(transaction, true, "test:ordered-" + queuedIndex)) {
+                    order.add(queuedIndex);
+                    callbackThreads.add(Thread.currentThread());
+                } catch (final Throwable throwable) {
+                    failure.compareAndSet(null, throwable);
+                }
+            }, "ordered-apartment-contender-" + index);
+            contender.setDaemon(true);
+            contenders.add(contender);
+            contender.start();
+            awaitQueuedLeases(apartment, index + 1);
+        }
+
+        release.countDown();
+        holder.join(5_000L);
+        for (final Thread contender : contenders) {
+            contender.join(5_000L);
+            Assertions.assertFalse(contender.isAlive());
+        }
+
+        Assertions.assertFalse(holder.isAlive());
+        Assertions.assertNull(failure.get());
+        Assertions.assertEquals(3, order.size());
+        Assertions.assertEquals(3, callbackThreads.size());
+        for (int index = 0; index < order.size(); ++index) {
+            Assertions.assertSame(contenders.get(order.get(index)), callbackThreads.get(index));
+        }
+        final List<Integer> delivered = new ArrayList<>(order);
+        Collections.sort(delivered);
+        Assertions.assertEquals(List.of(0, 1, 2), delivered);
+    }
