+    @Test
+    void serializedHandoffServicesOwnerCallbackBeforeLeaseRelease() throws InterruptedException {
+        final Plugin plugin = mockPlugin("CallbackPlugin");
+        final CompatibilityApartment apartment = new CompatibilityApartment(plugin);
+        final CompatibilityTransaction holderTransaction = transactionFor(plugin);
+        final CompatibilityTransaction handoffTransaction = transactionFor(plugin);
+        final MinecraftServer server = Mockito.mock(MinecraftServer.class);
+        final ServerLevel level = Mockito.mock(ServerLevel.class);
+        Mockito.when(level.getServer()).thenReturn(server);
+        Mockito.when(level.dimension()).thenReturn(Level.OVERWORLD);
+        final OwnerDomainExecutor.Owner owner = OwnerDomainExecutor.region(level, 2, 4, "compatibility-handoff-test");
+        final CountDownLatch leaseHeld = new CountDownLatch(1);
+        final AtomicReference<Throwable> holderFailure = new AtomicReference<>();
+        final AtomicReference<Throwable> ownerFailure = new AtomicReference<>();
+        final AtomicReference<String> ownerResult = new AtomicReference<>();
+
+        final Thread holder = new Thread(() -> {
+            try (CompatibilityApartment.Scope ignored = apartment.enter(holderTransaction, false)) {
+                leaseHeld.countDown();
+                awaitQueuedLeases(apartment, 1);
+                final String callbackResult = OwnerDomainExecutor.supply(owner, () -> {
+                    Assertions.assertTrue(OwnerDomainExecutor.isOwner(owner));
+                    return "owner-ready";
+                }).join();
+                Assertions.assertEquals("owner-ready", callbackResult);
+            } catch (final Throwable throwable) {
+                holderFailure.set(throwable);
+            }
+        }, "compatibility-lease-holder");
+        holder.setDaemon(true);
+        holder.start();
+        Assertions.assertTrue(leaseHeld.await(5L, TimeUnit.SECONDS));
+
+        final Thread ownerThread = new TickThread(() -> {
+            try (OwnerDomainExecutor.Scope ignored = OwnerDomainExecutor.enter(owner)) {
+                try (CompatibilityApartment.Scope scope = apartment.enterSerialized(
+                    handoffTransaction,
+                    true,
+                    "test:cooperative-handoff"
+                )) {
+                    Assertions.assertTrue(scope.acquired());
+                    Assertions.assertTrue(OwnerDomainExecutor.isOwner(owner));
+                    Assertions.assertTrue(TickThread.isTickThread(), "serialized callback left its genuine tick thread");
+                    ownerResult.set("listener-delivered");
+                }
+            } catch (final Throwable throwable) {
+                ownerFailure.set(throwable);
+            }
+        }, "compatibility-owner");
+        ownerThread.setDaemon(true);
+        ownerThread.start();
+        ownerThread.join(TimeUnit.SECONDS.toMillis(5L));
+        holder.join(TimeUnit.SECONDS.toMillis(5L));
+
+        Assertions.assertFalse(ownerThread.isAlive(), "owner-side compatibility handoff did not complete");
+        Assertions.assertFalse(holder.isAlive(), "lease holder did not complete its owner callback");
+        Assertions.assertNull(ownerFailure.get());
+        Assertions.assertNull(holderFailure.get());
+        Assertions.assertEquals("listener-delivered", ownerResult.get());
+    }
+
+    private static void awaitQueuedLeases(final CompatibilityApartment apartment, final int count) throws InterruptedException {
+        final long deadline = System.nanoTime() + TimeUnit.SECONDS.toNanos(5L);
+        while (apartment.queuedLeaseCount() != count && System.nanoTime() < deadline) {
+            Thread.sleep(1L);
+        }
+        Assertions.assertEquals(count, apartment.queuedLeaseCount());
     }
 
