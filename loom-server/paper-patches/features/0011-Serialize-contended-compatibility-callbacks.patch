+package net.minecraft.server.threading.runtime;
+
+import ca.spottedleaf.moonrise.common.util.TickThread;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Queue;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.ConcurrentLinkedQueue;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.concurrent.atomic.AtomicReference;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.server.threading.TickRegions;
+import net.minecraft.world.level.Level;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Assertions;
+import org.junit.jupiter.api.Test;
+import org.mockito.Mockito;
+
+@Normal
+class OwnerDomainExecutorCooperativeWaitTest {
+
+    @Test
+    void cooperativeWaitClaimsQueuedRegionOwnerTask() throws InterruptedException {
+        final MinecraftServer server = Mockito.mock(MinecraftServer.class);
+        final ServerLevel level = Mockito.mock(ServerLevel.class);
+        Mockito.when(level.getServer()).thenReturn(server);
+        Mockito.when(level.dimension()).thenReturn(Level.OVERWORLD);
+        final OwnerDomainExecutor.Owner owner = OwnerDomainExecutor.region(level, 11, -7, "prequeued-region-task");
+        final CompletableFuture<String> queued = OwnerDomainExecutor.supply(owner, () -> "region-claimed");
+        Assertions.assertFalse(queued.isDone());
+
+        final AtomicReference<String> result = new AtomicReference<>();
+        final AtomicReference<Throwable> failure = new AtomicReference<>();
+        final Thread ownerThread = new TickThread(() -> {
+            final TickRegions.RegionContext context = TickRegions.pushRegionContext(level, 11, -7, 11, -7);
+            try {
+                result.set(OwnerDomainExecutor.awaitCooperatively(queued, "prequeued-region-task"));
+            } catch (final Throwable throwable) {
+                failure.set(throwable);
+            } finally {
+                TickRegions.popContext(context);
+            }
+        }, "prequeued-region-owner");
+        ownerThread.setDaemon(true);
+        ownerThread.start();
+        ownerThread.join(TimeUnit.SECONDS.toMillis(5L));
+
+        Assertions.assertFalse(ownerThread.isAlive(), "prequeued region owner task was not claimed");
+        Assertions.assertNull(failure.get());
+        Assertions.assertEquals("region-claimed", result.get());
+    }
+
+    @Test
+    void cooperativeWaitClaimsOwnerTaskQueuedBeforeRegistration() throws InterruptedException {
+        final MinecraftServer server = Mockito.mock(MinecraftServer.class);
+        final AtomicReference<Runnable> queuedOwnerTask = new AtomicReference<>();
+        Mockito.when(server.enqueueGlobalOwnerTask(Mockito.any(Runnable.class))).thenAnswer(invocation -> {
+            queuedOwnerTask.set(invocation.getArgument(0));
+            return true;
+        });
+        Mockito.when(server.runQueuedGlobalOwnerTask(Mockito.any())).thenAnswer(invocation -> {
+            final java.util.function.Predicate<Runnable> predicate = invocation.getArgument(0);
+            final Runnable candidate = queuedOwnerTask.get();
+            if (candidate == null || !predicate.test(candidate) || !queuedOwnerTask.compareAndSet(candidate, null)) {
+                return false;
+            }
+            candidate.run();
+            return true;
+        });
+        final OwnerDomainExecutor.Owner owner = OwnerDomainExecutor.global(server, "prequeued-owner-task");
+        final CompletableFuture<String> queued = OwnerDomainExecutor.supply(owner, () -> "claimed");
+        Assertions.assertFalse(queued.isDone());
+        Assertions.assertNotNull(queuedOwnerTask.get());
+
+        final AtomicReference<String> result = new AtomicReference<>();
+        final AtomicReference<Throwable> failure = new AtomicReference<>();
+        final Thread ownerThread = new Thread(() -> {
+            try (OwnerDomainExecutor.Scope ignored = OwnerDomainExecutor.enter(owner)) {
+                result.set(OwnerDomainExecutor.awaitCooperatively(queued, "prequeued-owner-task"));
+            } catch (final Throwable throwable) {
+                failure.set(throwable);
+            }
+        }, "prequeued-owner");
+        ownerThread.setDaemon(true);
+        ownerThread.start();
+        ownerThread.join(TimeUnit.SECONDS.toMillis(5L));
+
+        Assertions.assertFalse(ownerThread.isAlive(), "prequeued owner task was not claimed");
+        Assertions.assertNull(failure.get());
+        Assertions.assertEquals("claimed", result.get());
+        Assertions.assertNull(queuedOwnerTask.get());
+    }
+
+    @Test
+    void cooperativeWaitPrioritizesTaskCompletingAwaitedFuture() throws InterruptedException {
+        final MinecraftServer server = Mockito.mock(MinecraftServer.class);
+        final Queue<Runnable> queuedOwnerTasks = new ConcurrentLinkedQueue<>();
+        Mockito.when(server.enqueueGlobalOwnerTask(Mockito.any(Runnable.class))).thenAnswer(invocation -> {
+            queuedOwnerTasks.add(invocation.getArgument(0));
+            return true;
+        });
+        Mockito.when(server.runQueuedGlobalOwnerTask(Mockito.any())).thenAnswer(invocation -> {
+            final java.util.function.Predicate<Runnable> predicate = invocation.getArgument(0);
+            for (final Runnable candidate : queuedOwnerTasks) {
+                if (predicate.test(candidate) && queuedOwnerTasks.remove(candidate)) {
+                    candidate.run();
+                    return true;
+                }
+            }
+            return false;
+        });
+        final OwnerDomainExecutor.Owner owner = OwnerDomainExecutor.global(server, "prioritized-owner-task");
+        final List<String> order = new ArrayList<>();
+        final CompletableFuture<String> unrelated = OwnerDomainExecutor.supply(owner, () -> {
+            order.add("unrelated");
+            return "unrelated";
+        });
+        final CompletableFuture<String> awaited = OwnerDomainExecutor.supply(owner, () -> {
+            Assertions.assertTrue(TickThread.isTickThread());
+            order.add("awaited");
+            return "awaited";
+        });
+
+        final AtomicReference<String> result = new AtomicReference<>();
+        final AtomicReference<Throwable> failure = new AtomicReference<>();
+        final Thread ownerThread = new TickThread(() -> {
+            try (OwnerDomainExecutor.Scope ignored = OwnerDomainExecutor.enter(owner)) {
+                result.set(OwnerDomainExecutor.awaitCooperatively(awaited, "prioritized-owner-task"));
+            } catch (final Throwable throwable) {
+                failure.set(throwable);
+            }
+        }, "prioritized-owner");
+        ownerThread.setDaemon(true);
+        ownerThread.start();
+        ownerThread.join(TimeUnit.SECONDS.toMillis(5L));
+
+        Assertions.assertFalse(ownerThread.isAlive(), "prioritized owner task did not complete");
+        Assertions.assertNull(failure.get());
+        Assertions.assertEquals("awaited", result.get());
+        Assertions.assertEquals(List.of("awaited"), order);
+        Assertions.assertFalse(unrelated.isDone());
+        Assertions.assertEquals(1, queuedOwnerTasks.size());
+    }
+
+    @Test
+    void cooperativeWaitCapsNestedWaits() throws InterruptedException {
+        final MinecraftServer server = Mockito.mock(MinecraftServer.class);
+        final OwnerDomainExecutor.Owner owner = OwnerDomainExecutor.global(server, "nested-wait-cap");
+        final AtomicReference<Throwable> failure = new AtomicReference<>();
+        final Thread ownerThread = new TickThread(() -> {
+            try (OwnerDomainExecutor.Scope ignored = OwnerDomainExecutor.enter(owner)) {
+                OwnerDomainExecutor.awaitCooperatively(() -> nestedWait(64), "nested-wait-cap");
+            } catch (final Throwable throwable) {
+                failure.set(throwable);
+            }
+        }, "nested-wait-owner");
+        ownerThread.setDaemon(true);
+        ownerThread.start();
+        ownerThread.join(TimeUnit.SECONDS.toMillis(5L));
+
+        Assertions.assertFalse(ownerThread.isAlive(), "nested cooperative waits did not terminate");
+        final IllegalStateException exception = Assertions.assertInstanceOf(IllegalStateException.class, failure.get());
+        Assertions.assertTrue(exception.getMessage().contains("Cooperative wait nesting exceeded"));
+        Assertions.assertEquals(0, OwnerDomainExecutor.activeCooperativeWaits());
+    }
+
+    @Test
+    void delegatedWorkCanCallBackIntoWaitingOwner() throws InterruptedException {
+        final MinecraftServer server = Mockito.mock(MinecraftServer.class);
+        final ServerLevel level = Mockito.mock(ServerLevel.class);
+        Mockito.when(level.getServer()).thenReturn(server);
+        Mockito.when(level.dimension()).thenReturn(Level.OVERWORLD);
+        final OwnerDomainExecutor.Owner owner = OwnerDomainExecutor.region(level, 3, 7, "cooperative-wait-test");
+        final AtomicInteger callbacks = new AtomicInteger();
+        final AtomicReference<String> result = new AtomicReference<>();
+        final AtomicReference<Throwable> failure = new AtomicReference<>();
+        final AtomicReference<Thread> ownerThreadReference = new AtomicReference<>();
+
+        final Thread ownerThread = new Thread(() -> {
+            try (OwnerDomainExecutor.Scope ignored = OwnerDomainExecutor.enter(owner)) {
+                result.set(OwnerDomainExecutor.awaitCooperatively(
+                    () -> CompletableFuture.supplyAsync(() -> OwnerDomainExecutor.supply(owner, () -> {
+                        Assertions.assertTrue(OwnerDomainExecutor.isOwner(owner));
+                        Assertions.assertSame(Thread.currentThread(), ownerThreadReference.get());
+                        callbacks.incrementAndGet();
+                        return "delivered";
+                    }).join()),
+                    "cooperative-wait-test"
+                ));
+            } catch (final Throwable throwable) {
+                failure.set(throwable);
+            }
+        }, "cooperative-owner");
+        ownerThreadReference.set(ownerThread);
+        ownerThread.setDaemon(true);
+        ownerThread.start();
+        ownerThread.join(TimeUnit.SECONDS.toMillis(5L));
+
+        Assertions.assertFalse(ownerThread.isAlive(), "cooperative owner wait did not complete");
+        Assertions.assertNull(failure.get());
+        Assertions.assertEquals("delivered", result.get());
+        Assertions.assertEquals(1, callbacks.get());
+        Assertions.assertEquals(0, OwnerDomainExecutor.activeCooperativeWaits());
+    }
+
+    private static CompletableFuture<String> nestedWait(final int remaining) {
+        if (remaining == 0) {
+            return CompletableFuture.completedFuture("done");
+        }
+        return CompletableFuture.completedFuture(OwnerDomainExecutor.awaitCooperatively(
+            () -> nestedWait(remaining - 1),
+            "nested-wait-" + remaining
+        ));
+    }
+}
