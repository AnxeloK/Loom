+    @Test
+    void serializedWaiterDoesNotOwnLeaseWhileCooperativeWorkDrains() throws Exception {
+        final Plugin plugin = mockPlugin("DrainPlugin");
+        final CompatibilityApartment apartment = new CompatibilityApartment(plugin);
+        final CompatibilityTransaction holderTransaction = transactionFor(plugin);
+        final CompatibilityTransaction waiterTransaction = transactionFor(plugin);
+        final MinecraftServer server = Mockito.mock(MinecraftServer.class);
+        final Queue<Runnable> queuedOwnerTasks = new ConcurrentLinkedQueue<>();
+        Mockito.when(server.enqueueGlobalOwnerTask(Mockito.any(Runnable.class))).thenAnswer(invocation -> {
+            queuedOwnerTasks.add(invocation.getArgument(0));
+            return true;
+        });
+        Mockito.when(server.runQueuedGlobalOwnerTask(Mockito.any())).thenAnswer(invocation -> {
+            final java.util.function.Predicate<Runnable> predicate = invocation.getArgument(0);
+            for (final Runnable candidate : queuedOwnerTasks) {
+                if (predicate.test(candidate) && queuedOwnerTasks.remove(candidate)) {
+                    candidate.run();
+                    return true;
+                }
+            }
+            return false;
+        });
+        final OwnerDomainExecutor.Owner owner = OwnerDomainExecutor.global(server, "compatibility-drain-test");
+        final CountDownLatch leaseHeld = new CountDownLatch(1);
+        final CountDownLatch releaseLease = new CountDownLatch(1);
+        final CountDownLatch callbackStarted = new CountDownLatch(1);
+        final CountDownLatch releaseCallback = new CountDownLatch(1);
+        final AtomicReference<Throwable> holderFailure = new AtomicReference<>();
+        final AtomicReference<Throwable> ownerFailure = new AtomicReference<>();
+
+        final Thread holder = new Thread(() -> {
+            try (CompatibilityApartment.Scope ignored = apartment.enter(holderTransaction, false)) {
+                leaseHeld.countDown();
+                releaseLease.await();
+            } catch (final Throwable throwable) {
+                holderFailure.set(throwable);
+            }
+        }, "compatibility-drain-holder");
+        holder.setDaemon(true);
+        holder.start();
+        Assertions.assertTrue(leaseHeld.await(5L, TimeUnit.SECONDS));
+
+        final Thread ownerThread = new TickThread(() -> {
+            try (OwnerDomainExecutor.Scope ignored = OwnerDomainExecutor.enter(owner);
+                 CompatibilityApartment.Scope scope = apartment.enterSerialized(waiterTransaction, true, "test:draining-handoff")) {
+                Assertions.assertTrue(scope.acquired());
+            } catch (final Throwable throwable) {
+                ownerFailure.set(throwable);
+            }
+        }, "compatibility-drain-owner");
+        ownerThread.setDaemon(true);
+        ownerThread.start();
+        awaitQueuedLeases(apartment, 1);
+
+        final CompletableFuture<String> drainingCallback = OwnerDomainExecutor.supply(owner, () -> {
+            callbackStarted.countDown();
+            try {
+                releaseCallback.await();
+            } catch (final InterruptedException interruptedException) {
+                Thread.currentThread().interrupt();
+                throw new AssertionError(interruptedException);
+            }
+            return "drained";
+        });
+        Assertions.assertTrue(callbackStarted.await(5L, TimeUnit.SECONDS));
+
+        releaseLease.countDown();
+        holder.join(5_000L);
+        Assertions.assertFalse(holder.isAlive());
+        Assertions.assertNull(holderFailure.get());
+
+        try (CompatibilityApartment.Scope probe = apartment.enter(transactionFor(plugin), false)) {
+            Assertions.assertEquals(CompatibilityApartment.EnterResult.BUSY, probe.result());
+            Assertions.assertNull(probe.busyLease(), "a waiter must not own the lease before its callback resumes");
+        } finally {
+            releaseCallback.countDown();
+        }
+
+        ownerThread.join(5_000L);
+        Assertions.assertFalse(ownerThread.isAlive(), "owner-side compatibility handoff did not resume");
+        Assertions.assertNull(ownerFailure.get());
+        Assertions.assertEquals("drained", drainingCallback.join());
+        try (CompatibilityApartment.Scope finalScope = apartment.enter(transactionFor(plugin), false)) {
+            Assertions.assertTrue(finalScope.acquired(), "the apartment remained stranded after cooperative work drained");
+        }
+    }
