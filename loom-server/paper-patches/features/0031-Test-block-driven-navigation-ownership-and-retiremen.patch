--- /dev/null
+++ b/src/test/java/net/minecraft/server/level/NavigationUpdatesTestSuite.java
@@ -0,0 +1,9 @@
+package net.minecraft.server.level;
+
+import org.junit.platform.suite.api.*;
+
+@Suite
+@IncludeTags("Normal")
+@SelectClasses(NavigationUpdatesTest.class)
+@ConfigurationParameter(key = "TestSuite", value = "Normal")
+public class NavigationUpdatesTestSuite {}
