         LOGGER.info(PlatformHooks.get().getBrand() + " is using " + workerThreads + " worker threads, " + ioThreads + " I/O threads");
     }
 
+    public static void applyLoomWorkerDefaults(final int configWorkerThreads, final int configIoThreads) {
+        final String workerThreadProperty = PlatformHooks.get().getBrand() + ".WorkerThreadCount";
+        if (configWorkerThreads > 0 || System.getProperty(workerThreadProperty) != null) {
+            return;
+        }
+
+        final int workerThreads = loomWorkerThreads(OSNuma.getNativeInstance().getTotalCores());
+        adjustWorkerThreads(workerThreads, configIoThreads);
+        LOGGER.info("Loom set the implicit chunk worker default to " + workerThreads + " threads");
+    }
+
+    static int loomWorkerThreads(final int totalCores) {
+        return Math.max(1, totalCores / 8);
+    }
+
