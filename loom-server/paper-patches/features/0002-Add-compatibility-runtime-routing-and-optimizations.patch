@@ -0,0 +1,43 @@
+package io.papermc.paper.plugin.manager.compat;
+
+import java.util.Objects;
+import java.util.concurrent.CompletableFuture;
+import org.bukkit.plugin.Plugin;
+
+public final class CompatibilitySyncBridge {
+
+    private CompatibilitySyncBridge() {
+    }
+
+    public static boolean isEnabledForCurrentContext() {
+        return CompatibilityRuntimeContext.currentPlugin() != null;
+    }
+
+    public static <T> T awaitFuture(
+        final CompletableFuture<T> future,
+        final String operation,
+        final String lane
+    ) {
+        Objects.requireNonNull(future, "future");
+        Objects.requireNonNull(operation, "operation");
+        Objects.requireNonNull(lane, "lane");
+
+        final Plugin plugin = CompatibilityRuntimeContext.currentPlugin();
+        if (plugin == null) {
+            throw new IllegalStateException("Compatibility sync bridge requires plugin runtime context");
+        }
+
+        final CompatibilityDiagnostics diagnostics = CompatibilityDiagnostics.global();
+        final PluginCompatibilityProfile profile = diagnostics.profileFor(plugin);
+        final long started = System.nanoTime();
+        try {
+            return CompatibilityContinuationBridge.callOffOwner(profile, diagnostics, operation, future::join);
+        } catch (final RuntimeException | Error throwable) {
+            throw throwable;
+        } catch (final Throwable throwable) {
+            throw new RuntimeException(throwable);
+        } finally {
+            diagnostics.recordBarrierWait(profile, lane, operation, System.nanoTime() - started);
+        }
+    }
+}
