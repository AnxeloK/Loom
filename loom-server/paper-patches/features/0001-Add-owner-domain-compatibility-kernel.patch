@@ -0,0 +1,119 @@
+package org.bukkit;
+
+import ca.spottedleaf.concurrentutil.util.Priority;
+import java.util.UUID;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.server.level.ServerPlayer;
+import net.minecraft.server.threading.runtime.OwnerDomainExecutor;
+import net.minecraft.server.threading.runtime.OwnershipRouter;
+import net.minecraft.world.level.ChunkPos;
+import net.minecraft.world.level.Level;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Assertions;
+import org.junit.jupiter.api.Test;
+import org.mockito.Mockito;
+
+@Normal
+class OwnershipRouterCompatibilityTest {
+
+    @Test
+    void canRunSynchronousCallbacksDependsOnOwnerDomain() {
+        final MinecraftServer server = Mockito.mock(MinecraftServer.class);
+        final ServerLevel level = Mockito.mock(ServerLevel.class);
+        Mockito.when(level.getServer()).thenReturn(server);
+
+        Assertions.assertFalse(OwnerDomainExecutor.canRunSynchronousCallbacks(), "Default domain should not allow synchronous callbacks");
+
+        try (OwnerDomainExecutor.Scope ignored = OwnerDomainExecutor.enter(OwnerDomainExecutor.global(server, "test-global"))) {
+            Assertions.assertTrue(OwnerDomainExecutor.canRunSynchronousCallbacks(), "Global domain should allow synchronous callbacks");
+        }
+
+        try (OwnerDomainExecutor.Scope ignored = OwnerDomainExecutor.enter(OwnerDomainExecutor.region(level, 1, 2, 3, 4, "test-region"))) {
+            Assertions.assertTrue(OwnerDomainExecutor.canRunSynchronousCallbacks(), "Region domain should allow synchronous callbacks");
+        }
+
+        final OwnerDomainExecutor.Owner playerOwner = new OwnerDomainExecutor.Owner(
+            OwnerDomainExecutor.Domain.PLAYER,
+            server,
+            level,
+            1,
+            2,
+            1,
+            2,
+            UUID.randomUUID(),
+            null,
+            "test-player"
+        );
+        try (OwnerDomainExecutor.Scope ignored = OwnerDomainExecutor.enter(playerOwner)) {
+            Assertions.assertTrue(OwnerDomainExecutor.canRunSynchronousCallbacks(), "Player domain should allow synchronous callbacks");
+        }
+
+        try (OwnerDomainExecutor.Scope ignored = OwnerDomainExecutor.enter(OwnerDomainExecutor.login(server, "test-login"))) {
+            Assertions.assertFalse(OwnerDomainExecutor.canRunSynchronousCallbacks(), "Login domain should not allow synchronous callbacks");
+        }
+
+        try (OwnerDomainExecutor.Scope ignored = OwnerDomainExecutor.enter(OwnerDomainExecutor.asyncIo(server, "test-async"))) {
+            Assertions.assertFalse(OwnerDomainExecutor.canRunSynchronousCallbacks(), "Async IO domain should not allow synchronous callbacks");
+        }
+    }
+
+    @Test
+    void playerScopeRequiresAndPreservesRegionOwnership() {
+        final MinecraftServer server = Mockito.mock(MinecraftServer.class);
+        final ServerLevel level = Mockito.mock(ServerLevel.class);
+        final ServerPlayer player = Mockito.mock(ServerPlayer.class);
+        final ChunkPos chunk = new ChunkPos(4, 7);
+        Mockito.when(level.getServer()).thenReturn(server);
+        Mockito.when(level.dimension()).thenReturn(Level.OVERWORLD);
+        Mockito.when(player.level()).thenReturn(level);
+        Mockito.when(player.chunkPosition()).thenReturn(chunk);
+        Mockito.when(player.getUUID()).thenReturn(UUID.randomUUID());
+
+        Assertions.assertThrows(
+            IllegalStateException.class,
+            () -> OwnerDomainExecutor.runPlayerNow(player, "test-player-without-region", () -> {
+            })
+        );
+
+        try (OwnerDomainExecutor.Scope ignored = OwnerDomainExecutor.enterRegion(level, 3, 6, 5, 8, "test-player-region")) {
+            OwnerDomainExecutor.runPlayerNow(player, "test-player-with-region", () -> {
+                Assertions.assertEquals(OwnerDomainExecutor.Domain.PLAYER, OwnerDomainExecutor.currentDomain());
+                Assertions.assertTrue(OwnerDomainExecutor.isPlayerOwner(player));
+                Assertions.assertTrue(OwnerDomainExecutor.isRegionOwner(level, chunk.x(), chunk.z()));
+            });
+            Assertions.assertEquals(OwnerDomainExecutor.Domain.REGION, OwnerDomainExecutor.currentDomain());
+        }
+    }
+
+    @Test
+    void runWhenChunksReadyRejectsInvalidBounds() {
+        final ServerLevel level = Mockito.mock(ServerLevel.class);
+
+        final IllegalArgumentException exception = Assertions.assertThrows(
+            IllegalArgumentException.class,
+            () -> OwnershipRouter.runWhenChunksReady(level, 4, 7, 3, 7, Priority.HIGHER, "invalid-bounds", chunks -> {
+            })
+        );
+
+        Assertions.assertTrue(exception.getMessage().contains("Invalid chunk bounds"));
+    }
+
+    @Test
+    void runWhenMoveChunksReadyRejectsNullOperation() {
+        final ServerLevel level = Mockito.mock(ServerLevel.class);
+        final NullPointerException exception = Assertions.assertThrows(
+            NullPointerException.class,
+            () -> OwnershipRouter.runWhenMoveChunksReady(
+                level,
+                new net.minecraft.world.phys.AABB(0.0, 0.0, 0.0, 1.0, 2.0, 1.0),
+                Priority.HIGHER,
+                null,
+                chunks -> {
+                }
+            )
+        );
+
+        Assertions.assertTrue(exception.getMessage().contains("operation"));
+    }
+}
