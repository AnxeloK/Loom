+package io.papermc.paper.plugin.manager.compat;
+
+import io.papermc.paper.plugin.configuration.PluginMeta;
+import java.util.List;
+import java.util.UUID;
+import java.util.logging.Logger;
+import org.bukkit.NamespacedKey;
+import org.bukkit.World;
+import org.bukkit.event.Event;
+import org.bukkit.event.HandlerList;
+import org.bukkit.plugin.Plugin;
+import org.bukkit.plugin.RegisteredListener;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Assertions;
+import org.junit.jupiter.api.Test;
+import org.mockito.Mockito;
+
+@Normal
+class BukkitFacadeRegistryTest {
+
+    @Test
+    void registryInternsByLogicalIdentityAndSupportsOverlayReads() {
+        final Plugin plugin = mockPlugin("FacadePlugin");
+        final CompatibilityTransaction transaction = transactionFor(plugin);
+        final BukkitFacadeRegistry registry = new BukkitFacadeRegistry();
+
+        final UUID worldId = UUID.randomUUID();
+        final World worldA = Mockito.mock(World.class);
+        Mockito.when(worldA.getUID()).thenReturn(worldId);
+        Mockito.when(worldA.getKey()).thenReturn(NamespacedKey.minecraft("overworld"));
+
+        final World worldB = Mockito.mock(World.class);
+        Mockito.when(worldB.getUID()).thenReturn(worldId);
+        Mockito.when(worldB.getKey()).thenReturn(NamespacedKey.minecraft("overworld"));
+
+        final World first = registry.intern(worldA);
+        final World second = registry.intern(worldB);
+        Assertions.assertSame(first, second, "global facade identity should be stable");
+
+        try (CompatibilityRuntimeContext.Scope ignored = CompatibilityRuntimeContext.enter(plugin, transaction, false)) {
+            final World scopedFirst = registry.intern(worldA);
+            final World scopedSecond = registry.intern(worldB);
+            Assertions.assertSame(scopedFirst, scopedSecond, "scope lookup should reuse same facade instance");
+        }
+
+        registry.writeOverlay(transaction, worldA, "spawn", "x:100,z:100", "GLOBAL_CONTROL", "setSpawnLocation");
+        final String overlayValue = registry.readOverlay(transaction, worldB, "spawn", () -> "x:0,z:0");
+        final String liveValue = registry.readOverlay(transaction, worldB, "weather", () -> "clear");
+
+        Assertions.assertEquals("x:100,z:100", overlayValue);
+        Assertions.assertEquals("clear", liveValue);
+    }
+
+    private static CompatibilityTransaction transactionFor(final Plugin plugin) {
+        final DummyEvent event = new DummyEvent();
+        final RegisteredListener[] listeners = new RegisteredListener[0];
+        final EventSemanticIndex.EventSemantics semantics = new EventSemanticIndex().resolve(event, listeners);
+        return new CompatibilityTransaction(event, semantics);
+    }
+
+    private static Plugin mockPlugin(final String name) {
+        final PluginMeta meta = Mockito.mock(PluginMeta.class);
+        Mockito.when(meta.getName()).thenReturn(name);
+        Mockito.when(meta.getMainClass()).thenReturn("com.example." + name);
+        Mockito.when(meta.getPluginDependencies()).thenReturn(List.of());
+        Mockito.when(meta.getPluginSoftDependencies()).thenReturn(List.of());
+        Mockito.when(meta.getVersion()).thenReturn("1.0.0");
+
+        final Plugin plugin = Mockito.mock(Plugin.class);
+        Mockito.when(plugin.getPluginMeta()).thenReturn(meta);
+        Mockito.when(plugin.getLogger()).thenReturn(Logger.getLogger(name));
+        Mockito.when(plugin.isEnabled()).thenReturn(true);
+        return plugin;
+    }
+
+    private static final class DummyEvent extends Event {
+        private static final HandlerList HANDLERS = new HandlerList();
+
+        @Override
+        public HandlerList getHandlers() {
+            return HANDLERS;
+        }
+
+        public static HandlerList getHandlerList() {
+            return HANDLERS;
+        }
+    }
+}
