@@ -0,0 +1,263 @@
+package io.papermc.paper.plugin.manager.compat;
+
+import io.papermc.paper.util.StackWalkerUtil;
+import java.lang.reflect.InvocationHandler;
+import java.lang.reflect.InvocationTargetException;
+import java.lang.reflect.Method;
+import java.lang.reflect.Proxy;
+import java.util.Collection;
+import java.util.Collections;
+import java.util.IdentityHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.CompletionException;
+import net.minecraft.server.threading.runtime.OwnerDomainExecutor;
+import org.bukkit.plugin.Plugin;
+import org.bukkit.plugin.RegisteredServiceProvider;
+import org.bukkit.plugin.ServicePriority;
+import org.bukkit.plugin.ServicesManager;
+import org.bukkit.plugin.SimpleServicesManager;
+import org.jetbrains.annotations.NotNull;
+import org.jetbrains.annotations.Nullable;
+
+public final class CompatibilityServicesManager implements ServicesManager {
+
+    private final SimpleServicesManager delegate = new SimpleServicesManager();
+    private final CompatibilityKernel compatibilityKernel;
+    private final CompatibilityServiceCallGraph callGraph = new CompatibilityServiceCallGraph();
+
+    private final Map<Object, Object> wrappedProviders = Collections.synchronizedMap(new IdentityHashMap<>());
+
+    public CompatibilityServicesManager(final CompatibilityKernel compatibilityKernel) {
+        this.compatibilityKernel = compatibilityKernel;
+    }
+
+    @Override
+    public <T> void register(
+        final @NotNull Class<T> service,
+        final @NotNull T provider,
+        final @NotNull Plugin plugin,
+        final @NotNull ServicePriority priority
+    ) {
+        final T wrapped = this.wrapProvider(service, provider, plugin);
+        if (wrapped != provider) {
+            this.wrappedProviders.put(provider, wrapped);
+        }
+        this.delegate.register(service, wrapped, plugin, priority);
+    }
+
+    @Override
+    public void unregisterAll(final @NotNull Plugin plugin) {
+        this.delegate.unregisterAll(plugin);
+        synchronized (this.wrappedProviders) {
+            this.wrappedProviders.entrySet().removeIf(entry -> {
+                final Object wrapped = entry.getValue();
+                if (wrapped == null || !Proxy.isProxyClass(wrapped.getClass())) {
+                    return false;
+                }
+                final InvocationHandler invocationHandler = Proxy.getInvocationHandler(wrapped);
+                return invocationHandler instanceof ServiceProxyHandler proxyHandler && proxyHandler.providerPlugin.equals(plugin);
+            });
+        }
+    }
+
+    @Override
+    public void unregister(final @NotNull Class<?> service, final @NotNull Object provider) {
+        final Object registeredProvider = this.resolveRegisteredProvider(provider);
+        this.delegate.unregister(service, registeredProvider);
+        this.wrappedProviders.remove(provider);
+    }
+
+    @Override
+    public void unregister(final @NotNull Object provider) {
+        final Object registeredProvider = this.resolveRegisteredProvider(provider);
+        this.delegate.unregister(registeredProvider);
+        this.wrappedProviders.remove(provider);
+    }
+
+    @Override
+    public <T> @Nullable T load(final @NotNull Class<T> service) {
+        return this.delegate.load(service);
+    }
+
+    @Override
+    public <T> @Nullable RegisteredServiceProvider<T> getRegistration(final @NotNull Class<T> service) {
+        return this.delegate.getRegistration(service);
+    }
+
+    @Override
+    public @NotNull List<RegisteredServiceProvider<?>> getRegistrations(final @NotNull Plugin plugin) {
+        return this.delegate.getRegistrations(plugin);
+    }
+
+    @Override
+    public <T> @NotNull Collection<RegisteredServiceProvider<T>> getRegistrations(final @NotNull Class<T> service) {
+        return this.delegate.getRegistrations(service);
+    }
+
+    @Override
+    public @NotNull Collection<Class<?>> getKnownServices() {
+        return this.delegate.getKnownServices();
+    }
+
+    @Override
+    public <T> boolean isProvidedFor(final @NotNull Class<T> service) {
+        return this.delegate.isProvidedFor(service);
+    }
+
+    private Object resolveRegisteredProvider(final Object provider) {
+        final Object wrapped = this.wrappedProviders.get(provider);
+        if (wrapped != null) {
+            return wrapped;
+        }
+        return provider;
+    }
+
+    @SuppressWarnings("unchecked")
+    private <T> T wrapProvider(final Class<T> service, final T provider, final Plugin providerPlugin) {
+        if (!service.isInterface()) {
+            return provider;
+        }
+        if (Proxy.isProxyClass(provider.getClass()) && Proxy.getInvocationHandler(provider) instanceof ServiceProxyHandler) {
+            return provider;
+        }
+
+        final InvocationHandler invocationHandler = new ServiceProxyHandler(service, provider, providerPlugin);
+        final ClassLoader classLoader = provider.getClass().getClassLoader() == null ? service.getClassLoader() : provider.getClass().getClassLoader();
+        return (T)Proxy.newProxyInstance(classLoader, new Class<?>[] {service}, invocationHandler);
+    }
+
+    private final class ServiceProxyHandler implements InvocationHandler {
+
+        private final Class<?> service;
+        private final Object provider;
+        private final Plugin providerPlugin;
+
+        private ServiceProxyHandler(final Class<?> service, final Object provider, final Plugin providerPlugin) {
+            this.service = service;
+            this.provider = provider;
+            this.providerPlugin = providerPlugin;
+        }
+
+        @Override
+        public Object invoke(final Object proxy, final Method method, final Object[] args) throws Throwable {
+            if (method.getDeclaringClass() == Object.class) {
+                return method.invoke(this.provider, args);
+            }
+
+            final Plugin callerPlugin = resolveCallerPlugin();
+            final String callerName = callerPlugin == null ? "<unknown>" : callerPlugin.getPluginMeta().getName();
+            final String providerName = this.providerPlugin.getPluginMeta().getName();
+
+            final CompatibilityServiceCallGraph.EnterResult graphEntry = callGraph.enter(
+                callerName,
+                providerName,
+                this.service.getName(),
+                method.getName()
+            );
+            final String path = "service:" + this.service.getSimpleName() + "#" + method.getName();
+
+            final PluginCompatibilityProfile profile = compatibilityKernel.profileFor(this.providerPlugin);
+            if (graphEntry.cycleDetected()) {
+                compatibilityKernel.diagnostics().recordRefusal(profile, "service cycle " + graphEntry.cyclePath());
+                callGraph.exit();
+                throw new IllegalStateException("Compatibility service cycle detected: " + graphEntry.cyclePath());
+            }
+
+            try {
+                final long transactionId = currentTransactionId();
+                try (CompatibilityApartment.Scope scope = compatibilityKernel.apartmentFor(this.providerPlugin).enter(transactionId, false, path)) {
+                    if (scope.acquired()) {
+                        return invokeProvider(method, args);
+                    }
+
+                    profile.noteApartmentContention(
+                        "service contention " + this.service.getSimpleName() + "#" + method.getName()
+                    );
+                    compatibilityKernel.diagnostics().recordStrictFallback(
+                        profile,
+                        "service apartment busy " + this.service.getSimpleName() + "#" + method.getName() + " owner=" + scope.busyLease()
+                    );
+
+                    if (OwnerDomainExecutor.canRunSynchronousCallbacks()) {
+                        compatibilityKernel.diagnostics().recordOwnerDomainWaitViolation(
+                            profile,
+                            path,
+                            "owner-domain wait blocked"
+                        );
+                        throw new IllegalStateException(
+                            "Service call cannot block in owner domain: " + this.service.getSimpleName() + "#" + method.getName()
+                        );
+                    }
+
+                    final long start = System.nanoTime();
+                    try {
+                        return compatibilityKernel.apartmentFor(this.providerPlugin)
+                            .submitStrictFallback(() -> {
+                                try (CompatibilityApartment.Scope fallbackScope = compatibilityKernel.apartmentFor(this.providerPlugin)
+                                    .enter(transactionId, true, path)) {
+                                    if (!fallbackScope.acquired()) {
+                                        throw new IllegalStateException(
+                                            "Strict fallback apartment handoff failed for service "
+                                                + this.service.getSimpleName()
+                                                + "#"
+                                                + method.getName()
+                                        );
+                                    }
+                                    try {
+                                        return invokeProvider(method, args);
+                                    } catch (final Throwable throwable) {
+                                        if (throwable instanceof Exception exception) {
+                                            throw exception;
+                                        }
+                                        throw new RuntimeException(throwable);
+                                    }
+                                }
+                            })
+                            .join();
+                    } catch (final CompletionException completionException) {
+                        throw unwrapCompletionException(completionException);
+                    } finally {
+                        compatibilityKernel.diagnostics().recordOwnerRpcWait(
+                            profile,
+                            "service-handoff:" + this.service.getSimpleName() + "#" + method.getName(),
+                            System.nanoTime() - start
+                        );
+                    }
+                }
+            } finally {
+                callGraph.exit();
+            }
+        }
+
+        private long currentTransactionId() {
+            final long contextTransactionId = CompatibilityRuntimeContext.currentTransactionId();
+            if (contextTransactionId >= 0L) {
+                return contextTransactionId;
+            }
+            return CompatibilityRuntimeContext.syntheticTransactionId();
+        }
+
+        private Object invokeProvider(final Method method, final Object[] args) throws Throwable {
+            try {
+                return method.invoke(this.provider, args);
+            } catch (final InvocationTargetException invocationTargetException) {
+                final Throwable cause = invocationTargetException.getCause();
+                throw cause == null ? invocationTargetException : cause;
+            }
+        }
+
+        private static Plugin resolveCallerPlugin() {
+            final Plugin current = CompatibilityRuntimeContext.currentPlugin();
+            if (current != null) {
+                return current;
+            }
+            return StackWalkerUtil.getFirstPluginCaller();
+        }
+
+        private static Throwable unwrapCompletionException(final CompletionException completionException) {
+            final Throwable cause = completionException.getCause();
+            return cause == null ? completionException : cause;
+        }
+    }
+}
