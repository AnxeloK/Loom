+import org.bukkit.plugin.Plugin;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Assertions;
+import org.junit.jupiter.api.Test;
+import org.mockito.Mockito;
+import org.objectweb.asm.ClassReader;
+import org.objectweb.asm.ClassWriter;
+import org.objectweb.asm.MethodVisitor;
+import org.objectweb.asm.Opcodes;
+import org.objectweb.asm.tree.AbstractInsnNode;
+import org.objectweb.asm.tree.ClassNode;
+import org.objectweb.asm.tree.MethodInsnNode;
+import org.objectweb.asm.tree.MethodNode;
+
+@Normal
+class PaperClassloaderBytecodeModifierTest {
+
+    @Test
+    void modifierRewritesSchedulerCallsAndInjectsBlockingWaitGuard() {
+        final byte[] original = samplePluginClass();
+        final PluginMeta meta = mockMeta("BytecodePlugin", "com.example.BytecodePlugin");
+
+        final byte[] modified = new PaperClassloaderBytecodeModifier().modify(meta, original);
+
+        final ClassNode node = new ClassNode();
+        new ClassReader(modified).accept(node, 0);
+
+        boolean sawSchedulerBridge = false;
+        boolean sawBlockingGuard = false;
+        boolean sawOriginalSchedulerInvoke = false;
+
+        for (final MethodNode method : node.methods) {
+            for (AbstractInsnNode instruction = method.instructions.getFirst(); instruction != null; instruction = instruction.getNext()) {
+                if (instruction instanceof MethodInsnNode call) {
+                    if (call.owner.equals("io/papermc/paper/plugin/manager/compat/CompatibilitySchedulerBridge")
+                        && call.name.equals("runTaskAsynchronously")) {
+                        sawSchedulerBridge = true;
+                    }
+                    if (call.owner.equals("io/papermc/paper/plugin/manager/compat/CompatibilityBytecodeBridge")
+                        && call.name.equals("beforeBlockingWait")) {
+                        sawBlockingGuard = true;
+                    }
+                    if (call.owner.equals("org/bukkit/scheduler/BukkitScheduler")
+                        && call.name.equals("runTaskAsynchronously")) {
+                        sawOriginalSchedulerInvoke = true;
+                    }
+                }
+            }
+        }
+
+        Assertions.assertTrue(sawSchedulerBridge, "Expected scheduler bridge rewrite");
+        Assertions.assertTrue(sawBlockingGuard, "Expected blocking wait guard injection");
+        Assertions.assertFalse(sawOriginalSchedulerInvoke, "Expected original scheduler call to be replaced");
+    }
+
+    @Test
+    void staticHintsEscalateProfileToInternalMode() {
+        PluginCompatibilityProfile.recordStaticInternalHint("HintedPlugin", "owner:nms");
+
+        final PluginMeta meta = mockMeta("HintedPlugin", "com.example.HintedPlugin");
+        final Plugin plugin = Mockito.mock(Plugin.class);
+        Mockito.when(plugin.getPluginMeta()).thenReturn(meta);
+
+        final PluginCompatibilityProfile profile = new PluginCompatibilityProfile(plugin);
+        Assertions.assertEquals(PluginCompatibilityProfile.Mode.LEGACY_INTERNAL, profile.mode());
+        Assertions.assertFalse(profile.snapshot().escalations().isEmpty());
+    }
+
+    private static byte[] samplePluginClass() {
+        final ClassWriter writer = new ClassWriter(0);
+        writer.visit(Opcodes.V17, Opcodes.ACC_PUBLIC, "com/example/TestPluginClass", null, "java/lang/Object", null);
+
+        MethodVisitor method = writer.visitMethod(Opcodes.ACC_PUBLIC, "<init>", "()V", null, null);
+        method.visitCode();
+        method.visitVarInsn(Opcodes.ALOAD, 0);
+        method.visitMethodInsn(Opcodes.INVOKESPECIAL, "java/lang/Object", "<init>", "()V", false);
+        method.visitInsn(Opcodes.RETURN);
+        method.visitMaxs(1, 1);
+        method.visitEnd();
+
+        method = writer.visitMethod(
+            Opcodes.ACC_PUBLIC,
+            "run",
+            "(Lorg/bukkit/scheduler/BukkitScheduler;Lorg/bukkit/plugin/Plugin;Ljava/lang/Runnable;Ljava/util/concurrent/CompletableFuture;)V",
+            null,
+            null
+        );
+        method.visitCode();
+        method.visitVarInsn(Opcodes.ALOAD, 1);
+        method.visitVarInsn(Opcodes.ALOAD, 2);
+        method.visitVarInsn(Opcodes.ALOAD, 3);
+        method.visitMethodInsn(
+            Opcodes.INVOKEINTERFACE,
+            "org/bukkit/scheduler/BukkitScheduler",
+            "runTaskAsynchronously",
+            "(Lorg/bukkit/plugin/Plugin;Ljava/lang/Runnable;)Lorg/bukkit/scheduler/BukkitTask;",
+            true
+        );
+        method.visitInsn(Opcodes.POP);
+
+        method.visitVarInsn(Opcodes.ALOAD, 4);
+        method.visitMethodInsn(
+            Opcodes.INVOKEVIRTUAL,
+            "java/util/concurrent/CompletableFuture",
+            "join",
+            "()Ljava/lang/Object;",
+            false
+        );
+        method.visitInsn(Opcodes.POP);
+        method.visitInsn(Opcodes.RETURN);
+        method.visitMaxs(3, 5);
+        method.visitEnd();
+
+        writer.visitEnd();
+        return writer.toByteArray();
+    }
+
+    private static PluginMeta mockMeta(final String name, final String mainClass) {
+        final PluginMeta meta = Mockito.mock(PluginMeta.class);
+        Mockito.when(meta.getName()).thenReturn(name);
+        Mockito.when(meta.getMainClass()).thenReturn(mainClass);
+        Mockito.when(meta.getPluginDependencies()).thenReturn(List.of());
+        Mockito.when(meta.getPluginSoftDependencies()).thenReturn(List.of());
+        Mockito.when(meta.getVersion()).thenReturn("1.0.0");
+        return meta;
+    }
+}
