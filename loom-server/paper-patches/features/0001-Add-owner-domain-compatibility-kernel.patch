@@ -0,0 +1,72 @@
+package io.papermc.paper.plugin.manager.compat;
+
+import com.mojang.logging.LogUtils;
+import io.papermc.paper.util.StackWalkerUtil;
+import net.minecraft.server.threading.runtime.OwnerDomainExecutor;
+import org.bukkit.plugin.Plugin;
+import org.slf4j.Logger;
+
+public final class CompatibilityBytecodeBridge {
+
+    private static final Logger LOGGER = LogUtils.getLogger();
+
+    private CompatibilityBytecodeBridge() {
+    }
+
+    public static void noteStaticInternalHint(final String pluginName, final String className, final String hint) {
+        PluginCompatibilityProfile.recordStaticInternalHint(pluginName, hint + " @" + className);
+    }
+
+    public static void beforeUnsafeInvoke(
+        final String className,
+        final String methodName,
+        final String owner,
+        final String targetName,
+        final String descriptor
+    ) {
+        final Plugin plugin = currentPlugin();
+        if (plugin == null) {
+            LOGGER.debug("[loom.compat] unsafe bytecode call {}#{} -> {}#{}{}", className, methodName, owner, targetName, descriptor);
+            return;
+        }
+
+        final CompatibilityDiagnostics diagnostics = CompatibilityDiagnostics.global();
+        final PluginCompatibilityProfile profile = diagnostics.profileFor(plugin);
+        diagnostics.recordUnsafeInternalAccess(
+            profile,
+            "bytecode-call " + className + "#" + methodName + " -> " + owner + "#" + targetName + descriptor
+        );
+    }
+
+    public static void beforeBlockingWait(
+        final String className,
+        final String methodName,
+        final String owner,
+        final String targetName,
+        final String descriptor
+    ) {
+        final Plugin plugin = currentPlugin();
+        if (plugin != null) {
+            final CompatibilityDiagnostics diagnostics = CompatibilityDiagnostics.global();
+            final PluginCompatibilityProfile profile = diagnostics.profileFor(plugin);
+            diagnostics.recordOwnerDomainWaitViolation(
+                profile,
+                "bytecode-wait " + className + "#" + methodName + " -> " + owner + "#" + targetName + descriptor
+            );
+        }
+
+        if (OwnerDomainExecutor.canRunSynchronousCallbacks()) {
+            throw new IllegalStateException(
+                "Blocking wait detected in owner domain from " + className + "#" + methodName + " -> " + owner + "#" + targetName + descriptor
+            );
+        }
+    }
+
+    private static Plugin currentPlugin() {
+        final Plugin contextPlugin = CompatibilityRuntimeContext.currentPlugin();
+        if (contextPlugin != null) {
+            return contextPlugin;
+        }
+        return StackWalkerUtil.getFirstPluginCaller();
+    }
+}
