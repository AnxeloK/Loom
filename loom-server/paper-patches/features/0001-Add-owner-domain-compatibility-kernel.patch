From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: anxelok <anxelok@localhost>
Date: Sun, 31 May 2026 13:58:45 +0000
Subject: [PATCH] Add owner-domain compatibility kernel

Route Paper APIs and plugin events through explicit owner domains while preserving supported synchronous contracts and recording unsafe paths.

diff --git a/src/main/java/ca/spottedleaf/moonrise/common/util/MoonriseCommon.java b/src/main/java/ca/spottedleaf/moonrise/common/util/MoonriseCommon.java
index b9f788693b0c4be48e8a923a3dec50555d135e7e..5b8bd9184e4b5a98dc2e7f874a3fa3fec978c231 100644
--- a/src/main/java/ca/spottedleaf/moonrise/common/util/MoonriseCommon.java
+++ b/src/main/java/ca/spottedleaf/moonrise/common/util/MoonriseCommon.java
@@ -62,6 +62,21 @@ public final class MoonriseCommon {
         LOGGER.info(PlatformHooks.get().getBrand() + " is using " + workerThreads + " worker threads, " + ioThreads + " I/O threads");
     }
 
+    public static void applyLoomWorkerDefaults(final int configWorkerThreads, final int configIoThreads) {
+        final String workerThreadProperty = PlatformHooks.get().getBrand() + ".WorkerThreadCount";
+        if (configWorkerThreads > 0 || System.getProperty(workerThreadProperty) != null) {
+            return;
+        }
+
+        final int workerThreads = loomWorkerThreads(OSNuma.getNativeInstance().getTotalCores());
+        adjustWorkerThreads(workerThreads, configIoThreads);
+        LOGGER.info("Loom set the implicit chunk worker default to " + workerThreads + " threads");
+    }
+
+    static int loomWorkerThreads(final int totalCores) {
+        return Math.max(1, Math.min(3, totalCores / 4));
+    }
+
     public static final long IO_QUEUE_HOLD_TIME = (long)(25.0e6); // 25ms
     public static final BalancedPrioritisedThreadPool IO_POOL = new BalancedPrioritisedThreadPool(
         IO_QUEUE_HOLD_TIME,
diff --git a/src/main/java/ca/spottedleaf/moonrise/common/util/TickThread.java b/src/main/java/ca/spottedleaf/moonrise/common/util/TickThread.java
index 071e2191bab8fd9de1fc4fb5fa2472f8315adaff..2c36922658ff18555c4f3dcbbf027501b49a7435 100644
--- a/src/main/java/ca/spottedleaf/moonrise/common/util/TickThread.java
+++ b/src/main/java/ca/spottedleaf/moonrise/common/util/TickThread.java
@@ -135,51 +135,85 @@ public class TickThread extends Thread {
         return false;
     }
 
+    // Loom start - region-aware tick-thread ownership checks
+    // Worlds and intra-world regions tick in parallel, so a tick thread is only valid for the world/region it
+    // actually owns; cross-world or cross-region access off the owning thread is detected as a loud throw
+    // instead of silently corrupting another region's state. The position-aware overloads check CHUNK
+    // ownership (region granularity); the level-only overload checks the world. The global owner (main thread)
+    // is always accepted.
+    private static boolean ownsLevel(final Level world) {
+        if (!(world instanceof final net.minecraft.server.level.ServerLevel level)) {
+            return true;
+        }
+        return net.minecraft.server.threading.runtime.OwnerDomainExecutor.isGlobalOwner(level.getServer())
+            || net.minecraft.server.threading.runtime.OwnerDomainExecutor.isCurrentRegionOwnerForLevel(level);
+    }
+
+    private static boolean ownsChunk(final Level world, final int chunkX, final int chunkZ) {
+        if (!(world instanceof final net.minecraft.server.level.ServerLevel level)) {
+            return true;
+        }
+        return net.minecraft.server.threading.runtime.OwnerDomainExecutor.isGlobalOwner(level.getServer())
+            || net.minecraft.server.threading.TickRegions.isCurrentThreadOwnerQuiet(level, chunkX, chunkZ);
+    }
+
+    private static boolean isTickThreadForLevel(final Level world) {
+        return isTickThread() && ownsLevel(world);
+    }
+
+    private static boolean isTickThreadForChunk(final Level world, final int chunkX, final int chunkZ) {
+        return isTickThread() && ownsChunk(world, chunkX, chunkZ);
+    }
+
     public static boolean isTickThreadFor(final Level world, final BlockPos pos) {
-        return isTickThread();
+        return isTickThreadForChunk(world, pos.getX() >> 4, pos.getZ() >> 4);
     }
 
     public static boolean isTickThreadFor(final Level world) {
-        return isTickThread();
+        return isTickThreadForLevel(world);
     }
 
     public static boolean isTickThreadFor(final Level world, final BlockPos pos, final int blockRadius) {
-        return isTickThread();
+        return isTickThreadForChunk(world, pos.getX() >> 4, pos.getZ() >> 4);
     }
 
     public static boolean isTickThreadFor(final Level world, final ChunkPos pos) {
-        return isTickThread();
+        return isTickThreadForChunk(world, pos.x(), pos.z());
     }
 
     public static boolean isTickThreadFor(final Level world, final Vec3 pos) {
-        return isTickThread();
+        return isTickThreadForChunk(world, net.minecraft.util.Mth.floor(pos.x) >> 4, net.minecraft.util.Mth.floor(pos.z) >> 4);
     }
 
     public static boolean isTickThreadFor(final Level world, final int chunkX, final int chunkZ) {
-        return isTickThread();
+        return isTickThreadForChunk(world, chunkX, chunkZ);
     }
 
     public static boolean isTickThreadFor(final Level world, final AABB aabb) {
-        return isTickThread();
+        return isTickThreadForChunk(world, net.minecraft.util.Mth.floor((aabb.minX + aabb.maxX) * 0.5D) >> 4, net.minecraft.util.Mth.floor((aabb.minZ + aabb.maxZ) * 0.5D) >> 4);
     }
 
     public static boolean isTickThreadFor(final Level world, final double blockX, final double blockZ) {
-        return isTickThread();
+        return isTickThreadForChunk(world, net.minecraft.util.Mth.floor(blockX) >> 4, net.minecraft.util.Mth.floor(blockZ) >> 4);
     }
 
     public static boolean isTickThreadFor(final Level world, final Vec3 position, final Vec3 deltaMovement, final int buffer) {
-        return isTickThread();
+        return isTickThreadForChunk(world, net.minecraft.util.Mth.floor(position.x) >> 4, net.minecraft.util.Mth.floor(position.z) >> 4);
     }
 
     public static boolean isTickThreadFor(final Level world, final int fromChunkX, final int fromChunkZ, final int toChunkX, final int toChunkZ) {
-        return isTickThread();
+        return isTickThreadForChunk(world, fromChunkX, fromChunkZ);
     }
 
     public static boolean isTickThreadFor(final Level world, final int chunkX, final int chunkZ, final int radius) {
-        return isTickThread();
+        return isTickThreadForChunk(world, chunkX, chunkZ);
     }
 
     public static boolean isTickThreadFor(final Entity entity) {
-        return isTickThread();
+        if (!isTickThread()) {
+            return false;
+        }
+        return ownsChunk(entity.level(), net.minecraft.util.Mth.floor(entity.getX()) >> 4, net.minecraft.util.Mth.floor(entity.getZ()) >> 4);
     }
+    // Loom end
 }
diff --git a/src/main/java/io/papermc/paper/configuration/LoomConfiguration.java b/src/main/java/io/papermc/paper/configuration/LoomConfiguration.java
new file mode 100644
index 0000000000000000000000000000000000000000..08c7b5e38f200b2bf0503e22d1897665425c8962
--- /dev/null
+++ b/src/main/java/io/papermc/paper/configuration/LoomConfiguration.java
@@ -0,0 +1,42 @@
+package io.papermc.paper.configuration;
+
+import com.mojang.logging.LogUtils;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import org.slf4j.Logger;
+
+public final class LoomConfiguration {
+
+    private static final Logger LOGGER = LogUtils.getLogger();
+    private static final String DEPRECATED_LOOM_CONFIG_FILE = "loom.yml";
+    private static volatile boolean startupLogged;
+
+    private LoomConfiguration() {
+    }
+
+    public static synchronized void initialize(final Path configDirectory) {
+        final Path directory = configDirectory == null ? Path.of(PaperConfigurations.CONFIG_DIR) : configDirectory;
+        final Path deprecatedConfigFile = directory.resolve(DEPRECATED_LOOM_CONFIG_FILE);
+
+        if (Files.exists(deprecatedConfigFile)) {
+            LOGGER.warn("Ignoring deprecated Loom runtime config at {}; Loom now runs a single path.", deprecatedConfigFile.toAbsolutePath());
+        }
+
+        applyRuntimeDefaults();
+        if (!startupLogged) {
+            LOGGER.info("Loom runtime modes have been removed. This is now just Loom.");
+            startupLogged = true;
+        }
+    }
+
+    private static void applyRuntimeDefaults() {
+        final GlobalConfiguration globalConfiguration = GlobalConfiguration.get();
+        if (globalConfiguration == null || globalConfiguration.chunkSystem == null) {
+            return;
+        }
+        ca.spottedleaf.moonrise.common.util.MoonriseCommon.applyLoomWorkerDefaults(
+            globalConfiguration.chunkSystem.workerThreads,
+            globalConfiguration.chunkSystem.ioThreads
+        );
+    }
+}
diff --git a/src/main/java/io/papermc/paper/plugin/entrypoint/classloader/PaperClassloaderBytecodeModifier.java b/src/main/java/io/papermc/paper/plugin/entrypoint/classloader/PaperClassloaderBytecodeModifier.java
index f9a2c55a354c877749db3f92956de802ae575788..10da4667a66266525a63282912b7510692df7172 100644
--- a/src/main/java/io/papermc/paper/plugin/entrypoint/classloader/PaperClassloaderBytecodeModifier.java
+++ b/src/main/java/io/papermc/paper/plugin/entrypoint/classloader/PaperClassloaderBytecodeModifier.java
@@ -1,12 +1,196 @@
 package io.papermc.paper.plugin.entrypoint.classloader;
 
 import io.papermc.paper.plugin.configuration.PluginMeta;
+import io.papermc.paper.plugin.manager.compat.CompatibilityBytecodeBridge;
+import java.util.LinkedHashSet;
+import java.util.Set;
+import org.objectweb.asm.ClassReader;
+import org.objectweb.asm.ClassVisitor;
+import org.objectweb.asm.ClassWriter;
+import org.objectweb.asm.MethodVisitor;
+import org.objectweb.asm.Opcodes;
 
-// Stub, implement in future.
 public class PaperClassloaderBytecodeModifier implements ClassloaderBytecodeModifier {
 
+    private static final String BYTECODE_BRIDGE = "io/papermc/paper/plugin/manager/compat/CompatibilityBytecodeBridge";
+    private static final String SCHEDULER_BRIDGE = "io/papermc/paper/plugin/manager/compat/CompatibilitySchedulerBridge";
+
     @Override
-    public byte[] modify(PluginMeta configuration, byte[] bytecode) {
-        return bytecode;
+    public byte[] modify(final PluginMeta configuration, final byte[] bytecode) {
+        final String pluginName = configuration.getName() == null ? "<unknown>" : configuration.getName();
+        final Set<String> staticHints = new LinkedHashSet<>();
+
+        final ClassReader reader = new ClassReader(bytecode);
+        final ClassWriter writer = new ClassWriter(reader, ClassWriter.COMPUTE_MAXS);
+
+        final ClassVisitor visitor = new ClassVisitor(Opcodes.ASM9, writer) {
+            private String className = "<unknown>";
+
+            @Override
+            public void visit(
+                final int version,
+                final int access,
+                final String name,
+                final String signature,
+                final String superName,
+                final String[] interfaces
+            ) {
+                this.className = name;
+                super.visit(version, access, name, signature, superName, interfaces);
+            }
+
+            @Override
+            public MethodVisitor visitMethod(
+                final int access,
+                final String name,
+                final String descriptor,
+                final String signature,
+                final String[] exceptions
+            ) {
+                final MethodVisitor parent = super.visitMethod(access, name, descriptor, signature, exceptions);
+                return new MethodVisitor(Opcodes.ASM9, parent) {
+                    @Override
+                    public void visitLdcInsn(final Object value) {
+                        if (value instanceof String stringValue) {
+                            collectStringHint(staticHints, stringValue);
+                        }
+                        super.visitLdcInsn(value);
+                    }
+
+                    @Override
+                    public void visitMethodInsn(
+                        final int opcode,
+                        final String owner,
+                        final String targetName,
+                        final String targetDescriptor,
+                        final boolean isInterface
+                    ) {
+                        collectOwnerHint(staticHints, owner, targetName);
+
+                        if (isBlockingWait(owner, targetName, targetDescriptor)) {
+                            this.visitLdcInsn(className);
+                            this.visitLdcInsn(name);
+                            this.visitLdcInsn(owner);
+                            this.visitLdcInsn(targetName);
+                            this.visitLdcInsn(targetDescriptor);
+                            super.visitMethodInsn(
+                                Opcodes.INVOKESTATIC,
+                                BYTECODE_BRIDGE,
+                                "beforeBlockingWait",
+                                "(Ljava/lang/String;Ljava/lang/String;Ljava/lang/String;Ljava/lang/String;Ljava/lang/String;)V",
+                                false
+                            );
+                        }
+
+                        if (isUnsafeInvocation(owner, targetName)) {
+                            this.visitLdcInsn(className);
+                            this.visitLdcInsn(name);
+                            this.visitLdcInsn(owner);
+                            this.visitLdcInsn(targetName);
+                            this.visitLdcInsn(targetDescriptor);
+                            super.visitMethodInsn(
+                                Opcodes.INVOKESTATIC,
+                                BYTECODE_BRIDGE,
+                                "beforeUnsafeInvoke",
+                                "(Ljava/lang/String;Ljava/lang/String;Ljava/lang/String;Ljava/lang/String;Ljava/lang/String;)V",
+                                false
+                            );
+                        }
+
+                        final SchedulerRewrite rewrite = rewriteSchedulerCall(opcode, owner, targetName, targetDescriptor);
+                        if (rewrite != null) {
+                            super.visitMethodInsn(Opcodes.INVOKESTATIC, SCHEDULER_BRIDGE, rewrite.method(), rewrite.descriptor(), false);
+                            return;
+                        }
+
+                        super.visitMethodInsn(opcode, owner, targetName, targetDescriptor, isInterface);
+                    }
+                };
+            }
+        };
+
+        reader.accept(visitor, 0);
+
+        for (final String hint : staticHints) {
+            CompatibilityBytecodeBridge.noteStaticInternalHint(pluginName, reader.getClassName(), hint);
+        }
+
+        return writer.toByteArray();
+    }
+
+    private static void collectStringHint(final Set<String> hints, final String literal) {
+        final String lowered = literal.toLowerCase(java.util.Locale.ROOT);
+        if (lowered.contains("net.minecraft")) {
+            hints.add("literal:nms");
+        } else if (lowered.contains("org.bukkit.craftbukkit")) {
+            hints.add("literal:craftbukkit");
+        } else if (lowered.contains("gethandle")) {
+            hints.add("literal:getHandle");
+        } else if (lowered.contains("java.lang.reflect")) {
+            hints.add("literal:reflection");
+        }
+    }
+
+    private static void collectOwnerHint(final Set<String> hints, final String owner, final String methodName) {
+        if (owner.startsWith("net/minecraft/")) {
+            hints.add("owner:nms");
+        } else if (owner.startsWith("org/bukkit/craftbukkit/")) {
+            hints.add("owner:craftbukkit");
+        } else if (owner.startsWith("java/lang/reflect/") || owner.startsWith("java/lang/invoke/")) {
+            hints.add("owner:reflection");
+        }
+        if ("getHandle".equals(methodName)) {
+            hints.add("method:getHandle");
+        }
+    }
+
+    private static boolean isUnsafeInvocation(final String owner, final String methodName) {
+        return owner.startsWith("net/minecraft/")
+            || owner.startsWith("org/bukkit/craftbukkit/")
+            || owner.startsWith("java/lang/reflect/")
+            || owner.startsWith("java/lang/invoke/")
+            || "getHandle".equals(methodName);
+    }
+
+    private static boolean isBlockingWait(final String owner, final String methodName, final String descriptor) {
+        return (owner.equals("java/util/concurrent/CompletableFuture") && (methodName.equals("join") || methodName.equals("get")))
+            || (owner.equals("java/util/concurrent/Future") && methodName.equals("get"))
+            || (owner.equals("java/lang/Thread") && (methodName.equals("join") || methodName.equals("sleep")))
+            || (owner.equals("java/lang/Object") && methodName.equals("wait"))
+            || (owner.equals("java/util/concurrent/CountDownLatch") && methodName.equals("await"))
+            || (owner.equals("java/util/concurrent/locks/LockSupport") && methodName.equals("park"))
+            || (owner.equals("java/util/concurrent/locks/LockSupport") && methodName.equals("parkNanos"))
+            || (owner.equals("java/util/concurrent/locks/LockSupport") && methodName.equals("parkUntil"))
+            || (owner.equals("java/util/concurrent/CompletableFuture") && methodName.equals("get") && descriptor.startsWith("("));
+    }
+
+    private static SchedulerRewrite rewriteSchedulerCall(
+        final int opcode,
+        final String owner,
+        final String methodName,
+        final String descriptor
+    ) {
+        if (opcode != Opcodes.INVOKEINTERFACE || !"org/bukkit/scheduler/BukkitScheduler".equals(owner)) {
+            return null;
+        }
+
+        return switch (methodName + descriptor) {
+            case "runTask(Lorg/bukkit/plugin/Plugin;Ljava/lang/Runnable;)Lorg/bukkit/scheduler/BukkitTask;" ->
+                new SchedulerRewrite("runTask", "(Lorg/bukkit/scheduler/BukkitScheduler;Lorg/bukkit/plugin/Plugin;Ljava/lang/Runnable;)Lorg/bukkit/scheduler/BukkitTask;");
+            case "runTaskLater(Lorg/bukkit/plugin/Plugin;Ljava/lang/Runnable;J)Lorg/bukkit/scheduler/BukkitTask;" ->
+                new SchedulerRewrite("runTaskLater", "(Lorg/bukkit/scheduler/BukkitScheduler;Lorg/bukkit/plugin/Plugin;Ljava/lang/Runnable;J)Lorg/bukkit/scheduler/BukkitTask;");
+            case "runTaskTimer(Lorg/bukkit/plugin/Plugin;Ljava/lang/Runnable;JJ)Lorg/bukkit/scheduler/BukkitTask;" ->
+                new SchedulerRewrite("runTaskTimer", "(Lorg/bukkit/scheduler/BukkitScheduler;Lorg/bukkit/plugin/Plugin;Ljava/lang/Runnable;JJ)Lorg/bukkit/scheduler/BukkitTask;");
+            case "runTaskAsynchronously(Lorg/bukkit/plugin/Plugin;Ljava/lang/Runnable;)Lorg/bukkit/scheduler/BukkitTask;" ->
+                new SchedulerRewrite("runTaskAsynchronously", "(Lorg/bukkit/scheduler/BukkitScheduler;Lorg/bukkit/plugin/Plugin;Ljava/lang/Runnable;)Lorg/bukkit/scheduler/BukkitTask;");
+            case "runTaskLaterAsynchronously(Lorg/bukkit/plugin/Plugin;Ljava/lang/Runnable;J)Lorg/bukkit/scheduler/BukkitTask;" ->
+                new SchedulerRewrite("runTaskLaterAsynchronously", "(Lorg/bukkit/scheduler/BukkitScheduler;Lorg/bukkit/plugin/Plugin;Ljava/lang/Runnable;J)Lorg/bukkit/scheduler/BukkitTask;");
+            case "runTaskTimerAsynchronously(Lorg/bukkit/plugin/Plugin;Ljava/lang/Runnable;JJ)Lorg/bukkit/scheduler/BukkitTask;" ->
+                new SchedulerRewrite("runTaskTimerAsynchronously", "(Lorg/bukkit/scheduler/BukkitScheduler;Lorg/bukkit/plugin/Plugin;Ljava/lang/Runnable;JJ)Lorg/bukkit/scheduler/BukkitTask;");
+            default -> null;
+        };
+    }
+
+    private record SchedulerRewrite(String method, String descriptor) {
     }
 }
