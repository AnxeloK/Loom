@@ -0,0 +1,82 @@
+package io.papermc.paper.plugin.manager.compat;
+
+import io.papermc.paper.plugin.configuration.PluginMeta;
+import java.util.List;
+import java.util.logging.Logger;
+import org.bukkit.plugin.Plugin;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Assertions;
+import org.junit.jupiter.api.Test;
+import org.mockito.Mockito;
+
+@Normal
+class CompatibilityPluginMatrixTest {
+
+    enum ExpectedOutcome {
+        SHOULD_WORK,
+        SHOULD_DEGRADE,
+        SHOULD_NOT_WORK
+    }
+
+    record MatrixEntry(String pluginName, String mainClass, List<String> dependencies, ExpectedOutcome expectedOutcome) {
+    }
+
+    @Test
+    void matrixContainsAllCompatibilityOutcomes() {
+        final List<MatrixEntry> matrix = List.of(
+            new MatrixEntry("LoomNativeTools", "com.example.loom.NativeTools", List.of(), ExpectedOutcome.SHOULD_WORK),
+            new MatrixEntry("OldClaims", "com.example.claims.OldClaims", List.of("Vault"), ExpectedOutcome.SHOULD_DEGRADE),
+            new MatrixEntry("PacketBridge", "com.example.packet.PacketBridge", List.of("ProtocolLib"), ExpectedOutcome.SHOULD_DEGRADE),
+            new MatrixEntry("UnsafeNativeMutator", "com.example.native.UnsafeNativeMutator", List.of(), ExpectedOutcome.SHOULD_NOT_WORK)
+        );
+
+        boolean sawWork = false;
+        boolean sawDegrade = false;
+        boolean sawNotWork = false;
+
+        for (final MatrixEntry entry : matrix) {
+            final PluginCompatibilityProfile profile = new PluginCompatibilityProfile(
+                mockPlugin(entry.pluginName(), entry.mainClass(), entry.dependencies())
+            );
+
+            if (entry.expectedOutcome() == ExpectedOutcome.SHOULD_NOT_WORK) {
+                profile.noteRefusal("unsafe native mutation");
+                Assertions.assertEquals(PluginCompatibilityProfile.Mode.REFUSED, profile.mode());
+                sawNotWork = true;
+                continue;
+            }
+
+            if (entry.expectedOutcome() == ExpectedOutcome.SHOULD_WORK) {
+                Assertions.assertEquals(PluginCompatibilityProfile.Mode.NATIVE_LOOM_AWARE, profile.mode());
+                sawWork = true;
+                continue;
+            }
+
+            Assertions.assertTrue(
+                profile.mode() == PluginCompatibilityProfile.Mode.LEGACY_NORMAL
+                    || profile.mode() == PluginCompatibilityProfile.Mode.LEGACY_INTERNAL,
+                "Expected degradable legacy profile for " + entry.pluginName()
+            );
+            sawDegrade = true;
+        }
+
+        Assertions.assertTrue(sawWork, "Matrix should include should-work plugin");
+        Assertions.assertTrue(sawDegrade, "Matrix should include should-degrade plugin");
+        Assertions.assertTrue(sawNotWork, "Matrix should include should-NOT-work plugin");
+    }
+
+    private static Plugin mockPlugin(final String name, final String mainClass, final List<String> dependencies) {
+        final PluginMeta meta = Mockito.mock(PluginMeta.class);
+        Mockito.when(meta.getName()).thenReturn(name);
+        Mockito.when(meta.getMainClass()).thenReturn(mainClass);
+        Mockito.when(meta.getPluginDependencies()).thenReturn(dependencies);
+        Mockito.when(meta.getPluginSoftDependencies()).thenReturn(List.of());
+        Mockito.when(meta.getVersion()).thenReturn("1.0.0");
+
+        final Plugin plugin = Mockito.mock(Plugin.class);
+        Mockito.when(plugin.getPluginMeta()).thenReturn(meta);
+        Mockito.when(plugin.getLogger()).thenReturn(Logger.getLogger(name));
+        Mockito.when(plugin.isEnabled()).thenReturn(true);
+        return plugin;
+    }
+}
