+    private void callThroughApartment(
+        final RegisteredListener registration,
+        final Event event,
+        final CompatibilityTransaction transaction,
+        final PluginCompatibilityProfile profile,
+        final boolean strictFallback,
+        final String path
+    ) throws Throwable {
+        final CompatibilityApartment apartment = this.compatibilityKernel.apartmentFor(registration.getPlugin());
+        try (CompatibilityApartment.Scope scope = apartment.enter(transaction, strictFallback, path)) {
+            if (!scope.acquired()) {
+                profile.noteApartmentContention("contention in " + event.getEventName() + " lane=" + registration.getPriority());
+                this.compatibilityKernel.diagnostics().recordStrictFallback(
+                    profile,
+                    "apartment busy in " + event.getEventName() + " owner=" + scope.busyLease()
+                );
+                if (OwnerDomainExecutor.canRunSynchronousCallbacks()) {
+                    this.compatibilityKernel.diagnostics().recordRefusal(
+                        profile,
+                        "owner-domain contention refusal for " + event.getEventName() + " lane=" + registration.getPriority()
+                    );
+                    return;
+                }
+                final long handoffStart = System.nanoTime();
+                try {
+                    apartment.submitStrictFallback(() -> {
+                        try (CompatibilityApartment.Scope handoffScope = apartment.enter(transaction, true, path)) {
+                            if (!handoffScope.acquired()) {
+                                throw new IllegalStateException("Strict fallback apartment handoff failed: " + handoffScope.busyLease());
+                            }
+                            try {
+                                this.callListener(registration, event, transaction, true, path);
+                            } catch (final Throwable throwable) {
+                                if (throwable instanceof Exception exception) {
+                                    throw exception;
+                                }
+                                throw new RuntimeException(throwable);
+                            }
+                        }
+                        return null;
+                    }).join();
+                } catch (final CompletionException ex) {
+                    throw unwrapCompletionException(ex);
+                } finally {
+                    this.compatibilityKernel.diagnostics().recordOwnerRpcWait(
+                        profile,
+                        "apartment-handoff:" + event.getEventName(),
+                        System.nanoTime() - handoffStart
+                    );
                 }
+                return;
             }
+            this.callListener(registration, event, transaction, strictFallback, path);
+        }
+    }
