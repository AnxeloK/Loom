@@ -0,0 +1,90 @@
+package io.papermc.paper.plugin.manager.compat;
+
+import io.papermc.paper.plugin.configuration.PluginMeta;
+import java.util.List;
+import java.util.UUID;
+import java.util.logging.Logger;
+import org.bukkit.event.Cancellable;
+import org.bukkit.event.Event;
+import org.bukkit.event.HandlerList;
+import org.bukkit.plugin.Plugin;
+import org.bukkit.plugin.RegisteredListener;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Assertions;
+import org.junit.jupiter.api.Test;
+import org.mockito.Mockito;
+
+@Normal
+class CompatibilityDiagnosticsTest {
+
+    @Test
+    void diagnosticsTracksBarrierOwnerRpcAndMutationCommitFailures() {
+        final CompatibilityDiagnostics diagnostics = CompatibilityDiagnostics.global();
+        final CompatibilityDiagnostics.Snapshot before = diagnostics.snapshot();
+
+        final Plugin plugin = mockPlugin("DiagnosticsPlugin");
+        final PluginCompatibilityProfile profile = diagnostics.profileFor(plugin);
+
+        diagnostics.recordOwnerRpcWait(profile, "owner-rpc-test", 10_000_000L);
+        diagnostics.recordBarrierWait(profile, "GLOBAL_STRICT", "barrier-test", 12_000_000L);
+
+        final CompatibilityTransaction transaction = transactionFor();
+        transaction.overlayWrite("block:0,64,0", "STONE", "REGION", "setType");
+        transaction.abort("forced-abort");
+        diagnostics.recordTransaction(transaction);
+
+        final CompatibilityDiagnostics.Snapshot after = diagnostics.snapshot();
+
+        Assertions.assertTrue(after.ownerRpcWaitNanos() >= before.ownerRpcWaitNanos() + 10_000_000L);
+        Assertions.assertTrue(after.barrierWaitNanos() >= before.barrierWaitNanos() + 12_000_000L);
+        Assertions.assertTrue(after.mutationCommitFailures() >= before.mutationCommitFailures() + 1L);
+        Assertions.assertTrue(after.barriers().containsKey("GLOBAL_STRICT"));
+    }
+
+    private static CompatibilityTransaction transactionFor() {
+        final TestEvent event = new TestEvent();
+        final EventSemanticIndex.EventSemantics semantics = new EventSemanticIndex().resolve(event, new RegisteredListener[0]);
+        return new CompatibilityTransaction(event, semantics);
+    }
+
+    private static Plugin mockPlugin(final String name) {
+        final PluginMeta meta = Mockito.mock(PluginMeta.class);
+        Mockito.when(meta.getName()).thenReturn(name);
+        Mockito.when(meta.getMainClass()).thenReturn("com.example." + name);
+        Mockito.when(meta.getPluginDependencies()).thenReturn(List.of());
+        Mockito.when(meta.getPluginSoftDependencies()).thenReturn(List.of());
+        Mockito.when(meta.getVersion()).thenReturn("1.0.0");
+
+        final Plugin plugin = Mockito.mock(Plugin.class);
+        Mockito.when(plugin.getPluginMeta()).thenReturn(meta);
+        Mockito.when(plugin.getLogger()).thenReturn(Logger.getLogger(name));
+        Mockito.when(plugin.isEnabled()).thenReturn(true);
+        return plugin;
+    }
+
+    private static final class TestEvent extends Event implements Cancellable {
+        private static final HandlerList HANDLERS = new HandlerList();
+
+        private boolean cancelled;
+        private UUID marker = UUID.randomUUID();
+
+        @Override
+        public boolean isCancelled() {
+            return this.cancelled;
+        }
+
+        @Override
+        public void setCancelled(final boolean cancel) {
+            this.cancelled = cancel;
+        }
+
+        @Override
+        public HandlerList getHandlers() {
+            return HANDLERS;
+        }
+
+        public static HandlerList getHandlerList() {
+            return HANDLERS;
+        }
+    }
+}
