+package io.papermc.paper.plugin.manager.compat;
+
+import io.papermc.paper.plugin.configuration.PluginMeta;
+import java.lang.reflect.Proxy;
+import java.util.List;
+import java.util.logging.Logger;
+import org.bukkit.plugin.Plugin;
+import org.bukkit.plugin.ServicePriority;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Assertions;
+import org.junit.jupiter.api.Test;
+import org.mockito.Mockito;
+
+@Normal
+class CompatibilityServicesManagerTest {
+
+    @Test
+    void serviceProviderIsWrappedAndInvokedThroughCompatibilityProxy() {
+        final CompatibilityKernel kernel = new CompatibilityKernel();
+        final CompatibilityServicesManager manager = new CompatibilityServicesManager(kernel);
+
+        final Plugin providerPlugin = mockPlugin("ServiceProvider");
+        final EchoService provider = value -> "echo:" + value;
+
+        manager.register(EchoService.class, provider, providerPlugin, ServicePriority.Normal);
+
+        final EchoService resolved = manager.load(EchoService.class);
+        Assertions.assertNotNull(resolved);
+        Assertions.assertNotSame(provider, resolved);
+        Assertions.assertTrue(Proxy.isProxyClass(resolved.getClass()));
+        Assertions.assertEquals("echo:ok", resolved.echo("ok"));
+    }
+
+    @Test
+    void crossApartmentServiceCycleFailsFast() {
+        final CompatibilityKernel kernel = new CompatibilityKernel();
+        final CompatibilityServicesManager manager = new CompatibilityServicesManager(kernel);
+
+        final Plugin pluginA = mockPlugin("PluginA");
+        final Plugin pluginB = mockPlugin("PluginB");
+
+        final FirstService firstService = () -> manager.load(SecondService.class).second();
+        final SecondService secondService = () -> manager.load(FirstService.class).first();
+
+        manager.register(FirstService.class, firstService, pluginA, ServicePriority.Normal);
+        manager.register(SecondService.class, secondService, pluginB, ServicePriority.Normal);
+
+        final IllegalStateException exception = Assertions.assertThrows(
+            IllegalStateException.class,
+            () -> manager.load(FirstService.class).first()
+        );
+
+        Assertions.assertTrue(exception.getMessage().contains("cycle"));
+    }
+
+    private static Plugin mockPlugin(final String name) {
+        final PluginMeta meta = Mockito.mock(PluginMeta.class);
+        Mockito.when(meta.getName()).thenReturn(name);
+        Mockito.when(meta.getMainClass()).thenReturn("com.example." + name);
+        Mockito.when(meta.getPluginDependencies()).thenReturn(List.of());
+        Mockito.when(meta.getPluginSoftDependencies()).thenReturn(List.of());
+        Mockito.when(meta.getVersion()).thenReturn("1.0.0");
+
+        final Plugin plugin = Mockito.mock(Plugin.class);
+        Mockito.when(plugin.getPluginMeta()).thenReturn(meta);
+        Mockito.when(plugin.getLogger()).thenReturn(Logger.getLogger(name));
+        Mockito.when(plugin.isEnabled()).thenReturn(true);
+        return plugin;
+    }
+
+    @FunctionalInterface
+    interface EchoService {
+        String echo(String value);
+    }
+
+    @FunctionalInterface
+    interface FirstService {
+        String first();
+    }
+
+    @FunctionalInterface
+    interface SecondService {
+        String second();
+    }
+}
