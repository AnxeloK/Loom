Subject: [PATCH] Test concurrent keepalive latency updates


diff --git a/src/test/java/io/papermc/paper/util/KeepAliveTest.java b/src/test/java/io/papermc/paper/util/KeepAliveTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..04ac627b71de7a165b637ef3a81feb61e9df1c85
--- /dev/null
+++ b/src/test/java/io/papermc/paper/util/KeepAliveTest.java
@@ -0,0 +1,51 @@
+package io.papermc.paper.util;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.Future;
+import java.util.concurrent.TimeUnit;
+import org.junit.jupiter.api.Test;
+
+class KeepAliveTest {
+
+    @Test
+    void pingCalculatorHandlesConcurrentUpdates() throws Exception {
+        final KeepAlive.PingCalculator calculator = new KeepAlive.PingCalculator(TimeUnit.MINUTES.toNanos(1L));
+        final int threads = 4;
+        final int updatesPerThread = 1_000;
+        final long baseTime = System.nanoTime();
+        final CountDownLatch start = new CountDownLatch(1);
+        final ExecutorService executor = Executors.newFixedThreadPool(threads);
+        final List<Future<?>> futures = new ArrayList<>();
+
+        try {
+            for (int thread = 0; thread < threads; ++thread) {
+                final int threadId = thread;
+                futures.add(executor.submit(() -> {
+                    start.await();
+                    for (int update = 0; update < updatesPerThread; ++update) {
+                        final long tx = baseTime + (long)threadId * updatesPerThread + update;
+                        calculator.update(new KeepAlive.KeepAliveResponse(tx, tx + TimeUnit.MILLISECONDS.toNanos(1L)));
+                    }
+                    return null;
+                }));
+            }
+
+            start.countDown();
+
+            for (final Future<?> future : futures) {
+                future.get();
+            }
+        } finally {
+            executor.shutdownNow();
+        }
+
+        assertEquals(1, calculator.getAvgLatencyMS());
+        assertEquals(threads * updatesPerThread, calculator.getAllNS().size());
+    }
+}
