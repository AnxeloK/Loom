@@ -0,0 +1,72 @@
+package io.papermc.paper.plugin.manager.compat;
+
+import org.bukkit.plugin.Plugin;
+import org.bukkit.scheduler.BukkitScheduler;
+import org.bukkit.scheduler.BukkitTask;
+
+public final class CompatibilitySchedulerBridge {
+
+    private CompatibilitySchedulerBridge() {
+    }
+
+    public static BukkitTask runTask(final BukkitScheduler scheduler, final Plugin plugin, final Runnable task) {
+        return scheduler.runTask(plugin, task);
+    }
+
+    public static BukkitTask runTaskLater(final BukkitScheduler scheduler, final Plugin plugin, final Runnable task, final long delay) {
+        return scheduler.runTaskLater(plugin, task, delay);
+    }
+
+    public static BukkitTask runTaskTimer(
+        final BukkitScheduler scheduler,
+        final Plugin plugin,
+        final Runnable task,
+        final long delay,
+        final long period
+    ) {
+        return scheduler.runTaskTimer(plugin, task, delay, period);
+    }
+
+    public static BukkitTask runTaskAsynchronously(final BukkitScheduler scheduler, final Plugin plugin, final Runnable task) {
+        return scheduler.runTaskAsynchronously(plugin, wrapAsyncRunnable(plugin, task));
+    }
+
+    public static BukkitTask runTaskLaterAsynchronously(
+        final BukkitScheduler scheduler,
+        final Plugin plugin,
+        final Runnable task,
+        final long delay
+    ) {
+        return scheduler.runTaskLaterAsynchronously(plugin, wrapAsyncRunnable(plugin, task), delay);
+    }
+
+    public static BukkitTask runTaskTimerAsynchronously(
+        final BukkitScheduler scheduler,
+        final Plugin plugin,
+        final Runnable task,
+        final long delay,
+        final long period
+    ) {
+        return scheduler.runTaskTimerAsynchronously(plugin, wrapAsyncRunnable(plugin, task), delay, period);
+    }
+
+    private static Runnable wrapAsyncRunnable(final Plugin plugin, final Runnable task) {
+        if (task == null) {
+            return null;
+        }
+        if (task instanceof ScopedRunnable) {
+            return task;
+        }
+        return new ScopedRunnable(plugin, task);
+    }
+
+    private record ScopedRunnable(Plugin plugin, Runnable delegate) implements Runnable {
+        @Override
+        public void run() {
+            final long transactionId = CompatibilityRuntimeContext.syntheticTransactionId();
+            try (CompatibilityRuntimeContext.Scope ignored = CompatibilityRuntimeContext.enter(this.plugin, transactionId, false)) {
+                this.delegate.run();
+            }
+        }
+    }
+}
diff --git a/src/main/java/io/papermc/paper/plugin/manager/compat/CompatibilityServicesManager.java b/src/main/java/io/papermc/paper/plugin/manager/compat/CompatibilityServicesManager.java
