+                assertThrows(CompletionException.class, result::join).getCause());
+            assertEquals(0, f.charges.get());
+        }
+    }
+
+    @Test void replacementDuringPreparationCannotReceiveTheOldRespawn() throws Exception {
+        try (Fixture f = new Fixture()) {
+            CompletableFuture<Location> preparation = new CompletableFuture<>();
