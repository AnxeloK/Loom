diff --git a/src/test/java/net/minecraft/server/level/RespawnAnchorConsumptionTest.java b/src/test/java/net/minecraft/server/level/RespawnAnchorConsumptionTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..ae6339cf3a861a76e0d4cf5d936f796d5be4b85c
--- /dev/null
+++ b/src/test/java/net/minecraft/server/level/RespawnAnchorConsumptionTest.java
@@ -0,0 +1,69 @@
+package net.minecraft.server.level;
+
+import java.util.Optional;
+import java.util.concurrent.RejectedExecutionException;
+import java.util.concurrent.atomic.AtomicReference;
+import net.minecraft.core.BlockPos;
+import net.minecraft.world.entity.EntityTypes;
+import net.minecraft.world.level.Level;
+import net.minecraft.world.level.block.Blocks;
+import net.minecraft.world.level.block.RespawnAnchorBlock;
+import net.minecraft.world.level.block.state.BlockState;
+import net.minecraft.world.level.storage.LevelData;
+import net.minecraft.world.phys.Vec3;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.ArgumentMatchers.*;
+import static org.mockito.Mockito.*;
+
+@Normal
+class RespawnAnchorConsumptionTest {
+    @Test void overlappingPreparedDecisionsCannotReuseTheLastCharge() {
+        ServerLevel level = mock(ServerLevel.class);
+        AtomicReference<BlockState> state = new AtomicReference<>(Blocks.RESPAWN_ANCHOR.defaultBlockState().setValue(RespawnAnchorBlock.CHARGE, 1));
+        when(level.getBlockState(BlockPos.ZERO)).thenAnswer(ignored -> state.get());
+        when(level.setBlockAndUpdate(eq(BlockPos.ZERO), any())).thenAnswer(invocation -> {
+            state.set(invocation.getArgument(1));
+            return true;
+        });
+        try (var anchor = mockStatic(RespawnAnchorBlock.class)) {
+            anchor.when(() -> RespawnAnchorBlock.canSetSpawn(level, BlockPos.ZERO)).thenReturn(true);
+            anchor.when(() -> RespawnAnchorBlock.findStandUpPosition(EntityTypes.PLAYER, level, BlockPos.ZERO))
+                .thenReturn(Optional.of(new Vec3(1.5, 1, 1.5)));
+            ServerPlayer.RespawnConfig config = new ServerPlayer.RespawnConfig(LevelData.RespawnData.of(Level.NETHER, BlockPos.ZERO, 0, 0), false);
+            Runnable first = ServerPlayer.findRespawnAndUseSpawnBlock(level, config, true).orElseThrow().consumeAnchorCharge();
+            Runnable second = ServerPlayer.findRespawnAndUseSpawnBlock(level, config, true).orElseThrow().consumeAnchorCharge();
+            first.run();
+            assertEquals(0, state.get().getValue(RespawnAnchorBlock.CHARGE));
+            assertThrows(RejectedExecutionException.class, second::run);
+            assertEquals(0, state.get().getValue(RespawnAnchorBlock.CHARGE));
+            verify(level, times(1)).setBlockAndUpdate(eq(BlockPos.ZERO), any());
+        }
+    }
+
+    @Test void consumptionUsesCurrentChargesAndCannotRecreateAReplacedAnchor() {
+        ServerLevel level = mock(ServerLevel.class);
+        BlockState initial = Blocks.RESPAWN_ANCHOR.defaultBlockState().setValue(RespawnAnchorBlock.CHARGE, 1);
+        AtomicReference<BlockState> state = new AtomicReference<>(initial);
+        when(level.getBlockState(BlockPos.ZERO)).thenAnswer(ignored -> state.get());
+        when(level.setBlockAndUpdate(eq(BlockPos.ZERO), any())).thenAnswer(invocation -> {
+            state.set(invocation.getArgument(1));
+            return true;
+        });
+        try (var anchor = mockStatic(RespawnAnchorBlock.class)) {
+            anchor.when(() -> RespawnAnchorBlock.canSetSpawn(level, BlockPos.ZERO)).thenReturn(true);
+            anchor.when(() -> RespawnAnchorBlock.findStandUpPosition(EntityTypes.PLAYER, level, BlockPos.ZERO))
+                .thenReturn(Optional.of(new Vec3(1.5, 1, 1.5)));
+            ServerPlayer.RespawnConfig config = new ServerPlayer.RespawnConfig(LevelData.RespawnData.of(Level.NETHER, BlockPos.ZERO, 0, 0), false);
+            Runnable prepared = ServerPlayer.findRespawnAndUseSpawnBlock(level, config, true).orElseThrow().consumeAnchorCharge();
+            state.set(initial.setValue(RespawnAnchorBlock.CHARGE, 4));
+            prepared.run();
+            assertEquals(3, state.get().getValue(RespawnAnchorBlock.CHARGE));
+            state.set(Blocks.STONE.defaultBlockState());
+            assertThrows(RejectedExecutionException.class, prepared::run);
+            assertTrue(state.get().is(Blocks.STONE));
+            verify(level, times(1)).setBlockAndUpdate(eq(BlockPos.ZERO), any());
+        }
+    }
+}
