+    @Test void deferredDestinationResumesOnTheOwnerBeforePublishingTheResult() throws Exception {
+        try (Fixture f = new Fixture()) {
+            CompletableFuture<Location> preparation = new CompletableFuture<>();
+            f.listener = event -> event.setRespawnLocationAsync(preparation);
+            CompletableFuture<ServerPlayer.RespawnResult> result = f.startDefault();
+            f.drain();
+            assertFalse(result.isDone());
+            assertEquals(1, f.events.get());
+            preparation.complete(f.personalLanding);
+            assertFalse(result.isDone());
+            f.drain();
+            assertEquals(new Vec3(120.5, 75, -250.5), result.join().transition().position());
+            assertEquals(1, f.events.get());
+        }
+    }
+
+    @Test void deferredAnchorSelectionConsumesItsChargeOnlyAfterOwnedCompletion() throws Exception {
+        try (Fixture f = new Fixture()) {
+            CompletableFuture<Location> preparation = new CompletableFuture<>();
+            f.listener = event -> event.setRespawnLocationAsync(preparation);
+            CompletableFuture<ServerPlayer.RespawnResult> result = f.startAnchor();
+            f.drain();
+            assertFalse(result.isDone());
+            assertEquals(0, f.charges.get());
+            preparation.complete(new Location(f.world, 8.5, 70, 8.5));
+            assertEquals(0, f.charges.get());
+            f.drain();
+            assertTrue(result.join().isAnchorSpawn());
+            assertEquals(1, f.charges.get());
+        }
+    }
+
+    @Test void aDeferredAnchorRedirectKeepsItsCharge() throws Exception {
+        try (Fixture f = new Fixture()) {
+            CompletableFuture<Location> preparation = new CompletableFuture<>();
+            f.listener = event -> event.setRespawnLocationAsync(preparation);
+            CompletableFuture<ServerPlayer.RespawnResult> result = f.startAnchor();
+            f.drain();
+            preparation.complete(f.personalLanding);
+            f.drain();
+            assertEquals(new Vec3(120.5, 75, -250.5), result.join().transition().position());
+            assertEquals(0, f.charges.get());
+        }
+    }
+
+    @Test void disconnectDuringPreparationCannotPublishALocationOrUseAnAnchor() throws Exception {
+        try (Fixture f = new Fixture()) {
+            CompletableFuture<Location> preparation = new CompletableFuture<>();
+            f.listener = event -> event.setRespawnLocationAsync(preparation);
+            CompletableFuture<ServerPlayer.RespawnResult> result = f.startAnchor();
