+            try (CompatibilityApartment.Scope nestedScope = apartment.enter(nested, false)) {
+                Assertions.assertEquals(CompatibilityApartment.EnterResult.REENTRANT, nestedScope.result());
+                Assertions.assertTrue(nestedScope.acquired());
+            }
+            // After the nested scope closes the outer lease must still be held (depth bookkeeping).
+            try (CompatibilityApartment.Scope stillHeld = apartment.enter(outer, false)) {
