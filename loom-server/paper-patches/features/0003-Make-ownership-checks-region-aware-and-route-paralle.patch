+++ b/src/main/java/io/papermc/paper/plugin/manager/compat/CompatibilityDiagnostics.java
@@ -261,6 +261,20 @@ public final class CompatibilityDiagnostics {
         );
     }
 
+    // Records a refusal for one dispatch without changing the plugin's persistent classification. Apartment
+    // contention can clear before the next event, so record it separately from profile.noteRefusal.
+    public void recordTransientRefusal(final PluginCompatibilityProfile profile, final String reason) {
+        this.refusals.increment();
+        this.logStructured(
+            "transient_refusal",
+            Map.of(
+                "plugin", profile.pluginName(),
+                "reason", reason,
+                "mode", profile.mode().name()
+            )
+        );
+    }
+
     public void recordAsyncViolation(final String reason) {
         this.asyncViolations.increment();
         final org.bukkit.plugin.Plugin current = CompatibilityRuntimeContext.currentPlugin();
diff --git a/src/main/java/org/spigotmc/AsyncCatcher.java b/src/main/java/org/spigotmc/AsyncCatcher.java
index cd05cc077c61fea77d344710b37c9a533700fe72..00e829286d7d36d6130ad1a5ea4c1992a79f13c9 100644
--- a/src/main/java/org/spigotmc/AsyncCatcher.java
+++ b/src/main/java/org/spigotmc/AsyncCatcher.java
@@ -24,6 +24,58 @@ public class AsyncCatcher {
         if (context == null || context.length == 0 || isOwnerForContext(context)) {
             return;
         }
+        failOwnerMismatch(reason, context);
+    }
+
+    public static void catchOp(final String reason, final Entity entity) {
+        catchOp(reason);
+        if (isGlobalOwner() || OwnerDomainExecutor.isEntityOwner(entity) || isRegionOwnerForEntity(entity)) {
+            return;
+        }
+        failOwnerMismatch(reason, entity);
+    }
+
+    // Loom - a tick thread that owns the region an entity currently occupies may operate on that entity.
+    // Players carry a PLAYER owner domain distinct from the region they stand in, so during a (possibly
+    // parallel) world tick the region owner must still be accepted for entity/tracker work on entities in
+    // it. Under serial ticking the full-level lease already covers the chunk, so this changes nothing.
+    private static boolean isRegionOwnerForEntity(final Entity entity) {
+        if (!(entity.level() instanceof final ServerLevel serverLevel)) {
+            return false;
+        }
+        final BlockPos pos = entity.blockPosition();
+        return OwnerDomainExecutor.isRegionOwner(serverLevel, pos.getX() >> 4, pos.getZ() >> 4);
+    }
+
+    public static void catchOp(final String reason, final Level level) {
+        catchOp(reason);
+        final ServerLevel serverLevel = asServerLevel(level);
+        if (isGlobalOwner() || serverLevel != null && OwnerDomainExecutor.isCurrentRegionOwnerForLevel(serverLevel)) {
+            return;
+        }
+        failOwnerMismatch(reason, level);
+    }
+
+    public static void catchOp(final String reason, final Level level, final BlockPos pos) {
+        catchOp(reason);
+        final ServerLevel serverLevel = asServerLevel(level);
+        if (isGlobalOwner()
+            || serverLevel != null && OwnerDomainExecutor.isRegionOwner(serverLevel, pos.getX() >> 4, pos.getZ() >> 4)) {
+            return;
+        }
+        failOwnerMismatch(reason, level, pos);
+    }
+
+    public static void catchOp(final String reason, final Level level, final int chunkX, final int chunkZ) {
+        catchOp(reason);
+        final ServerLevel serverLevel = asServerLevel(level);
+        if (isGlobalOwner() || serverLevel != null && OwnerDomainExecutor.isRegionOwner(serverLevel, chunkX, chunkZ)) {
+            return;
+        }
+        failOwnerMismatch(reason, level, chunkX, chunkZ);
+    }
+
+    private static void failOwnerMismatch(final String reason, final Object... context) {
         CompatibilityDiagnostics.global().recordAsyncViolation("owner-mismatch: " + reason);
         final String message = "Owner-domain violation for " + reason + ", context=" + describeContext(context);
         MinecraftServer.LOGGER.error(message, new Throwable());
@@ -31,13 +83,12 @@ public class AsyncCatcher {
     }
 
     private static boolean isOwnerForContext(final Object... context) {
-        final MinecraftServer server = MinecraftServer.getServer();
-        if (server != null && OwnerDomainExecutor.isGlobalOwner(server)) {
+        if (isGlobalOwner()) {
             return true;
         }
 
         for (final Object entry : context) {
-            if (entry instanceof Entity entity && OwnerDomainExecutor.isOwner(OwnerDomainExecutor.entity(entity, "async-catcher-entity"))) {
+            if (entry instanceof Entity entity && OwnerDomainExecutor.isEntityOwner(entity)) {
                 return true;
             }
         }
@@ -70,17 +121,25 @@ public class AsyncCatcher {
             return false;
         }
         if (chunkPos != null) {
-            return OwnerDomainExecutor.isOwner(OwnerDomainExecutor.region(level, chunkPos.x(), chunkPos.z(), "async-catcher-chunk-pos"));
+            return OwnerDomainExecutor.isRegionOwner(level, chunkPos.x(), chunkPos.z());
         }
         if (blockPos != null) {
-            return OwnerDomainExecutor.isOwner(OwnerDomainExecutor.region(level, blockPos.getX() >> 4, blockPos.getZ() >> 4, "async-catcher-block-pos"));
+            return OwnerDomainExecutor.isRegionOwner(level, blockPos.getX() >> 4, blockPos.getZ() >> 4);
         }
         if (chunkX != null && chunkZ != null) {
-            return OwnerDomainExecutor.isOwner(OwnerDomainExecutor.region(level, chunkX, chunkZ, "async-catcher-chunk-coordinates"));
+            return OwnerDomainExecutor.isRegionOwner(level, chunkX, chunkZ);
         }
 
-        final OwnerDomainExecutor.Owner owner = OwnerDomainExecutor.currentOwner();
-        return owner != null && owner.domain() == OwnerDomainExecutor.Domain.REGION && owner.level() == level;
+        return OwnerDomainExecutor.isCurrentRegionOwnerForLevel(level);
+    }
+
+    private static boolean isGlobalOwner() {
+        final MinecraftServer server = MinecraftServer.getServer();
+        return server != null && OwnerDomainExecutor.isGlobalOwner(server);
+    }
+
+    private static ServerLevel asServerLevel(final Level level) {
+        return level instanceof ServerLevel serverLevel ? serverLevel : null;
     }
 
     private static String describeContext(final Object... context) {
