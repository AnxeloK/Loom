diff --git a/src/main/java/ca/spottedleaf/moonrise/common/util/TickThread.java b/src/main/java/ca/spottedleaf/moonrise/common/util/TickThread.java
index 071e2191bab8fd9de1fc4fb5fa2472f8315adaff..2c36922658ff18555c4f3dcbbf027501b49a7435 100644
--- a/src/main/java/ca/spottedleaf/moonrise/common/util/TickThread.java
+++ b/src/main/java/ca/spottedleaf/moonrise/common/util/TickThread.java
@@ -135,51 +135,85 @@ public class TickThread extends Thread {
         return false;
     }
 
+    // Loom start - region-aware tick-thread ownership checks
+    // Worlds and intra-world regions tick in parallel, so a tick thread is only valid for the world/region it
+    // actually owns; cross-world or cross-region access off the owning thread is detected as a loud throw
+    // instead of silently corrupting another region's state. The position-aware overloads check CHUNK
+    // ownership (region granularity); the level-only overload checks the world. The global owner (main thread)
+    // is always accepted.
+    private static boolean ownsLevel(final Level world) {
+        if (!(world instanceof final net.minecraft.server.level.ServerLevel level)) {
+            return true;
+        }
+        return net.minecraft.server.threading.runtime.OwnerDomainExecutor.isGlobalOwner(level.getServer())
+            || net.minecraft.server.threading.runtime.OwnerDomainExecutor.isCurrentRegionOwnerForLevel(level);
+    }
+
+    private static boolean ownsChunk(final Level world, final int chunkX, final int chunkZ) {
+        if (!(world instanceof final net.minecraft.server.level.ServerLevel level)) {
+            return true;
+        }
+        return net.minecraft.server.threading.runtime.OwnerDomainExecutor.isGlobalOwner(level.getServer())
+            || net.minecraft.server.threading.TickRegions.isCurrentThreadOwnerQuiet(level, chunkX, chunkZ);
+    }
+
+    private static boolean isTickThreadForLevel(final Level world) {
+        return isTickThread() && ownsLevel(world);
+    }
+
+    private static boolean isTickThreadForChunk(final Level world, final int chunkX, final int chunkZ) {
+        return isTickThread() && ownsChunk(world, chunkX, chunkZ);
+    }
+
     public static boolean isTickThreadFor(final Level world, final BlockPos pos) {
-        return isTickThread();
+        return isTickThreadForChunk(world, pos.getX() >> 4, pos.getZ() >> 4);
     }
 
     public static boolean isTickThreadFor(final Level world) {
-        return isTickThread();
+        return isTickThreadForLevel(world);
     }
 
     public static boolean isTickThreadFor(final Level world, final BlockPos pos, final int blockRadius) {
-        return isTickThread();
+        return isTickThreadForChunk(world, pos.getX() >> 4, pos.getZ() >> 4);
     }
 
     public static boolean isTickThreadFor(final Level world, final ChunkPos pos) {
-        return isTickThread();
+        return isTickThreadForChunk(world, pos.x(), pos.z());
     }
 
     public static boolean isTickThreadFor(final Level world, final Vec3 pos) {
-        return isTickThread();
+        return isTickThreadForChunk(world, net.minecraft.util.Mth.floor(pos.x) >> 4, net.minecraft.util.Mth.floor(pos.z) >> 4);
     }
 
     public static boolean isTickThreadFor(final Level world, final int chunkX, final int chunkZ) {
-        return isTickThread();
+        return isTickThreadForChunk(world, chunkX, chunkZ);
     }
 
     public static boolean isTickThreadFor(final Level world, final AABB aabb) {
-        return isTickThread();
+        return isTickThreadForChunk(world, net.minecraft.util.Mth.floor((aabb.minX + aabb.maxX) * 0.5D) >> 4, net.minecraft.util.Mth.floor((aabb.minZ + aabb.maxZ) * 0.5D) >> 4);
     }
 
     public static boolean isTickThreadFor(final Level world, final double blockX, final double blockZ) {
-        return isTickThread();
+        return isTickThreadForChunk(world, net.minecraft.util.Mth.floor(blockX) >> 4, net.minecraft.util.Mth.floor(blockZ) >> 4);
     }
 
     public static boolean isTickThreadFor(final Level world, final Vec3 position, final Vec3 deltaMovement, final int buffer) {
-        return isTickThread();
+        return isTickThreadForChunk(world, net.minecraft.util.Mth.floor(position.x) >> 4, net.minecraft.util.Mth.floor(position.z) >> 4);
     }
 
     public static boolean isTickThreadFor(final Level world, final int fromChunkX, final int fromChunkZ, final int toChunkX, final int toChunkZ) {
-        return isTickThread();
+        return isTickThreadForChunk(world, fromChunkX, fromChunkZ);
     }
 
     public static boolean isTickThreadFor(final Level world, final int chunkX, final int chunkZ, final int radius) {
-        return isTickThread();
+        return isTickThreadForChunk(world, chunkX, chunkZ);
     }
 
     public static boolean isTickThreadFor(final Entity entity) {
-        return isTickThread();
+        if (!isTickThread()) {
+            return false;
+        }
+        return ownsChunk(entity.level(), net.minecraft.util.Mth.floor(entity.getX()) >> 4, net.minecraft.util.Mth.floor(entity.getZ()) >> 4);
     }
+    // Loom end
 }
diff --git a/src/main/java/io/papermc/paper/plugin/manager/PaperEventManager.java b/src/main/java/io/papermc/paper/plugin/manager/PaperEventManager.java
index d0b25c2909647a55d878ba1e8e33ac6cf23ae354..fb62c3167fd7ddf22cbbe2433f610c48cab1b555 100644
--- a/src/main/java/io/papermc/paper/plugin/manager/PaperEventManager.java
+++ b/src/main/java/io/papermc/paper/plugin/manager/PaperEventManager.java
@@ -49,6 +49,23 @@ class PaperEventManager {
 
     // SimplePluginManager
     public void callEvent(final @NotNull Event event) {
+        // Loom start - defer synchronous events fired on a region worker thread during parallel ticking to
+        // the owning (main) thread's serial replay, so plugin handlers run single-threaded as under serial
+        // ticking. This keeps legacy main-thread-only plugins safe with the parallel flags enabled.
+        if (!event.isAsynchronous() && net.minecraft.server.threading.RegionTickStaging.stageEvent(event)) {
+            return;
+        }
+        // Loom Fix 1c - the stageEvent path above only catches events fired INSIDE a random-tick / entity-tick
+        // staging window. Events fired on a region worker OUTSIDE that window (e.g. ChunkLoadEvent /
+        // ChunkUnloadEvent from the chunk pipeline, and other post-facto notifications) are routed back to the
+        // owning thread here, where their listeners run single-threaded. This replaces the old behaviour of
+        // running them inline on a worker and then REFUSING them on apartment contention (which silently
+        // dropped e.g. WorldGuard's protection listeners). Staged-veto events (cancellation gating a
+        // synchronous side effect) are intentionally NOT deferred and fall through unchanged.
+        if (!event.isAsynchronous() && net.minecraft.server.threading.RegionTickStaging.deferEventToOwner(event)) {
+            return;
+        }
+        // Loom end
         if (event.isAsynchronous() && this.server.isPrimaryThread()) {
             throw new IllegalStateException(event.getEventName() + " may only be triggered asynchronously.");
         } else if (!event.isAsynchronous() && !this.server.isPrimaryThread() && !this.server.isStopping()) {
@@ -170,15 +187,22 @@ class PaperEventManager {
         final CompatibilityApartment apartment = this.compatibilityKernel.apartmentFor(registration.getPlugin());
         try (CompatibilityApartment.Scope scope = apartment.enter(transaction, strictFallback, path)) {
             if (!scope.acquired()) {
-                profile.noteApartmentContention("contention in " + event.getEventName() + " lane=" + registration.getPriority());
-                this.compatibilityKernel.diagnostics().recordStrictFallback(
-                    profile,
-                    "apartment busy in " + event.getEventName() + " owner=" + scope.busyLease()
-                );
+                // Apartment contention is local to this dispatch. It must not persistently change the plugin
+                // classification to LEGACY_STRICT or REFUSED: that would drop later events, including events
+                // that can run safely on their owner thread. Record this refusal only for diagnostics.
                 if (OwnerDomainExecutor.canRunSynchronousCallbacks()) {
-                    this.compatibilityKernel.diagnostics().recordRefusal(
+                    // The owner thread is hard-blocked in futures.join() during the parallel phase, so we can
+                    // neither run the listener inline here (off-owner, would race shared plugin state) nor
+                    // synchronously round-trip to the owner (deadlock). Post-facto events were already routed
+                    // to the owner by RegionTickStaging.deferEventToOwner before reaching this path; anything
+                    // still arriving here is the staged-veto class (cancellation must suppress a synchronous
+                    // side effect) which cannot be deferred without firing-site staging. Drop ONLY this one
+                    // dispatch (no persistent classification change), recording it for the diagnostics counter so the
+                    // remaining gap stays visible.
+                    this.compatibilityKernel.diagnostics().recordTransientRefusal(
                         profile,
-                        "owner-domain contention refusal for " + event.getEventName() + " lane=" + registration.getPriority()
+                        "transient apartment contention for " + event.getEventName() + " lane=" + registration.getPriority()
+                            + " owner=" + scope.busyLease()
                     );
                     return;
                 }
diff --git a/src/main/java/io/papermc/paper/plugin/manager/compat/CompatibilityApartment.java b/src/main/java/io/papermc/paper/plugin/manager/compat/CompatibilityApartment.java
index 8bd9acfc677a854a19bf3e5b88473f0ad27120ef..63009af5233851977b4bb84099b8de84e9e7a2e7 100644
--- a/src/main/java/io/papermc/paper/plugin/manager/compat/CompatibilityApartment.java
+++ b/src/main/java/io/papermc/paper/plugin/manager/compat/CompatibilityApartment.java
@@ -102,7 +102,20 @@ public final class CompatibilityApartment {
                 continue;
             }
 
-            if (current.ownerThread == currentThread && current.transactionId == transactionId) {
+            // Loom Fix 1d - re-enter on SAME-THREAD ownership alone, regardless of transactionId. This apartment
+            // is per-plugin, so a thread that already holds this plugin's lease and re-enters is ALWAYS the
+            // plugin's own synchronous, nested call — never a concurrent contender (a single thread cannot race
+            // itself). The previous `&& current.transactionId == transactionId` guard only re-entered the SAME
+            // event's re-dispatch and treated a NESTED dispatch of a DIFFERENT event as foreign contention. That
+            // is exactly the WorldGuard pattern: WG's listener on a Bukkit event (e.g. CreatureSpawnEvent /
+            // BlockPlaceEvent / BlockBreakEvent) synchronously fires WG's own delegate event (SpawnEntityEvent /
+            // PlaceBlockEvent / BreakBlockEvent) via Bukkit.getPluginManager().callEvent() from inside that
+            // listener. The delegate is a fresh transaction, so under the old guard the nested dispatch hit BUSY
+            // on the same thread and was REFUSED — so WG's region-protection listeners on the delegate never ran,
+            // silently bypassing place/break/spawn protection under parallel ticking. Matching on thread identity
+            // alone is both safe (same thread, no data race) and correct (it is the plugin re-entering itself),
+            // and leaves the cross-thread BUSY path (the apartment's actual purpose) unchanged.
+            if (current.ownerThread == currentThread) {
                 current.depth.incrementAndGet();
                 final CompatibilityRuntimeContext.Scope context = transaction == null
                     ? CompatibilityRuntimeContext.enter(this.plugin, transactionId, strictFallback, path)
diff --git a/src/main/java/io/papermc/paper/plugin/manager/compat/CompatibilityDiagnostics.java b/src/main/java/io/papermc/paper/plugin/manager/compat/CompatibilityDiagnostics.java
