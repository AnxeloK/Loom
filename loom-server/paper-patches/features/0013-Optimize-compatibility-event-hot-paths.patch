From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: anxelok <anxelok@localhost>
Date: Mon, 1 Jun 2026 22:53:27 +0000
Subject: [PATCH] Optimize compatibility event hot paths


diff --git a/src/main/java/io/papermc/paper/plugin/manager/PaperEventManager.java b/src/main/java/io/papermc/paper/plugin/manager/PaperEventManager.java
index d249cfe3a8a0acfde7fcb1d6324246e9b6aa7335..c6fb5dbd9a05b23f050cdb2a2712fe4a8445c0d1 100644
--- a/src/main/java/io/papermc/paper/plugin/manager/PaperEventManager.java
+++ b/src/main/java/io/papermc/paper/plugin/manager/PaperEventManager.java
@@ -57,6 +57,10 @@ class PaperEventManager {
 
         final HandlerList handlers = event.getHandlers();
         final RegisteredListener[] listeners = handlers.getRegisteredListeners();
+        if (listeners.length == 0) {
+            return;
+        }
+
         final CompatibilityTransaction transaction = this.compatibilityKernel.beginTransaction(event, listeners);
         final CompatibilityKernel.RoutingDecision routingDecision = this.compatibilityKernel.routingDecision(transaction, listeners);
 
@@ -95,7 +99,7 @@ class PaperEventManager {
                     continue;
                 }
 
-                final CompatibilityTransaction.ListenerSnapshot beforeListener = transaction.beforeListener();
+                final CompatibilityTransaction.ListenerSnapshot beforeListener = transaction.beforeListener(lane);
                 final long callbackStart = System.nanoTime();
 
                 try {
diff --git a/src/main/java/io/papermc/paper/plugin/manager/compat/CompatibilityDiagnostics.java b/src/main/java/io/papermc/paper/plugin/manager/compat/CompatibilityDiagnostics.java
index 1244fe4c71adf3b6c70d9483b98e8cdc77ea3af0..5c4b87b63591735ee7fcfd48c94e7684bca87dcf 100644
--- a/src/main/java/io/papermc/paper/plugin/manager/compat/CompatibilityDiagnostics.java
+++ b/src/main/java/io/papermc/paper/plugin/manager/compat/CompatibilityDiagnostics.java
@@ -94,7 +94,7 @@ public final class CompatibilityDiagnostics {
             this.mutationTransactions.increment();
         }
 
-        if (transaction.state() == CompatibilityTransaction.State.ABORTED) {
+        if (transaction.state() == CompatibilityTransaction.State.ABORTED && !isExpectedCancellation(transaction)) {
             this.logStructured(
                 "transaction_aborted",
                 Map.of(
@@ -124,6 +124,10 @@ public final class CompatibilityDiagnostics {
         }
     }
 
+    private static boolean isExpectedCancellation(final CompatibilityTransaction transaction) {
+        return transaction.pendingWriteCount() == 0 && "event cancelled".equals(transaction.abortReason());
+    }
+
     public void recordSnapshotDelivery(final PluginCompatibilityProfile profile, final String eventName) {
         this.snapshotDeliveries.increment();
         final EventCounter counter = this.events.computeIfAbsent(eventName, ignored -> new EventCounter());
diff --git a/src/main/java/io/papermc/paper/plugin/manager/compat/CompatibilityTransaction.java b/src/main/java/io/papermc/paper/plugin/manager/compat/CompatibilityTransaction.java
index 99cc1893429571e8d50cfaea297b11c0f6feee41..5b89f1ceea9bb63f33163e5c64d8f8f5f1e7eb79 100644
--- a/src/main/java/io/papermc/paper/plugin/manager/compat/CompatibilityTransaction.java
+++ b/src/main/java/io/papermc/paper/plugin/manager/compat/CompatibilityTransaction.java
@@ -124,8 +124,9 @@ public final class CompatibilityTransaction {
         return Math.max(0L, end - this.startedNanos);
     }
 
-    public ListenerSnapshot beforeListener() {
-        return new ListenerSnapshot(eventDigest(this.event), this.cancellable && ((Cancellable)this.event).isCancelled());
+    public ListenerSnapshot beforeListener(final EventSemanticIndex.Lane lane) {
+        final int digest = lane == EventSemanticIndex.Lane.MONITOR ? eventDigest(this.event) : 0;
+        return new ListenerSnapshot(digest, this.cancellable && ((Cancellable)this.event).isCancelled());
     }
 
     public void afterListener(
@@ -135,7 +136,7 @@ public final class CompatibilityTransaction {
         final long durationNanos
     ) {
         final boolean cancelledAfter = this.cancellable && ((Cancellable)this.event).isCancelled();
-        final int afterDigest = eventDigest(this.event);
+        final int afterDigest = lane == EventSemanticIndex.Lane.MONITOR ? eventDigest(this.event) : before.digest();
         this.listenerPasses.add(new ListenerPass(
             listener.getPlugin().getPluginMeta().getName(),
             lane,
diff --git a/src/test/java/io/papermc/paper/plugin/manager/compat/CompatibilityTransactionTest.java b/src/test/java/io/papermc/paper/plugin/manager/compat/CompatibilityTransactionTest.java
index 9b47fc7a948e01faa780a7e25892d3bc12069275..3510087ad05b403f94e75ebe510e08c2f94fd056 100644
--- a/src/test/java/io/papermc/paper/plugin/manager/compat/CompatibilityTransactionTest.java
+++ b/src/test/java/io/papermc/paper/plugin/manager/compat/CompatibilityTransactionTest.java
@@ -41,7 +41,7 @@ class CompatibilityTransactionTest {
         final EventSemanticIndex.EventSemantics semantics = index.resolve(event, new RegisteredListener[] {registered});
         final CompatibilityTransaction transaction = new CompatibilityTransaction(event, semantics);
 
-        final CompatibilityTransaction.ListenerSnapshot before = transaction.beforeListener();
+        final CompatibilityTransaction.ListenerSnapshot before = transaction.beforeListener(EventSemanticIndex.Lane.MONITOR);
         final long started = System.nanoTime();
         registered.callEvent(event);
         transaction.afterListener(registered, EventSemanticIndex.lane(registered.getPriority()), before, System.nanoTime() - started);
@@ -71,6 +71,27 @@ class CompatibilityTransactionTest {
         Assertions.assertEquals("cancelled", transaction.abortReason());
     }
 
+    @Test
+    void nonMonitorLaneSkipsReflectiveDigest() {
+        final Plugin plugin = mockPlugin("FastPath");
+        final Listener listener = Mockito.mock(Listener.class);
+        final RegisteredListener registered = new RegisteredListener(
+            listener,
+            (ignored, event) -> {
+            },
+            EventPriority.NORMAL,
+            plugin,
+            false
+        );
+
+        final TestExplosiveHashEvent event = new TestExplosiveHashEvent();
+        final EventSemanticIndex.EventSemantics semantics = new EventSemanticIndex().resolve(event, new RegisteredListener[] {registered});
+        final CompatibilityTransaction transaction = new CompatibilityTransaction(event, semantics);
+        final CompatibilityTransaction.ListenerSnapshot before = transaction.beforeListener(EventSemanticIndex.Lane.NORMAL);
+
+        Assertions.assertDoesNotThrow(() -> transaction.afterListener(registered, EventSemanticIndex.Lane.NORMAL, before, 1L));
+    }
+
     private static Plugin mockPlugin(final String name) {
         final PluginMeta meta = Mockito.mock(PluginMeta.class);
         Mockito.when(meta.getName()).thenReturn(name);
@@ -119,4 +140,24 @@ class CompatibilityTransactionTest {
             return HANDLERS;
         }
     }
+
+    private static final class TestExplosiveHashEvent extends Event {
+        private static final HandlerList HANDLERS = new HandlerList();
+
+        private final Object payload = new Object() {
+            @Override
+            public int hashCode() {
+                throw new AssertionError("non-MONITOR listener must not digest payload");
+            }
+        };
+
+        @Override
+        public HandlerList getHandlers() {
+            return HANDLERS;
+        }
+
+        public static HandlerList getHandlerList() {
+            return HANDLERS;
+        }
+    }
 }
