From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: anxelok <anxelok@localhost>
Date: Fri, 3 Jul 2026 12:09:44 +0000
Subject: [PATCH] Retry a busy plugin apartment briefly before dropping a
 dispatch

When an event listener had to run through its plugin apartment on an
owner-domain thread and the lease was held elsewhere, the dispatch was
dropped immediately. The holder is normally another worker finishing a
listener within microseconds, so most of those losses were avoidable,
and for cancellable events a lost dispatch means a lost cancellation.

Retry the lease for a bounded budget before giving up, and record the
wait in the plugin's diagnostics profile. The budget is a hard cap so
a holder that is itself blocked on this thread's phase join costs at
most the budget rather than a deadlock. Off-owner callers keep their
existing strict-fallback handoff and get no retry. The budget is
tunable with Loom.CompatApartmentWaitMillis and defaults to 5.

diff --git a/src/main/java/io/papermc/paper/plugin/manager/PaperEventManager.java b/src/main/java/io/papermc/paper/plugin/manager/PaperEventManager.java
index fb62c3167fd7ddf22cbbe2433f610c48cab1b555..ab438e9ee827fde2aa6f5756d3850eafcbe5cd5c 100644
--- a/src/main/java/io/papermc/paper/plugin/manager/PaperEventManager.java
+++ b/src/main/java/io/papermc/paper/plugin/manager/PaperEventManager.java
@@ -35,6 +35,12 @@ import org.jetbrains.annotations.NotNull;
 
 class PaperEventManager {
 
+    // Maximum time an owner-domain thread may retry a busy plugin apartment. A hard deadline prevents the
+    // retry from waiting indefinitely when the lease holder is blocked on this thread's phase join.
+    private static final long APARTMENT_CONTENTION_WAIT_NANOS = java.util.concurrent.TimeUnit.MILLISECONDS.toNanos(
+        Math.max(0L, Long.getLong("Loom.CompatApartmentWaitMillis", 5L))
+    );
+
     private final Server server;
     private final CompatibilityKernel compatibilityKernel;
 
@@ -185,20 +191,17 @@ class PaperEventManager {
         final String path
     ) throws Throwable {
         final CompatibilityApartment apartment = this.compatibilityKernel.apartmentFor(registration.getPlugin());
-        try (CompatibilityApartment.Scope scope = apartment.enter(transaction, strictFallback, path)) {
+        try (CompatibilityApartment.Scope scope = this.enterApartmentBounded(apartment, transaction, strictFallback, path, profile, event)) {
             if (!scope.acquired()) {
                 // Apartment contention is local to this dispatch. It must not persistently change the plugin
                 // classification to LEGACY_STRICT or REFUSED: that would drop later events, including events
                 // that can run safely on their owner thread. Record this refusal only for diagnostics.
                 if (OwnerDomainExecutor.canRunSynchronousCallbacks()) {
-                    // The owner thread is hard-blocked in futures.join() during the parallel phase, so we can
-                    // neither run the listener inline here (off-owner, would race shared plugin state) nor
-                    // synchronously round-trip to the owner (deadlock). Post-facto events were already routed
-                    // to the owner by RegionTickStaging.deferEventToOwner before reaching this path; anything
-                    // still arriving here is the staged-veto class (cancellation must suppress a synchronous
-                    // side effect) which cannot be deferred without firing-site staging. Drop ONLY this one
-                    // dispatch (no persistent classification change), recording it for the diagnostics counter so the
-                    // remaining gap stays visible.
+                    // The bounded retry in enterApartmentBounded already waited for the lease. Reaching this
+                    // point means the holder did not release it within the budget, so running the listener
+                    // inline (off-owner, would race shared plugin state) and a synchronous round-trip to the
+                    // owner (deadlock while it joins the parallel phase) both stay off the table. Drop this
+                    // dispatch without changing the persistent classification and record it for diagnostics.
                     this.compatibilityKernel.diagnostics().recordTransientRefusal(
                         profile,
                         "transient apartment contention for " + event.getEventName() + " lane=" + registration.getPriority()
@@ -239,6 +242,40 @@ class PaperEventManager {
         }
     }
 
+    // Attempts to acquire the plugin apartment and briefly retries on an owner-domain thread. The deadline
+    // bounds the wait when the lease holder is blocked on this thread's phase join. Off-owner callers use
+    // the strict-fallback executor instead.
+    private CompatibilityApartment.Scope enterApartmentBounded(
+        final CompatibilityApartment apartment,
+        final CompatibilityTransaction transaction,
+        final boolean strictFallback,
+        final String path,
+        final PluginCompatibilityProfile profile,
+        final Event event
+    ) {
+        CompatibilityApartment.Scope scope = apartment.enter(transaction, strictFallback, path);
+        if (scope.acquired()
+            || APARTMENT_CONTENTION_WAIT_NANOS <= 0L
+            || !OwnerDomainExecutor.canRunSynchronousCallbacks()) {
+            return scope;
+        }
+        final long start = System.nanoTime();
+        final long deadline = start + APARTMENT_CONTENTION_WAIT_NANOS;
+        do {
+            java.util.concurrent.locks.LockSupport.parkNanos(50_000L);
+            scope = apartment.enter(transaction, strictFallback, path);
+            if (scope.acquired()) {
+                this.compatibilityKernel.diagnostics().recordOwnerRpcWait(
+                    profile,
+                    "apartment-contention-wait:" + event.getEventName(),
+                    System.nanoTime() - start
+                );
+                return scope;
+            }
+        } while (System.nanoTime() < deadline);
+        return scope;
+    }
+
     private void callListener(
         final RegisteredListener registration,
         final Event event,
