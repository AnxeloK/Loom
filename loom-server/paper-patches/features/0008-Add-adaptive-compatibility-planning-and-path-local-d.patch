+    public InvocationPlan planFor(
+        final RegisteredListener listener,
+        final CompatibilityTransaction transaction,
+        final RoutingDecision routingDecision
+    ) {
+        final PluginCompatibilityProfile profile = this.profileFor(listener.getPlugin());
+        final String path = pathFor(transaction, listener);
+        final PluginCompatibilityProfile.State state = profile.stateForPath(path);
+        final CompatibilityMode compatibilityMode = configuredMode();
+
+        if (profile.mode() == PluginCompatibilityProfile.Mode.REFUSED || state == PluginCompatibilityProfile.State.REFUSED) {
+            return new InvocationPlan(InvocationPolicy.REFUSE, ExecutionLane.REFUSAL_LANE, path, "profile/path refused");
+        }
+
+        if (compatibilityMode == CompatibilityMode.STRICT && state == PluginCompatibilityProfile.State.FORCED_MAX_COMPAT) {
+            return new InvocationPlan(InvocationPolicy.REFUSE, ExecutionLane.REFUSAL_LANE, path, "strict mode refuses forced max-compat path");
+        }
+
+        if (compatibilityMode == CompatibilityMode.MAX_COMPAT) {
+            if (profile.mode() == PluginCompatibilityProfile.Mode.NATIVE_LOOM_AWARE && state == PluginCompatibilityProfile.State.NATIVE_FAST_PATH
+                && routingDecision.route() == DispatchRoute.NATIVE_FAST_PATH) {
+                return new InvocationPlan(InvocationPolicy.NATIVE, ExecutionLane.FAST_LANE, path, "max-compat preserved native fast path");
+            }
+            return new InvocationPlan(InvocationPolicy.EMERGENCY_COMPATIBILITY, ExecutionLane.EMERGENCY_COMPATIBILITY_LANE, path, "max-compat policy");
+        }
+
+        if (state == PluginCompatibilityProfile.State.FORCED_MAX_COMPAT) {
+            return new InvocationPlan(
+                InvocationPolicy.EMERGENCY_COMPATIBILITY,
+                ExecutionLane.EMERGENCY_COMPATIBILITY_LANE,
+                path,
+                "path forced to max compatibility"
+            );
+        }
+
+        final InvocationPolicy policy = this.policyFor(profile);
+        final ExecutionLane lane = laneFor(policy, routingDecision);
+        return new InvocationPlan(policy, lane, path, routingDecision.reason());
+    }
+
+    public static String pathFor(final CompatibilityTransaction transaction, final RegisteredListener listener) {
+        return "event:" + transaction.event().getEventName()
+            + "#priority:" + listener.getPriority().name()
+            + "#ignoreCancelled:" + listener.isIgnoringCancelled();
+    }
+
     public void finishTransaction(final CompatibilityTransaction transaction) {
         transaction.finish();
         this.diagnostics.recordTransaction(transaction);
@@ -122,4 +186,25 @@ public final class CompatibilityKernel {
     ) {
         profile.noteMonitorMutation("MONITOR lane mutated " + mutation.event() + " in tx=" + mutation.transactionId());
     }
+
+    private static ExecutionLane laneFor(final InvocationPolicy policy, final RoutingDecision routingDecision) {
+        return switch (policy) {
+            case NATIVE -> ExecutionLane.FAST_LANE;
+            case APARTMENT -> switch (routingDecision.route()) {
+                case ORDERED_DECISION, MUTATION_TRANSACTION -> ExecutionLane.TRANSACTION_LANE;
+                case SNAPSHOT_OBSERVER, UNSAFE_INTERNAL, STRICT_REFUSAL, NATIVE_FAST_PATH -> ExecutionLane.APARTMENT_LANE;
+            };
+            case STRICT_FALLBACK -> ExecutionLane.TRANSACTION_LANE;
+            case EMERGENCY_COMPATIBILITY -> ExecutionLane.EMERGENCY_COMPATIBILITY_LANE;
+            case REFUSE -> ExecutionLane.REFUSAL_LANE;
+        };
+    }
+
+    private static CompatibilityMode configuredMode() {
+        final GlobalConfiguration globalConfiguration = GlobalConfiguration.get();
+        if (globalConfiguration == null || globalConfiguration.compatibility == null) {
+            return CompatibilityMode.HYBRID;
+        }
+        return CompatibilityMode.fromConfig(globalConfiguration.compatibility.mode);
+    }
 }
