@@ -0,0 +1,52 @@
+package org.bukkit.craftbukkit.entity;
+
+import java.io.IOException;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.CompletionException;
+import net.minecraft.server.level.ServerPlayer;
+import net.minecraft.server.dedicated.DedicatedPlayerList;
+import org.bukkit.craftbukkit.CraftServer;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+@Normal
+public class CraftPlayerSaveTest {
+    @Test void asyncCompletionComesFromTheOrderedNativeSave() {
+        DedicatedPlayerList players = mock(DedicatedPlayerList.class);
+        ServerPlayer player = mock(ServerPlayer.class);
+        CompletableFuture<Void> nativeSave = new CompletableFuture<>();
+        CraftPlayer craft = player(players, player);
+        when(players.savePlayerDataAsync(player)).thenReturn(nativeSave);
+        CompletableFuture<Void> result = craft.saveDataAsync();
+        assertFalse(result.isDone()); verify(players).savePlayerDataAsync(player);
+        nativeSave.complete(null); assertDoesNotThrow(result::join);
+    }
+    @Test void failedNativeCheckpointIsNotReportedAsSuccess() {
+        DedicatedPlayerList players = mock(DedicatedPlayerList.class);
+        ServerPlayer player = mock(ServerPlayer.class);
+        IOException failure = new IOException("fixture disk failure");
+        CraftPlayer craft = player(players, player);
+        when(players.savePlayerDataAsync(player)).thenReturn(CompletableFuture.failedFuture(failure));
+        assertSame(failure, assertThrows(CompletionException.class, () -> craft.saveDataAsync().join()).getCause());
+    }
+    private static CraftPlayer player(DedicatedPlayerList players, ServerPlayer player) {
+        CraftServer server = mock(CraftServer.class);
+        when(server.getHandle()).thenReturn(players);
+        when(player.getUUID()).thenReturn(java.util.UUID.randomUUID());
+        when(server.getDefaultGameMode()).thenReturn(org.bukkit.GameMode.SURVIVAL);
+        doReturn(net.minecraft.world.entity.EntityTypes.PLAYER).when(player).getType();
+        when(player.getInventory()).thenReturn(mock(net.minecraft.world.entity.player.Inventory.class));
+        when(player.getEnderChestInventory()).thenReturn(mock(net.minecraft.world.inventory.PlayerEnderChestContainer.class));
+        return new CraftPlayer(server, player);
+    }
+    @Test void legacySaveKeepsTheDisabledSavingNoOp() {
+        boolean original = org.spigotmc.SpigotConfig.disablePlayerDataSaving;
+        try {
+            org.spigotmc.SpigotConfig.disablePlayerDataSaving = true;
+            CraftPlayer craft = mock(CraftPlayer.class); doCallRealMethod().when(craft).saveData();
+            assertDoesNotThrow(craft::saveData); verify(craft, never()).getServer();
+        } finally { org.spigotmc.SpigotConfig.disablePlayerDataSaving = original; }
+    }
+}
