diff --git a/src/test/java/net/minecraft/world/level/storage/PlayerDataCheckpointTest.java b/src/test/java/net/minecraft/world/level/storage/PlayerDataCheckpointTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..8063f6208b63fdf3cfd6c9c0a77c3b7658a8f976
--- /dev/null
+++ b/src/test/java/net/minecraft/world/level/storage/PlayerDataCheckpointTest.java
@@ -0,0 +1,73 @@
+package net.minecraft.world.level.storage;
+
+import com.mojang.datafixers.DataFixer;
+import java.io.DataOutput;
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.UUID;
+import net.minecraft.nbt.CompoundTag;
+import net.minecraft.nbt.NbtAccounter;
+import net.minecraft.nbt.NbtIo;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+@Normal
+public class PlayerDataCheckpointTest {
+    @TempDir Path directory;
+    final UUID id = UUID.randomUUID();
+    PlayerDataStorage storage;
+    @BeforeEach void setup() {
+        var access = mock(LevelStorageSource.LevelStorageAccess.class);
+        when(access.getLevelPath(LevelResource.PLAYER_DATA_DIR)).thenReturn(directory);
+        storage = new PlayerDataStorage(access, mock(DataFixer.class));
+    }
+    PlayerDataStorage.PendingSave save(int value) {
+        CompoundTag data = new CompoundTag(); data.putInt("inventory-receipt", value);
+        return new PlayerDataStorage.PendingSave(id.toString(), "CheckpointFixture", data);
+    }
+    Path current() { return directory.resolve(id + ".dat"); }
+    Path previous() { return directory.resolve(id + ".dat_old"); }
+    int read(Path path) throws IOException { return NbtIo.readCompressed(path, NbtAccounter.unlimitedHeap()).getIntOr("inventory-receipt", -1); }
+    void noTemporaryFiles() throws IOException {
+        try (var files = Files.list(directory)) {
+            assertFalse(files.anyMatch(path -> path.getFileName().toString().contains("-checkpoint-") || path.getFileName().toString().contains("-backup-")));
+        }
+    }
+    @Test void firstCheckpointIsReadableAfterCompletion() throws Exception {
+        storage.writeSaveChecked(save(1));
+        assertEquals(1, read(current())); assertFalse(Files.exists(previous())); noTemporaryFiles();
+    }
+    @Test void replacingAFileKeepsItsPreviousCompleteData() throws Exception {
+        storage.writeSaveChecked(save(1)); storage.writeSaveChecked(save(2));
+        assertEquals(2, read(current())); assertEquals(1, read(previous())); noTemporaryFiles();
+    }
+    @Test void failedOutputCannotReplaceTheLastSuccessfulPlayerFile() throws Exception {
+        storage.writeSaveChecked(save(1)); byte[] original = Files.readAllBytes(current());
+        CompoundTag broken = mock(CompoundTag.class); when(broken.getId()).thenReturn((byte) 10);
+        doAnswer(call -> {
+            ((DataOutput) call.getArgument(0)).write(new byte[4096]);
+            throw new IOException("fixture interrupted compressed output");
+        }).when(broken).write(any(DataOutput.class));
+        assertThrows(IOException.class, () -> storage.writeSaveChecked(new PlayerDataStorage.PendingSave(id.toString(), "CheckpointFixture", broken)));
+        assertArrayEquals(original, Files.readAllBytes(current())); assertEquals(1, read(current())); noTemporaryFiles();
+    }
+    @Test void failedBackupLeavesTheCurrentInventoryUnchanged() throws Exception {
+        storage.writeSaveChecked(save(1)); Files.createDirectory(previous());
+        assertThrows(IOException.class, () -> storage.writeSaveChecked(save(2)));
+        assertEquals(1, read(current())); assertTrue(Files.isDirectory(previous())); noTemporaryFiles();
+    }
+    @Test void aDirectoryAtThePlayerFileIsAnObservableFailure() throws Exception {
+        Files.createDirectory(current());
+        assertThrows(IOException.class, () -> storage.writeSaveChecked(save(1)));
+        assertTrue(Files.isDirectory(current())); noTemporaryFiles();
+    }
+    @Test void invalidIdentityCannotWriteOutsidePlayerStorage() throws Exception {
+        assertThrows(IllegalArgumentException.class, () -> storage.writeSaveChecked(new PlayerDataStorage.PendingSave("../outside", "CheckpointFixture", new CompoundTag())));
+        try (var files = Files.list(directory)) { assertEquals(0, files.count()); }
+    }
+}
diff --git a/src/test/java/org/bukkit/craftbukkit/entity/CraftPlayerSaveTest.java b/src/test/java/org/bukkit/craftbukkit/entity/CraftPlayerSaveTest.java
