diff --git a/src/test/java/net/minecraft/server/threading/runtime/OwnerDomainExecutorCooperativeWaitTest.java b/src/test/java/net/minecraft/server/threading/runtime/OwnerDomainExecutorCooperativeWaitTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..7b6b62607a7ba27639c234b465cdf5df46abf4ac
--- /dev/null
+++ b/src/test/java/net/minecraft/server/threading/runtime/OwnerDomainExecutorCooperativeWaitTest.java
@@ -0,0 +1,56 @@
+package net.minecraft.server.threading.runtime;
+
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.concurrent.atomic.AtomicReference;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.world.level.Level;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Assertions;
+import org.junit.jupiter.api.Test;
+import org.mockito.Mockito;
+
+@Normal
+class OwnerDomainExecutorCooperativeWaitTest {
+
+    @Test
+    void delegatedWorkCanCallBackIntoWaitingOwner() throws InterruptedException {
+        final MinecraftServer server = Mockito.mock(MinecraftServer.class);
+        final ServerLevel level = Mockito.mock(ServerLevel.class);
+        Mockito.when(level.getServer()).thenReturn(server);
+        Mockito.when(level.dimension()).thenReturn(Level.OVERWORLD);
+        final OwnerDomainExecutor.Owner owner = OwnerDomainExecutor.region(level, 3, 7, "cooperative-wait-test");
+        final AtomicInteger callbacks = new AtomicInteger();
+        final AtomicReference<String> result = new AtomicReference<>();
+        final AtomicReference<Throwable> failure = new AtomicReference<>();
+        final AtomicReference<Thread> ownerThreadReference = new AtomicReference<>();
+
+        final Thread ownerThread = new Thread(() -> {
+            try (OwnerDomainExecutor.Scope ignored = OwnerDomainExecutor.enter(owner)) {
+                result.set(OwnerDomainExecutor.awaitCooperatively(
+                    () -> CompletableFuture.supplyAsync(() -> OwnerDomainExecutor.supply(owner, () -> {
+                        Assertions.assertTrue(OwnerDomainExecutor.isOwner(owner));
+                        Assertions.assertSame(Thread.currentThread(), ownerThreadReference.get());
+                        callbacks.incrementAndGet();
+                        return "delivered";
+                    }).join()),
+                    "cooperative-wait-test"
+                ));
+            } catch (final Throwable throwable) {
+                failure.set(throwable);
+            }
+        }, "cooperative-owner");
+        ownerThreadReference.set(ownerThread);
+        ownerThread.setDaemon(true);
+        ownerThread.start();
+        ownerThread.join(TimeUnit.SECONDS.toMillis(5L));
+
+        Assertions.assertFalse(ownerThread.isAlive(), "cooperative owner wait did not complete");
+        Assertions.assertNull(failure.get());
+        Assertions.assertEquals("delivered", result.get());
+        Assertions.assertEquals(1, callbacks.get());
+        Assertions.assertEquals(0, OwnerDomainExecutor.activeCooperativeWaits());
+    }
+}
