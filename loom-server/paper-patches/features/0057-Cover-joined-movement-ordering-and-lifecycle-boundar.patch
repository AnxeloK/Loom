+package net.minecraft.server;
+
+import java.lang.reflect.Constructor;
+import java.lang.reflect.Field;
+import java.lang.reflect.Method;
+import java.util.Arrays;
+import net.minecraft.network.PacketProcessor;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+@Normal
+class PlayerPacketDrainBudgetTest {
+    @Test
+    void aBusyLargeServerStillServicesANormalClientFramesPackets() throws Exception {
+        Fixture f = new Fixture(100);
+        f.packets(299);
+        assertTrue(f.shouldDrain(), "The expired soft budget must not leave a normal client frame queued");
+        f.packets(300);
+        assertFalse(f.shouldDrain(), "The normal frame floor must not remove the soft budget");
+    }
+
+    @Test
+    void smallServersRetainTheirExistingMinimumAndTimeBudget() throws Exception {
+        for (int players : new int[]{0, 1, 10}) {
+            Fixture f = new Fixture(players);
+            f.packets(31);
+            assertTrue(f.shouldDrain());
+            f.packets(32);
+            assertFalse(f.shouldDrain());
+            f.nanos.setLong(f.drain, 0L);
+            assertTrue(f.shouldDrain(), "Available time still permits more queued work");
+        }
+    }
+
+    @Test
+    void theConfiguredMaximumStillBoundsAnOverloadedLargePopulation() throws Exception {
+        Fixture f = new Fixture(Integer.MAX_VALUE);
+        f.packets(2047);
+        assertTrue(f.shouldDrain());
+        f.packets(2048);
+        assertFalse(f.shouldDrain());
+    }
+
+    private static final class Fixture {
+        final MinecraftServer server = mock(MinecraftServer.class);
+        final Object drain;
+        final Method shouldDrain;
+        final Field packets;
+        final Field nanos;
+
+        Fixture(int players) throws Exception {
+            Class<?> type = Arrays.stream(MinecraftServer.class.getDeclaredClasses())
+                .filter(candidate -> candidate.getSimpleName().equals("TickStartPacketDrain")).findFirst().orElseThrow();
+            Constructor<?> constructor = type.getDeclaredConstructor(int.class);
+            constructor.setAccessible(true);
+            drain = constructor.newInstance(players);
+            packets = type.getDeclaredField("packets");
+            packets.setAccessible(true);
+            nanos = type.getDeclaredField("nanos");
+            nanos.setAccessible(true);
+            nanos.setLong(drain, Long.MAX_VALUE);
+            shouldDrain = MinecraftServer.class.getDeclaredMethod("shouldDrainTickStartPacket", type);
+            shouldDrain.setAccessible(true);
+            Field processor = MinecraftServer.class.getDeclaredField("packetProcessor");
+            processor.setAccessible(true);
+            processor.set(server, new PacketProcessor(Thread.currentThread()));
+        }
+
+        void packets(int count) throws Exception {
+            packets.setInt(drain, count);
+        }
+
+        boolean shouldDrain() throws Exception {
+            return (boolean)shouldDrain.invoke(server, drain);
+        }
+    }
+}
