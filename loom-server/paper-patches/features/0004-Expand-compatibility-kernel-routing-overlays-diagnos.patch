                         case STRICT_FALLBACK -> {
                             this.compatibilityKernel.diagnostics().recordStrictFallback(profile, "strict policy for " + event.getEventName());
@@ -109,6 +123,9 @@ class PaperEventManager {
                 } catch (final Throwable ex) {
                     final String msg = "Could not pass event " + event.getEventName() + " to " + plugin.getPluginMeta().getDisplayName();
                     this.server.getLogger().log(Level.SEVERE, msg, ex);
+                    if (transaction.pendingWriteCount() > 0) {
+                        transaction.abort("listener exception in " + plugin.getPluginMeta().getName());
+                    }
