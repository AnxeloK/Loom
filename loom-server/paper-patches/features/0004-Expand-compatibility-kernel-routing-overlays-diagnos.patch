                         this.callEvent(new ServerExceptionEvent(new ServerEventException(msg, ex, plugin, registration.getListener(), event)));
                     }
@@ -144,24 +161,55 @@ class PaperEventManager {
                     profile,
                     "apartment busy in " + event.getEventName() + " owner=" + scope.busyLease()
                 );
-                this.callListener(registration, event, transaction.id(), true);
+                if (OwnerDomainExecutor.canRunSynchronousCallbacks()) {
+                    this.compatibilityKernel.diagnostics().recordRefusal(
+                        profile,
+                        "owner-domain contention refusal for " + event.getEventName() + " lane=" + registration.getPriority()
+                    );
+                    return;
+                }
+                final long handoffStart = System.nanoTime();
+                try {
+                    apartment.submitStrictFallback(() -> {
+                        try (CompatibilityApartment.Scope handoffScope = apartment.enter(transaction, true)) {
+                            if (!handoffScope.acquired()) {
+                                throw new IllegalStateException("Strict fallback apartment handoff failed: " + handoffScope.busyLease());
+                            }
+                            this.callListener(registration, event, transaction, true);
+                        }
+                        return null;
+                    }).join();
+                } catch (final CompletionException ex) {
+                    throw unwrapCompletionException(ex);
+                } finally {
+                    this.compatibilityKernel.diagnostics().recordOwnerRpcWait(
+                        profile,
+                        "apartment-handoff:" + event.getEventName(),
+                        System.nanoTime() - handoffStart
+                    );
+                }
                 return;
             }
-            this.callListener(registration, event, transaction.id(), strictFallback);
+            this.callListener(registration, event, transaction, strictFallback);
         }
     }
 
     private void callListener(
         final RegisteredListener registration,
         final Event event,
-        final long transactionId,
+        final CompatibilityTransaction transaction,
         final boolean strictFallback
     ) throws Throwable {
-        try (CompatibilityRuntimeContext.Scope ignored = CompatibilityRuntimeContext.enter(registration.getPlugin(), transactionId, strictFallback)) {
+        try (CompatibilityRuntimeContext.Scope ignored = CompatibilityRuntimeContext.enter(registration.getPlugin(), transaction, strictFallback)) {
             registration.callEvent(event);
         }
     }
 
+    private static Throwable unwrapCompletionException(final CompletionException completionException) {
+        final Throwable cause = completionException.getCause();
+        return cause == null ? completionException : cause;
+    }
