     private final Plugin plugin;
+    private final ExecutorService strictFallbackExecutor;
     private final AtomicReference<@Nullable Lease> activeLease = new AtomicReference<>();
 
     public CompatibilityApartment(final Plugin plugin) {
         this.plugin = Objects.requireNonNull(plugin, "plugin");
+        this.strictFallbackExecutor = Executors.newSingleThreadExecutor(runnable -> {
+            final Thread thread = new Thread(runnable, "Loom Compat " + this.plugin.getPluginMeta().getName());
+            thread.setDaemon(true);
+            return thread;
+        });
     }
 
     public Plugin plugin() {
         return this.plugin;
     }
 
+    public <T> CompletableFuture<T> submitStrictFallback(final Callable<T> action) {
+        final CompletableFuture<T> future = new CompletableFuture<>();
+        this.strictFallbackExecutor.execute(() -> {
+            try {
+                future.complete(action.call());
+            } catch (final Throwable throwable) {
+                future.completeExceptionally(throwable);
+            }
+        });
+        return future;
+    }
