+    // A plain class rather than a record so the facade scope cache can be lazy: nearly every listener
+    // scope never touches a facade, so the per-scope HashMap is only allocated on first use.
+    public static final class ScopeState {
+        private final Plugin plugin;
+        private final @Nullable CompatibilityTransaction transaction;
+        private final long transactionId;
+        private final boolean strictFallback;
+        private final String path;
+        private final long scopeId;
+        private @Nullable Map<Object, Object> facadeScopeCache;
+
+        private ScopeState(
+            final Plugin plugin,
+            final @Nullable CompatibilityTransaction transaction,
+            final long transactionId,
+            final boolean strictFallback,
+            final String path,
+            final long scopeId
+        ) {
+            this.plugin = plugin;
+            this.transaction = transaction;
+            this.transactionId = transactionId;
+            this.strictFallback = strictFallback;
+            this.path = path;
+            this.scopeId = scopeId;
+        }
+
+        public Plugin plugin() {
+            return this.plugin;
+        }
+
+        public @Nullable CompatibilityTransaction transaction() {
+            return this.transaction;
+        }
+
+        public long transactionId() {
+            return this.transactionId;
+        }
+
+        public boolean strictFallback() {
+            return this.strictFallback;
+        }
+
+        public String path() {
+            return this.path;
+        }
+
+        public long scopeId() {
+            return this.scopeId;
+        }
+
+        @Nullable Map<Object, Object> facadeScopeCacheIfPresent() {
+            return this.facadeScopeCache;
+        }
+
+        Map<Object, Object> facadeScopeCacheOrCreate() {
+            Map<Object, Object> cache = this.facadeScopeCache;
+            if (cache == null) {
+                cache = new HashMap<>();
+                this.facadeScopeCache = cache;
+            }
+            return cache;
+        }
     }
 
