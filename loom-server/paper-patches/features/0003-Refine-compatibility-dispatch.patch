+    // Loom - acquire the plugin apartment, retrying briefly on an owner-domain thread instead of failing the
+    // dispatch outright. The busy lease normally belongs to another worker that releases it within
+    // microseconds; waiting a few milliseconds rescues the dispatch (and with it a protection plugin's
+    // cancellation) in almost every contention case. The budget is a hard bound so a holder that is itself
+    // blocked on this thread's phase join can only cost the budget, never a deadlock. Off-owner callers get
+    // no retry: their path below hands off to the plugin's strict-fallback thread and blocks safely there.
+    private CompatibilityApartment.Scope enterApartmentBounded(
+        final CompatibilityApartment apartment,
+        final CompatibilityTransaction transaction,
+        final boolean strictFallback,
+        final String path,
+        final PluginCompatibilityProfile profile,
+        final Event event
+    ) {
+        CompatibilityApartment.Scope scope = apartment.enter(transaction, strictFallback, path);
+        if (scope.acquired()
+            || APARTMENT_CONTENTION_WAIT_NANOS <= 0L
+            || !OwnerDomainExecutor.canRunSynchronousCallbacks()) {
+            return scope;
+        }
+        final long start = System.nanoTime();
+        final long deadline = start + APARTMENT_CONTENTION_WAIT_NANOS;
+        do {
+            java.util.concurrent.locks.LockSupport.parkNanos(50_000L);
+            scope = apartment.enter(transaction, strictFallback, path);
+            if (scope.acquired()) {
+                this.compatibilityKernel.diagnostics().recordOwnerRpcWait(
+                    profile,
+                    "apartment-contention-wait:" + event.getEventName(),
+                    System.nanoTime() - start
+                );
+                return scope;
+            }
+        } while (System.nanoTime() < deadline);
+        return scope;
+    }
