     private static final AtomicInteger ID_GENERATOR = new AtomicInteger();
+    private static final Set<TickThread> TICK_THREADS = ConcurrentHashMap.newKeySet();
+
+    // Loom - each tick worker publishes its own diagnostic entity. A single process-wide atomic reference
+    // both lost all but one concurrently ticking entity and forced every worker to contend on the same cache
+    // line in the hottest entity path.
+    public volatile Entity currentlyTickingEntity;
 
     public TickThread(final String name) {
         this(null, name);
@@ -121,6 +131,27 @@ public class TickThread extends Thread {
     private TickThread(final ThreadGroup group, final Runnable run, final String name, final int id) {
         super(group, run, name);
         this.id = id;
+        TICK_THREADS.add(this);
+    }
+
+    @Override
+    public void run() {
+        try {
+            super.run();
+        } finally {
+            TICK_THREADS.remove(this);
+        }
+    }
+
+    public static List<Entity> getCurrentlyTickingEntities() {
+        final List<Entity> ret = new ArrayList<>();
+        for (final TickThread thread : TICK_THREADS) {
+            final Entity entity = thread.currentlyTickingEntity;
+            if (entity != null) {
+                ret.add(entity);
+            }
+        }
+        return ret;
     }
 
