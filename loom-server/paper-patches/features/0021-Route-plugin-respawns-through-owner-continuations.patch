diff --git a/src/test/java/net/minecraft/server/players/PlayerRespawnOperationTest.java b/src/test/java/net/minecraft/server/players/PlayerRespawnOperationTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..bd798e59caaf07cce5d68c2c76b8adff0fca212a
--- /dev/null
+++ b/src/test/java/net/minecraft/server/players/PlayerRespawnOperationTest.java
@@ -0,0 +1,60 @@
+package net.minecraft.server.players;
+
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.CompletionException;
+import java.util.concurrent.atomic.AtomicInteger;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+@Normal
+class PlayerRespawnOperationTest {
+    @Test
+    void overlappingClientAndPluginRequestsWaitForOneTransfer() {
+        final PlayerRespawnOperation operation = new PlayerRespawnOperation();
+        final CompletableFuture<Void> transfer = new CompletableFuture<>();
+        final AtomicInteger starts = new AtomicInteger();
+        final CompletableFuture<Void> plugin = operation.start(() -> { starts.incrementAndGet(); return transfer; });
+        final CompletableFuture<Void> client = operation.start(() -> { starts.incrementAndGet(); return transfer; });
+        assertEquals(1, starts.get());
+        assertFalse(plugin.isDone());
+        assertFalse(client.isDone());
+        transfer.complete(null);
+        assertDoesNotThrow(plugin::join);
+        assertDoesNotThrow(client::join);
+    }
+
+    @Test
+    void callerCancellationCannotReleaseThePendingRespawn() {
+        final PlayerRespawnOperation operation = new PlayerRespawnOperation();
+        final CompletableFuture<Void> transfer = new CompletableFuture<>();
+        operation.start(() -> transfer).cancel(false);
+        final CompletableFuture<Void> next = operation.start(() -> fail("Second respawn started"));
+        assertFalse(next.isDone());
+        assertFalse(transfer.isCancelled());
+        transfer.complete(null);
+        assertDoesNotThrow(next::join);
+    }
+
+    @Test
+    void failedTransferReachesEveryCallerAndAllowsRetry() {
+        final PlayerRespawnOperation operation = new PlayerRespawnOperation();
+        final CompletableFuture<Void> transfer = new CompletableFuture<>();
+        final CompletableFuture<Void> first = operation.start(() -> transfer);
+        final CompletableFuture<Void> second = operation.start(() -> fail("Duplicate respawn"));
+        final IllegalStateException failure = new IllegalStateException("Destination unavailable");
+        transfer.completeExceptionally(failure);
+        assertSame(failure, assertThrows(CompletionException.class, first::join).getCause());
+        assertSame(failure, assertThrows(CompletionException.class, second::join).getCause());
+        assertDoesNotThrow(() -> operation.start(() -> CompletableFuture.completedFuture(null)).join());
+    }
+
+    @Test
+    void failedStartDoesNotLeaveTheSessionStuck() {
+        final PlayerRespawnOperation operation = new PlayerRespawnOperation();
+        final IllegalStateException failure = new IllegalStateException("No current player");
+        assertSame(failure, assertThrows(CompletionException.class,
+            () -> operation.start(() -> { throw failure; }).join()).getCause());
+        assertDoesNotThrow(() -> operation.start(() -> CompletableFuture.completedFuture(null)).join());
+    }
+}
