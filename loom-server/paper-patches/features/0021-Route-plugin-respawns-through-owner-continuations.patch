index 0000000000000000000000000000000000000000..fae023546e7ab8ca10cfdcd327cb0e98da889c6f
--- /dev/null
+++ b/src/test/java/org/bukkit/craftbukkit/entity/CraftPlayerRespawnTest.java
@@ -0,0 +1,70 @@
+package org.bukkit.craftbukkit.entity;
+
+import java.util.concurrent.*;
+import java.util.function.Supplier;
+import net.minecraft.server.level.ServerPlayer;
+import net.minecraft.server.network.ServerGamePacketListenerImpl;
+import net.minecraft.server.threading.runtime.OwnerDomainExecutor;
+import org.bukkit.event.player.PlayerRespawnEvent.RespawnReason;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.mockito.MockedStatic;
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+@Normal
+public class CraftPlayerRespawnTest {
+    @Test void completionWaitsForDestinationRespawn() {
+        try (Fixture f = new Fixture()) {
+            CompletableFuture<Void> completed = f.craft.respawnAsync();
+            assertFalse(completed.isDone());
+            verify(f.connection).respawnAsync(RespawnReason.PLUGIN);
+            f.transfer.complete(null);
+            assertDoesNotThrow(completed::join);
+        }
+    }
+    @Test void transferFailuresReachTheCaller() {
+        try (Fixture f = new Fixture()) {
+            CompletableFuture<Void> completed = f.craft.respawnAsync();
+            IllegalStateException failure = new IllegalStateException("Spawn unavailable");
+            f.transfer.completeExceptionally(failure);
+            assertSame(failure, assertThrows(CompletionException.class, completed::join).getCause());
+        }
+    }
+    @Test void disconnectedPlayerCannotStartARespawn() {
+        try (Fixture f = new Fixture()) {
+            when(f.connection.isDisconnected()).thenReturn(true);
+            assertInstanceOf(CancellationException.class,
+                assertThrows(CompletionException.class, () -> f.craft.respawnAsync().join()).getCause());
+            verify(f.connection, never()).respawnAsync(any());
+        }
+    }
+    @Test void retiredHandleCannotRespawnAReplacementSession() {
+        try (Fixture f = new Fixture()) {
+            when(f.craft.getHandle()).thenReturn(f.player, mock(ServerPlayer.class));
+            assertInstanceOf(CancellationException.class,
+                assertThrows(CompletionException.class, () -> f.craft.respawnAsync().join()).getCause());
+            verify(f.connection, never()).respawnAsync(any());
+        }
+    }
+    private static final class Fixture implements AutoCloseable {
+        final CraftPlayer craft = mock(CraftPlayer.class);
+        final ServerPlayer player = mock(ServerPlayer.class);
+        final ServerGamePacketListenerImpl connection = mock(ServerGamePacketListenerImpl.class);
+        final CompletableFuture<Void> transfer = new CompletableFuture<>();
+        final MockedStatic<OwnerDomainExecutor> owners = mockStatic(OwnerDomainExecutor.class);
+        Fixture() {
+            player.connection = connection;
+            when(craft.getHandle()).thenReturn(player);
+            when(craft.respawnAsync()).thenCallRealMethod();
+            when(connection.respawnAsync(RespawnReason.PLUGIN)).thenReturn(transfer);
+            OwnerDomainExecutor.Owner owner = mock(OwnerDomainExecutor.Owner.class);
+            owners.when(() -> OwnerDomainExecutor.player(player, "plugin-respawn")).thenReturn(owner);
+            owners.when(() -> OwnerDomainExecutor.supply(eq(owner), any())).thenAnswer(call -> {
+                try { return CompletableFuture.completedFuture(((Supplier<?>) call.getArgument(1)).get()); }
+                catch (Throwable failure) { return CompletableFuture.failedFuture(failure); }
+            });
+        }
+        @Override public void close() { owners.close(); }
+    }
+}
