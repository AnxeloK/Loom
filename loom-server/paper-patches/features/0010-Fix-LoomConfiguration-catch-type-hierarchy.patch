diff --git a/src/main/java/io/papermc/paper/configuration/LoomConfiguration.java b/src/main/java/io/papermc/paper/configuration/LoomConfiguration.java
index 176e4487bbb45ce48a079f1308a262bd21045bff..c64d460e2a1cfa6488076b7dc548306709017aaf 100644
