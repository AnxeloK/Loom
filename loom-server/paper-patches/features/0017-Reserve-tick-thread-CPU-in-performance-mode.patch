From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: anxelok <anxelok@localhost>
Date: Tue, 2 Jun 2026 01:39:17 +0000
Subject: [PATCH] Reserve tick thread CPU in performance mode


diff --git a/src/main/java/ca/spottedleaf/moonrise/common/util/MoonriseCommon.java b/src/main/java/ca/spottedleaf/moonrise/common/util/MoonriseCommon.java
index 0f666660b8da4fde97d90bcc00f773050b5e4699..3e05fee1a7fc5d40f629625d77eb3cabbd671231 100644
--- a/src/main/java/ca/spottedleaf/moonrise/common/util/MoonriseCommon.java
+++ b/src/main/java/ca/spottedleaf/moonrise/common/util/MoonriseCommon.java
@@ -70,11 +70,11 @@ public final class MoonriseCommon {
 
         final int workerThreads = loomPerformanceWorkerThreads(OSNuma.getNativeInstance().getTotalCores());
         adjustWorkerThreads(workerThreads, configIoThreads);
-        LOGGER.info("Loom performance mode raised the implicit chunk worker default to " + workerThreads + " threads");
+        LOGGER.info("Loom performance mode set the implicit chunk worker default to " + workerThreads + " threads");
     }
 
     static int loomPerformanceWorkerThreads(final int totalCores) {
-        return Math.max(1, totalCores / 3);
+        return Math.max(1, totalCores / 8);
     }
 
     public static final long IO_QUEUE_HOLD_TIME = (long)(25.0e6); // 25ms
diff --git a/src/test/java/ca/spottedleaf/moonrise/common/util/MoonriseCommonTest.java b/src/test/java/ca/spottedleaf/moonrise/common/util/MoonriseCommonTest.java
index 2a3f3e92402b887a75c9c1408f8314206b364f76..6c52b30e62e9fa26f2afea0c7cb6de4f088dd888 100644
--- a/src/test/java/ca/spottedleaf/moonrise/common/util/MoonriseCommonTest.java
+++ b/src/test/java/ca/spottedleaf/moonrise/common/util/MoonriseCommonTest.java
@@ -11,7 +11,9 @@ class MoonriseCommonTest {
     void loomPerformanceWorkerDefaultLeavesTickThreadHeadroom() {
         Assertions.assertEquals(1, MoonriseCommon.loomPerformanceWorkerThreads(1));
         Assertions.assertEquals(1, MoonriseCommon.loomPerformanceWorkerThreads(2));
-        Assertions.assertEquals(2, MoonriseCommon.loomPerformanceWorkerThreads(6));
-        Assertions.assertEquals(4, MoonriseCommon.loomPerformanceWorkerThreads(12));
+        Assertions.assertEquals(1, MoonriseCommon.loomPerformanceWorkerThreads(6));
+        Assertions.assertEquals(1, MoonriseCommon.loomPerformanceWorkerThreads(12));
+        Assertions.assertEquals(2, MoonriseCommon.loomPerformanceWorkerThreads(16));
+        Assertions.assertEquals(4, MoonriseCommon.loomPerformanceWorkerThreads(32));
     }
 }
