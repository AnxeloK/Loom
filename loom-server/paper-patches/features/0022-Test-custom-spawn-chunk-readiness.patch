+package net.minecraft.world.level.levelgen;
+
+import ca.spottedleaf.concurrentutil.util.Priority;
+import io.papermc.paper.configuration.WorldConfiguration;
+import java.util.ArrayDeque;
+import java.util.List;
+import java.util.Optional;
+import java.util.Queue;
+import java.util.concurrent.CompletableFuture;
+import java.util.function.Consumer;
+import net.minecraft.core.BlockPos;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.server.level.ServerPlayer;
+import net.minecraft.server.threading.runtime.OwnerDomainExecutor;
+import net.minecraft.server.threading.runtime.OwnershipRouter;
+import net.minecraft.util.RandomSource;
+import net.minecraft.world.entity.EntityTypes;
+import net.minecraft.world.entity.SpawnPlacementType;
+import net.minecraft.world.entity.SpawnPlacements;
+import net.minecraft.world.entity.ai.village.poi.PoiManager;
+import net.minecraft.world.entity.npc.wanderingtrader.WanderingTraderSpawner;
+import net.minecraft.world.level.chunk.ChunkAccess;
+import net.minecraft.world.level.chunk.status.ChunkStatus;
+import net.minecraft.world.level.gamerules.GameRules;
+import net.minecraft.world.level.saveddata.WanderingTraderData;
+import net.minecraft.world.level.storage.SavedDataStorage;
+import org.bukkit.support.environment.VanillaFeature;
+import org.junit.jupiter.api.Test;
+import org.mockito.MockedStatic;
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+@VanillaFeature
+class WanderingTraderReadinessTest {
+    @Test void terrainSearchWaitsAndRetainsTheTenAttemptLimit() {
+        try (Fixture f = new Fixture()) {
+            assertDoesNotThrow(() -> f.spawner.tick(f.level, true));
+            verify(f.level, never()).getHeight(any(), anyInt(), anyInt());
+            assertEquals(1, f.requests);
+            for (int i = 0; i < 10; i++) f.resume();
+            assertTrue(f.callbacks.isEmpty());
+            assertEquals(10, f.requests);
+            verify(f.level, times(10)).getHeight(any(), anyInt(), anyInt());
+            verify(f.level, never()).addFreshEntityWithPassengers(any());
+        }
+    }
+
+    @Test void pendingSearchCannotFanOutEverySpawnInterval() {
+        try (Fixture f = new Fixture()) {
+            for (int i = 0; i < 100; i++) f.spawner.tick(f.level, true);
+            assertEquals(1, f.requests);
+        }
+    }
+
+    @Test void failedLoadAllowsTheNextAttempt() {
+        try (Fixture f = new Fixture()) {
+            f.spawner.tick(f.level, true);
+            f.futures.remove().completeExceptionally(new IllegalStateException("generation failed"));
+            f.callbacks.remove();
+            f.spawner.tick(f.level, true);
+            assertEquals(2, f.requests);
+            verify(f.level, never()).getHeight(any(), anyInt(), anyInt());
+        }
+    }
+
+    @Test void movedPlayerCannotStartTheOldTerrainSearch() {
+        try (Fixture f = new Fixture()) {
+            f.spawner.tick(f.level, true);
+            when(f.player.blockPosition()).thenReturn(BlockPos.ZERO);
+            f.resume();
+            verify(f.level, never()).getHeight(any(), anyInt(), anyInt());
+            assertEquals(1, f.requests);
+        }
+    }
+
+    @Test void retiredWorldAndChangedRuleCancelSearch() {
+        try (Fixture f = new Fixture()) {
+            f.spawner.tick(f.level, true);
+            when(f.server.getLevel(any())).thenReturn(null);
+            f.resume();
+            verify(f.level, never()).getHeight(any(), anyInt(), anyInt());
+        }
+        try (Fixture f = new Fixture()) {
+            f.spawner.tick(f.level, true);
+            when(f.rules.get(GameRules.SPAWN_WANDERING_TRADERS)).thenReturn(false);
+            f.resume();
+            verify(f.level, never()).getHeight(any(), anyInt(), anyInt());
+        }
+    }
+
+    private static final class Fixture implements AutoCloseable {
+        final ServerLevel level = mock(ServerLevel.class);
+        final MinecraftServer server = mock(MinecraftServer.class);
+        final ServerPlayer player = mock(ServerPlayer.class);
+        final GameRules rules = mock(GameRules.class);
+        final MockedStatic<OwnershipRouter> routing = mockStatic(OwnershipRouter.class);
+        final MockedStatic<RandomSource> randomFactory = mockStatic(RandomSource.class);
+        final MockedStatic<SpawnPlacements> placements = mockStatic(SpawnPlacements.class);
+        final Queue<Consumer<List<ChunkAccess>>> callbacks = new ArrayDeque<>();
+        final Queue<CompletableFuture<Void>> futures = new ArrayDeque<>();
+        final WanderingTraderSpawner spawner;
+        boolean ready;
+        int requests;
+        Fixture() {
+            RandomSource random = mock(RandomSource.class);
+            randomFactory.when(RandomSource::create).thenReturn(random);
+            SavedDataStorage storage = mock(SavedDataStorage.class);
+            when(storage.computeIfAbsent(WanderingTraderData.TYPE)).thenReturn(new WanderingTraderData());
+            spawner = new WanderingTraderSpawner(storage);
+            WorldConfiguration config = mock(WorldConfiguration.class);
+            config.entities = mock(WorldConfiguration.Entities.class);
+            config.entities.spawning = mock(WorldConfiguration.Entities.Spawning.class);
+            config.entities.spawning.wanderingTrader = mock(WorldConfiguration.Entities.Spawning.WanderingTrader.class);
+            config.entities.spawning.wanderingTrader.spawnMinuteLength = 1;
+            config.entities.spawning.wanderingTrader.spawnDayLength = 1;
+            config.entities.spawning.wanderingTrader.spawnChanceMin = 100;
+            config.entities.spawning.wanderingTrader.spawnChanceMax = 100;
+            when(level.paperConfig()).thenReturn(config);
+            when(level.getServer()).thenReturn(server);
+            when(server.getLevel(any())).thenReturn(level);
+            when(level.getGameRules()).thenReturn(rules);
+            when(rules.get(GameRules.SPAWN_WANDERING_TRADERS)).thenReturn(true);
+            when(level.getRandomPlayer()).thenReturn(player);
+            when(level.players()).thenReturn(List.of(player));
+            when(player.level()).thenReturn(level);
+            when(player.blockPosition()).thenReturn(new BlockPos(915, 67, 4091));
+            PoiManager poi = mock(PoiManager.class);
+            when(level.getPoiManager()).thenReturn(poi);
+            when(poi.find(any(), any(), any(), anyInt(), any())).thenReturn(Optional.empty());
+            SpawnPlacementType type = mock(SpawnPlacementType.class);
+            placements.when(() -> SpawnPlacements.getPlacementType(EntityTypes.WANDERING_TRADER)).thenReturn(type);
+            placements.when(() -> SpawnPlacements.getHeightmapType(EntityTypes.WANDERING_TRADER)).thenReturn(Heightmap.Types.MOTION_BLOCKING_NO_LEAVES);
+            when(level.getHeight(any(), anyInt(), anyInt())).thenAnswer(call -> {
+                if (!ready) throw new IllegalStateException("Non-blocking runtime cannot synchronously wait for terrain");
+                return 67;
+            });
+            routing.when(() -> OwnershipRouter.runWhenChunksReady(eq(level), anyInt(), anyInt(), anyInt(), anyInt(),
+                eq(ChunkStatus.FULL), any(Priority.class), any(OwnerDomainExecutor.Owner.class), any()))
+                .thenAnswer(call -> {
+                    requests++;
+                    OwnerDomainExecutor.Owner owner = call.getArgument(7);
+                    assertEquals(Integer.MIN_VALUE, owner.minChunkX());
+                    assertEquals(Integer.MAX_VALUE, owner.maxChunkX());
+                    callbacks.add(call.getArgument(8));
+                    CompletableFuture<Void> future = new CompletableFuture<>(); futures.add(future);
+                    return future;
+                });
+        }
+        void resume() {
+            ready = true;
+            Consumer<List<ChunkAccess>> callback = callbacks.remove();
+            CompletableFuture<Void> future = futures.remove();
+            callback.accept(List.of()); future.complete(null);
+        }
+        @Override public void close() { placements.close(); randomFactory.close(); routing.close(); }
+    }
+}
