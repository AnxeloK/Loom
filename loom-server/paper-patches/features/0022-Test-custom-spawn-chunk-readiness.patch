+package net.minecraft.server.threading.runtime;
+
+import ca.spottedleaf.concurrentutil.util.Priority;
+import java.util.List;
+import java.util.concurrent.atomic.AtomicBoolean;
+import java.util.function.Consumer;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.server.level.ServerChunkCache;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.world.level.ChunkPos;
+import net.minecraft.world.level.chunk.ChunkAccess;
+import net.minecraft.world.level.chunk.LevelChunk;
+import net.minecraft.world.level.chunk.status.ChunkStatus;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.mockito.MockedStatic;
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+@Normal
+class CustomSpawnerOwnerTest {
+    @Test void broaderLevelOwnerCompletesAfterPublishedChunks() {
+        ServerLevel level = mock(ServerLevel.class);
+        when(level.getServer()).thenReturn(mock(MinecraftServer.class));
+        ServerChunkCache source = mock(ServerChunkCache.class);
+        when(level.getChunkSource()).thenReturn(source);
+        LevelChunk chunk = mock(LevelChunk.class);
+        when(chunk.getPos()).thenReturn(new ChunkPos(4, 7));
+        when(source.getChunkAtIfLoadedImmediately(4, 7)).thenReturn(chunk);
+        OwnerDomainExecutor.Owner owner = OwnerDomainExecutor.region(level,
+            Integer.MIN_VALUE, Integer.MIN_VALUE, Integer.MAX_VALUE, Integer.MAX_VALUE, "custom-spawner");
+        AtomicBoolean called = new AtomicBoolean();
+        doAnswer(call -> { ((Consumer<List<ChunkAccess>>)call.getArgument(6)).accept(List.of(chunk)); return null; })
+            .when(level).moonrise$loadChunksAsync(eq(4), eq(4), eq(7), eq(7), eq(ChunkStatus.FULL), eq(Priority.NORMAL), any());
+        try (MockedStatic<OwnerDomainExecutor> owners = mockStatic(OwnerDomainExecutor.class)) {
+            owners.when(() -> OwnerDomainExecutor.isOwner(owner)).thenReturn(true);
+            assertDoesNotThrow(() -> OwnershipRouter.runWhenChunksReady(level, 4, 7, 4, 7,
+                ChunkStatus.FULL, Priority.NORMAL, owner, chunks -> called.set(true)).join());
+            assertTrue(called.get());
+            owners.verify(() -> OwnerDomainExecutor.isOwner(owner));
+        }
+    }
+
+    @Test void callbackOwnerMustContainAllRequestedChunks() {
+        ServerLevel level = mock(ServerLevel.class);
+        when(level.getServer()).thenReturn(mock(MinecraftServer.class));
+        OwnerDomainExecutor.Owner owner = OwnerDomainExecutor.region(level, 4, 7, "custom-spawner");
+        assertThrows(IllegalArgumentException.class, () -> OwnershipRouter.runWhenChunksReady(level,
+            3, 7, 4, 7, ChunkStatus.FULL, Priority.NORMAL, owner, ignored -> fail("callback")));
+        verify(level, never()).moonrise$loadChunksAsync(anyInt(), anyInt(), anyInt(), anyInt(), any(), any(), any());
+    }
+
+    @Test void callbackOwnerCannotBelongToAnotherWorld() {
+        ServerLevel level = mock(ServerLevel.class), other = mock(ServerLevel.class);
+        when(other.getServer()).thenReturn(mock(MinecraftServer.class));
+        OwnerDomainExecutor.Owner owner = OwnerDomainExecutor.region(other, 4, 7, "custom-spawner");
+        assertThrows(IllegalArgumentException.class, () -> OwnershipRouter.runWhenChunksReady(level,
+            4, 7, 4, 7, ChunkStatus.FULL, Priority.NORMAL, owner, ignored -> fail("callback")));
+        verify(level, never()).moonrise$loadChunksAsync(anyInt(), anyInt(), anyInt(), anyInt(), any(), any(), any());
+    }
+}
