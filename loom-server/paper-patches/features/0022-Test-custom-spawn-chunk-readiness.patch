+package net.minecraft.world.level.levelgen;
+
+import ca.spottedleaf.concurrentutil.util.Priority;
+import io.papermc.paper.configuration.WorldConfiguration;
+import java.util.List;
+import java.util.UUID;
+import java.util.concurrent.CompletableFuture;
+import java.util.function.Consumer;
+import net.minecraft.core.BlockPos;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.server.level.ServerPlayer;
+import net.minecraft.server.threading.runtime.OwnerDomainExecutor;
+import net.minecraft.server.threading.runtime.OwnershipRouter;
+import net.minecraft.stats.ServerStatsCounter;
+import net.minecraft.stats.Stats;
+import net.minecraft.util.RandomSource;
+import net.minecraft.world.Difficulty;
+import net.minecraft.world.DifficultyInstance;
+import net.minecraft.world.entity.EntityTypes;
+import net.minecraft.world.level.NaturalSpawner;
+import net.minecraft.world.level.block.Blocks;
+import net.minecraft.world.level.chunk.ChunkAccess;
+import net.minecraft.world.level.chunk.status.ChunkStatus;
+import net.minecraft.world.level.dimension.DimensionType;
+import net.minecraft.world.level.gamerules.GameRules;
+import net.minecraft.world.level.material.Fluids;
+import org.bukkit.Bukkit;
+import org.bukkit.craftbukkit.CraftWorld;
+import org.bukkit.craftbukkit.entity.CraftPlayer;
+import org.bukkit.plugin.PluginManager;
+import org.bukkit.support.environment.VanillaFeature;
+import org.junit.jupiter.api.Test;
+import org.mockito.MockedStatic;
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+@VanillaFeature
+class CustomSpawnerReadinessTest {
+    @Test void phantomWaitsForAdjacentChunkBeforeFluidRead() {
+        try (Fixture f = new Fixture()) {
+            assertDoesNotThrow(() -> f.spawner.tick(f.level, true));
+            assertNotNull(f.continuation);
+            assertEquals(List.of(56, 255, 57, 255), f.bounds);
+            assertEquals(Integer.MIN_VALUE, f.owner.minChunkX());
+            assertEquals(Integer.MAX_VALUE, f.owner.maxChunkX());
+            verify(f.level, never()).getFluidState(any());
+            f.resume();
+            verify(f.level).getFluidState(new BlockPos(905, 87, 4081));
+        }
+    }
+
+    @Test void aPendingPlayerAttemptDoesNotQueueAgain() {
+        try (Fixture f = new Fixture()) {
+            f.spawner.tick(f.level, true);
+            for (int i = 0; i < 100; i++) f.spawner.tick(f.level, true);
+            assertEquals(1, f.requests);
+            f.resume();
+            for (int i = 0; i < 21; i++) f.spawner.tick(f.level, true);
+            assertEquals(2, f.requests);
+        }
+    }
+
+    @Test void failedLoadReleasesThePendingAttempt() {
+        try (Fixture f = new Fixture()) {
+            f.spawner.tick(f.level, true);
+            f.pending.completeExceptionally(new IllegalStateException("generation failed"));
+            verify(f.level, never()).getFluidState(any());
+            for (int i = 0; i < 21; i++) f.spawner.tick(f.level, true);
+            assertEquals(2, f.requests);
+        }
+    }
+
+    @Test void teleportRetiresTheOriginalAttempt() {
+        try (Fixture f = new Fixture()) {
+            f.spawner.tick(f.level, true);
+            when(f.player.blockPosition()).thenReturn(new BlockPos(5000, 70, 5000));
+            f.resume();
+            verify(f.level, never()).getFluidState(any());
+        }
+    }
+
+    @Test void logoutAndReplacementRetireTheOriginalAttempt() {
+        try (Fixture f = new Fixture()) {
+            f.spawner.tick(f.level, true);
+            when(f.level.players()).thenReturn(List.of(mock(ServerPlayer.class)));
+            f.resume();
+            verify(f.level, never()).getFluidState(any());
+        }
+    }
+
+    @Test void unloadedWorldCannotResumeAnAttempt() {
+        try (Fixture f = new Fixture()) {
+            f.spawner.tick(f.level, true);
+            when(f.server.getLevel(any())).thenReturn(mock(ServerLevel.class));
+            f.resume();
+            verify(f.level, never()).getFluidState(any());
+        }
+    }
+
+    @Test void sleepingAndChangedRulesCancelPendingAttempts() {
+        try (Fixture f = new Fixture()) {
+            f.spawner.tick(f.level, true);
+            when(f.stats.getValue(Stats.CUSTOM.get(Stats.TIME_SINCE_REST))).thenReturn(0);
+            f.resume();
+            verify(f.level, never()).getFluidState(any());
+        }
+        try (Fixture f = new Fixture()) {
+            f.spawner.tick(f.level, true);
+            when(f.rules.get(GameRules.SPAWN_PHANTOMS)).thenReturn(false);
+            f.resume();
+            verify(f.level, never()).getFluidState(any());
+        }
+    }
+
+    @Test void cancelledPreSpawnEventStillPreventsSpawningAfterReadiness() {
+        try (Fixture f = new Fixture(); MockedStatic<Bukkit> bukkit = mockStatic(Bukkit.class)) {
+            PluginManager plugins = mock(PluginManager.class);
+            bukkit.when(Bukkit::getPluginManager).thenReturn(plugins);
+            doAnswer(call -> {
+                ((com.destroystokyo.paper.event.entity.PhantomPreSpawnEvent)call.getArgument(0)).setCancelled(true);
+                return null;
+            }).when(plugins).callEvent(any());
+            f.natural.when(() -> NaturalSpawner.isValidEmptySpawnBlock(eq(f.level), any(), any(), any(), eq(EntityTypes.PHANTOM)))
+                .thenReturn(true);
+            f.spawner.tick(f.level, true);
+            verify(plugins, never()).callEvent(any());
+            f.resume();
+            verify(plugins).callEvent(any(com.destroystokyo.paper.event.entity.PhantomPreSpawnEvent.class));
+            verify(f.level, never()).addFreshEntityWithPassengers(any(), any());
+        }
+    }
+
+    private static final class Fixture implements AutoCloseable {
+        final ServerLevel level = mock(ServerLevel.class);
+        final MinecraftServer server = mock(MinecraftServer.class);
+        final ServerPlayer player = mock(ServerPlayer.class);
+        final ServerStatsCounter stats = mock(ServerStatsCounter.class);
+        final GameRules rules = mock(GameRules.class);
+        final PhantomSpawner spawner = new PhantomSpawner();
+        final MockedStatic<OwnershipRouter> routing = mockStatic(OwnershipRouter.class);
+        final MockedStatic<NaturalSpawner> natural = mockStatic(NaturalSpawner.class);
+        CompletableFuture<Void> pending;
+        Consumer<List<ChunkAccess>> continuation;
+        OwnerDomainExecutor.Owner owner;
+        List<Integer> bounds;
+        boolean ready;
+        int requests;
+        Fixture() {
+            WorldConfiguration config = mock(WorldConfiguration.class);
+            config.entities = mock(WorldConfiguration.Entities.class);
+            config.entities.behavior = mock(WorldConfiguration.Entities.Behavior.class);
+            config.entities.behavior.phantomsSpawnAttemptMinSeconds = 1;
+            config.entities.behavior.phantomsSpawnAttemptMaxSeconds = 1;
+            config.entities.behavior.playerInsomniaStartTicks = 1;
+            when(level.paperConfig()).thenReturn(config);
+            when(level.getServer()).thenReturn(server);
+            when(server.getLevel(any())).thenReturn(level);
+            when(level.getGameRules()).thenReturn(rules);
+            when(rules.get(GameRules.SPAWN_PHANTOMS)).thenReturn(true);
+            when(level.players()).thenReturn(List.of(player));
+            when(player.level()).thenReturn(level);
+            when(player.getUUID()).thenReturn(UUID.randomUUID());
+            when(player.blockPosition()).thenReturn(new BlockPos(915, 67, 4091));
+            when(player.getBukkitEntity()).thenReturn(mock(CraftPlayer.class));
+            when(level.getWorld()).thenReturn(mock(CraftWorld.class));
+            when(player.getStats()).thenReturn(stats);
+            when(stats.getValue(Stats.CUSTOM.get(Stats.TIME_SINCE_REST))).thenReturn(1000);
+            DimensionType dimension = mock(DimensionType.class);
+            when(level.dimensionType()).thenReturn(dimension);
+            DifficultyInstance difficulty = mock(DifficultyInstance.class);
+            when(level.getCurrentDifficultyAt(any())).thenReturn(difficulty);
+            when(difficulty.isHarderThan(anyFloat())).thenReturn(true);
+            when(difficulty.getDifficulty()).thenReturn(Difficulty.HARD);
+            RandomSource random = mock(RandomSource.class);
+            when(level.getRandom()).thenReturn(random);
+            when(random.nextInt(anyInt())).thenAnswer(call -> (int)call.getArgument(0) == 1000 ? 100 : 0);
+            when(level.getFluidState(any())).thenAnswer(call -> {
+                if (!ready) throw new IllegalStateException("Non-blocking runtime cannot synchronously wait for chunk 56,255");
+                return Fluids.EMPTY.defaultFluidState();
+            });
+            when(level.getBlockState(any())).thenReturn(Blocks.AIR.defaultBlockState());
+            routing.when(() -> OwnershipRouter.runWhenChunksReady(eq(level), anyInt(), anyInt(), anyInt(), anyInt(),
+                eq(ChunkStatus.FULL), any(Priority.class), any(OwnerDomainExecutor.Owner.class), any()))
+                .thenAnswer(call -> {
+                    requests++;
+                    bounds = List.of(call.getArgument(1), call.getArgument(2), call.getArgument(3), call.getArgument(4));
+                    owner = call.getArgument(7);
+                    continuation = call.getArgument(8);
+                    pending = new CompletableFuture<>();
+                    return pending;
+                });
+        }
+        void resume() { ready = true; continuation.accept(List.of()); pending.complete(null); }
+        @Override public void close() { natural.close(); routing.close(); }
+    }
+}
