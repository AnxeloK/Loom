+package net.minecraft.server.level;
+
+import ca.spottedleaf.moonrise.common.util.TickThread;
+import ca.spottedleaf.moonrise.patches.chunk_system.scheduling.ChunkHolderManager;
+import ca.spottedleaf.moonrise.patches.chunk_system.scheduling.ChunkTaskScheduler;
+import java.lang.reflect.Field;
+import java.util.concurrent.atomic.AtomicReference;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.server.threading.TickRegions;
+import net.minecraft.server.threading.runtime.OwnerDomainExecutor;
+import net.minecraft.world.level.Level;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+@Normal
+class ServerChunkCachePollingTest {
+    @Test void emptyPollDoesNotEnterTheWorldQueues() throws Exception {
+        Fixture f = new Fixture();
+        f.run(() -> assertFalse(f.chunks.pollTask()));
+        verify(f.holders, never()).processTicketUpdates();
+        verify(f.scheduler, never()).executeMainThreadTask();
+    }
+
+    @Test void queuedRunnableRunsWithTheWorldOwnerAndRestoresTheCaller() throws Exception {
+        Fixture f = new Fixture();
+        AtomicReference<TickRegions.RegionContext> observed = new AtomicReference<>();
+        f.run(() -> {
+            f.loop.execute(() -> { f.assertWorldOwner(); observed.set(TickRegions.currentContext()); });
+            assertTrue(f.chunks.pollTask());
+            assertNotNull(observed.get());
+            assertNull(TickRegions.currentContext());
+            assertEquals(OwnerDomainExecutor.Domain.GLOBAL_CONTROL, OwnerDomainExecutor.currentDomain());
+        });
+    }
+
+    @Test void queuedRunnableReusesAnExistingFullWorldContext() throws Exception {
+        Fixture f = new Fixture();
+        f.run(() -> {
+            var context = TickRegions.pushLevelContext(f.level);
+            try {
+                f.loop.execute(() -> { f.assertWorldOwner(); assertSame(context, TickRegions.currentContext()); });
+                assertTrue(f.chunks.pollTask());
+                assertSame(context, TickRegions.currentContext());
+            } finally { TickRegions.popContext(context); }
+        });
+    }
+
+    @Test void boundedCallerStillAcquiresTheWholeWorldForQueuedWork() throws Exception {
+        Fixture f = new Fixture();
+        f.run(() -> {
+            var context = TickRegions.pushRegionContext(f.level, 0, 0, 0, 0);
+            try {
+                f.loop.execute(f::assertWorldOwner);
+                assertTrue(f.chunks.pollTask());
+                assertSame(context, TickRegions.currentContext());
+            } finally { TickRegions.popContext(context); }
+        });
+    }
+
+    @Test void schedulerWorkRunsEvenWhenTheRunnableQueueIsEmpty() throws Exception {
+        Fixture f = new Fixture();
+        when(f.scheduler.hasPendingMainThreadTasks()).thenReturn(true);
+        when(f.scheduler.executeMainThreadTask()).thenAnswer(call -> { f.assertWorldOwner(); return true; });
+        f.run(() -> assertTrue(f.chunks.pollTask()));
+        verify(f.scheduler).executeMainThreadTask();
+    }
+
+    @Test void failedWorldWorkRestoresTheGlobalCaller() throws Exception {
+        Fixture f = new Fixture();
+        when(f.scheduler.hasPendingMainThreadTasks()).thenReturn(true);
+        when(f.holders.processTicketUpdates()).thenThrow(new IllegalStateException("ticket update failed"));
+        f.run(() -> {
+            assertThrows(IllegalStateException.class, f.chunks::pollTask);
+            assertNull(TickRegions.currentContext());
+            assertEquals(OwnerDomainExecutor.Domain.GLOBAL_CONTROL, OwnerDomainExecutor.currentDomain());
+        });
+    }
+
+    @Test void workQueuedAfterAnEmptyPollRunsOnTheNextPoll() throws Exception {
+        Fixture f = new Fixture();
+        AtomicReference<Boolean> ran = new AtomicReference<>(false);
+        f.run(() -> {
+            assertFalse(f.chunks.pollTask());
+            f.loop.execute(() -> ran.set(true));
+            assertTrue(f.chunks.pollTask());
+            assertTrue(ran.get());
+        });
+    }
+
+    @Test void pendingTicketUpdatesRunWithoutOtherQueuedTasks() throws Exception {
+        Fixture f = new Fixture();
+        when(f.holders.hasPendingTicketUpdates()).thenReturn(true);
+        when(f.holders.processTicketUpdates()).thenAnswer(call -> { f.assertWorldOwner(); return true; });
+        f.run(() -> assertTrue(f.chunks.pollTask()));
+        verify(f.holders).processTicketUpdates();
+    }
+
+    private static final class Fixture {
+        final MinecraftServer server = mock(MinecraftServer.class);
+        final ServerLevel level = mock(ServerLevel.class);
+        final ServerChunkCache chunks = mock(ServerChunkCache.class, CALLS_REAL_METHODS);
+        final ChunkTaskScheduler scheduler = mock(ChunkTaskScheduler.class);
+        final ChunkHolderManager holders = mock(ChunkHolderManager.class);
+        final ServerChunkCache.MainThreadExecutor loop;
+        Fixture() throws Exception {
+            when(level.getServer()).thenReturn(server);
+            when(level.dimension()).thenReturn(Level.OVERWORLD);
+            when(level.moonrise$getChunkTaskScheduler()).thenReturn(scheduler);
+            set(scheduler, "chunkHolderManager", holders);
+            set(chunks, "level", level);
+            var constructor = ServerChunkCache.MainThreadExecutor.class.getDeclaredConstructor(ServerChunkCache.class, Level.class);
+            constructor.setAccessible(true);
+            loop = constructor.newInstance(chunks, level);
+            set(chunks, "mainThreadProcessor", loop);
+        }
+        void assertWorldOwner() {
+            assertEquals(OwnerDomainExecutor.Domain.REGION, OwnerDomainExecutor.currentDomain());
+            assertTrue(TickRegions.isCurrentThreadOwnerQuiet(level, Integer.MIN_VALUE, Integer.MIN_VALUE, Integer.MAX_VALUE, Integer.MAX_VALUE));
+        }
+        void run(Runnable action) throws Exception {
+            AtomicReference<Throwable> failure = new AtomicReference<>();
+            Thread thread = new TickThread(() -> {
+                try (var owner = OwnerDomainExecutor.enterGlobal(server, "chunk-poll-test")) { action.run(); }
+                catch (Throwable error) { failure.set(error); }
+            }, "chunk-poll-test");
+            when(server.getRunningThread()).thenReturn(thread);
+            set(chunks, "mainThread", thread);
+            thread.start();thread.join(5000);
+            assertFalse(thread.isAlive(), "Chunk polling did not return");
+            if (failure.get() != null) fail(failure.get());
+        }
+    }
+    private static void set(Object target, String name, Object value) throws Exception {
+        for (Class<?> type = target.getClass(); type != null; type = type.getSuperclass()) {
+            try { Field field = type.getDeclaredField(name); field.setAccessible(true); field.set(target, value); return; }
+            catch (NoSuchFieldException ignored) { }
+        }
+        throw new NoSuchFieldException(name);
+    }
+}
