+    @Test
+    void pendingWorkHintCoversSerialAndDeferredStatuses() throws InterruptedException {
+        final ServerLevel level = Mockito.mock(ServerLevel.class);
+        final MinecraftServer server = Mockito.mock(MinecraftServer.class);
+        Mockito.when(level.getServer()).thenReturn(server);
+        final ChunkHolderManager manager = new ChunkHolderManager(level, Mockito.mock(ChunkTaskScheduler.class));
+        final NewChunkHolder first = Mockito.mock(NewChunkHolder.class);
+        final NewChunkHolder second = Mockito.mock(NewChunkHolder.class);
+        Mockito.when(first.handleFullStatusChange(Mockito.anyList())).thenReturn(true);
+        Mockito.when(second.handleFullStatusChange(Mockito.anyList())).thenReturn(true);
+        runOnTickThread(() -> {
+            try (var owner = OwnerDomainExecutor.enterGlobal(server, "pending-work-test")) {
+                Assertions.assertFalse(manager.hasPendingTicketUpdates());
+                manager.addChangedStatuses(java.util.List.of(first));
+                Assertions.assertTrue(manager.hasPendingTicketUpdates());
+                try (var bounded = OwnerDomainExecutor.enterRegion(level, 0, 0, 0, 0, "deferred-producer")) {
+                    manager.addChangedStatuses(java.util.List.of(second));
+                }
+                Assertions.assertTrue(manager.hasPendingTicketUpdates());
+                Assertions.assertTrue(manager.processTicketUpdates());
+                Assertions.assertFalse(manager.hasPendingTicketUpdates());
+                Mockito.verify(first).handleFullStatusChange(Mockito.anyList());
+                Mockito.verify(second).handleFullStatusChange(Mockito.anyList());
+            }
+        });
+    }
+
+    @Test
+    void statusesProducedByACompletionStayInTheDrain() throws InterruptedException {
+        final ServerLevel level = Mockito.mock(ServerLevel.class);
+        final MinecraftServer server = Mockito.mock(MinecraftServer.class);
+        Mockito.when(level.getServer()).thenReturn(server);
+        final ChunkHolderManager manager = new ChunkHolderManager(level, Mockito.mock(ChunkTaskScheduler.class));
+        final NewChunkHolder first = Mockito.mock(NewChunkHolder.class);
+        final NewChunkHolder second = Mockito.mock(NewChunkHolder.class);
+        Mockito.when(first.handleFullStatusChange(Mockito.anyList())).thenAnswer(call -> {
+            ((java.util.List<NewChunkHolder>)call.getArgument(0)).add(second);
+            return true;
+        });
+        Mockito.when(second.handleFullStatusChange(Mockito.anyList())).thenReturn(true);
+        runOnTickThread(() -> {
+            try (var owner = OwnerDomainExecutor.enterGlobal(server, "pending-work-test")) {
+                manager.addChangedStatuses(java.util.List.of(first));
+                Assertions.assertTrue(manager.processTicketUpdates());
+                Assertions.assertFalse(manager.hasPendingTicketUpdates());
+                Mockito.verify(second).handleFullStatusChange(Mockito.anyList());
+            }
+        });
+    }
+
+    @Test
+    void failedCompletionKeepsTheRemainingWorkVisible() throws InterruptedException {
+        final ServerLevel level = Mockito.mock(ServerLevel.class);
+        final MinecraftServer server = Mockito.mock(MinecraftServer.class);
+        Mockito.when(level.getServer()).thenReturn(server);
+        final ChunkHolderManager manager = new ChunkHolderManager(level, Mockito.mock(ChunkTaskScheduler.class));
+        final NewChunkHolder first = Mockito.mock(NewChunkHolder.class);
+        final NewChunkHolder second = Mockito.mock(NewChunkHolder.class);
+        Mockito.when(first.handleFullStatusChange(Mockito.anyList())).thenThrow(new IllegalStateException("failed"));
+        Mockito.when(second.handleFullStatusChange(Mockito.anyList())).thenReturn(true);
+        runOnTickThread(() -> {
+            try (var owner = OwnerDomainExecutor.enterGlobal(server, "pending-work-test")) {
+                manager.addChangedStatuses(java.util.List.of(first, second));
+                Assertions.assertThrows(IllegalStateException.class, manager::processTicketUpdates);
+                Assertions.assertTrue(manager.hasPendingTicketUpdates());
+                Assertions.assertTrue(manager.processTicketUpdates());
+                Assertions.assertFalse(manager.hasPendingTicketUpdates());
+            }
+        });
+    }
+
+    @Test
+    void blockedTicketUpdatesStillRequireTheNormalValidation() throws InterruptedException {
+        final ServerLevel level = Mockito.mock(ServerLevel.class);
+        final MinecraftServer server = Mockito.mock(MinecraftServer.class);
+        Mockito.when(level.getServer()).thenReturn(server);
+        final ChunkHolderManager manager = new ChunkHolderManager(level, Mockito.mock(ChunkTaskScheduler.class));
+        runOnTickThread(() -> {
+            try (var owner = OwnerDomainExecutor.enterGlobal(server, "pending-work-test")) {
+                final Boolean previous = manager.blockTicketUpdates();
+                try {
+                    Assertions.assertTrue(manager.hasPendingTicketUpdates());
+                    Assertions.assertThrows(IllegalStateException.class, manager::processTicketUpdates);
+                } finally { manager.unblockTicketUpdates(previous); }
+                Assertions.assertFalse(manager.hasPendingTicketUpdates());
+            }
+        });
+    }
+
+    @Test
+    void anUnownedSerialQueueConservativelyRequiresOwnerEntry() throws InterruptedException {
+        final ServerLevel level = Mockito.mock(ServerLevel.class);
+        final ChunkHolderManager manager = new ChunkHolderManager(level, Mockito.mock(ChunkTaskScheduler.class));
+        Assertions.assertTrue(manager.hasPendingTicketUpdates());
+        runOnTickThread(() -> {
+            try (var bounded = OwnerDomainExecutor.enterRegion(level, 0, 0, 0, 0, "bounded-poll-test")) {
+                Assertions.assertTrue(manager.hasPendingTicketUpdates());
+            }
+        });
+    }
+
