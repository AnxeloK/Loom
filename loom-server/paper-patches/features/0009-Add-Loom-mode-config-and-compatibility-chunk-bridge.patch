+++ b/src/main/java/io/papermc/paper/plugin/manager/compat/CompatibilityChunkBridge.java
@@ -0,0 +1,38 @@
+package io.papermc.paper.plugin.manager.compat;
+
+import io.papermc.paper.configuration.LoomConfiguration;
+import java.util.concurrent.CompletableFuture;
+import org.bukkit.plugin.Plugin;
+
+public final class CompatibilityChunkBridge {
+
+    private static final String BARRIER_LANE = "LEGACY_SYNC_BRIDGE";
+
+    private CompatibilityChunkBridge() {
+    }
+
+    public static boolean isEnabledForCurrentContext() {
+        return LoomConfiguration.mode() == LoomConfiguration.Mode.COMPATIBILITY
+            && CompatibilityRuntimeContext.currentPlugin() != null;
+    }
+
+    public static <T> T awaitChunkFuture(final CompletableFuture<T> future, final String operation) {
+        final Plugin plugin = CompatibilityRuntimeContext.currentPlugin();
+        if (plugin == null) {
+            throw new IllegalStateException("Compatibility chunk bridge requires plugin runtime context");
+        }
+
+        final CompatibilityDiagnostics diagnostics = CompatibilityDiagnostics.global();
+        final PluginCompatibilityProfile profile = diagnostics.profileFor(plugin);
+        final long started = System.nanoTime();
+        try {
+            return CompatibilityContinuationBridge.awaitOffOwner(profile, diagnostics, operation, () -> future);
+        } catch (final RuntimeException | Error throwable) {
+            throw throwable;
+        } catch (final Throwable throwable) {
+            throw new RuntimeException(throwable);
+        } finally {
+            diagnostics.recordBarrierWait(profile, BARRIER_LANE, operation, System.nanoTime() - started);
+        }
+    }
+}
