new file mode 100644
index 0000000000000000000000000000000000000000..176e4487bbb45ce48a079f1308a262bd21045bff
--- /dev/null
+++ b/src/main/java/io/papermc/paper/configuration/LoomConfiguration.java
@@ -0,0 +1,106 @@
+package io.papermc.paper.configuration;
+
+import com.mojang.logging.LogUtils;
+import io.papermc.paper.plugin.manager.compat.CompatibilityMode;
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.Locale;
+import org.slf4j.Logger;
+import org.spongepowered.configurate.ConfigurateException;
+import org.spongepowered.configurate.ConfigurationNode;
+import org.spongepowered.configurate.yaml.YamlConfigurationLoader;
+import org.jetbrains.annotations.VisibleForTesting;
+
+public final class LoomConfiguration {
+
+    private static final Logger LOGGER = LogUtils.getLogger();
+    private static final String LOOM_CONFIG_FILE = "loom.yml";
+
+    private static volatile Mode mode = Mode.COMPATIBILITY;
+    private static volatile Path sourcePath;
+
+    private LoomConfiguration() {
+    }
+
+    public static synchronized void initialize(final Path configDirectory) {
+        final Path directory = configDirectory == null ? Path.of(PaperConfigurations.CONFIG_DIR) : configDirectory;
+        final Path configFile = directory.resolve(LOOM_CONFIG_FILE);
+
+        try {
+            Files.createDirectories(directory);
+            final YamlConfigurationLoader loader = ConfigurationLoaders.naturallySortedWithoutHeader(configFile);
+            final ConfigurationNode node = Files.exists(configFile) ? loader.load() : loader.createNode();
+
+            final String configured = node.node("mode").getString();
+            final Mode resolved = Mode.fromConfig(configured);
+            node.node("mode").set(resolved.configValue());
+            loader.save(node);
+
+            mode = resolved;
+            sourcePath = configFile.toAbsolutePath();
+            LOGGER.info("Loaded Loom compatibility mode '{}' from {}", resolved.configValue(), sourcePath);
+        } catch (final ConfigurateException | IOException ex) {
+            mode = Mode.COMPATIBILITY;
+            sourcePath = configFile.toAbsolutePath();
+            LOGGER.error("Failed to load {}, defaulting Loom mode to '{}'", sourcePath, mode.configValue(), ex);
+        }
+    }
+
+    public static Mode mode() {
+        return mode;
+    }
+
+    public static CompatibilityMode compatibilityMode() {
+        return mode.compatibilityMode();
+    }
+
+    public static Path sourcePath() {
+        return sourcePath;
+    }
+
+    @VisibleForTesting
+    public static void setModeForTesting(final Mode testMode) {
+        mode = testMode == null ? Mode.COMPATIBILITY : testMode;
+    }
+
+    @VisibleForTesting
+    public static void resetForTesting() {
+        mode = Mode.COMPATIBILITY;
+        sourcePath = null;
+    }
+
+    public enum Mode {
+        COMPATIBILITY("compatibility", CompatibilityMode.MAX_COMPAT),
+        BALANCED("balanced", CompatibilityMode.HYBRID),
+        PERFORMANCE("performance", CompatibilityMode.STRICT);
+
+        private final String configValue;
+        private final CompatibilityMode compatibilityMode;
+
+        Mode(final String configValue, final CompatibilityMode compatibilityMode) {
+            this.configValue = configValue;
+            this.compatibilityMode = compatibilityMode;
+        }
+
+        public String configValue() {
+            return this.configValue;
+        }
+
+        public CompatibilityMode compatibilityMode() {
+            return this.compatibilityMode;
+        }
+
+        public static Mode fromConfig(final String value) {
+            if (value == null || value.isBlank()) {
+                return COMPATIBILITY;
+            }
+            return switch (value.trim().toLowerCase(Locale.ROOT)) {
+                case "compatibility", "max-compat", "max_compat", "maxcompat" -> COMPATIBILITY;
+                case "performance", "strict" -> PERFORMANCE;
+                case "balanced", "hybrid" -> BALANCED;
+                default -> COMPATIBILITY;
+            };
+        }
+    }
+}
