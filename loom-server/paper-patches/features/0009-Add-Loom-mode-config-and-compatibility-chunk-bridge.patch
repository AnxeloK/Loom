+package io.papermc.paper.plugin.manager.compat;
+
+import io.papermc.paper.configuration.LoomConfiguration;
+import io.papermc.paper.plugin.configuration.PluginMeta;
+import java.util.List;
+import java.util.concurrent.CompletableFuture;
+import java.util.logging.Logger;
+import org.bukkit.plugin.Plugin;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.Assertions;
+import org.junit.jupiter.api.Test;
+import org.mockito.Mockito;
+
+@Normal
+class CompatibilityChunkBridgeTest {
+
+    @AfterEach
+    void resetMode() {
+        LoomConfiguration.resetForTesting();
+    }
+
+    @Test
+    void compatibilityModeEnablesBridgeForPluginContext() {
+        LoomConfiguration.setModeForTesting(LoomConfiguration.Mode.COMPATIBILITY);
+        final Plugin plugin = mockPlugin("LegacyBridgePlugin");
+
+        try (CompatibilityRuntimeContext.Scope ignored = CompatibilityRuntimeContext.enter(plugin, CompatibilityRuntimeContext.syntheticTransactionId(), false)) {
+            Assertions.assertTrue(CompatibilityChunkBridge.isEnabledForCurrentContext());
+        }
+    }
+
+    @Test
+    void balancedModeDisablesBridgeEvenWithPluginContext() {
+        LoomConfiguration.setModeForTesting(LoomConfiguration.Mode.BALANCED);
+        final Plugin plugin = mockPlugin("LegacyBridgePlugin");
+
+        try (CompatibilityRuntimeContext.Scope ignored = CompatibilityRuntimeContext.enter(plugin, CompatibilityRuntimeContext.syntheticTransactionId(), false)) {
+            Assertions.assertFalse(CompatibilityChunkBridge.isEnabledForCurrentContext());
+        }
+    }
+
+    @Test
+    void bridgeCanAwaitDelayedChunkFuture() {
+        LoomConfiguration.setModeForTesting(LoomConfiguration.Mode.COMPATIBILITY);
+        final Plugin plugin = mockPlugin("LegacyBridgePlugin");
+        final CompletableFuture<String> delayed = CompletableFuture.supplyAsync(() -> {
+            try {
+                Thread.sleep(25L);
+            } catch (final InterruptedException ex) {
+                Thread.currentThread().interrupt();
+                throw new RuntimeException(ex);
+            }
+            return "loaded";
+        });
+
+        try (CompatibilityRuntimeContext.Scope ignored = CompatibilityRuntimeContext.enter(plugin, CompatibilityRuntimeContext.syntheticTransactionId(), false)) {
+            final String result = CompatibilityChunkBridge.awaitChunkFuture(delayed, "test chunk wait");
+            Assertions.assertEquals("loaded", result);
+        }
+    }
+
+    private static Plugin mockPlugin(final String name) {
+        final PluginMeta meta = Mockito.mock(PluginMeta.class);
+        Mockito.when(meta.getName()).thenReturn(name);
+        Mockito.when(meta.getMainClass()).thenReturn("com.example." + name);
+        Mockito.when(meta.getPluginDependencies()).thenReturn(List.of());
+        Mockito.when(meta.getPluginSoftDependencies()).thenReturn(List.of());
+        Mockito.when(meta.getVersion()).thenReturn("1.0.0");
+
+        final Plugin plugin = Mockito.mock(Plugin.class);
+        Mockito.when(plugin.getPluginMeta()).thenReturn(meta);
+        Mockito.when(plugin.getLogger()).thenReturn(Logger.getLogger(name));
+        Mockito.when(plugin.isEnabled()).thenReturn(true);
+        return plugin;
+    }
+}
