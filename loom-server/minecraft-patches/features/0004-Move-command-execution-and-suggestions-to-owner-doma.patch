     }
 
+    private static void ensureSynchronousContext(final CommandSourceStack source, final String operation) {
+        final org.bukkit.Server server = source.getServer().server;
+        if (server == null) {
+            if (ca.spottedleaf.moonrise.common.util.TickThread.isTickThread()) {
+                return;
+            }
+            throw new IllegalStateException("Asynchronous " + operation + " is not allowed before server bootstrap ownership is available");
+        }
+        if (net.minecraft.server.threading.runtime.ExecutionContextGate.canRunSynchronousCallbacks(server)) {
+            return;
+        }
+        throw new IllegalStateException(
+            "Asynchronous " + operation + " is not allowed in mutable runtime path ("
+                + net.minecraft.server.threading.runtime.ExecutionContextGate.describe(server)
+                + ")"
+        );
+    }
+
     private static int wrapTime(final long ticks) {
         return Math.toIntExact(ticks % 2147483647L);
     }
