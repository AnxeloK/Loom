@@ -21,7 +25,7 @@ public class KillCommand {
 
     private static int kill(final CommandSourceStack source, final Collection<? extends Entity> victims) {
         for (Entity entity : victims) {
-            entity.kill(source.getLevel());
+            runWithEntityContext(entity, () -> entity.kill(entity.level() instanceof ServerLevel serverLevel ? serverLevel : source.getLevel()));
