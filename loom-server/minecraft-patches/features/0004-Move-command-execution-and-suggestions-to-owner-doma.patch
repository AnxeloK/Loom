         if (victims.size() == 1) {
@@ -32,4 +36,15 @@ public class KillCommand {
 
         return victims.size();
     }
+
+    private static void runWithEntityContext(final Entity entity, final Runnable action) {
+        final Level level = entity.level();
+        if (!(level instanceof ServerLevel serverLevel)) {
+            action.run();
+            return;
+        }
+
+        final ChunkPos chunk = entity.chunkPosition();
+        OwnerDomainExecutor.runRegionNow(serverLevel, chunk.x(), chunk.z(), chunk.x(), chunk.z(), "kill-command", action);
+    }
 }
