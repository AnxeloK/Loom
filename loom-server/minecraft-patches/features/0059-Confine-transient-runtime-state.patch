From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: anxelok <anxelok@localhost>
Date: Sat, 11 Jul 2026 10:36:11 +0000
Subject: [PATCH] Confine transient runtime state


diff --git a/net/minecraft/core/Rotations.java b/net/minecraft/core/Rotations.java
index 0d5805a9002854ea2666ef3bc792e61f016ffd34..cc55597996d1c84a1a345dac110c68c1d7abb756 100644
--- a/net/minecraft/core/Rotations.java
+++ b/net/minecraft/core/Rotations.java
@@ -27,17 +27,24 @@ public record Rotations(float x, float y, float z) {
         }
     };
     // Paper start - add internal method for skipping validation for plugins using userdev
-    private static boolean SKIP_VALIDATION = false;
+    private static final ThreadLocal<Boolean> SKIP_VALIDATION = new ThreadLocal<>();
     public static Rotations createWithoutValidityChecks(float x, float y, float z) {
-        SKIP_VALIDATION = true;
-        Rotations rotations = new Rotations(x, y, z);
-        SKIP_VALIDATION = false;
-        return rotations;
+        final Boolean previous = SKIP_VALIDATION.get();
+        SKIP_VALIDATION.set(Boolean.TRUE);
+        try {
+            return new Rotations(x, y, z);
+        } finally {
+            if (previous == null) {
+                SKIP_VALIDATION.remove();
+            } else {
+                SKIP_VALIDATION.set(previous);
+            }
+        }
     }
     // Paper end - add internal method for skipping validation for plugins using userdev
 
     public Rotations {
-        if (!SKIP_VALIDATION) { // Paper - add internal method for skipping validation for plugins using userdev
+        if (SKIP_VALIDATION.get() != Boolean.TRUE) { // Paper - add internal method for skipping validation for plugins using userdev; Loom - thread-confined
         x = !Float.isInfinite(x) && !Float.isNaN(x) ? x % 360.0F : 0.0F;
         y = !Float.isInfinite(y) && !Float.isNaN(y) ? y % 360.0F : 0.0F;
         z = !Float.isInfinite(z) && !Float.isNaN(z) ? z % 360.0F : 0.0F;
diff --git a/net/minecraft/server/level/ServerLevel.java b/net/minecraft/server/level/ServerLevel.java
index b1ed577dff4d60e95ee24b202dd37b150733c890..0b6651d2cb72e03c8562b6e4a5898611afe1010a 100644
--- a/net/minecraft/server/level/ServerLevel.java
+++ b/net/minecraft/server/level/ServerLevel.java
@@ -941,7 +941,7 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
                 loomDiagnostics.record(LoomTickSectionDiagnostics.BLOCK_ENTITIES, System.nanoTime() - loomBlockEntitiesStart);
             }
             profiler.pop();
-            this.spigotConfig.currentPrimedTnt = 0; // Spigot
+            this.spigotConfig.currentPrimedTnt.set(0); // Spigot; Loom - reset after all parallel entity workers join
         }
 
         loomSectionStart = loomDiagnostics == null ? 0L : System.nanoTime();
diff --git a/net/minecraft/world/entity/item/PrimedTnt.java b/net/minecraft/world/entity/item/PrimedTnt.java
index 237d579c4fa760e6f6c8f8e747873b115d04d1bd..9a998d332b20c72f9f2d0d64e162de0973408882 100644
--- a/net/minecraft/world/entity/item/PrimedTnt.java
+++ b/net/minecraft/world/entity/item/PrimedTnt.java
@@ -104,7 +104,7 @@ public class PrimedTnt extends Entity implements TraceableEntity {
 
     @Override
     public void tick() {
-        if (this.level().spigotConfig.maxTntTicksPerTick > 0 && ++this.level().spigotConfig.currentPrimedTnt > this.level().spigotConfig.maxTntTicksPerTick) { return; } // Spigot
+        if (!this.level().spigotConfig.acquirePrimedTntTick()) { return; } // Spigot; Loom - exact parallel quota
         this.handlePortal();
         this.applyGravity();
         this.move(MoverType.SELF, this.getDeltaMovement());
diff --git a/net/minecraft/world/level/block/entity/SculkCatalystBlockEntity.java b/net/minecraft/world/level/block/entity/SculkCatalystBlockEntity.java
index 4aa2d141eba2596e782fc4ab4890c5e2d80eb811..c6fec2004967793dd8a85063edb3f62ca1ab384e 100644
--- a/net/minecraft/world/level/block/entity/SculkCatalystBlockEntity.java
+++ b/net/minecraft/world/level/block/entity/SculkCatalystBlockEntity.java
@@ -44,9 +44,12 @@ public class SculkCatalystBlockEntity extends BlockEntity implements GameEventLi
     // Paper end - Fix NPE in SculkBloomEvent world access
 
     public static void serverTick(final Level level, final BlockPos pos, final BlockState state, final SculkCatalystBlockEntity entity) {
-        org.bukkit.craftbukkit.event.CraftEventFactory.sourceBlockOverride = pos; // CraftBukkit - SPIGOT-7068: Add source block override, not the most elegant way but better than passing down a BlockPos up to five methods deep.
-        entity.catalystListener.getSculkSpreader().updateCursors(level, pos, level.getRandom(), true);
-        org.bukkit.craftbukkit.event.CraftEventFactory.sourceBlockOverride = null; // CraftBukkit
+        final BlockPos previousSource = org.bukkit.craftbukkit.event.CraftEventFactory.setScopedSourceBlockOverride(entity.getBlockPos()); // CraftBukkit - SPIGOT-7068
+        try {
+            entity.catalystListener.getSculkSpreader().updateCursors(level, pos, level.getRandom(), true);
+        } finally {
+            org.bukkit.craftbukkit.event.CraftEventFactory.restoreScopedSourceBlockOverride(previousSource);
+        }
     }
 
     @Override
