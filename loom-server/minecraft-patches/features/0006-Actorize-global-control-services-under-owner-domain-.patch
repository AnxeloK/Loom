diff --git a/net/minecraft/world/scores/ScoreboardThreading.java b/net/minecraft/world/scores/ScoreboardThreading.java
new file mode 100644
index 0000000000000000000000000000000000000000..31bae024d0ece3175edd6e0072d9afe79929b937
--- /dev/null
+++ b/net/minecraft/world/scores/ScoreboardThreading.java
@@ -0,0 +1,21 @@
+package net.minecraft.world.scores;
+
+import ca.spottedleaf.moonrise.common.util.TickThread;
+import net.minecraft.server.MinecraftServer;
+
+final class ScoreboardThreading {
+
+    private ScoreboardThreading() {
+    }
+
+    static void ensureThreadAccess(final String reason) {
+        final MinecraftServer server = MinecraftServer.getServer();
+        if (server == null) {
+            return;
+        }
+        if (net.minecraft.server.threading.runtime.OwnerDomainExecutor.isGlobalOwner(server) || TickThread.isShutdownThread()) {
+            return;
+        }
+        throw new IllegalStateException("Scoreboard owner-domain violation: " + reason);
+    }
+}
