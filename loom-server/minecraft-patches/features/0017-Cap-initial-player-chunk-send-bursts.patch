From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: anxelok <anxelok@localhost>
Date: Wed, 3 Jun 2026 16:53:24 +0000
Subject: [PATCH] Cap initial player chunk send bursts


diff --git a/ca/spottedleaf/moonrise/patches/chunk_system/player/RegionizedPlayerChunkLoader.java b/ca/spottedleaf/moonrise/patches/chunk_system/player/RegionizedPlayerChunkLoader.java
index c19f2418027356d6fe0d17dc7add7151fc20ea33..47d6510a68f3a704712d4eba5bd466139f30a9f6 100644
--- a/ca/spottedleaf/moonrise/patches/chunk_system/player/RegionizedPlayerChunkLoader.java
+++ b/ca/spottedleaf/moonrise/patches/chunk_system/player/RegionizedPlayerChunkLoader.java
@@ -428,6 +428,9 @@ public final class RegionizedPlayerChunkLoader {
         private final Long idBoxed = Long.valueOf(this.id);
 
         private static final long MAX_RATE = 10_000L;
+        private static final int LOOM_PLAYER_CHUNK_SEND_MAX_PER_TICK = getIntProperty(
+            "Loom.PlayerChunkSendMaxPerTick", 4
+        );
         private static final long LOOM_KEEPALIVE_SOFT_BACKPRESSURE_NANOS = getMillisPropertyNanos(
             "Loom.PlayerChunkSendKeepAliveSoftBackpressureMillis", 5_000L
         );
@@ -767,7 +770,7 @@ public final class RegionizedPlayerChunkLoader {
         }
 
         private long getMaxChunkSendsThisTick(final long now) {
-            long maxSends = Math.max(0L, Math.min(MAX_RATE, Math.min(this.sendQueue.size(), Integer.MAX_VALUE)));
+            long maxSends = Math.max(0L, Math.min(Math.min(MAX_RATE, LOOM_PLAYER_CHUNK_SEND_MAX_PER_TICK), Math.min(this.sendQueue.size(), Integer.MAX_VALUE)));
             final net.minecraft.server.network.ServerGamePacketListenerImpl connection = this.player.connection;
             if (connection == null) {
                 return maxSends;
