+    private void spawnWhenReady(final ServerLevel level, final ServerPlayer player, final BlockPos playerPos,
+        final BlockPos spawnPos, final DifficultyInstance difficulty) {
+        if (!this.pendingSpawns.add(player.getUUID())) {
+            return;
+        }
+        // The attempt reads player state and fires plugin events, so retain the original full-level owner.
+        final net.minecraft.server.threading.runtime.OwnerDomainExecutor.Owner owner =
+            net.minecraft.server.threading.runtime.OwnerDomainExecutor.region(level,
+                Integer.MIN_VALUE, Integer.MIN_VALUE, Integer.MAX_VALUE, Integer.MAX_VALUE, "phantom-spawn");
+        try {
+            net.minecraft.server.threading.runtime.OwnershipRouter.runWhenChunksReady(level,
+                Math.min(playerPos.getX(), spawnPos.getX() - 1) >> 4,
+                Math.min(playerPos.getZ(), spawnPos.getZ() - 1) >> 4,
+                Math.max(playerPos.getX(), spawnPos.getX() + 1) >> 4,
+                Math.max(playerPos.getZ(), spawnPos.getZ() + 1) >> 4,
+                net.minecraft.world.level.chunk.status.ChunkStatus.FULL,
+                ca.spottedleaf.concurrentutil.util.Priority.NORMAL, owner, chunks -> {
+                    if (level.getServer().isStopped() || level.getServer().getLevel(level.dimension()) != level
+                        || !level.players().contains(player) || player.level() != level || player.isRemoved()
+                        || !player.blockPosition().equals(playerPos) || player.isSpectator()
+                        || !level.getGameRules().get(GameRules.SPAWN_PHANTOMS)
+                        || !level.getGameRules().get(GameRules.SPAWN_MOBS) || !level.getChunkSource().spawnEnemies
+                        || level.paperConfig().entities.behavior.phantomsSpawnAttemptMaxSeconds <= 0
+                        || level.paperConfig().entities.behavior.playerInsomniaStartTicks < 0
+                        || (level.dimensionType().hasSkyLight() && (level.getSkyDarken() < 5
+                            || playerPos.getY() < level.getSeaLevel() || !level.canSeeSky(playerPos)))
+                        || (level.paperConfig().entities.behavior.phantomsDoNotSpawnOnCreativePlayers && player.isCreative())
+                        || player.getStats().getValue(Stats.CUSTOM.get(Stats.TIME_SINCE_REST))
+                            < level.paperConfig().entities.behavior.playerInsomniaStartTicks) {
+                        return;
+                    }
+                    this.spawnGroup(level, player, spawnPos, difficulty);
+                }).whenComplete((ignored, failure) -> {
+                    this.pendingSpawns.remove(player.getUUID());
+                    if (failure != null) {
+                        LOGGER.error("Failed to complete phantom spawn at {}", spawnPos, failure);
+                    }
+                });
+        } catch (final RuntimeException failure) {
+            this.pendingSpawns.remove(player.getUUID());
+            LOGGER.error("Failed to prepare phantom spawn at {}", spawnPos, failure);
+        }
+    }
+
+    private void spawnGroup(final ServerLevel level, final ServerPlayer player, final BlockPos spawnPos,
+        final DifficultyInstance difficulty) {
+        final RandomSource random = level.getRandom();
+        BlockState blockState = level.getBlockState(spawnPos);
+        FluidState fluidState = level.getFluidState(spawnPos);
+        if (NaturalSpawner.isValidEmptySpawnBlock(level, spawnPos, blockState, fluidState, EntityTypes.PHANTOM)) {
+            SpawnGroupData groupData = null;
+            int groupSize = 1 + random.nextInt(difficulty.getDifficulty().getId() + 1);
+
+            for (int i = 0; i < groupSize; i++) {
+                // Paper start - PhantomPreSpawnEvent
+                com.destroystokyo.paper.event.entity.PhantomPreSpawnEvent event = new com.destroystokyo.paper.event.entity.PhantomPreSpawnEvent(org.bukkit.craftbukkit.util.CraftLocation.toBukkit(spawnPos, level), player.getBukkitEntity(), org.bukkit.event.entity.CreatureSpawnEvent.SpawnReason.NATURAL);
+                if (!event.callEvent()) {
+                    if (event.shouldAbortSpawn()) {
+                        break;
+                    }
+                    continue;
+                }
+                // Paper end - PhantomPreSpawnEvent
+                Phantom phantom = EntityTypes.PHANTOM.create(level, EntitySpawnReason.NATURAL);
+                if (phantom != null) {
+                    phantom.spawningEntity = player.getUUID(); // Paper - PhantomPreSpawnEvent
+                    phantom.snapTo(spawnPos, 0.0F, 0.0F);
+                    groupData = phantom.finalizeSpawn(level, difficulty, EntitySpawnReason.NATURAL, groupData);
+                    level.addFreshEntityWithPassengers(phantom, org.bukkit.event.entity.CreatureSpawnEvent.SpawnReason.NATURAL); // CraftBukkit
+                }
+            }
+        }
+    }
