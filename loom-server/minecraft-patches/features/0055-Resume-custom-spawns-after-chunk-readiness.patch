+    private void spawnCandidate(final ServerLevel level, final Player player, final BlockPos playerPos,
+        final BlockPos referencePos, final int remaining, final java.util.concurrent.CompletableFuture<Boolean> result) {
+        if (result.isDone()) {
+            return;
+        }
+        if (remaining == 0) {
+            result.complete(false);
+            return;
+        }
+        final int x = referencePos.getX() + this.random.nextInt(96) - 48;
+        final int z = referencePos.getZ() + this.random.nextInt(96) - 48;
+        final net.minecraft.server.threading.runtime.OwnerDomainExecutor.Owner owner =
+            net.minecraft.server.threading.runtime.OwnerDomainExecutor.region(level,
+                Integer.MIN_VALUE, Integer.MIN_VALUE, Integer.MAX_VALUE, Integer.MAX_VALUE, "wandering-trader-spawn");
+        // Include the space check, spawn collision box and the two llamas' four-block search radius.
+        net.minecraft.server.threading.runtime.OwnershipRouter.runWhenChunksReady(level,
+            (x - 5) >> 4, (z - 5) >> 4, (x + 5) >> 4, (z + 5) >> 4,
+            net.minecraft.world.level.chunk.status.ChunkStatus.FULL,
+            ca.spottedleaf.concurrentutil.util.Priority.NORMAL, owner, chunks -> {
+                if (level.getServer().isStopped() || level.getServer().getLevel(level.dimension()) != level
+                    || !level.players().contains(player) || player.level() != level || player.isRemoved()
+                    || !player.blockPosition().equals(playerPos)
+                    || !level.getGameRules().get(GameRules.SPAWN_WANDERING_TRADERS)
+                    || !level.getGameRules().get(GameRules.SPAWN_MOBS)) {
+                    result.complete(false);
+                    return;
+                }
+                final BlockPos candidate = new BlockPos(x,
+                    level.getHeight(SpawnPlacements.getHeightmapType(EntityTypes.WANDERING_TRADER), x, z), z);
+                if (SpawnPlacements.getPlacementType(EntityTypes.WANDERING_TRADER)
+                    .isSpawnPositionOk(level, candidate, EntityTypes.WANDERING_TRADER)) {
+                    result.complete(this.spawnAt(level, candidate, referencePos));
+                } else {
+                    this.spawnCandidate(level, player, playerPos, referencePos, remaining - 1, result);
+                }
+            }).whenComplete((ignored, failure) -> {
+                if (failure != null) {
+                    result.completeExceptionally(failure);
+                }
+            });
+    }
