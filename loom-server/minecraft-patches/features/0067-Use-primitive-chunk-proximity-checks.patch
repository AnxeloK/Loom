@@ -782,10 +782,23 @@ public class ChunkMap extends SimpleRegionStorage implements ChunkHolder.PlayerP
     }
 
     boolean anyPlayerCloseEnoughTo(final BlockPos pos, final int maxDistance) {
-        Vec3 target = new Vec3(pos);
+        if (maxDistance <= 0) {
+            return false;
+        }
+        final double targetX = pos.getX();
+        final double targetY = pos.getY();
+        final double targetZ = pos.getZ();
+        final double maxDistanceSquared = (double)maxDistance * (double)maxDistance;
 
         for (ServerPlayer player : this.playerMap.getAllPlayers()) {
-            if (this.playerIsCloseEnoughTo(player, target, maxDistance)) {
+            if (player.isSpectator()) {
+                continue;
+            }
+            final Vec3 playerPos = player.position();
+            final double deltaX = playerPos.x - targetX;
+            final double deltaY = playerPos.y - targetY;
+            final double deltaZ = playerPos.z - targetZ;
+            if (deltaX * deltaX + deltaY * deltaY + deltaZ * deltaZ < maxDistanceSquared) {
                 return true;
             }
         }
@@ -865,26 +878,26 @@ public class ChunkMap extends SimpleRegionStorage implements ChunkHolder.PlayerP
     }
 
     public boolean playerIsCloseEnoughForSpawning(final ServerPlayer player, final ChunkPos pos, final double range) { // Spigot // Paper - chunk tick iteration optimisation - public
-        if (player.isSpectator()) {
-            return false;
-        } else {
-            double distanceToChunk = euclideanDistanceSquared(pos, player.position());
-            return distanceToChunk < range; // Spigot
-        }
+        return this.playerIsCloseEnoughForSpawning(player, pos.x(), pos.z(), range);
     }
 
-    private boolean playerIsCloseEnoughTo(final ServerPlayer player, final Vec3 pos, final int maxDistance) {
+    private boolean playerIsCloseEnoughForSpawning(
+        final ServerPlayer player,
+        final int chunkX,
+        final int chunkZ,
+        final double range
+    ) {
         if (player.isSpectator()) {
             return false;
         } else {
-            double distanceToPos = player.position().distanceTo(pos);
-            return distanceToPos < maxDistance;
+            double distanceToChunk = euclideanDistanceSquared(chunkX, chunkZ, player.position());
+            return distanceToChunk < range; // Spigot
         }
     }
 
-    private static double euclideanDistanceSquared(final ChunkPos chunkPos, final Vec3 pos) {
-        double xPos = SectionPos.sectionToBlockCoord(chunkPos.x(), 8);
-        double zPos = SectionPos.sectionToBlockCoord(chunkPos.z(), 8);
+    private static double euclideanDistanceSquared(final int chunkX, final int chunkZ, final Vec3 pos) {
+        double xPos = (double)(chunkX << 4) + 8.0;
+        double zPos = (double)(chunkZ << 4) + 8.0;
         double xd = xPos - pos.x;
         double zd = zPos - pos.z;
         return xd * xd + zd * zd;
