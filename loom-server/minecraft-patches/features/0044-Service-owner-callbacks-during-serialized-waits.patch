+    /**
+     * Waits for a result without abandoning the current owner. Cross-thread work targeting an owner in the
+     * current stack is routed back to this thread and serviced while the result is pending. This is reserved
+     * for synchronous runtime contracts whose delegated work can call back into the originating owner.
+     */
+    public static <T> T awaitCooperatively(final CompletableFuture<T> future, final String operation) {
+        Objects.requireNonNull(future, "future");
+        if (future.isDone()) {
+            return future.getNow(null);
+        }
+        return awaitCooperatively(() -> future, operation);
+    }
+
+    /**
+     * Registers the cooperative owner before starting delegated work, closing the race where that work can
+     * immediately call back into this owner before the wait becomes visible.
+     */
+    public static <T> T awaitCooperatively(
+        final Supplier<? extends CompletableFuture<T>> futureSupplier,
+        final String operation
+    ) {
+        Objects.requireNonNull(futureSupplier, "futureSupplier");
+        Objects.requireNonNull(operation, "operation");
+        final OwnerContext ownerContext = CURRENT_OWNER.get();
+        if (ownerContext == null || !canRunSynchronousCallbacks()) {
+            throw new IllegalStateException("Cooperative wait requires a synchronous owner domain: " + operation);
+        }
+
+        final int[] depth = COOPERATIVE_WAIT_DEPTH.get();
+        if (++depth[0] > MAX_COOPERATIVE_WAIT_DEPTH) {
+            --depth[0];
+            throw new IllegalStateException("Cooperative wait nesting exceeded " + MAX_COOPERATIVE_WAIT_DEPTH + " for " + operation);
+        }
+
+        final CooperativeWait wait = new CooperativeWait(Thread.currentThread(), ownerContext, operation);
+        registerCooperativeWait(wait);
+
+        boolean interrupted = false;
+        try {
+            final CompletableFuture<T> future = Objects.requireNonNull(futureSupplier.get(), "futureSupplier returned null future");
+            future.whenComplete((result, throwable) -> wait.signal());
+            int workInSlice = 0;
+            while (!future.isDone()) {
+                if (wait.runOneCompleting(future)
+                    || wait.runQueuedOwnerTaskCompleting(future)
+                    || wait.runOne()
+                    || wait.runQueuedOwnerTask()) {
+                    if (++workInSlice == COOPERATIVE_WORK_SLICE) {
+                        workInSlice = 0;
+                        Thread.yield();
+                    }
+                } else {
+                    workInSlice = 0;
+                    LockSupport.park(wait);
+                    if (Thread.interrupted()) {
+                        interrupted = true;
+                    }
+                }
+            }
+
+            wait.stopAccepting();
+            while (wait.runOne()) {
+                // Drain every task accepted before the wait closed so no owner handoff is lost.
+            }
+            return future.getNow(null);
+        } finally {
+            wait.stopAccepting();
+            unregisterCooperativeWait(wait);
+            if (--depth[0] == 0) {
+                COOPERATIVE_WAIT_DEPTH.remove();
+            }
+            if (interrupted) {
+                Thread.currentThread().interrupt();
+            }
+        }
+    }
+
+    static int activeCooperativeWaits() {
+        return cooperativeWaits.length;
+    }
