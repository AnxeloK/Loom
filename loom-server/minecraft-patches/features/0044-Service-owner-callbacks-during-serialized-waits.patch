+    private static boolean dispatchToCooperativeWait(final Owner owner, final Runnable task) {
+        final CooperativeWait[] waits = cooperativeWaits;
+        for (int i = waits.length - 1; i >= 0; --i) {
+            final CooperativeWait wait = waits[i];
+            if (wait.accepts(owner) && wait.offer(wrap(owner, task))) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private static void registerCooperativeWait(final CooperativeWait wait) {
+        synchronized (COOPERATIVE_WAITS_LOCK) {
+            final CooperativeWait[] current = cooperativeWaits;
+            final CooperativeWait[] updated = new CooperativeWait[current.length + 1];
+            System.arraycopy(current, 0, updated, 0, current.length);
+            updated[current.length] = wait;
+            cooperativeWaits = updated;
+        }
+    }
+
+    private static void unregisterCooperativeWait(final CooperativeWait wait) {
+        synchronized (COOPERATIVE_WAITS_LOCK) {
+            final CooperativeWait[] current = cooperativeWaits;
+            int index = -1;
+            for (int i = current.length - 1; i >= 0; --i) {
+                if (current[i] == wait) {
+                    index = i;
+                    break;
+                }
+            }
+            if (index < 0) {
+                return;
+            }
+            if (current.length == 1) {
+                cooperativeWaits = NO_COOPERATIVE_WAITS;
+                return;
+            }
+            final CooperativeWait[] updated = new CooperativeWait[current.length - 1];
+            System.arraycopy(current, 0, updated, 0, index);
+            System.arraycopy(current, index + 1, updated, index, current.length - index - 1);
+            cooperativeWaits = updated;
+        }
+    }
