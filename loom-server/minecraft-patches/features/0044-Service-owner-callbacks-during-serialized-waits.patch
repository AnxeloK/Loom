+        private boolean runQueuedOwnerTask(final Predicate<Runnable> predicate) {
+            Runnable continuation = null;
+            CrossRegionMessage message = null;
+            synchronized (this.lock) {
+                for (final Iterator<RegionBoundTask> iterator = this.regionContinuations.iterator(); iterator.hasNext(); ) {
+                    final RegionBoundTask candidate = iterator.next();
+                    if (predicate.test(candidate.task())) {
+                        iterator.remove();
+                        continuation = candidate.task();
+                        break;
+                    }
+                }
+                if (continuation == null) {
+                    for (final Iterator<Runnable> iterator = this.fullLevelContinuations.iterator(); iterator.hasNext(); ) {
+                        final Runnable candidate = iterator.next();
+                        if (predicate.test(candidate)) {
+                            iterator.remove();
+                            continuation = candidate;
+                            break;
+                        }
+                    }
+                }
+                if (continuation == null) {
+                    for (final Iterator<CrossRegionMessage> iterator = this.mailbox.iterator(); iterator.hasNext(); ) {
+                        final CrossRegionMessage candidate = iterator.next();
+                        if (predicate.test(candidate.action())) {
+                            iterator.remove();
+                            message = candidate;
+                            break;
+                        }
+                    }
+                }
+            }
+
+            if (continuation != null) {
+                try {
+                    continuation.run();
+                } catch (final Throwable throwable) {
+                    recordDiagnostic(
+                        DiagnosticType.MAILBOX_MESSAGE_DROPPED,
+                        this.world,
+                        Integer.MIN_VALUE,
+                        Integer.MIN_VALUE,
+                        Integer.MAX_VALUE,
+                        Integer.MAX_VALUE,
+                        "Owner continuation threw exception during cooperative wait: " + throwable
+                    );
+                }
+                return true;
+            }
+            if (message != null) {
+                this.runMailboxMessage(message);
+                return true;
+            }
+            return false;
+        }
+
