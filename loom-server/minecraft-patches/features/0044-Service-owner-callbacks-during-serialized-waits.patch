+    public boolean runQueuedTaskMatching(final java.util.function.Predicate<? super R> predicate) {
+        if (!this.isSameThread()) {
+            throw new IllegalStateException();
+        }
+
+        for (final R run : this.pendingRunnables) {
+            if ((predicate == null || predicate.test(run)) && this.pendingRunnables.remove(run)) {
+                this.doRunTask(run);
+                return true;
+            }
+        }
+        return false;
+    }
