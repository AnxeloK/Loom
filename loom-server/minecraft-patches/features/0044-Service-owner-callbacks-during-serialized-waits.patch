+    private static final class CooperativeWait {
+        private final Thread thread;
+        private final OwnerContext ownerContext;
+        private final String operation;
+        private final ConcurrentLinkedQueue<Runnable> tasks = new ConcurrentLinkedQueue<>();
+        private boolean accepting = true;
+
+        private CooperativeWait(final Thread thread, final OwnerContext ownerContext, final String operation) {
+            this.thread = thread;
+            this.ownerContext = ownerContext;
+            this.operation = operation;
+        }
+
+        private boolean accepts(final Owner requested) {
+            if (requested.domain() == Domain.PLAYER
+                && (requested.player() == null || requested.player().hasDisconnected())) {
+                return false;
+            }
+            for (OwnerContext context = this.ownerContext; context != null; context = context.previous()) {
+                if (context.owner().contains(requested)) {
+                    return true;
+                }
+            }
+            return false;
+        }
+
+        private synchronized boolean offer(final Runnable task) {
+            if (!this.accepting) {
+                return false;
+            }
+            this.tasks.add(task);
+            this.signal();
+            return true;
+        }
+
+        private boolean runOne() {
+            final Runnable task = this.tasks.poll();
+            if (task == null) {
+                return false;
+            }
+            this.runTask(task);
+            return true;
+        }
+
+        private boolean runOneCompleting(final CompletableFuture<?> future) {
+            for (final Runnable task : this.tasks) {
+                if (task instanceof OwnerTask ownerTask
+                    && ownerTask.completes(future)
+                    && this.tasks.remove(task)) {
+                    this.runTask(task);
+                    return true;
+                }
+            }
+            return false;
+        }
+
+        private void runTask(final Runnable task) {
+            try {
+                task.run();
+            } catch (final Throwable throwable) {
+                LOGGER.error("Owner task failed during cooperative wait for {}", this.operation, throwable);
+            }
+        }
+
+        private boolean runQueuedOwnerTaskCompleting(final CompletableFuture<?> future) {
+            return this.runQueuedOwnerTask(task -> this.acceptsTaskCompleting(task, future));
+        }
+
+        private boolean runQueuedOwnerTask() {
+            return this.runQueuedOwnerTask(this::acceptsTask);
+        }
+
+        private boolean runQueuedOwnerTask(final java.util.function.Predicate<Runnable> predicate) {
+            for (OwnerContext context = this.ownerContext; context != null; context = context.previous()) {
+                final Owner owner = context.owner();
+                if (owner.domain() == Domain.GLOBAL_CONTROL) {
+                    final MinecraftServer server = owner.server();
+                    if (server != null && server.runQueuedGlobalOwnerTask(predicate)) {
+                        return true;
+                    }
+                } else if ((owner.domain() == Domain.REGION || owner.domain() == Domain.PLAYER)
+                    && owner.level() != null
+                    && TickRegions.runQueuedOwnerTask(owner.level(), predicate)) {
+                    return true;
+                }
+            }
+            return false;
+        }
+
+        private boolean acceptsTask(final Runnable task) {
+            return task instanceof OwnerTask ownerTask && this.accepts(ownerTask.owner);
+        }
+
+        private boolean acceptsTaskCompleting(final Runnable task, final CompletableFuture<?> future) {
+            return task instanceof OwnerTask ownerTask
+                && ownerTask.completes(future)
+                && this.accepts(ownerTask.owner);
+        }
+
+        private synchronized void stopAccepting() {
+            this.accepting = false;
+        }
+
+        private void signal() {
+            LockSupport.unpark(this.thread);
+        }
+    }
