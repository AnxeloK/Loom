From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: anxelok <anxelok@localhost>
Date: Sun, 12 Jul 2026 22:27:42 +0000
Subject: [PATCH] Avoid transient collision bounds


diff --git a/ca/spottedleaf/moonrise/patches/collisions/CollisionUtil.java b/ca/spottedleaf/moonrise/patches/collisions/CollisionUtil.java
index 15568f598b8c61cf92563b6a7f8cae526b84484e..ebd819146895072314021818596aa6671c6a1b97 100644
--- a/ca/spottedleaf/moonrise/patches/collisions/CollisionUtil.java
+++ b/ca/spottedleaf/moonrise/patches/collisions/CollisionUtil.java
@@ -2013,16 +2013,21 @@ public final class CollisionUtil {
 
                                     AABB singleAABB = ((CollisionVoxelShape)blockCollision).moonrise$getSingleAABBRepresentation();
                                     if (singleAABB != null) {
-                                        singleAABB = singleAABB.move((double)blockX, (double)blockY, (double)blockZ);
+                                        final double movedMinX = singleAABB.minX + (double)blockX;
+                                        final double movedMinY = singleAABB.minY + (double)blockY;
+                                        final double movedMinZ = singleAABB.minZ + (double)blockZ;
+                                        final double movedMaxX = singleAABB.maxX + (double)blockX;
+                                        final double movedMaxY = singleAABB.maxY + (double)blockY;
+                                        final double movedMaxZ = singleAABB.maxZ + (double)blockZ;
 
                                         // Not using the epsilon violates the collision rules but this is what Vanilla does.
                                         // Check BlockCollisions.class
                                         if (blockCollision == Shapes.block()) {
-                                            if (!aabb.intersects(singleAABB)) {
+                                            if (!aabb.intersects(movedMinX, movedMinY, movedMinZ, movedMaxX, movedMaxY, movedMaxZ)) {
                                                 continue;
                                             }
                                         } else {
-                                            if (!voxelShapeIntersect(aabb, singleAABB)) {
+                                            if (!voxelShapeIntersect(aabb, movedMinX, movedMinY, movedMinZ, movedMaxX, movedMaxY, movedMaxZ)) {
                                                 continue;
                                             }
                                         }
@@ -2037,7 +2042,7 @@ public final class CollisionUtil {
                                             return true;
                                         } else {
                                             ret = true;
-                                            intoAABB.add(singleAABB);
+                                            intoAABB.add(new AABB(movedMinX, movedMinY, movedMinZ, movedMaxX, movedMaxY, movedMaxZ));
                                             continue;
                                         }
                                     }
diff --git a/net/minecraft/world/entity/Entity.java b/net/minecraft/world/entity/Entity.java
index 3b137a93c58a668a4c2f387bfee5da83f74f122b..814cfa74cc8d1021983be98b8dde54978df5a085 100644
--- a/net/minecraft/world/entity/Entity.java
+++ b/net/minecraft/world/entity/Entity.java
@@ -1625,11 +1625,13 @@ public abstract class Entity
             }
 
             BlockState belowState = this.level().getBlockState(getOnPos);
-            return (!(offset <= 0.5) || !belowState.is(BlockTags.FENCES))
-                    && !belowState.is(BlockTags.WALLS)
-                    && !(belowState.getBlock() instanceof FenceGateBlock)
-                ? getOnPos.atY(Mth.floor(this.position.y - offset))
-                : getOnPos;
+            if ((!(offset <= 0.5) || !belowState.is(BlockTags.FENCES))
+                && !belowState.is(BlockTags.WALLS)
+                && !(belowState.getBlock() instanceof FenceGateBlock)) {
+                final int onY = Mth.floor(this.position.y - offset);
+                return getOnPos.getY() == onY ? getOnPos : getOnPos.atY(onY);
+            }
+            return getOnPos;
         } else {
             int xTruncated = Mth.floor(this.position.x);
             int yTruncatedBelow = Mth.floor(this.position.y - offset);
@@ -3193,21 +3195,30 @@ public abstract class Entity
         }
 
         // Paper start - optimise collisions
-        final double reducedWith = (double)(this.dimensions.width() * 0.8F);
-        final AABB boundingBox = AABB.ofSize(this.getEyePosition(), reducedWith, 1.0E-6D, reducedWith);
+        final double reducedWidth = (double)(this.dimensions.width() * 0.8F);
+        final double halfWidth = reducedWidth / 2.0;
+        final double centerX = this.getX();
+        final double centerY = this.getEyeY();
+        final double centerZ = this.getZ();
+        final double minX = centerX - halfWidth;
+        final double minY = centerY - 5.0E-7D;
+        final double minZ = centerZ - halfWidth;
+        final double maxX = centerX + halfWidth;
+        final double maxY = centerY + 5.0E-7D;
+        final double maxZ = centerZ + halfWidth;
         final Level world = this.level;
 
-        if (ca.spottedleaf.moonrise.patches.collisions.CollisionUtil.isEmpty(boundingBox)) {
+        if (ca.spottedleaf.moonrise.patches.collisions.CollisionUtil.isEmpty(minX, minY, minZ, maxX, maxY, maxZ)) {
             return false;
         }
 
-        final int minBlockX = Mth.floor(boundingBox.minX);
-        final int minBlockY = Mth.floor(boundingBox.minY);
-        final int minBlockZ = Mth.floor(boundingBox.minZ);
+        final int minBlockX = Mth.floor(minX);
+        final int minBlockY = Mth.floor(minY);
+        final int minBlockZ = Mth.floor(minZ);
 
-        final int maxBlockX = Mth.floor(boundingBox.maxX);
-        final int maxBlockY = Mth.floor(boundingBox.maxY);
-        final int maxBlockZ = Mth.floor(boundingBox.maxZ);
+        final int maxBlockX = Mth.floor(maxX);
+        final int maxBlockY = Mth.floor(maxY);
+        final int maxBlockZ = Mth.floor(maxZ);
 
         final int minChunkX = minBlockX >> 4;
         final int minChunkY = minBlockY >> 4;
@@ -3274,16 +3285,24 @@ public abstract class Entity
                                     continue;
                                 }
 
-                                final AABB toCollide = boundingBox.move(-(double)blockX, -(double)blockY, -(double)blockZ);
+                                final double localMinX = minX - (double)blockX;
+                                final double localMinY = minY - (double)blockY;
+                                final double localMinZ = minZ - (double)blockZ;
+                                final double localMaxX = maxX - (double)blockX;
+                                final double localMaxY = maxY - (double)blockY;
+                                final double localMaxZ = maxZ - (double)blockZ;
 
                                 final AABB singleAABB = ((ca.spottedleaf.moonrise.patches.collisions.shape.CollisionVoxelShape)collisionShape).moonrise$getSingleAABBRepresentation();
                                 if (singleAABB != null) {
-                                    if (ca.spottedleaf.moonrise.patches.collisions.CollisionUtil.voxelShapeIntersect(singleAABB, toCollide)) {
+                                    if (ca.spottedleaf.moonrise.patches.collisions.CollisionUtil.voxelShapeIntersect(
+                                        singleAABB, localMinX, localMinY, localMinZ, localMaxX, localMaxY, localMaxZ
+                                    )) {
                                         return true;
                                     }
                                     continue;
                                 }
 
+                                final AABB toCollide = new AABB(localMinX, localMinY, localMinZ, localMaxX, localMaxY, localMaxZ);
                                 if (ca.spottedleaf.moonrise.patches.collisions.CollisionUtil.voxelShapeIntersectNoEmpty(collisionShape, toCollide)) {
                                     return true;
                                 }
@@ -4797,18 +4816,37 @@ public abstract class Entity
                 maxX = bb.maxX,
                 maxY = bb.maxY,
                 maxZ = bb.maxZ;
+        boolean adjusted = false;
         double len = bb.maxX - bb.minX;
-        if (len < 0) maxX = minX;
-        if (len > 64) maxX = minX + 64.0;
+        if (len < 0) {
+            maxX = minX;
+            adjusted = true;
+        }
+        if (len > 64) {
+            maxX = minX + 64.0;
+            adjusted = true;
+        }
 
         len = bb.maxY - bb.minY;
-        if (len < 0) maxY = minY;
-        if (len > 64) maxY = minY + 64.0;
+        if (len < 0) {
+            maxY = minY;
+            adjusted = true;
+        }
+        if (len > 64) {
+            maxY = minY + 64.0;
+            adjusted = true;
+        }
 
         len = bb.maxZ - bb.minZ;
-        if (len < 0) maxZ = minZ;
-        if (len > 64) maxZ = minZ + 64.0;
-        this.bb = new AABB(minX, minY, minZ, maxX, maxY, maxZ);
+        if (len < 0) {
+            maxZ = minZ;
+            adjusted = true;
+        }
+        if (len > 64) {
+            maxZ = minZ + 64.0;
+            adjusted = true;
+        }
+        this.bb = adjusted ? new AABB(minX, minY, minZ, maxX, maxY, maxZ) : bb;
         // CraftBukkit end
     }
 
