+    private CompletableFuture<@Nullable Vec3> applyPreparedExitPortalAsync(
+        final ServerLevel level,
+        final BlockPos portalEntryPos,
+        final PreparedExitPortal preparedExit
+    ) {
+        final int chunkX = portalEntryPos.getX() >> 4;
+        final int chunkZ = portalEntryPos.getZ() >> 4;
+        final CompletableFuture<@Nullable Vec3> result = new CompletableFuture<>();
+        OwnershipRouter.runWhenChunksReady(
+            level,
+            chunkX,
+            chunkZ,
+            chunkX,
+            chunkZ,
+            ca.spottedleaf.concurrentutil.util.Priority.HIGHER,
+            "end-gateway-source-ready",
+            chunks -> {
+                if (level.getBlockEntity(portalEntryPos) != this) {
+                    result.complete(null);
+                    return;
+                }
+
+                if (this.exitPortal == null) {
+                    this.setExitPosition(preparedExit.portalPosition(), this.exactTeleport);
+                }
+
+                if (this.exactTeleport) {
+                    result.complete(Vec3.atBottomCenterOf(this.exitPortal));
+                } else if (this.exitPortal.equals(preparedExit.portalPosition())) {
+                    result.complete(preparedExit.teleportPosition());
+                } else {
+                    resolvePortalPositionAsync(level, this.exitPortal, false).whenComplete((position, throwable) -> {
+                        if (throwable != null) {
+                            result.completeExceptionally(throwable);
+                        } else {
+                            result.complete(position);
+                        }
+                    });
+                }
+            }
+        ).whenComplete((ignored, throwable) -> {
+            if (throwable != null) {
+                result.completeExceptionally(throwable);
+            }
+        });
+        return result;
     }
 
