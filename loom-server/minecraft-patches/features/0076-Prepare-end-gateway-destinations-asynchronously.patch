+    private static CompletableFuture<PreparedExitPortal> prepareExitPortalAsync(
+        final ServerLevel level,
+        final BlockPos portalEntryPos,
+        final Vec3 tentativePosition
+    ) {
+        final int chunkX = Mth.floor(tentativePosition.x / 16.0);
+        final int chunkZ = Mth.floor(tentativePosition.z / 16.0);
+        final CompletableFuture<PreparedExitPortal> result = new CompletableFuture<>();
+        OwnershipRouter.runWhenChunksReady(
+            level,
+            chunkX - 1,
+            chunkZ - 1,
+            chunkX + 1,
+            chunkZ + 1,
+            ca.spottedleaf.concurrentutil.util.Priority.HIGHER,
+            "end-gateway-destination-ready",
+            chunks -> {
+                final LevelChunk exitPortalChunk = level.getChunkSource().getChunkAtIfLoadedImmediately(chunkX, chunkZ);
+                if (exitPortalChunk == null) {
+                    throw new IllegalStateException("End gateway destination chunk was not available after readiness");
+                }
+
+                BlockPos exitPortalPos = findValidSpawnInChunk(exitPortalChunk);
+                if (exitPortalPos == null) {
+                    final BlockPos newExitPortalPos = BlockPos.containing(tentativePosition.x + 0.5, 75.0, tentativePosition.z + 0.5);
+                    LOGGER.debug("Failed to find a suitable block to teleport to, spawning an island on {}", newExitPortalPos);
+                    level.registryAccess()
+                        .lookup(Registries.CONFIGURED_FEATURE)
+                        .flatMap(registry -> registry.get(EndFeatures.END_ISLAND))
+                        .ifPresent(
+                            endIsland -> endIsland.value()
+                                .place(level, level.getChunkSource().getGenerator(), RandomSource.create(newExitPortalPos.asLong()), newExitPortalPos)
+                        );
+                    exitPortalPos = newExitPortalPos;
+                } else {
+                    LOGGER.debug("Found suitable block to teleport to: {}", exitPortalPos);
+                }
 
-        LOGGER.debug("Found chunk at {}", exitPortalXZPosTentative);
-        return exitPortalXZPosTentative;
+                final BlockPos gatewayPosition = findTallestBlock(level, exitPortalPos, 16, true).above(10);
+                LOGGER.debug("Creating portal at {}", gatewayPosition);
+                spawnGatewayPortal(level, gatewayPosition, EndGatewayConfiguration.knownExit(portalEntryPos, false));
+                result.complete(new PreparedExitPortal(gatewayPosition, Vec3.atBottomCenterOf(findExitPosition(level, gatewayPosition))));
+            }
+        ).whenComplete((ignored, throwable) -> {
+            if (throwable != null) {
+                result.completeExceptionally(throwable);
+            }
+        });
+        return result;
