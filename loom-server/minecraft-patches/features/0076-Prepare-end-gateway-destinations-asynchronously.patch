+    private static CompletableFuture<Boolean> isChunkEmptyAsync(final ServerLevel level, final Vec3 position) {
+        final int chunkX = Mth.floor(position.x / 16.0);
+        final int chunkZ = Mth.floor(position.z / 16.0);
+        final CompletableFuture<Boolean> result = new CompletableFuture<>();
+        OwnershipRouter.runWhenChunksReady(
+            level,
+            chunkX,
+            chunkZ,
+            chunkX,
+            chunkZ,
+            ca.spottedleaf.concurrentutil.util.Priority.HIGHER,
+            "end-gateway-scan-chunk-ready",
+            chunks -> result.complete(chunks.getFirst().getHighestFilledSectionIndex() == -1)
+        ).whenComplete((ignored, throwable) -> {
+            if (throwable != null) {
+                result.completeExceptionally(throwable);
+            }
+        });
+        return result;
+    }
