+    private static void scanForwardForNonEmptyChunk(
+        final ServerLevel level,
+        final Vec3 direction,
+        final Vec3 position,
+        final int remainingChunks,
+        final CompletableFuture<Vec3> result
+    ) {
+        isChunkEmptyAsync(level, position).whenComplete((empty, throwable) -> {
+            if (throwable != null) {
+                result.completeExceptionally(throwable);
+            } else if (!empty || remainingChunks == 0) {
+                LOGGER.debug("Found chunk at {}", position);
+                result.complete(position);
+            } else {
+                LOGGER.debug("Skipping forward past empty chunk at {}", position);
+                scanForwardForNonEmptyChunk(level, direction, position.add(direction.scale(16.0)), remainingChunks - 1, result);
+            }
+        });
