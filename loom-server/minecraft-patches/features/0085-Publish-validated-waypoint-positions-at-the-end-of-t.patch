Subject: [PATCH] Publish validated waypoint positions at the end of the tick


diff --git a/net/minecraft/server/MinecraftServer.java b/net/minecraft/server/MinecraftServer.java
index 31f2bfe2a2ffa9a15bfbd9c9489115d88bed55f1..2a693b91947da0accac13615b0ce2891b728eb38 100644
--- a/net/minecraft/server/MinecraftServer.java
+++ b/net/minecraft/server/MinecraftServer.java
@@ -2082,8 +2082,13 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
             profiler.push("tick");
             this.tickFrame.start();
             // Paper - improve tick loop - moved into runAllTasksAtTickStart
-            this.runAllTasksAtTickStart(); // Paper - improve tick loop
-            this.tickServer(sprinting ? () -> false : this::haveTime);
+            try {
+                for (final ServerLevel level : this.getAllLevels()) level.getWaypointManager().beginPositionUpdateBatch();
+                this.runAllTasksAtTickStart(); // Paper - improve tick loop
+                this.tickServer(sprinting ? () -> false : this::haveTime);
+            } finally {
+                this.finishWaypointPositionBatches(false);
+            }
             // Paper start - rewrite chunk system
             final Throwable crash = this.chunkSystemCrash;
             if (crash != null) {
@@ -2097,6 +2102,19 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
         }
     }
 
+    private void finishWaypointPositionBatches(final boolean publish) {
+        final java.util.List<ServerLevel> pending = new java.util.ArrayList<>();
+        for (final ServerLevel level : this.getAllLevels()) {
+            if (level.getWaypointManager().endPositionUpdateBatch()) pending.add(level);
+        }
+        if (pending.isEmpty()) return;
+        net.minecraft.server.threading.TickRegions.runJoinedWorldPhase(this, pending, level -> {
+            final var context = net.minecraft.server.threading.TickRegions.pushLevelContext(level);
+            try { level.getWaypointManager().flushPositionUpdates(publish); }
+            finally { net.minecraft.server.threading.TickRegions.popContext(context); }
+        }, "waypointPositions");
+    }
+
     private void autoSave() {
         this.ticksUntilAutosave = this.autosavePeriod; // CraftBukkit
         LOGGER.debug("Autosave started");
@@ -2282,6 +2300,7 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
             player.connection.resumeFlushing();
         }
 
+        this.finishWaypointPositionBatches(true);
         profiler.pop();
         this.serverActivityMonitor.tick();
     }
