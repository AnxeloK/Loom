diff --git a/net/minecraft/server/waypoints/ServerWaypointManager.java b/net/minecraft/server/waypoints/ServerWaypointManager.java
index 4c2a292ce16aec16da53e774fafb712b7fcdd99e..1ca367cbdeaa9a87540aa8ab8428467fe2a55493 100644
--- a/net/minecraft/server/waypoints/ServerWaypointManager.java
+++ b/net/minecraft/server/waypoints/ServerWaypointManager.java
@@ -18,6 +18,12 @@ import net.minecraft.world.waypoints.WaypointTransmitter;
 import org.jspecify.annotations.Nullable;
 
 public class ServerWaypointManager implements WaypointManager<WaypointTransmitter> {
+    private static final org.slf4j.Logger LOGGER = com.mojang.logging.LogUtils.getLogger();
+    private final net.minecraft.server.level.ServerLevel level;
+    // Global control opens and closes the tick window; the world owner owns its pending updates.
+    private volatile boolean positionUpdateBatch;
+    private volatile boolean positionsPending;
+    private Map<ServerPlayer, Boolean> pendingPositions = new java.util.IdentityHashMap<>();
     private final Set<WaypointTransmitter> waypoints = new HashSet<>();
     private final Set<ServerPlayer> players = new HashSet<>();
     private final Table<ServerPlayer, WaypointTransmitter, WaypointTransmitter.Connection> connections = HashBasedTable.create();
@@ -28,10 +34,67 @@ public class ServerWaypointManager implements WaypointManager<WaypointTransmitte
     public boolean locatorBarEnabled; // Avoid a gamerule lookup for each player
 
     public ServerWaypointManager(net.minecraft.server.level.ServerLevel serverLevel) {
+        this.level = serverLevel;
         this.locatorBarEnabled = serverLevel.getGameRules().get(GameRules.LOCATOR_BAR);
     }
     // Paper end - optimize ServerWaypointManager with locator bar disabled
 
+    public void beginPositionUpdateBatch() {
+        net.minecraft.server.threading.runtime.OwnerDomainExecutor.assertGlobalOwner(this.level.getServer(), "begin-waypoint-positions");
+        if (this.positionUpdateBatch || this.positionsPending) {
+            throw new IllegalStateException("Previous waypoint position batch has not finished");
+        }
+        this.positionUpdateBatch = true;
+    }
+
+    public boolean endPositionUpdateBatch() {
+        if (!this.positionUpdateBatch) return this.positionsPending;
+        net.minecraft.server.threading.runtime.OwnerDomainExecutor.assertGlobalOwner(this.level.getServer(), "end-waypoint-positions");
+        this.positionUpdateBatch = false;
+        return this.positionsPending;
+    }
+
+    /** Retain final locator positions during the tick without deferring physics or decision events. */
+    public boolean deferPositionUpdate(final ServerPlayer player, final boolean moved) {
+        if (!this.positionUpdateBatch || !this.locatorBarEnabled) return false;
+        this.assertPositionOwner();
+        if (player.level() != this.level || player.isRemoved()) return false;
+        this.pendingPositions.merge(player, moved, (previous, current) -> previous || current);
+        this.positionsPending = true;
+        return true;
+    }
+
+    public void flushPositionUpdates(final boolean publish) {
+        this.assertPositionOwner();
+        final Map<ServerPlayer, Boolean> pending = this.pendingPositions;
+        this.pendingPositions = new java.util.IdentityHashMap<>();
+        this.positionsPending = false;
+        try {
+            if (!publish || !this.locatorBarEnabled) return;
+            for (Entry<ServerPlayer, Boolean> update : pending.entrySet()) {
+                final ServerPlayer player = update.getKey();
+                if (player.level() != this.level || player.isRemoved()
+                    || player.connection != null && (player.connection.player != player || player.connection.processedDisconnect)) continue;
+                try {
+                    if (update.getValue() && player.isTransmittingWaypoint()) this.updateWaypoint(player);
+                    if (player.isReceivingWaypoints() && player.connection != null) this.updatePlayer(player);
+                } catch (Exception failure) {
+                    if (failure instanceof net.minecraft.ReportedException reported && reported.getCause() instanceof OutOfMemoryError) throw reported;
+                    LOGGER.error("Failed to update waypoint position for player {} in {}", player.getUUID(), this.level.dimension().identifier(), failure);
+                    this.level.getServer().reportPacketHandlingException(failure, net.minecraft.network.protocol.game.GamePacketTypes.CLIENTBOUND_WAYPOINT);
+                }
+            }
+        } finally {
+            pending.clear();
+        }
+    }
+
+    private void assertPositionOwner() {
+        if (!net.minecraft.server.threading.runtime.OwnerDomainExecutor.isRegionOwner(
+            this.level, Integer.MIN_VALUE, Integer.MIN_VALUE, Integer.MAX_VALUE, Integer.MAX_VALUE
+        )) throw new IllegalStateException("Waypoint position updates require the full world owner");
+    }
+
     @Override
     public void trackWaypoint(final WaypointTransmitter waypoint) {
         this.waypoints.add(waypoint);
@@ -147,6 +210,8 @@ public class ServerWaypointManager implements WaypointManager<WaypointTransmitte
     }
 
     public void removePlayer(final ServerPlayer player) {
+        this.pendingPositions.remove(player);
+        this.positionsPending = !this.pendingPositions.isEmpty();
         this.connections.row(player).entrySet().removeIf(entry -> {
             entry.getValue().disconnect();
             this.removeReceiverIndex(player, entry.getKey());
@@ -157,6 +222,8 @@ public class ServerWaypointManager implements WaypointManager<WaypointTransmitte
     }
 
     public void breakAllConnections() {
+        this.pendingPositions.clear();
+        this.positionsPending = false;
         this.connections.values().forEach(WaypointTransmitter.Connection::disconnect);
         this.connections.clear();
         this.receiversByWaypoint.values().forEach(Map::clear);
