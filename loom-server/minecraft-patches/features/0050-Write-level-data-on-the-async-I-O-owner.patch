+        }
+
+        private void writeLevelData(final CompoundTag root) throws IOException {
+            final Path worldDir = this.levelDirectory.path();
+            final Path dataFile = Files.createTempFile(worldDir, "level", ".dat");
+            NbtIo.writeCompressed(root, dataFile);
+            final Path oldDataFile = this.levelDirectory.oldDataFile();
+            final Path currentFile = this.levelDirectory.dataFile();
+            if (!Util.safeReplaceOrMoveFile(currentFile, dataFile, oldDataFile, false)) {
+                throw new IOException("Failed to replace level data for " + this.levelId);
+            }
+        }
+
+        // Serializes level.dat writes handed to the async-I/O owner; see saveLevelDataAsync.
+        private final Object levelDataWriteLock = new Object();
+        private CompletableFuture<Void> pendingLevelDataWrite = CompletableFuture.completedFuture(null);
+        private boolean closingLevelDataWrites;
