@@ -724,7 +810,66 @@ public class LevelStorageSource {
 
         @Override
         public void close() throws IOException {
-            this.lock.close();
+            final CompletableFuture<Void> pendingWrite;
+            synchronized (this.levelDataWriteLock) {
+                this.closingLevelDataWrites = true;
+                pendingWrite = this.pendingLevelDataWrite;
+            }
+
+            IOException writeFailure = null;
+            if (OwnerDomainExecutor.currentOwner() != null && OwnerDomainExecutor.canRunSynchronousCallbacks()) {
+                final CompletableFuture<Void> boundedWrite = pendingWrite.copy()
+                    .orTimeout(60L, java.util.concurrent.TimeUnit.SECONDS);
+                try {
+                    OwnerDomainExecutor.awaitCooperatively(boundedWrite, "close-level-data-storage");
+                } catch (final java.util.concurrent.CompletionException exception) {
+                    if (exception.getCause() instanceof java.util.concurrent.TimeoutException timeout) {
+                        throw new IOException(
+                            "Timed out after 60s waiting for the level data write for " + this.levelId
+                                + "; the storage lock remains held",
+                            timeout
+                        );
+                    }
+                    writeFailure = new IOException("Failed to flush pending level data for " + this.levelId, exception.getCause());
+                } catch (final java.util.concurrent.CancellationException exception) {
+                    writeFailure = new IOException("Pending level data write was cancelled for " + this.levelId, exception);
+                }
+            } else {
+                try {
+                    net.minecraft.server.threading.runtime.ThreadedRegionsBlockingBarrier.awaitNonOwnerFutureInterruptibly(
+                        pendingWrite, 60L, java.util.concurrent.TimeUnit.SECONDS, "close-level-data-storage"
+                    );
+                } catch (final java.util.concurrent.TimeoutException exception) {
+                    throw new IOException(
+                        "Timed out after 60s waiting for the level data write for " + this.levelId
+                            + "; the storage lock remains held",
+                        exception
+                    );
+                } catch (final InterruptedException exception) {
+                    Thread.currentThread().interrupt();
+                    throw new IOException(
+                        "Interrupted while waiting for the level data write for " + this.levelId
+                            + "; the storage lock remains held",
+                        exception
+                    );
+                } catch (final java.util.concurrent.ExecutionException exception) {
+                    writeFailure = new IOException("Failed to flush pending level data for " + this.levelId, exception.getCause());
+                } catch (final java.util.concurrent.CancellationException exception) {
+                    writeFailure = new IOException("Pending level data write was cancelled for " + this.levelId, exception);
+                }
+            }
+
+            try {
+                this.lock.close();
+            } catch (final IOException lockFailure) {
+                if (writeFailure == null) {
+                    throw lockFailure;
+                }
+                writeFailure.addSuppressed(lockFailure);
+            }
+            if (writeFailure != null) {
+                throw writeFailure;
+            }
         }
 
