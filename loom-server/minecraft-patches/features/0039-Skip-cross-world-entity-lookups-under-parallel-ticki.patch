From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: anxelok <anxelok@localhost>
Date: Wed, 17 Jun 2026 21:18:08 +0000
Subject: [PATCH] Skip cross-world entity lookups under parallel ticking
 instead of claiming foreign leases


diff --git a/net/minecraft/server/level/ServerLevel.java b/net/minecraft/server/level/ServerLevel.java
index 591511d4b2ea65425c8ed64cac087dad6f7b1ad1..339f68767697304e41f7534e19657927bab729a1 100644
--- a/net/minecraft/server/level/ServerLevel.java
+++ b/net/minecraft/server/level/ServerLevel.java
@@ -2282,8 +2282,16 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
         } else {
             for (ServerLevel otherLevel : this.getServer().getAllLevels()) {
                 if (otherLevel != this) {
+                    final boolean ownsOther = net.minecraft.server.threading.TickRegions.isCurrentThreadOwnerQuiet(otherLevel, Integer.MIN_VALUE, Integer.MIN_VALUE, Integer.MAX_VALUE, Integer.MAX_VALUE);
+                    // Loom - under parallel world ticking, another world may be ticking on its own thread and
+                    // hold its lease. Claiming it here for a cross-dimension read would conflict (or risk an
+                    // owner deadlock), so skip that dimension - best-effort and non-corrupting. Under serial
+                    // ticking this guard is disabled and the original lease-claiming read below is used.
+                    if (!ownsOther && net.minecraft.server.threading.TickRegions.PARALLEL_WORLDS_ENABLED) {
+                        continue;
+                    }
                     final Entity otherEntity;
-                    if (net.minecraft.server.threading.TickRegions.isCurrentThreadOwnerQuiet(otherLevel, Integer.MIN_VALUE, Integer.MIN_VALUE, Integer.MAX_VALUE, Integer.MAX_VALUE)) {
+                    if (ownsOther) {
                         otherEntity = otherLevel.getEntity(uuid);
                     } else {
                         final net.minecraft.server.threading.TickRegions.RegionContext otherLevelContext =
