+    private CompletableFuture<@Nullable RespawnResult> resolveRespawnDecisionAsync(
+        final ServerLevel respawnLevel,
+        final Vec3 position,
+        final int chunkRadius,
+        final java.util.function.Supplier<CompletableFuture<@Nullable RespawnResult>> resolver
+    ) {
+        final int chunkX = net.minecraft.util.Mth.floor(position.x()) >> 4;
+        final int chunkZ = net.minecraft.util.Mth.floor(position.z()) >> 4;
+        return net.minecraft.server.threading.runtime.OwnershipRouter.runWhenChunksReady(
+            respawnLevel, chunkX - chunkRadius, chunkZ - chunkRadius, chunkX + chunkRadius, chunkZ + chunkRadius,
+            ca.spottedleaf.concurrentutil.util.Priority.HIGHER, "player-respawn-decision",
+            chunks -> {
+                for (final net.minecraft.world.level.chunk.ChunkAccess chunk : chunks) {
+                    respawnLevel.getChunkSource().addTicketAtLevel(
+                        net.minecraft.server.level.TicketType.POST_TELEPORT, chunk.getPos(),
+                        net.minecraft.server.level.ChunkLevel.FULL_CHUNK_LEVEL
+                    );
+                }
+            }
+        ).thenCompose(ignored -> net.minecraft.server.threading.runtime.OwnershipRouter.supplyOnServer(this.server, () -> {
+            if (this.connection.isDisconnected() || this.connection.player != this
+                || this.server.getPlayerList().getPlayer(this.getUUID()) != this) {
+                return CompletableFuture.<@Nullable RespawnResult>completedFuture(null);
+            }
+            if (respawnLevel.isUnloading()) {
+                return CompletableFuture.<@Nullable RespawnResult>failedFuture(
+                    new java.util.concurrent.RejectedExecutionException("Respawn world is unloading")
+                );
+            }
+            if (!net.minecraft.server.threading.runtime.OwnershipRouter.areChunksReady(
+                respawnLevel, chunkX - chunkRadius, chunkZ - chunkRadius, chunkX + chunkRadius, chunkZ + chunkRadius,
+                net.minecraft.world.level.chunk.status.ChunkStatus.FULL
+            )) {
+                return this.resolveRespawnDecisionAsync(respawnLevel, position, chunkRadius, resolver);
+            }
+            final CompletableFuture<@Nullable RespawnResult> result = new CompletableFuture<>();
+            PlayerList.runWithRespawnOwnerContexts(this, respawnLevel, position, () -> resolver.get().whenComplete((resolved, failure) -> {
+                if (failure != null) {
+                    result.completeExceptionally(failure);
+                } else {
+                    result.complete(resolved);
+                }
+            }));
+            return result;
+        })).thenCompose(result -> result);
+    }
+
