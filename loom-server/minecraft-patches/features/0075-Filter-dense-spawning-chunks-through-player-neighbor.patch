+        private boolean collectByPlayer(final List<LevelChunk> output) {
+            final int width = PLAYER_RADIUS_CHUNKS * 2 + 1;
+            if (this.sourceChunks.length < width * width * 2
+                || !net.minecraft.server.threading.runtime.OwnerDomainExecutor.isRegionOwner(this.chunkMap.level,
+                    Integer.MIN_VALUE, Integer.MIN_VALUE, Integer.MAX_VALUE, Integer.MAX_VALUE)
+                || !net.minecraft.server.threading.TickRegions.isCurrentThreadOwnerQuiet(this.chunkMap.level,
+                    Integer.MIN_VALUE, Integer.MIN_VALUE, Integer.MAX_VALUE, Integer.MAX_VALUE)) {
+                return false;
+            }
+            if (this.chunkIndices == null) {
+                this.chunkIndices = new Long2IntOpenHashMap(this.sourceChunks.length);
+                this.chunkIndices.defaultReturnValue(-1);
+                for (int index = 0; index < this.sourceChunks.length; ++index) {
+                    final LevelChunk chunk = this.sourceChunks[index];
+                    this.chunkIndices.put(ca.spottedleaf.moonrise.common.util.CoordinateUtils.getChunkKey(chunk.locX, chunk.locZ), index);
+                }
+            }
+            java.util.Arrays.fill(this.included, false);
+            final ServerPlayer[] players = this.chunkMap.level.moonrise$getNearbyPlayers().getTrackedPlayersSnapshot();
+            for (final ServerPlayer player : players) {
+                final var event = player.playerNaturallySpawnedEvent;
+                if (event == null || event.isCancelled() || player.isSpectator()) {
+                    continue;
+                }
+                final int radius = Math.abs((int)event.getSpawnRadius());
+                final int blockRadius = event.getSpawnRadius() << 4;
+                final double range = (double)(blockRadius * blockRadius);
+                final Vec3 position = player.position();
+                if (radius > PLAYER_RADIUS_CHUNKS) {
+                    // Custom radii still use the tracked membership, including a lagging tracking centre.
+                    for (int index = 0; index < this.sourceChunks.length; ++index) {
+                        this.includeForPlayer(index, player, position, range);
+                    }
+                } else if (radius != 0 && Double.isFinite(position.x) && Double.isFinite(position.z)) {
+                    final int centreX = net.minecraft.util.Mth.floor(position.x) >> 4;
+                    final int centreZ = net.minecraft.util.Mth.floor(position.z) >> 4;
+                    for (int z = centreZ - radius; z <= centreZ + radius; ++z) {
+                        for (int x = centreX - radius; x <= centreX + radius; ++x) {
+                            final int index = this.chunkIndices.get(ca.spottedleaf.moonrise.common.util.CoordinateUtils.getChunkKey(x, z));
+                            if (index >= 0) {
+                                this.includeForPlayer(index, player, position, range);
+                            }
+                        }
+                    }
+                }
+            }
+            for (int index = 0; index < this.sourceChunks.length; ++index) {
+                if (this.included[index]) {
+                    output.add(this.sourceChunks[index]);
+                }
+            }
+            return true;
+        }
+
+        private void includeForPlayer(final int index, final ServerPlayer player, final Vec3 position, final double range) {
+            if (this.included[index]) {
+                return;
+            }
+            final LevelChunk chunk = this.sourceChunks[index];
+            if (!(euclideanDistanceSquared(chunk.locX, chunk.locZ, position) < range)) {
+                return;
+            }
+            final var nearby = chunk.moonrise$getChunkHolder().holderData.nearbyPlayers;
+            final var players = nearby == null ? null : nearby.getPlayers(
+                ca.spottedleaf.moonrise.common.misc.NearbyPlayers.NearbyMapType.SPAWN_RANGE);
+            if (players != null && players.contains(player)) {
+                this.included[index] = true;
+            }
+        }
+
