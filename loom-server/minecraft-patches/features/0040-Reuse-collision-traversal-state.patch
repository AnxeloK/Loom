+    private static final ThreadLocal<CollisionScratch> COLLISION_SCRATCH = ThreadLocal.withInitial(CollisionScratch::new);
+
+    private static CollisionScratch acquireCollisionScratch() {
+        CollisionScratch scratch = COLLISION_SCRATCH.get();
+        while (scratch.inUse) {
+            if (scratch.next == null) {
+                scratch.next = new CollisionScratch();
+            }
+            scratch = scratch.next;
+        }
+        scratch.inUse = true;
+        return scratch;
+    }
+
+    private static void releaseCollisionScratch(final CollisionScratch scratch) {
+        scratch.potentialCollisionsVoxel.clear();
+        scratch.potentialCollisionsBB.clear();
+        scratch.entityAABBs.clear();
+        scratch.stepVoxels.clear();
+        scratch.inUse = false;
+    }
