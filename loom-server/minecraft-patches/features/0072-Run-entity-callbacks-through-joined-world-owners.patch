@@ -1660,12 +1662,87 @@ public class TickRegions {
     // region work but do not recursively enter another world tick. Failures remain deterministic by world
     // list order, with Error taking priority after every world has completed.
     public static void tickWorldsInParallel(final List<ServerLevel> worlds, final java.util.function.Consumer<ServerLevel> worldTick) {
-        try (var trace = LoomProfileTrace.begin("world-batch", "worldTick", "", MinecraftServer.currentTick)) {
-            tickWorldsInParallelTraced(worlds, worldTick);
+        runWorldPhaseInParallel(worlds, worldTick, "worldTick");
+    }
+
+    // Keep the scheduler snapshot order within each world. Transfers are revalidated before execution;
+    // schedulers that moved to another world wait for the joined batch, then tick under the global owner.
+    public static void tickEntitySchedulersInParallel(
+        final MinecraftServer server,
+        final io.papermc.paper.threadedregions.EntityScheduler[] schedulers
+    ) {
+        if (OwnerDomainExecutor.currentDomain() != OwnerDomainExecutor.Domain.GLOBAL_CONTROL || currentContext() != null) {
+            throw new IllegalStateException("Entity callback phases require the global owner outside a world context");
+        }
+        OwnerDomainExecutor.assertGlobalOwner(server, "entity-scheduler-phase");
+        if (schedulers.length == 0) {
+            return;
+        }
+        final Map<ServerLevel, IntArrayList> byWorld = new LinkedHashMap<>();
+        for (int index = 0; index < schedulers.length; ++index) {
+            final io.papermc.paper.threadedregions.EntityScheduler scheduler = schedulers[index];
+            if (!scheduler.isRetired()) {
+                byWorld.computeIfAbsent(entitySchedulerWorld(server, scheduler), ignored -> new IntArrayList()).add(index);
+            }
+        }
+        if (byWorld.isEmpty()) {
+            return;
+        }
+
+        final boolean[] ticked = new boolean[schedulers.length];
+        runWorldPhaseInParallel(new ArrayList<>(byWorld.keySet()), world -> {
+            final RegionContext context = pushLevelContext(world);
+            try {
+                final IntArrayList indices = byWorld.get(world);
+                for (int offset = 0; offset < indices.size(); ++offset) {
+                    final int index = indices.getInt(offset);
+                    final io.papermc.paper.threadedregions.EntityScheduler scheduler = schedulers[index];
+                    if (scheduler.isRetired()) {
+                        ticked[index] = true;
+                    } else if (scheduler.entity.getHandleRaw().level() == world) {
+                        scheduler.executeTick();
+                        ticked[index] = true;
+                    }
+                }
+            } finally {
+                popContext(context);
+            }
+        }, "entityScheduler");
+
+        for (int index = 0; index < schedulers.length; ++index) {
+            final io.papermc.paper.threadedregions.EntityScheduler scheduler = schedulers[index];
+            if (!ticked[index] && !scheduler.isRetired()) {
+                entitySchedulerWorld(server, scheduler);
+                scheduler.executeTick();
+            }
+        }
+    }
+
+    private static ServerLevel entitySchedulerWorld(
+        final MinecraftServer server,
+        final io.papermc.paper.threadedregions.EntityScheduler scheduler
+    ) {
+        if (!(scheduler.entity.getHandleRaw().level() instanceof ServerLevel world) || world.getServer() != server) {
+            throw new IllegalArgumentException("Entity scheduler is not owned by this server");
         }
+        return world;
     }
 
-    private static void tickWorldsInParallelTraced(final List<ServerLevel> worlds, final java.util.function.Consumer<ServerLevel> worldTick) {
+    private static void runWorldPhaseInParallel(
+        final List<ServerLevel> worlds,
+        final java.util.function.Consumer<ServerLevel> worldTick,
+        final String phase
+    ) {
+        try (var trace = LoomProfileTrace.begin("world-batch", phase, "", MinecraftServer.currentTick)) {
+            tickWorldsInParallelTraced(worlds, worldTick, phase);
+        }
+    }
+
+    private static void tickWorldsInParallelTraced(
+        final List<ServerLevel> worlds,
+        final java.util.function.Consumer<ServerLevel> worldTick,
+        final String phase
+    ) {
         if (RUNNING_WORLD_TICK.get()) {
             throw new IllegalStateException("Cannot recursively enter a parallel world tick");
         }
@@ -1675,7 +1752,7 @@ public class TickRegions {
                 RUNNING_WORLD_TICK.set(Boolean.TRUE);
                 try {
                     for (final ServerLevel world : worlds) {
-                        try (var trace = LoomProfileTrace.begin("world", "worldTick", LoomProfileTrace.ENABLED ? world.dimension().identifier().toString() : "", MinecraftServer.currentTick)) {
+                        try (var trace = LoomProfileTrace.begin("world", phase, LoomProfileTrace.ENABLED ? world.dimension().identifier().toString() : "", MinecraftServer.currentTick)) {
                             worldTick.accept(world);
                         }
                     }
@@ -1689,11 +1766,11 @@ public class TickRegions {
             worlds.size(),
             i -> {
                 final ServerLevel world = worlds.get(i);
-                try (var trace = LoomProfileTrace.begin("world", "worldTick", LoomProfileTrace.ENABLED ? world.dimension().identifier().toString() : "", MinecraftServer.currentTick)) {
+                try (var trace = LoomProfileTrace.begin("world", phase, LoomProfileTrace.ENABLED ? world.dimension().identifier().toString() : "", MinecraftServer.currentTick)) {
                     worldTick.accept(world);
                 }
             },
-            "worldTick",
