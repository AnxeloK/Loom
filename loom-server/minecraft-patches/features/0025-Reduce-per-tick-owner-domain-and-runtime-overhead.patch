+++ b/net/minecraft/server/threading/runtime/OwnerDomainExecutor.java
@@ -126,6 +126,43 @@ public final class OwnerDomainExecutor {
         return context == null ? null : context.owner();
     }
 
+    static @Nullable String currentRandomKey(final ServerLevel level) {
+        final OwnerContext context = CURRENT_OWNER.get();
+        if (context == null) {
+            return null;
+        }
+        if (context.randomLevel == level) {
+            return context.randomUseFallback ? null : context.randomKey;
+        }
+
+        final Owner owner = context.owner();
+        if (isFullLevelRegion(owner, level)
+            && TickRegions.isCurrentThreadOwnerQuiet(level, Integer.MIN_VALUE, Integer.MIN_VALUE, Integer.MAX_VALUE, Integer.MAX_VALUE)) {
+            context.randomLevel = level;
+            context.randomKey = null;
+            context.randomUseFallback = true;
+            return null;
+        }
+
+        final String key = level.dimension().identifier() + "|" + owner.domain()
+            + "|" + owner.minChunkX() + "," + owner.minChunkZ()
+            + "|" + owner.maxChunkX() + "," + owner.maxChunkZ()
+            + "|" + owner.playerId();
+        context.randomLevel = level;
+        context.randomKey = key;
+        context.randomUseFallback = false;
+        return key;
+    }
+
+    private static boolean isFullLevelRegion(final Owner owner, final ServerLevel level) {
+        return owner.domain() == Domain.REGION
+            && owner.level() == level
+            && owner.minChunkX() == Integer.MIN_VALUE
+            && owner.minChunkZ() == Integer.MIN_VALUE
+            && owner.maxChunkX() == Integer.MAX_VALUE
+            && owner.maxChunkZ() == Integer.MAX_VALUE;
+    }
+
     public static Domain currentDomain() {
         final OwnerContext context = CURRENT_OWNER.get();
         return context == null ? Domain.ASYNC_IO : context.owner().domain();
@@ -146,7 +183,60 @@ public final class OwnerDomainExecutor {
     }
 
     public static boolean isGlobalOwner(final MinecraftServer server) {
-        return isOwner(global(server, "global-owner-check"));
+        for (OwnerContext context = CURRENT_OWNER.get(); context != null; context = context.previous()) {
+            final Owner owner = context.owner();
+            if (owner.domain() == Domain.GLOBAL_CONTROL && owner.server() == server) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    public static boolean isRegionOwner(final ServerLevel level, final int chunkX, final int chunkZ) {
+        for (OwnerContext context = CURRENT_OWNER.get(); context != null; context = context.previous()) {
+            final Owner owner = context.owner();
+            if (owner.domain() == Domain.REGION
+                && owner.level() == level
+                && chunkX >= owner.minChunkX()
+                && chunkX <= owner.maxChunkX()
+                && chunkZ >= owner.minChunkZ()
+                && chunkZ <= owner.maxChunkZ()) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    public static boolean isCurrentRegionOwnerForLevel(final ServerLevel level) {
+        final Owner owner = currentOwner();
+        return owner != null && owner.domain() == Domain.REGION && owner.level() == level;
+    }
+
+    public static boolean isEntityOwner(final Entity entity) {
+        Objects.requireNonNull(entity, "entity");
+        if (entity instanceof ServerPlayer player) {
+            return isPlayerOwner(player);
+        }
+
+        final Level level = entity.level();
+        if (level instanceof ServerLevel serverLevel) {
+            final net.minecraft.world.level.ChunkPos chunk = entity.chunkPosition();
+            return isRegionOwner(serverLevel, chunk.x(), chunk.z());
+        }
+
+        final MinecraftServer server = MinecraftServer.getServer();
+        return server != null && isGlobalOwner(server);
+    }
+
+    public static boolean isPlayerOwner(final ServerPlayer player) {
+        final UUID playerId = player.getUUID();
+        for (OwnerContext context = CURRENT_OWNER.get(); context != null; context = context.previous()) {
+            final Owner owner = context.owner();
+            if (owner.domain() == Domain.PLAYER && Objects.equals(owner.playerId(), playerId)) {
+                return true;
+            }
+        }
+        return false;
     }
 
     public static void assertOwner(final Owner owner, final String operation) {
@@ -319,7 +409,25 @@ public final class OwnerDomainExecutor {
     ) {
     }
 
-    private record OwnerContext(Owner owner, @Nullable OwnerContext previous) {
+    private static final class OwnerContext {
+        private final Owner owner;
+        private final @Nullable OwnerContext previous;
+        private @Nullable ServerLevel randomLevel;
+        private @Nullable String randomKey;
+        private boolean randomUseFallback;
+
+        private OwnerContext(final Owner owner, final @Nullable OwnerContext previous) {
+            this.owner = owner;
+            this.previous = previous;
+        }
+
+        private Owner owner() {
+            return this.owner;
+        }
+
+        private @Nullable OwnerContext previous() {
+            return this.previous;
+        }
     }
 
     public static final class Scope implements AutoCloseable {
