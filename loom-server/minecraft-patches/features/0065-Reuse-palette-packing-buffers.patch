From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: anxelok <anxelok@localhost>
Date: Sun, 12 Jul 2026 19:29:51 +0000
Subject: [PATCH] Reuse palette packing buffers


diff --git a/net/minecraft/world/level/chunk/PalettedContainer.java b/net/minecraft/world/level/chunk/PalettedContainer.java
index 26dbb9da7a7f50ec913b1226eff9e9ce6b4f3f12..9022152c70ebc77ae43dd3de6b86587b3caaaeac 100644
--- a/net/minecraft/world/level/chunk/PalettedContainer.java
+++ b/net/minecraft/world/level/chunk/PalettedContainer.java
@@ -24,6 +24,10 @@ import org.jspecify.annotations.Nullable;
 
 public class PalettedContainer<T> implements PaletteResize<T>, PalettedContainerRO<T> {
     private static final int MIN_PALETTE_BITS = 0;
+    // Loom - packing a chunk section previously allocated a 4096-entry int array for every palette.
+    // Save workers consume this scratch array synchronously while holding the container lock, so one
+    // buffer per worker avoids the allocation without retaining or sharing serialized state.
+    private static final ThreadLocal<int[]> PACK_REENCODE_BUFFER = ThreadLocal.withInitial(() -> new int[4096]);
     public volatile PalettedContainer.Data<T> data; // Paper - optimise collisions - public
     private final Strategy<T> strategy;
     private final T @Nullable [] presetValues; // Paper - Anti-Xray - Add preset values
@@ -332,7 +336,8 @@ public class PalettedContainer<T> implements PaletteResize<T>, PalettedContainer
                     Palette<T> oldPalette = new HashMapPalette<>(bitsOnDisc, paletteEntries);
                     SimpleBitStorage oldStorage = new SimpleBitStorage(bitsOnDisc, entryCount, data);
                     Palette<T> newPalette = storedConfiguration.createPalette(strategy, paletteEntries);
-                    int[] newContents = reencodeContents(oldStorage, oldPalette, newPalette);
+                    int[] newContents = new int[oldStorage.getSize()];
+                    reencodeContents(oldStorage, oldPalette, newPalette, newContents);
                     palette = newPalette;
                     storage = new SimpleBitStorage(storedConfiguration.bitsInMemory(), entryCount, newContents);
                 }
@@ -353,7 +358,12 @@ public class PalettedContainer<T> implements PaletteResize<T>, PalettedContainer
             Palette<T> currentPalette = this.data.palette;
             HashMapPalette<T> newPalette = new HashMapPalette<>(currentStorage.getBits());
             int entryCount = strategy.entryCount();
-            int[] newContents = reencodeContents(currentStorage, currentPalette, newPalette);
+            int[] newContents = PACK_REENCODE_BUFFER.get();
+            if (newContents.length < currentStorage.getSize()) {
+                newContents = new int[currentStorage.getSize()];
+                PACK_REENCODE_BUFFER.set(newContents);
+            }
+            reencodeContents(currentStorage, currentPalette, newPalette, newContents);
             Configuration storedConfiguration = strategy.getConfigurationForPaletteSize(newPalette.getSize());
             int bitsOnDisc = storedConfiguration.bitsInStorage();
             Optional<LongStream> values;
@@ -370,14 +380,18 @@ public class PalettedContainer<T> implements PaletteResize<T>, PalettedContainer
         }
     }
 
-    private static <T> int[] reencodeContents(final BitStorage storage, final Palette<T> oldPalette, final Palette<T> newPalette) {
-        int[] buffer = new int[storage.getSize()];
+    private static <T> void reencodeContents(
+        final BitStorage storage,
+        final Palette<T> oldPalette,
+        final Palette<T> newPalette,
+        final int[] buffer
+    ) {
         storage.unpack(buffer);
         PaletteResize<T> dummyResizer = PaletteResize.noResizeExpected();
         int lastReadId = -1;
         int lastWrittenId = -1;
 
-        for (int index = 0; index < buffer.length; index++) {
+        for (int index = 0, len = storage.getSize(); index < len; index++) {
             int id = buffer[index];
             if (id != lastReadId) {
                 lastReadId = id;
@@ -386,8 +400,6 @@ public class PalettedContainer<T> implements PaletteResize<T>, PalettedContainer
 
             buffer[index] = lastWrittenId;
         }
-
-        return buffer;
     }
 
     @Override
