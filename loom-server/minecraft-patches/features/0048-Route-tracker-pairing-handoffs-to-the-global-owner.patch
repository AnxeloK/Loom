From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: anxelok <anxelok@localhost>
Date: Mon, 6 Jul 2026 16:37:46 +0000
Subject: [PATCH] Route tracker pairing handoffs to the global owner

A worker owns the entity's own region, so the region-targeted handoff
ran inline straight back into the staging guard and overflowed the
stack. The global queue drains on the server thread where staging is
off and both endpoints are owned.

diff --git a/net/minecraft/server/level/ChunkMap.java b/net/minecraft/server/level/ChunkMap.java
index 8ae2d277ee223dd1585238945a3a5b2c70f06b46..bc62921e84a28b71f1643cf8e6f7f1a34dc83879 100644
--- a/net/minecraft/server/level/ChunkMap.java
+++ b/net/minecraft/server/level/ChunkMap.java
@@ -1415,10 +1415,10 @@ public class ChunkMap extends SimpleRegionStorage implements ChunkHolder.PlayerP
                 if (!this.seenBy.contains(player.connection)) {
                     return;
                 }
-                final ChunkPos entityChunk = this.entity.chunkPosition();
+                // See updatePlayer: global owner, not the worker's own region.
                 net.minecraft.server.threading.runtime.OwnerDomainExecutor.execute(
-                    net.minecraft.server.threading.runtime.OwnerDomainExecutor.region(
-                        ChunkMap.this.level, entityChunk.x(), entityChunk.z(), "tracker-unpairing"),
+                    net.minecraft.server.threading.runtime.OwnerDomainExecutor.global(
+                        ChunkMap.this.level.getServer(), "tracker-unpairing"),
                     () -> this.removePlayer(player));
                 return;
             }
@@ -1481,10 +1481,13 @@ public class ChunkMap extends SimpleRegionStorage implements ChunkHolder.PlayerP
                 if (visible == this.seenBy.contains(player.connection)) {
                     return;
                 }
-                final ChunkPos entityChunk = this.entity.chunkPosition();
+                // Route to the GLOBAL owner: a worker owns the entity's own region, so a region-targeted
+                // handoff would run inline right back into this guard. The global queue drains on the
+                // server thread, where staging is off, both endpoints are owned by definition, and the
+                // pairing event fires on the real main thread.
                 net.minecraft.server.threading.runtime.OwnerDomainExecutor.execute(
-                    net.minecraft.server.threading.runtime.OwnerDomainExecutor.region(
-                        ChunkMap.this.level, entityChunk.x(), entityChunk.z(), "tracker-pairing"),
+                    net.minecraft.server.threading.runtime.OwnerDomainExecutor.global(
+                        ChunkMap.this.level.getServer(), "tracker-pairing"),
                     () -> this.updatePlayer(player));
                 return;
             }
