index 0000000000000000000000000000000000000000..0bf3b71503e83a139dafc0fc29bbdade885ea0ef
--- /dev/null
+++ b/net/minecraft/server/players/PlayerRespawnOperation.java
@@ -0,0 +1,38 @@
+package net.minecraft.server.players;
+
+import java.util.concurrent.CompletableFuture;
+import java.util.function.Supplier;
+
+/** Shares one respawn across client and plugin requests until transfer has completed. */
+public final class PlayerRespawnOperation {
+    private CompletableFuture<Void> pending;
+
+    public CompletableFuture<Void> start(final Supplier<CompletableFuture<Void>> operation) {
+        final CompletableFuture<Void> completion;
+        synchronized (this) {
+            if (this.pending != null) {
+                return this.pending.copy();
+            }
+            completion = new CompletableFuture<>();
+            this.pending = completion;
+        }
+        try {
+            operation.get().whenComplete((ignored, failure) -> this.finish(completion, failure));
+        } catch (final Throwable failure) {
+            this.finish(completion, failure);
+        }
+        // Cancelling one caller must not permit another transfer while the first still runs.
+        return completion.copy();
+    }
+
+    private void finish(final CompletableFuture<Void> completion, final Throwable failure) {
+        synchronized (this) {
+            this.pending = null;
+        }
+        if (failure == null) {
+            completion.complete(null);
+        } else {
+            completion.completeExceptionally(failure);
+        }
+    }
+}
