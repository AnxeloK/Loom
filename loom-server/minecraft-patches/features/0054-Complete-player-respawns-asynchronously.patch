+    public CompletableFuture<Void> respawnAsync(final RespawnReason reason) {
+        return this.respawnOperation.start(() -> {
+            final ServerPlayer respawningPlayer = this.player;
+            final boolean returningFromEnd = reason == RespawnReason.END_PORTAL;
+            if (this.isDisconnected()) {
+                return CompletableFuture.failedFuture(new java.util.concurrent.CancellationException("Player disconnected"));
+            }
+            if (!returningFromEnd && respawningPlayer.getHealth() > 0.0F) {
+                return CompletableFuture.completedFuture(null);
+            }
+            respawningPlayer.wonGame = false;
+            return this.server.getPlayerList().respawnAsync(
+                respawningPlayer,
+                returningFromEnd,
+                returningFromEnd ? Entity.RemovalReason.CHANGED_DIMENSION : Entity.RemovalReason.KILLED,
+                reason
+            ).thenCompose(respawnedPlayer -> net.minecraft.server.threading.runtime.OwnerDomainExecutor.supply(
+                net.minecraft.server.threading.runtime.OwnerDomainExecutor.player(respawningPlayer, "respawn-completion"),
+                () -> {
+                    if (this.isDisconnected() || this.player != respawningPlayer || respawnedPlayer == null) {
+                        throw new java.util.concurrent.CancellationException("Player session retired during respawn");
+                    }
+                    this.player = respawnedPlayer;
+                    this.resetPosition();
+                    this.restartClientLoadTimerAfterRespawn();
+                    if (returningFromEnd) {
+                        CriteriaTriggers.CHANGED_DIMENSION.trigger(this.player, Level.END, Level.OVERWORLD);
+                    } else if (reason == RespawnReason.DEATH && this.server.isHardcore()) {
+                        this.player.setGameMode(GameType.SPECTATOR, org.bukkit.event.player.PlayerGameModeChangeEvent.Cause.HARDCORE_DEATH, null);
+                    }
+                    return null;
+                }
+            )).thenCompose(ignored -> {
+                if (reason != RespawnReason.DEATH || !this.server.isHardcore()) {
+                    return CompletableFuture.completedFuture(null);
+                }
+                return net.minecraft.server.threading.runtime.OwnershipRouter.runOnServer(this.server, () -> {
+                    if (this.isDisconnected() || this.player != respawningPlayer) {
+                        throw new java.util.concurrent.CancellationException("Player session retired during respawn");
+                    }
+                    this.player.level().getGameRules().set(GameRules.SPECTATORS_GENERATE_CHUNKS, false, this.player.level());
+                });
+            });
+        });
+    }
