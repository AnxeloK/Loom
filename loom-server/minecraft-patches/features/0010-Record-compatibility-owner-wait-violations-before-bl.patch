From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: anxelok <anxelok@localhost>
Date: Sun, 31 May 2026 16:51:24 +0000
Subject: [PATCH] Record compatibility owner wait violations before blocking
 barrier throws


diff --git a/net/minecraft/server/threading/runtime/ThreadedRegionsBlockingBarrier.java b/net/minecraft/server/threading/runtime/ThreadedRegionsBlockingBarrier.java
index 3b9371d781b041082d57b88ca3e63cd3b5457974..3682d5b7ed257e569a46ab603307ad870c6cb3cc 100644
--- a/net/minecraft/server/threading/runtime/ThreadedRegionsBlockingBarrier.java
+++ b/net/minecraft/server/threading/runtime/ThreadedRegionsBlockingBarrier.java
@@ -1,5 +1,7 @@
 package net.minecraft.server.threading.runtime;
 
+import io.papermc.paper.plugin.manager.compat.CompatibilityDiagnostics;
+import io.papermc.paper.plugin.manager.compat.CompatibilityRuntimeContext;
 import java.util.concurrent.CompletableFuture;
 import java.util.concurrent.TimeUnit;
 import java.util.concurrent.locks.Condition;
@@ -69,6 +71,10 @@ public final class ThreadedRegionsBlockingBarrier {
 
     private static void assertOffOwnerDomain(final String operation) {
         if (OwnerDomainExecutor.canRunSynchronousCallbacks()) {
+            final org.bukkit.plugin.Plugin plugin = CompatibilityRuntimeContext.currentPlugin();
+            if (plugin != null) {
+                CompatibilityDiagnostics.global().profileFor(plugin).noteOwnerDomainWaitViolation(operation);
+            }
             throw new IllegalStateException("Owner-domain violation: " + operation + " cannot block an owner-domain thread");
         }
     }
