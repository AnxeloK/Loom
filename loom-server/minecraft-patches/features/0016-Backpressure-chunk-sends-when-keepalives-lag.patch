From: anxelok <anxelok@localhost>
Date: Wed, 3 Jun 2026 16:33:28 +0000
Subject: [PATCH] Backpressure chunk sends when keepalives lag


diff --git a/ca/spottedleaf/moonrise/patches/chunk_system/player/RegionizedPlayerChunkLoader.java b/ca/spottedleaf/moonrise/patches/chunk_system/player/RegionizedPlayerChunkLoader.java
index 376879e8e6f0da1ef06cafbc3027f4134efc188a..c19f2418027356d6fe0d17dc7add7151fc20ea33 100644
--- a/ca/spottedleaf/moonrise/patches/chunk_system/player/RegionizedPlayerChunkLoader.java
+++ b/ca/spottedleaf/moonrise/patches/chunk_system/player/RegionizedPlayerChunkLoader.java
@@ -428,6 +428,18 @@ public final class RegionizedPlayerChunkLoader {
         private final Long idBoxed = Long.valueOf(this.id);
 
         private static final long MAX_RATE = 10_000L;
+        private static final long LOOM_KEEPALIVE_SOFT_BACKPRESSURE_NANOS = getMillisPropertyNanos(
+            "Loom.PlayerChunkSendKeepAliveSoftBackpressureMillis", 5_000L
+        );
+        private static final long LOOM_KEEPALIVE_HARD_BACKPRESSURE_NANOS = getMillisPropertyNanos(
+            "Loom.PlayerChunkSendKeepAliveHardBackpressureMillis", 10_000L
+        );
+        private static final int LOOM_KEEPALIVE_SOFT_SEND_MAX_PER_TICK = getIntProperty(
+            "Loom.PlayerChunkSendKeepAliveSoftMaxPerTick", 4
+        );
+        private static final int LOOM_KEEPALIVE_HARD_SEND_MAX_PER_TICK = getIntProperty(
+            "Loom.PlayerChunkSendKeepAliveHardMaxPerTick", 2
+        );
 
         private final ServerPlayer player;
         private final ServerLevel world;
@@ -482,6 +494,30 @@ public final class RegionizedPlayerChunkLoader {
                 .build();
         }
 
+        private static int getIntProperty(final String property, final int fallback) {
+            final String configured = System.getProperty(property);
+            if (configured == null) {
+                return fallback;
+            }
+            try {
+                return Math.max(1, Integer.parseInt(configured));
+            } catch (final NumberFormatException ignored) {
+                return fallback;
+            }
+        }
+
+        private static long getMillisPropertyNanos(final String property, final long fallback) {
+            final String configured = System.getProperty(property);
+            if (configured == null) {
+                return TimeUnit.MILLISECONDS.toNanos(fallback);
+            }
+            try {
+                return TimeUnit.MILLISECONDS.toNanos(Math.max(1L, Long.parseLong(configured)));
+            } catch (final NumberFormatException ignored) {
+                return TimeUnit.MILLISECONDS.toNanos(fallback);
+            }
+        }
+
         private final StaggeredRateLimiter chunkSendLimiter = createChunkLimiter();
         private final StaggeredRateLimiter chunkLoadTicketLimiter = createChunkLimiter();
         private final StaggeredRateLimiter chunkGenerateTicketLimiter = createChunkLimiter();
@@ -730,6 +766,23 @@ public final class RegionizedPlayerChunkLoader {
             return configRate <= 0.0 || configRate > (double)MAX_RATE ? (double)MAX_RATE : Math.max(1.0, configRate);
         }
 
+        private long getMaxChunkSendsThisTick(final long now) {
+            long maxSends = Math.max(0L, Math.min(MAX_RATE, Math.min(this.sendQueue.size(), Integer.MAX_VALUE)));
+            final net.minecraft.server.network.ServerGamePacketListenerImpl connection = this.player.connection;
+            if (connection == null) {
+                return maxSends;
+            }
+
+            final long keepAliveAgeNanos = connection.oldestPendingKeepAliveAgeNanos(now);
+            if (keepAliveAgeNanos >= LOOM_KEEPALIVE_HARD_BACKPRESSURE_NANOS) {
+                maxSends = Math.min(maxSends, LOOM_KEEPALIVE_HARD_SEND_MAX_PER_TICK);
+            } else if (keepAliveAgeNanos >= LOOM_KEEPALIVE_SOFT_BACKPRESSURE_NANOS) {
+                maxSends = Math.min(maxSends, LOOM_KEEPALIVE_SOFT_SEND_MAX_PER_TICK);
+            }
+
+            return maxSends;
+        }
+
         private long getMaxChunkLoads() {
             final long radiusChunks = (2L * this.lastLoadDistance + 1L) * (2L * this.lastLoadDistance + 1L);
             long configLimit = (long)PlatformHooks.get().configPlayerMaxConcurrentLoads();
@@ -1006,7 +1059,7 @@ public final class RegionizedPlayerChunkLoader {
             }
 
             // try to pull sending chunks
-            final long maxSends = Math.max(0L, Math.min(MAX_RATE, Math.min(this.sendQueue.size(), Integer.MAX_VALUE))); // note: no logic to track concurrent sends
+            final long maxSends = this.getMaxChunkSendsThisTick(time); // note: no logic to track concurrent sends
             final long maxSendsThisTick = this.chunkSendLimiter.takeAllocation(maxSends);
             // we do not return sends that we took from the allocation back because we want to limit the max send rate, not target it
             for (long i = 0; i < maxSendsThisTick; ++i) {
diff --git a/net/minecraft/server/network/ServerCommonPacketListenerImpl.java b/net/minecraft/server/network/ServerCommonPacketListenerImpl.java
index 67662f842d30ffc9582d7f925ae845479234f022..f8c0298b33f7115b633780fd634eaff6378b5910 100644
--- a/net/minecraft/server/network/ServerCommonPacketListenerImpl.java
+++ b/net/minecraft/server/network/ServerCommonPacketListenerImpl.java
@@ -148,6 +148,11 @@ public abstract class ServerCommonPacketListenerImpl implements ServerCommonPack
         this.latency = this.keepAlive.pingCalculator5s.getAvgLatencyMS();
     }
 
+    public long oldestPendingKeepAliveAgeNanos(final long now) {
+        final io.papermc.paper.util.KeepAlive.PendingKeepAlive oldest = this.keepAlive.pendingKeepAlives.peek();
+        return oldest == null ? 0L : Math.max(0L, now - oldest.txTimeNS());
+    }
+
     @Override
     public void handlePong(final ServerboundPongPacket serverboundPongPacket) {
     }
