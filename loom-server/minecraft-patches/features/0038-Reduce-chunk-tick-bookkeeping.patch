+            final it.unimi.dsi.fastutil.longs.Long2ObjectMap<ArrayList<LevelChunk>> byRegion =
+                new it.unimi.dsi.fastutil.longs.Long2ObjectOpenHashMap<>();
+            for (int i = 0; i < size; ++i) {
+                final LevelChunk chunk = chunks[i];
+                final int regionX = chunk.locX >> shift;
+                final int regionZ = chunk.locZ >> shift;
+                final long key = ((long)regionX << 32) | (regionZ & 0xFFFFFFFFL);
+                byRegion.computeIfAbsent(key, ignored -> new ArrayList<>()).add(chunk);
+            }
+            if (byRegion.size() <= 1) {
