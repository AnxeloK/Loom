From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: anxelok <anxelok@localhost>
Date: Mon, 6 Jul 2026 13:51:13 +0000
Subject: [PATCH] Coalesce event-loop flushes for packets sent off the event
 loop

Writes marshalled onto the event loop no longer flush individually;
one flush task per burst is queued behind the writes it covers. Under
parallel ticking the entity tracker sends from region threads, and
per-packet flushing cost a syscall per tracker packet. Sparse traffic
schedules its own flush immediately, so handshakes and keepalives are
unaffected; a packet racing a pending flush is picked up by the next
trigger at worst one tick later.

diff --git a/net/minecraft/network/Connection.java b/net/minecraft/network/Connection.java
index 6122b576da4a3d821d41ae872692554ef10bea3b..b9347a045ded7cac8cd684ce9f7f44f6da4f0105 100644
--- a/net/minecraft/network/Connection.java
+++ b/net/minecraft/network/Connection.java
@@ -70,6 +70,7 @@ public class Connection extends SimpleChannelInboundHandler<Packet<?>> {
     private volatile boolean sendLoginDisconnect = true;
     private final Queue<WrappedConsumer> pendingActions = Queues.newConcurrentLinkedQueue(); // Paper - Optimize network
     private final AtomicInteger loomPendingEventLoopWrites = new AtomicInteger();
+    private final java.util.concurrent.atomic.AtomicBoolean loomFlushScheduled = new java.util.concurrent.atomic.AtomicBoolean();
     public Channel channel;
     public SocketAddress address;
     // Spigot start
@@ -473,15 +474,29 @@ public class Connection extends SimpleChannelInboundHandler<Packet<?>> {
         if (this.channel.eventLoop().inEventLoop()) {
             this.doSendPacket(packet, listener, flush);
         } else {
+            // Loom - coalesce flushes for writes marshalled onto the event loop. Under parallel ticking the
+            // entity tracker sends from region threads, so a mob-heavy tick queues thousands of these writes;
+            // flushing each one costs a syscall per packet (profiled at ~a fifth of total CPU under load).
+            // Write without flushing and enqueue at most ONE flush task per burst: the flush task is queued
+            // after the writes it covers, so everything already marshalled reaches the socket in one flush.
+            // A packet that arrives while a flush is pending simply leaves the flag set; its own bytes are
+            // covered by the next trigger (the tracker fires every tick, and sparse traffic such as login
+            // and keepalive schedules its own flush immediately), so worst-case added latency is one tick.
             this.loomPendingEventLoopWrites.incrementAndGet();
             try {
                 this.channel.eventLoop().execute(() -> {
                     try {
-                        this.doSendPacket(packet, listener, flush);
+                        this.doSendPacket(packet, listener, false);
                     } finally {
                         this.loomPendingEventLoopWrites.decrementAndGet();
                     }
                 });
+                if (flush && this.loomFlushScheduled.compareAndSet(false, true)) {
+                    this.channel.eventLoop().execute(() -> {
+                        this.loomFlushScheduled.set(false);
+                        this.channel.flush();
+                    });
+                }
             } catch (final RuntimeException ex) {
                 this.loomPendingEventLoopWrites.decrementAndGet();
                 throw ex;
