From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: anxelok <anxelok@localhost>
Date: Mon, 6 Jul 2026 14:24:37 +0000
Subject: [PATCH] Coalesce play-phase flushes for packets sent off the event
 loop

Under parallel ticking the entity tracker sends from region threads,
so every tracker packet is marshalled onto the event loop and flushed
individually - a syscall per packet, profiled at about a fifth of
total CPU under mob load. For connections in the play protocol the
flushes now coalesce per event-loop burst: writes queue unflushed and
at most one flush task per burst is enqueued behind them.

Handshake, login and configuration keep per-write flushes; those
exchanges are request-response and the peer waits on each packet,
which is how two earlier blanket forms of this change broke logins.
The play flag follows the outbound protocol transitions, so a
connection returning to configuration also returns to eager flushes.

diff --git a/net/minecraft/network/Connection.java b/net/minecraft/network/Connection.java
index 6122b576da4a3d821d41ae872692554ef10bea3b..669164b419143dbf1aa4572f95e9fd977c0ea4dd 100644
--- a/net/minecraft/network/Connection.java
+++ b/net/minecraft/network/Connection.java
@@ -70,6 +70,12 @@ public class Connection extends SimpleChannelInboundHandler<Packet<?>> {
     private volatile boolean sendLoginDisconnect = true;
     private final Queue<WrappedConsumer> pendingActions = Queues.newConcurrentLinkedQueue(); // Paper - Optimize network
     private final AtomicInteger loomPendingEventLoopWrites = new AtomicInteger();
+    // Loom - flush batching applies only to established PLAY-phase connections. Handshake, login and
+    // configuration are request-response exchanges where the peer waits on every packet, so those keep
+    // per-write flushes; play traffic is a firehose the client never round-trips on, so its flushes
+    // coalesce per event-loop burst.
+    private volatile boolean loomFlushBatchable;
+    private final java.util.concurrent.atomic.AtomicBoolean loomFlushScheduled = new java.util.concurrent.atomic.AtomicBoolean();
     public Channel channel;
     public SocketAddress address;
     // Spigot start
@@ -347,6 +353,7 @@ public class Connection extends SimpleChannelInboundHandler<Packet<?>> {
             }
 
             boolean isLoginProtocol = protocol.id() == ConnectionProtocol.LOGIN;
+            this.loomFlushBatchable = protocol.id() == ConnectionProtocol.PLAY; // Loom - see field
             syncAfterConfigurationChange(this.channel.writeAndFlush(configMessage.andThen(ctx -> this.sendLoginDisconnect = isLoginProtocol)));
         }
     }
@@ -473,15 +480,28 @@ public class Connection extends SimpleChannelInboundHandler<Packet<?>> {
         if (this.channel.eventLoop().inEventLoop()) {
             this.doSendPacket(packet, listener, flush);
         } else {
+            // Loom - on an established play-phase connection, coalesce the flushes of writes marshalled
+            // onto the event loop: write without flushing and queue at most one flush task per burst. The
+            // flush task is enqueued behind the writes it covers, so everything already marshalled reaches
+            // the socket in a single flush; a packet racing a pending flush is picked up by the next
+            // trigger (the entity tracker fires every tick). Pre-play phases keep per-write flushes - the
+            // peer round-trips on those packets, so deferring them stalls the exchange.
+            final boolean batchFlush = flush && this.loomFlushBatchable;
             this.loomPendingEventLoopWrites.incrementAndGet();
             try {
                 this.channel.eventLoop().execute(() -> {
                     try {
-                        this.doSendPacket(packet, listener, flush);
+                        this.doSendPacket(packet, listener, batchFlush ? false : flush);
                     } finally {
                         this.loomPendingEventLoopWrites.decrementAndGet();
                     }
                 });
+                if (batchFlush && this.loomFlushScheduled.compareAndSet(false, true)) {
+                    this.channel.eventLoop().execute(() -> {
+                        this.loomFlushScheduled.set(false);
+                        this.channel.flush();
+                    });
+                }
             } catch (final RuntimeException ex) {
                 this.loomPendingEventLoopWrites.decrementAndGet();
                 throw ex;
