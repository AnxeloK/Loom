-                    ++this.createdRegions;
-                    this.regions.put(
-                        regionId,
-                        new RegionDescriptor(regionId, minChunkX, minChunkZ, maxChunkX, maxChunkZ, RegionLifecycleEvent.CREATED, List.of())
-                    );
-                    final Lease lease = new Lease(
-                        leaseId,
-                        minChunkX,
-                        minChunkZ,
-                        maxChunkX,
-                        maxChunkZ,
-                        ownerThread,
-                        ownerThreadName,
-                        regionId
-                    );
-                    final Lease prev = this.leases.put(lease.id, lease);
-                    if (prev != null) {
-                        throw new IllegalStateException("Duplicate lease id: " + lease.id);
+                // The claim path is hot (every parallel bucket, every tick). The former region
+                // descriptor/reference-count bookkeeping (exact-lease scan, overlap set, containing-
+                // region scan, descriptor allocation and timestamps) fed only the /loom snapshot's
+                // aggregate counters, so claims now do exactly two things: the conflict check that is
+                // the safety contract, and the lease registration itself. A lease is its own region
