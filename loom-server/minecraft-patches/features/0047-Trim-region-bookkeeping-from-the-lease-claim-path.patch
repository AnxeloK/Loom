             } finally {
                 this.lock.unlock();
             }
@@ -332,15 +305,7 @@ public class RegionRuntime {
                     return;
                 }
                 this.unindexLease(removed);
-                final Integer refs = this.regionReferenceCounts.get(removed.regionId);
-                if (refs == null || refs <= 1) {
-                    this.regionReferenceCounts.remove(removed.regionId);
-                    if (this.regions.remove(removed.regionId) != null) {
-                        ++this.retiredRegions;
-                    }
-                } else {
-                    this.regionReferenceCounts.put(removed.regionId, refs - 1);
-                }
+                ++this.retiredRegions;
             } finally {
                 this.lock.unlock();
             }
@@ -447,96 +412,8 @@ public class RegionRuntime {
             return null;
         }
 
-        private long resolveRegionId(
-            final int minChunkX,
-            final int minChunkZ,
-            final int maxChunkX,
-            final int maxChunkZ,
-            final AtomicLong nextRegionId
-        ) {
-            final Lease exact = this.findExactLease(minChunkX, minChunkZ, maxChunkX, maxChunkZ);
-            if (exact != null) {
-                return exact.regionId;
-            }
 
-            final Set<Long> overlappingRegions = new HashSet<>();
-            for (final Lease existing : this.leases.values()) {
-                if (existing.intersects(minChunkX, minChunkZ, maxChunkX, maxChunkZ)) {
-                    overlappingRegions.add(existing.regionId);
-                }
-            }
 
-            final long reusableRegionId = this.findContainingRegion(
-                overlappingRegions,
-                minChunkX,
-                minChunkZ,
-                maxChunkX,
-                maxChunkZ
-            );
-            if (reusableRegionId != Long.MIN_VALUE) {
-                ++this.reusedRegionAssignments;
-                final RegionDescriptor descriptor = this.regions.get(reusableRegionId);
-                if (descriptor != null) {
-                    descriptor.touch();
-                }
-                return reusableRegionId;
-            }
-
-            final long regionId = nextRegionId.getAndIncrement();
-            final RegionLifecycleEvent lifecycleEvent;
-            final List<Long> parentRegionIds;
-            if (overlappingRegions.isEmpty()) {
-                lifecycleEvent = RegionLifecycleEvent.CREATED;
-                parentRegionIds = List.of();
-            } else if (overlappingRegions.size() == 1) {
-                lifecycleEvent = RegionLifecycleEvent.SPLIT;
-                ++this.splitEvents;
-                parentRegionIds = List.copyOf(overlappingRegions);
-            } else {
-                lifecycleEvent = RegionLifecycleEvent.MERGE;
-                ++this.mergeEvents;
-                parentRegionIds = List.copyOf(overlappingRegions);
-            }
-
-            ++this.createdRegions;
-            this.regions.put(
-                regionId,
-                new RegionDescriptor(regionId, minChunkX, minChunkZ, maxChunkX, maxChunkZ, lifecycleEvent, parentRegionIds)
-            );
-            return regionId;
-        }
-
-        private long findContainingRegion(
-            final Set<Long> overlappingRegions,
-            final int minChunkX,
-            final int minChunkZ,
-            final int maxChunkX,
-            final int maxChunkZ
-        ) {
-            long selectedRegionId = Long.MIN_VALUE;
-            long selectedArea = Long.MAX_VALUE;
-            for (final Long regionId : overlappingRegions) {
-                final RegionDescriptor descriptor = this.regions.get(regionId);
-                if (descriptor == null || !descriptor.contains(minChunkX, minChunkZ, maxChunkX, maxChunkZ)) {
-                    continue;
-                }
-                final long area = descriptor.area();
-                if (selectedRegionId == Long.MIN_VALUE || area < selectedArea) {
-                    selectedRegionId = regionId.longValue();
-                    selectedArea = area;
-                }
-            }
-            return selectedRegionId;
-        }
-
-        private Lease findExactLease(final int minChunkX, final int minChunkZ, final int maxChunkX, final int maxChunkZ) {
-            for (final Lease lease : this.leases.values()) {
-                if (lease.matches(minChunkX, minChunkZ, maxChunkX, maxChunkZ)) {
-                    return lease;
-                }
-            }
-            return null;
-        }
 
         private WorldDiagnostics snapshot(final String worldId) {
             this.lock.lock();
@@ -544,7 +421,7 @@ public class RegionRuntime {
                 return new WorldDiagnostics(
                     worldId,
                     this.leases.size(),
-                    this.regionReferenceCounts.size(),
+                    this.leases.size(),
                     this.createdRegions,
                     this.splitEvents,
                     this.mergeEvents,
