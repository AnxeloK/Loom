+    private static final class SpawnCommitGate {
+        private final NavigableMap<Long, ArrayDeque<CommitRequest>> pending = new TreeMap<>();
+        private @Nullable CommitRequest active;
+
+        private boolean execute(final long orderKey, final BooleanSupplier action) {
+            final CommitRequest request = new CommitRequest(orderKey);
+            synchronized (this) {
+                this.pending.computeIfAbsent(orderKey, ignored -> new ArrayDeque<>()).addLast(request);
+                while (this.active != null || !this.isFirstPending(request)) {
+                    try {
+                        this.wait();
+                    } catch (final InterruptedException ex) {
+                        Thread.currentThread().interrupt();
+                        this.removeRequest(request);
+                        this.notifyAll();
+                        throw new IllegalStateException("Interrupted while waiting for natural spawn commit gate", ex);
+                    }
+                }
+                this.active = request;
+            }
+
+            try {
+                return action.getAsBoolean();
+            } finally {
+                synchronized (this) {
+                    this.removeRequest(request);
+                    this.active = null;
+                    this.notifyAll();
+                }
+            }
+        }
+
+        private boolean isFirstPending(final CommitRequest request) {
+            final java.util.Map.Entry<Long, ArrayDeque<CommitRequest>> first = this.pending.firstEntry();
+            return first != null && first.getValue().peekFirst() == request;
+        }
+
+        private void removeRequest(final CommitRequest request) {
+            final ArrayDeque<CommitRequest> requests = this.pending.get(request.orderKey);
+            if (requests == null) {
+                return;
+            }
+            requests.remove(request);
+            if (requests.isEmpty()) {
+                this.pending.remove(request.orderKey);
+            }
+        }
+    }
