+        private boolean isTrackerPlayerContextOwned(final ServerPlayer player) {
+            if (player.level() != ChunkMap.this.level) {
+                return ca.spottedleaf.moonrise.common.util.TickThread.isTickThreadFor(player);
+            }
+            final ChunkPos entityChunk = this.entity.chunkPosition();
+            final ChunkPos playerChunk = player.chunkPosition();
+            return net.minecraft.server.threading.TickRegions.isCurrentThreadOwnerQuiet(ChunkMap.this.level, entityChunk.x(), entityChunk.z())
+                && net.minecraft.server.threading.TickRegions.isCurrentThreadOwnerQuiet(ChunkMap.this.level, playerChunk.x(), playerChunk.z());
+        }
+
+        private void runWithTrackerPlayerContext(final ServerPlayer player, final Runnable action) {
+            if (player.level() != ChunkMap.this.level) {
+                action.run();
+                return;
+            }
+            final ChunkPos entityChunk = this.entity.chunkPosition();
+            final ChunkPos playerChunk = player.chunkPosition();
+            net.minecraft.server.threading.TickRegions.RegionContext entityContext = null;
+            net.minecraft.server.threading.TickRegions.RegionContext playerContext = null;
+            if (!net.minecraft.server.threading.TickRegions.isCurrentThreadOwnerQuiet(ChunkMap.this.level, entityChunk.x(), entityChunk.z())) {
+                entityContext = net.minecraft.server.threading.TickRegions.pushRegionContext(
+                    ChunkMap.this.level, entityChunk.x(), entityChunk.z(), entityChunk.x(), entityChunk.z()
+                );
+            }
+            if (!net.minecraft.server.threading.TickRegions.isCurrentThreadOwnerQuiet(ChunkMap.this.level, playerChunk.x(), playerChunk.z())) {
+                playerContext = net.minecraft.server.threading.TickRegions.pushRegionContext(
+                    ChunkMap.this.level, playerChunk.x(), playerChunk.z(), playerChunk.x(), playerChunk.z()
+                );
+            }
+            try {
+                action.run();
+            } finally {
+                if (playerContext != null) {
+                    net.minecraft.server.threading.TickRegions.popContext(playerContext);
+                }
+                if (entityContext != null) {
+                    net.minecraft.server.threading.TickRegions.popContext(entityContext);
+                }
+            }
+        }
+
         private int scaledRange(final int range) {
             return ChunkMap.this.level.getServer().getScaledTrackingDistance(range);
         }
