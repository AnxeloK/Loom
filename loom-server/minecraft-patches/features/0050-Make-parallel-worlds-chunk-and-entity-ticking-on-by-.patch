From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: anxelok <anxelok@localhost>
Date: Fri, 19 Jun 2026 19:44:00 +0000
Subject: [PATCH] Make parallel worlds, chunk and entity ticking on by default

Flip PARALLEL_WORLDS_ENABLED, PARALLEL_CHUNK_TICK_ENABLED and
PARALLEL_ENTITY_TICK_ENABLED to default ON. Each can still be disabled
explicitly with -Dloom.parallelX=false; any other value (or unset)
leaves parallel ticking active.


diff --git a/net/minecraft/server/threading/TickRegions.java b/net/minecraft/server/threading/TickRegions.java
index 64a24a727e2097918ab28904356568e69db966e0..d495b50210396ee5f714c1cdaf3ba00fd80e75e2 100644
--- a/net/minecraft/server/threading/TickRegions.java
+++ b/net/minecraft/server/threading/TickRegions.java
@@ -110,20 +110,23 @@ public class TickRegions {
         1,
         Integer.getInteger("paper.threadedregions.parallelSimulation.targetTasksPerWorker", 4)
     );
-    // Loom - experimental, opt-in parallel world ticking. Default off preserves the vanilla serial level loop.
-    // When enabled, independent worlds (overworld/nether/end and any others) tick concurrently on the region
-    // pool, each on a single thread holding its own full-level lease. Each world stays internally serial.
-    public static final boolean PARALLEL_WORLDS_ENABLED = Boolean.getBoolean("loom.parallelWorlds");
+    // Loom - parallel world ticking, ON by default. Disable with -Dloom.parallelWorlds=false to restore the
+    // vanilla serial level loop. When enabled, independent worlds (overworld/nether/end and any others) tick
+    // concurrently on the region pool, each on a single thread holding its own full-level lease. Each world
+    // stays internally serial.
+    public static final boolean PARALLEL_WORLDS_ENABLED = !"false".equalsIgnoreCase(System.getProperty("loom.parallelWorlds"));
     // Loom - non-adjacency buffer (in chunks) between region-task buckets that run in parallel. A block
     // update fans out at most ~1 chunk, so buckets within this many chunks of each other are merged to tick
     // together, guaranteeing parallel buckets cannot race on a shared edge chunk. This is the load-bearing
     // safety primitive for intra-world parallel ticking. Higher = safer but coarser (less parallelism).
     static final int REGION_TASK_BUFFER_CHUNKS = Math.max(0, Integer.getInteger("loom.regionTaskBufferChunks", 1));
-    // Loom - experimental intra-world parallel chunk ticking (Stage 3). When enabled, the per-chunk tick
-    // (random ticks + chunk block updates) is dispatched as region-bound tasks and non-adjacent regions tick
-    // concurrently on the region pool. Default off. This is the first wired tick phase of intra-world regions.
-    public static final boolean PARALLEL_CHUNK_TICK_ENABLED = Boolean.getBoolean("loom.parallelChunkTick");
-    public static final boolean PARALLEL_ENTITY_TICK_ENABLED = Boolean.getBoolean("loom.parallelEntityTick");
+    // Loom - intra-world parallel chunk ticking (Stage 3), ON by default. Disable with
+    // -Dloom.parallelChunkTick=false. When enabled, the per-chunk tick (random ticks + chunk block updates) is
+    // dispatched as region-bound tasks and non-adjacent regions tick concurrently on the region pool. This is
+    // the first wired tick phase of intra-world regions.
+    public static final boolean PARALLEL_CHUNK_TICK_ENABLED = !"false".equalsIgnoreCase(System.getProperty("loom.parallelChunkTick"));
+    // Loom - intra-world parallel entity ticking, ON by default. Disable with -Dloom.parallelEntityTick=false.
+    public static final boolean PARALLEL_ENTITY_TICK_ENABLED = !"false".equalsIgnoreCase(System.getProperty("loom.parallelEntityTick"));
     private static final int DIAGNOSTIC_EVENT_LIMIT = Math.max(
         64,
         Integer.getInteger("paper.threadedregions.diagnostics.eventLimit", 512)
