-                continue;
+        final int len = trackerEntities.size();
+        // Loom start - parallel entity tracker: bucket by region cell like entity ticking. Workers run the
+        // per-entity range math and dirty-data sync (packet sends are thread-safe enqueues); the rare pairing
+        // TRANSITIONS defer to the owning thread via the region mailbox, both because a worker must not push
+        // overlapping single-chunk leases and because pairing fires a cancellable Bukkit event whose veto
+        // must gate the mutation synchronously. Steady-state pairs (still visible / still hidden) do nothing.
+        if (len > 1 && net.minecraft.server.threading.TickRegions.currentContext() != null) {
+            final int shift = net.minecraft.server.threading.TickRegions.getRegionChunkShift();
+            final it.unimi.dsi.fastutil.longs.Long2ObjectMap<java.util.List<Entity>> byRegion =
+                new it.unimi.dsi.fastutil.longs.Long2ObjectOpenHashMap<>();
+            for (int i = 0; i < len; ++i) {
+                final Entity entity = trackerEntitiesRaw[i];
+                if (entity == null) {
+                    continue;
+                }
+                final net.minecraft.world.level.ChunkPos cp = entity.chunkPosition();
+                final long key = (((long) (cp.x() >> shift)) << 32) | ((cp.z() >> shift) & 0xFFFFFFFFL);
+                byRegion.computeIfAbsent(key, k -> new java.util.ArrayList<>()).add(entity);
             }
-            ((ca.spottedleaf.moonrise.patches.entity_tracker.EntityTrackerTrackedEntity)tracker).moonrise$tick(((ca.spottedleaf.moonrise.patches.chunk_system.entity.ChunkSystemEntity)entity).moonrise$getChunkData().nearbyPlayers);
-            if (((ca.spottedleaf.moonrise.patches.entity_tracker.EntityTrackerTrackedEntity)tracker).moonrise$hasPlayers()
-                || ((ca.spottedleaf.moonrise.patches.chunk_system.entity.ChunkSystemEntity)entity).moonrise$getChunkStatus().isOrAfter(FullChunkStatus.ENTITY_TICKING)) {
-                tracker.serverEntity.sendChanges();
+            if (byRegion.size() > 1) {
+                final net.minecraft.server.threading.RegionTickStaging.Session session =
+                    net.minecraft.server.threading.RegionTickStaging.newSession();
+                final java.util.List<net.minecraft.server.threading.TickRegions.RegionBoundTask> tasks =
+                    new java.util.ArrayList<>(byRegion.size());
+                final int regionChunks = 1 << shift;
+                for (final it.unimi.dsi.fastutil.longs.Long2ObjectMap.Entry<java.util.List<Entity>> regionEntry
+                    : byRegion.long2ObjectEntrySet()) {
+                    final java.util.List<Entity> regionEntities = regionEntry.getValue();
+                    final long key = regionEntry.getLongKey();
+                    final int regionX = (int) (key >> 32);
+                    final int regionZ = (int) key;
+                    final int fMinX = regionX << shift;
+                    final int fMinZ = regionZ << shift;
+                    final int fMaxX = fMinX + regionChunks - 1;
+                    final int fMaxZ = fMinZ + regionChunks - 1;
+                    final net.minecraft.world.level.ChunkPos dispatchPos = regionEntities.get(0).chunkPosition();
+                    tasks.add(new net.minecraft.server.threading.TickRegions.RegionBoundTask(
+                        dispatchPos.x(), dispatchPos.z(), fMinX, fMinZ, fMaxX, fMaxZ, () -> {
+                        net.minecraft.server.threading.RegionTickStaging.begin(session);
+                        try {
+                            for (int i = 0, n = regionEntities.size(); i < n; ++i) {
+                                this.trackOneEntity(regionEntities.get(i));
+                            }
+                        } finally {
+                            net.minecraft.server.threading.RegionTickStaging.end();
+                        }
+                    }));
+                }
+                net.minecraft.server.threading.TickRegions.runRegionBoundTasksFromCurrentContext(this.level, tasks, "entityTracker");
+                net.minecraft.server.threading.RegionTickStaging.applyAndClear(session, this.level);
+                return;
             }
         }
+        // Loom end
+        for (int i = 0; i < len; ++i) {
+            this.trackOneEntity(trackerEntitiesRaw[i]);
+        }
+    }
+
+    private void trackOneEntity(final Entity entity) {
+        if (entity == null) {
+            return;
+        }
+        final ChunkMap.TrackedEntity tracker = ((ca.spottedleaf.moonrise.patches.entity_tracker.EntityTrackerEntity)entity).moonrise$getTrackedEntity();
+        if (tracker == null) {
+            return;
+        }
+        ((ca.spottedleaf.moonrise.patches.entity_tracker.EntityTrackerTrackedEntity)tracker).moonrise$tick(((ca.spottedleaf.moonrise.patches.chunk_system.entity.ChunkSystemEntity)entity).moonrise$getChunkData().nearbyPlayers);
+        if (((ca.spottedleaf.moonrise.patches.entity_tracker.EntityTrackerTrackedEntity)tracker).moonrise$hasPlayers()
+            || ((ca.spottedleaf.moonrise.patches.chunk_system.entity.ChunkSystemEntity)entity).moonrise$getChunkStatus().isOrAfter(FullChunkStatus.ENTITY_TICKING)) {
+            tracker.serverEntity.sendChanges();
+        }
     }
     // Paper end - optimise entity tracker
 
