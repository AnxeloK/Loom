Subject: [PATCH] Keep block-driven navigation work within world ownership


diff --git a/net/minecraft/server/level/NavigationUpdates.java b/net/minecraft/server/level/NavigationUpdates.java
new file mode 100644
index 0000000000000000000000000000000000000000..fb6aedc1cf7e45f75a39dc3b0ad19ef26ec438bc
--- /dev/null
+++ b/net/minecraft/server/level/NavigationUpdates.java
@@ -0,0 +1,65 @@
+package net.minecraft.server.level;
+
+import java.util.ArrayList;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Set;
+import java.util.concurrent.ConcurrentHashMap;
+import net.minecraft.core.BlockPos;
+import net.minecraft.server.threading.TickRegions;
+import net.minecraft.server.threading.runtime.OwnerDomainExecutor;
+import net.minecraft.world.entity.Mob;
+import net.minecraft.world.entity.ai.navigation.PathNavigation;
+
+/** Navigation state is read only while the caller owns every tracked mob in the world. */
+final class NavigationUpdates {
+    private final ServerLevel level;
+    private final Set<Mob> mobs = ConcurrentHashMap.newKeySet();
+    private final Set<BlockPos> pending = new LinkedHashSet<>();
+    private boolean queued;
+    private boolean updating;
+
+    NavigationUpdates(ServerLevel level) { this.level = level; }
+
+    void add(Mob mob) { this.mobs.add(mob); }
+    void remove(Mob mob) { this.mobs.remove(mob); }
+
+    void blockChanged(BlockPos pos) {
+        if (this.mobs.isEmpty()) return;
+        if (OwnerDomainExecutor.isCurrentFullLevelOwnerOrGlobal(this.level) && !this.updating) {
+            this.update(pos);
+            return;
+        }
+        synchronized (this.pending) {
+            // Retain one position per phase and one continuation per world, including reentrant writes.
+            this.pending.add(pos.immutable());
+            if (this.queued) return;
+            this.queued = true;
+        }
+        TickRegions.sendFullLevelContinuation(this.level, this::drain);
+    }
+
+    private void drain() {
+        if (!OwnerDomainExecutor.isCurrentFullLevelOwnerOrGlobal(this.level))
+            throw new IllegalStateException("Navigation updates require the full world owner");
+        final List<BlockPos> changed;
+        synchronized (this.pending) {
+            changed = new ArrayList<>(this.pending);
+            this.pending.clear();
+            this.queued = false;
+        }
+        for (BlockPos pos : changed) this.update(pos);
+    }
+
+    private void update(BlockPos pos) {
+        List<PathNavigation> affected = new ArrayList<>();
+        for (Mob mob : this.mobs) {
+            PathNavigation navigation = mob.getNavigation();
+            if (navigation.shouldRecomputePath(pos)) affected.add(navigation);
+        }
+        this.updating = true;
+        try {
+            for (PathNavigation navigation : affected) navigation.recomputePath();
+        } finally { this.updating = false; }
+    }
+}
