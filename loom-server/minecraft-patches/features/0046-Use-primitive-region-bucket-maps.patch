-            final List<TaskBucket> buckets = new ArrayList<>(entries.size());
-            for (int i = 0, len = entries.size(); i < len; ++i) {
-                buckets.add(entries.get(i).getValue());
+                TaskBucket bucket = bucketMap.get(bucketKey);
+                if (bucket == null) {
+                    bucket = new TaskBucket(this.world);
+                    bucketMap.put(bucketKey, bucket);
+                }
+                bucket.add(task);
             }
-            return buckets;
