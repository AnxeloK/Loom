             for (int i = 0, len = toRun.size(); i < len; ++i) {
                 final RegionScheduledTask task = toRun.get(i);
                 final long bucketKey = regionBucketKey(task.chunkX, task.chunkZ);
-                bucketMap.computeIfAbsent(bucketKey, ignored -> new TaskBucket(this.world)).add(task);
