From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: anxelok <anxelok@localhost>
Date: Fri, 31 Jul 2026 05:32:53 +0000
Subject: [PATCH] Use primitive region bucket maps

Avoid boxed keys and hash nodes while keeping signed bucket order and stable task order across region dispatch paths.

diff --git a/net/minecraft/server/threading/TickRegions.java b/net/minecraft/server/threading/TickRegions.java
index 18fa40dd1740e50d1b361e27d764e01dc4ff3a1f..57fbf6e2f24f92769d2d307975b76ac5b34a96fa 100644
--- a/net/minecraft/server/threading/TickRegions.java
+++ b/net/minecraft/server/threading/TickRegions.java
@@ -1,6 +1,7 @@
 package net.minecraft.server.threading;
 
 import ca.spottedleaf.moonrise.common.util.TickThread;
+import it.unimi.dsi.fastutil.longs.Long2ObjectOpenHashMap;
 import net.minecraft.server.level.ServerLevel;
 import net.minecraft.server.threading.runtime.OwnerDomainExecutor;
 import net.minecraft.util.Util;
@@ -11,6 +12,7 @@ import org.jspecify.annotations.Nullable;
 
 import java.util.ArrayDeque;
 import java.util.ArrayList;
+import java.util.Arrays;
 import java.util.Comparator;
 import java.util.EnumMap;
 import java.util.HashMap;
@@ -1038,18 +1040,26 @@ public class TickRegions {
         final ServerLevel world,
         final List<RegionBoundTask> tasks
     ) {
-        final Map<Long, RegionBoundBucket> bucketMap = new HashMap<>();
+        final Long2ObjectOpenHashMap<RegionBoundBucket> bucketMap = new Long2ObjectOpenHashMap<>();
         for (int i = 0, len = tasks.size(); i < len; ++i) {
             final RegionBoundTask task = tasks.get(i);
             final long bucketKey = regionBucketKey(task.chunkX(), task.chunkZ());
-            bucketMap.computeIfAbsent(bucketKey, ignored -> new RegionBoundBucket(world)).add(task);
+            RegionBoundBucket bucket = bucketMap.get(bucketKey);
+            if (bucket == null) {
+                bucket = new RegionBoundBucket(world);
+                bucketMap.put(bucketKey, bucket);
+            }
+            bucket.add(task);
         }
+        return sortedBuckets(bucketMap);
+    }
 
-        final List<Map.Entry<Long, RegionBoundBucket>> entries = new ArrayList<>(bucketMap.entrySet());
-        entries.sort(Map.Entry.comparingByKey());
-        final List<RegionBoundBucket> buckets = new ArrayList<>(entries.size());
-        for (int i = 0, len = entries.size(); i < len; ++i) {
-            buckets.add(entries.get(i).getValue());
+    private static <T> List<T> sortedBuckets(final Long2ObjectOpenHashMap<T> bucketMap) {
+        final long[] keys = bucketMap.keySet().toLongArray();
+        Arrays.sort(keys);
+        final List<T> buckets = new ArrayList<>(keys.length);
+        for (int i = 0; i < keys.length; ++i) {
+            buckets.add(bucketMap.get(keys[i]));
         }
         return buckets;
     }
@@ -1995,39 +2005,33 @@ public class TickRegions {
         }
 
