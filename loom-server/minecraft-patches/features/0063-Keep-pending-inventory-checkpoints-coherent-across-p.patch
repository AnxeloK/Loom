+package net.minecraft.server.players;
+
+import net.minecraft.nbt.CompoundTag;
+
+/** An owner-bound proposal kept coherent across captures until its live application or rejection. */
+public interface InventoryCheckpoint {
+    /** Overlay a lifecycle capture only while its source state is still valid. */
+    void project(CompoundTag captured);
+
+    /** Revalidate immediately before application, including the caller's permission predicate. */
+    boolean canApply();
+
+    /** Apply already persisted inventory and metadata on the player owner. */
+    void apply();
+
+    /** Monotonic invalidation, also safe from write completion threads. Future captures use actual state. */
+    void invalidate();
+}
