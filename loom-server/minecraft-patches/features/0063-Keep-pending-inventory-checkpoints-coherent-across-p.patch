+    private record PendingInventoryCheckpoint(ServerPlayer player,
+        net.minecraft.server.network.ServerGamePacketListenerImpl connection, InventoryCheckpoint projection,
+        CompletableFuture<Void> finished) {}
+
+    /** Keep lifecycle captures coherent while proposed inventory waits for its physical checkpoint. */
+    public void projectInventoryCheckpoint(final ServerPlayer player, final CompoundTag captured) {
+        final PendingInventoryCheckpoint pending = this.inventoryCheckpoints.get(player.getUUID());
+        if (pending != null && pending.player() == player) pending.projection().project(captured);
+    }
+
+    public void invalidateInventoryCheckpoint(final ServerPlayer player) {
+        final PendingInventoryCheckpoint pending = this.inventoryCheckpoints.get(player.getUUID());
+        if (pending != null && pending.player() == player) pending.projection().invalidate();
+    }
+
+    public CompletableFuture<Boolean> applyInventoryCheckpointAsync(final ServerPlayer player,
+        final java.util.function.Supplier<InventoryCheckpoint> proposal) {
+        return this.admitPlayerSave(() -> net.minecraft.server.threading.runtime.OwnerDomainExecutor.supply(
+            net.minecraft.server.threading.runtime.OwnerDomainExecutor.player(player, "capture-inventory-checkpoint"),
+            () -> {
+                if (this.inventoryCheckpointsClosing) throw new java.util.concurrent.RejectedExecutionException("Server is stopping");
+                if (this.getPlayer(player.getUUID()) != player) throw new IllegalStateException("Player session is no longer current");
+                if (org.spigotmc.SpigotConfig.disablePlayerDataSaving) throw new IllegalStateException("Player saving is disabled");
+                if (this.inventoryCheckpoints.containsKey(player.getUUID())) {
+                    throw new java.util.concurrent.RejectedExecutionException("An inventory checkpoint is already pending for this player");
+                }
+                final PendingInventoryCheckpoint pending = new PendingInventoryCheckpoint(player, player.connection,
+                    java.util.Objects.requireNonNull(proposal.get(), "Inventory checkpoint proposal"), new CompletableFuture<>());
+                if (this.inventoryCheckpoints.putIfAbsent(player.getUUID(), pending) != null) {
+                    throw new java.util.concurrent.RejectedExecutionException("An inventory checkpoint is already pending for this player");
+                }
+                final CompletableFuture<Boolean> result;
+                try {
+                    result = this.writePluginPlayerSave(player.getUUID(), this.capturePluginPlayerSave(player), true)
+                        .thenCompose(ignored -> this.finishInventoryCheckpoint(player.getUUID(), pending));
+                } catch (final Throwable failure) {
+                    pending.projection().invalidate();
+                    this.inventoryCheckpoints.remove(player.getUUID(), pending);
+                    pending.finished().complete(null);
+                    throw failure;
+                }
+                return result.whenComplete((applied, failure) -> {
+                    pending.projection().invalidate();
+                    this.inventoryCheckpoints.remove(player.getUUID(), pending);
+                    pending.finished().complete(null);
+                });
+            }
+        ).thenCompose(result -> result));
+    }
+
+    private CompletableFuture<Boolean> finishInventoryCheckpoint(final UUID playerId, final PendingInventoryCheckpoint pending) {
+        return net.minecraft.server.threading.runtime.OwnerDomainExecutor.supply(
+            net.minecraft.server.threading.runtime.OwnerDomainExecutor.global(this.server, "resolve-inventory-checkpoint"),
+            () -> {
+                final ServerPlayer current = this.getPlayer(playerId);
+                if (current == null || current.connection != pending.connection()) {
+                    throw new IllegalStateException("Player session retired during its inventory checkpoint");
+                }
+                return net.minecraft.server.threading.runtime.OwnerDomainExecutor.supply(
+                    net.minecraft.server.threading.runtime.OwnerDomainExecutor.player(current, "finish-inventory-checkpoint"),
+                    () -> {
+                        if (this.getPlayer(playerId) != current || current.connection != pending.connection()
+                            || this.inventoryCheckpoints.get(playerId) != pending) {
+                            throw new IllegalStateException("Player session retired during its inventory checkpoint");
+                        }
+                        if (current == pending.player() && pending.projection().canApply()) {
+                            pending.projection().apply();
+                            this.inventoryCheckpoints.remove(playerId, pending);
+                            return CompletableFuture.completedFuture(true);
+                        }
+                        // Never acknowledge rejection until actual state has replaced the proposal on disk.
+                        pending.projection().invalidate();
+                        this.inventoryCheckpoints.remove(playerId, pending);
+                        return this.writePluginPlayerSave(playerId, this.capturePluginPlayerSave(current), true).thenApply(ignored -> false);
+                    }
+                ).thenCompose(result -> result);
+            }
+        ).thenCompose(result -> result);
+    }
+
+    /** Finish accepted owner continuations before plugin shutdown can wait for their IO chains. */
+    public void awaitInventoryCheckpointsOnShutdown() {
+        net.minecraft.server.threading.runtime.OwnerDomainExecutor.assertGlobalOwner(this.server, "finish-inventory-checkpoints");
+        this.inventoryCheckpointsClosing = true;
+        final CompletableFuture<?>[] pending = this.inventoryCheckpoints.values().stream()
+            .map(PendingInventoryCheckpoint::finished).toArray(CompletableFuture[]::new);
+        net.minecraft.server.threading.runtime.OwnerDomainExecutor.awaitCooperatively(
+            CompletableFuture.allOf(pending), "finish-inventory-checkpoints"
+        );
+    }
