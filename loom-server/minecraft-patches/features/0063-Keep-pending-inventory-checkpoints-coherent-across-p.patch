+    private <T> CompletableFuture<T> afterInventoryCheckpoint(final UUID playerId,
+        final java.util.function.Supplier<CompletableFuture<T>> read) {
+        final PendingInventoryCheckpoint pending;
+        final PlayerSaveQueue.Reservation reservation;
+        synchronized (this.inventoryCheckpoints) {
+            pending = this.inventoryCheckpoints.get(playerId);
+            reservation = pending == null ? this.playerSaveQueue.reserve(playerId) : null;
+        }
+        if (pending != null) return pending.finished().thenCompose(ignored -> this.afterInventoryCheckpoint(playerId, read));
+        // Only reserve under the admission lock; an already-owned IO task may execute inline.
+        return this.playerSaveQueue.submitReserved(reservation, read);
+    }
