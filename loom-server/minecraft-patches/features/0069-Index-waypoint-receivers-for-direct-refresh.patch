         if (!this.locatorBarEnabled) return; // Paper - optimize ServerWaypointManager with locator bar disabled
         if (this.waypoints.contains(waypoint)) {
-            Map<ServerPlayer, WaypointTransmitter.Connection> playerConnection = this.connections.column(waypoint);
+            Map<ServerPlayer, WaypointTransmitter.Connection> playerConnection = new ReceiverColumn(waypoint);
 
             List<BrokenPlayerConnection> brokenConnections = null;
             for (Entry<ServerPlayer, WaypointTransmitter.Connection> waypointConnection : playerConnection.entrySet()) {
@@ -83,6 +87,10 @@ public class ServerWaypointManager implements WaypointManager<WaypointTransmitte
     public void untrackWaypoint(final WaypointTransmitter waypoint) {
         this.connections.column(waypoint).forEach((player, connection) -> connection.disconnect());
         Tables.transpose(this.connections).row(waypoint).clear();
+        Map<ServerPlayer, WaypointTransmitter.Connection> removed = this.receiversByWaypoint.remove(waypoint);
+        if (removed != null) {
+            removed.clear();
+        }
         this.waypoints.remove(waypoint);
     }
 
@@ -139,8 +147,9 @@ public class ServerWaypointManager implements WaypointManager<WaypointTransmitte
     }
 
     public void removePlayer(final ServerPlayer player) {
-        this.connections.row(player).values().removeIf(connection -> {
-            connection.disconnect();
+        this.connections.row(player).entrySet().removeIf(entry -> {
