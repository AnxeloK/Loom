             return true;
         });
         this.untrackWaypoint(player);
@@ -150,6 +159,8 @@ public class ServerWaypointManager implements WaypointManager<WaypointTransmitte
     public void breakAllConnections() {
         this.connections.values().forEach(WaypointTransmitter.Connection::disconnect);
         this.connections.clear();
+        this.receiversByWaypoint.values().forEach(Map::clear);
+        this.receiversByWaypoint.clear();
     }
 
     public void remakeConnections(final WaypointTransmitter waypoint) {
@@ -170,14 +181,63 @@ public class ServerWaypointManager implements WaypointManager<WaypointTransmitte
     // Paper end - optimize ServerWaypointManager with locator bar disabled
     }
 
+    // A live view also observes a column removed and recreated by a connection callback.
+    private final class ReceiverColumn extends java.util.AbstractMap<ServerPlayer, WaypointTransmitter.Connection> {
+        private final WaypointTransmitter waypoint;
+
+        private ReceiverColumn(final WaypointTransmitter waypoint) {
+            this.waypoint = waypoint;
+        }
+
+        @Override
+        public Set<Entry<ServerPlayer, WaypointTransmitter.Connection>> entrySet() {
+            Map<ServerPlayer, WaypointTransmitter.Connection> receivers = receiversByWaypoint.get(this.waypoint);
+            return receivers == null ? Set.of() : receivers.entrySet();
+        }
+
+        @Override
+        public int size() {
+            Map<ServerPlayer, WaypointTransmitter.Connection> receivers = receiversByWaypoint.get(this.waypoint);
+            return receivers == null ? 0 : receivers.size();
+        }
+
+        @Override
+        public boolean containsKey(final Object player) {
+            Map<ServerPlayer, WaypointTransmitter.Connection> receivers = receiversByWaypoint.get(this.waypoint);
+            return receivers != null && receivers.containsKey(player);
+        }
+    }
+
+    private void putConnection(final ServerPlayer player, final WaypointTransmitter waypoint, final WaypointTransmitter.Connection connection) {
+        this.connections.put(player, waypoint, connection);
+        this.receiversByWaypoint.computeIfAbsent(waypoint, ignored -> new java.util.HashMap<>()).put(player, connection);
+    }
+
+    private WaypointTransmitter.@Nullable Connection removeConnection(final ServerPlayer player, final WaypointTransmitter waypoint) {
+        WaypointTransmitter.Connection removed = this.connections.remove(player, waypoint);
+        this.removeReceiverIndex(player, waypoint);
+        return removed;
+    }
+
+    private void removeReceiverIndex(final ServerPlayer player, final WaypointTransmitter waypoint) {
+        Map<ServerPlayer, WaypointTransmitter.Connection> receivers = this.receiversByWaypoint.get(waypoint);
+        if (receivers == null) {
+            return;
+        }
+        receivers.remove(player);
+        if (receivers.isEmpty()) {
+            this.receiversByWaypoint.remove(waypoint);
+        }
+    }
+
     private void createConnection(final ServerPlayer player, final WaypointTransmitter waypoint) {
         if (player != waypoint) {
             if (isLocatorBarEnabledFor(player)) {
                 waypoint.makeWaypointConnectionWith(player).ifPresentOrElse(connection -> {
-                    this.connections.put(player, waypoint, connection);
+                    this.putConnection(player, waypoint, connection);
                     connection.connect();
                 }, () -> {
-                    WaypointTransmitter.Connection connection = this.connections.remove(player, waypoint);
+                    WaypointTransmitter.Connection connection = this.removeConnection(player, waypoint);
                     if (connection != null) {
                         connection.disconnect();
                     }
@@ -201,10 +261,10 @@ public class ServerWaypointManager implements WaypointManager<WaypointTransmitte
     private void replaceBrokenConnection(final ServerPlayer player, final WaypointTransmitter waypoint, final WaypointTransmitter.Connection connection) {
         waypoint.makeWaypointConnectionWith(player).ifPresentOrElse(newConnection -> {
             newConnection.connect();
-            this.connections.put(player, waypoint, newConnection);
+            this.putConnection(player, waypoint, newConnection);
         }, () -> {
             connection.disconnect();
-            this.connections.remove(player, waypoint);
+            this.removeConnection(player, waypoint);
         });
     }
 
