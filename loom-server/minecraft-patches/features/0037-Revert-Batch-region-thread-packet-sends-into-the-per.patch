From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: anxelok <anxelok@localhost>
Date: Mon, 6 Jul 2026 13:33:58 +0000
Subject: [PATCH] Revert "Batch region-thread packet sends into the per-tick
 flush"

This reverts commit 2b0abf2688a6bbef1d5360636351dd69d7b74fcb.

diff --git a/net/minecraft/server/network/ServerCommonPacketListenerImpl.java b/net/minecraft/server/network/ServerCommonPacketListenerImpl.java
index 92cbb59c063e7386e52e245b478c0ed54a84591a..3a40c5086415bc3aff4f23c9967406c632d0f7ed 100644
--- a/net/minecraft/server/network/ServerCommonPacketListenerImpl.java
+++ b/net/minecraft/server/network/ServerCommonPacketListenerImpl.java
@@ -337,14 +337,8 @@ public abstract class ServerCommonPacketListenerImpl implements ServerCommonPack
             this.close();
         }
 
-        // Loom - batch tick-thread sends exactly like Paper: while flushing is suspended for the tick,
-        // ANY tick thread's packets ride the per-tick batch (region workers run the entity tracker under
-        // parallel ticking, and resumeFlushing() runs on the server thread after the world join, so their
-        // writes are always flushed the same tick). The previous owner-domain form of this check treated
-        // region threads as "not the server thread" and force-flushed every one of their packets - a
-        // syscall per tracker packet, which profiling showed burning whole cores on send().
         boolean flush = !this.suspendFlushingOnServerThread
-            || !ca.spottedleaf.moonrise.common.util.TickThread.isTickThread();
+            || !net.minecraft.server.threading.runtime.OwnerDomainExecutor.isGlobalOwner(this.server);
 
         try {
             this.connection.send(packet, listener, flush);
