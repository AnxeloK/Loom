+    private final class InsideBlockTraversal implements BlockGetter.BlockStepVisitor {
+        private boolean inUse;
+        private @Nullable InsideBlockTraversal next;
+        private Vec3 from;
+        private Vec3 to;
+        private InsideBlockEffectApplier.StepBasedCollector effectCollector;
+        private LongSet visitedBlocks;
+        private int maxMovementIterations;
+        private AABB deflatedBoundingBoxAtTarget;
+        private boolean movedFar;
+        private boolean debugEntityBlockIntersections;
+
+        private void prepare(
+            final Vec3 from,
+            final Vec3 to,
+            final InsideBlockEffectApplier.StepBasedCollector effectCollector,
+            final LongSet visitedBlocks,
+            final int maxMovementIterations,
+            final AABB deflatedBoundingBoxAtTarget,
+            final boolean movedFar,
+            final boolean debugEntityBlockIntersections
+        ) {
+            this.from = from;
+            this.to = to;
+            this.effectCollector = effectCollector;
+            this.visitedBlocks = visitedBlocks;
+            this.maxMovementIterations = maxMovementIterations;
+            this.deflatedBoundingBoxAtTarget = deflatedBoundingBoxAtTarget;
+            this.movedFar = movedFar;
+            this.debugEntityBlockIntersections = debugEntityBlockIntersections;
+        }
 
-                            if (debugEntityBlockIntersections) {
-                                this.debugBlockIntersection((ServerLevel)this.level(), blockIntersection.immutable(), insideBlock, insideFluid);
+        @Override
+        public boolean visit(final BlockPos blockIntersection, final int iteration) {
+            if (!Entity.this.isAlive()) {
+                return false;
+            } else if (iteration >= this.maxMovementIterations) {
+                return false;
+            } else {
+                BlockState state = Entity.this.level().getBlockState(blockIntersection);
+                if (state.isAir()) {
+                    if (this.debugEntityBlockIntersections) {
+                        Entity.this.debugBlockIntersection((ServerLevel)Entity.this.level(), blockIntersection.immutable(), false, false);
+                    }
+
+                    return true;
+                } else {
+                    VoxelShape intersectShape = state.getEntityInsideCollisionShape(Entity.this.level(), blockIntersection, Entity.this);
+                    boolean insideBlock = intersectShape == Shapes.block()
+                        || Entity.this.collidedWithShapeMovingFrom(this.from, this.to, intersectShape.move(new Vec3(blockIntersection)).toAabbs());
+                    boolean insideFluid = Entity.this.collidedWithFluid(state.getFluidState(), blockIntersection, this.from, this.to);
+                    if ((insideBlock || insideFluid) && this.visitedBlocks.add(blockIntersection.asLong())) {
+                        if (insideBlock) {
+                            try {
+                                boolean isPrecise = this.movedFar || this.deflatedBoundingBoxAtTarget.intersects(blockIntersection);
+                                this.effectCollector.advanceStep(iteration, blockIntersection); // Paper - track position inside effect was triggered on
+                                state.entityInside(Entity.this.level(), blockIntersection, Entity.this, this.effectCollector, isPrecise);
+                                Entity.this.onInsideBlock(state);
+                            } catch (Throwable var20) {
+                                CrashReport report = CrashReport.forThrowable(var20, "Colliding entity with block");
+                                CrashReportCategory category = report.addCategory("Block being collided with");
+                                CrashReportCategory.populateBlockDetails(category, Entity.this.level(), blockIntersection, state);
+                                CrashReportCategory entityCategory = report.addCategory("Entity being checked for collision");
+                                Entity.this.fillCrashReportCategory(entityCategory);
+                                throw new ReportedException(report);
                             }
+                        }
+
+                        if (insideFluid) {
+                            this.effectCollector.advanceStep(iteration, blockIntersection); // Paper - track position inside effect was triggered on
+                            state.getFluidState().entityInside(Entity.this.level(), blockIntersection, Entity.this, this.effectCollector);
+                        }
 
-                            return true;
-                        } else {
-                            return true;
