+    private InsideBlockTraversal acquireInsideBlockTraversal() {
+        InsideBlockTraversal traversal = this.insideBlockTraversal;
+        if (traversal == null) {
+            this.insideBlockTraversal = traversal = new InsideBlockTraversal();
+        }
+        while (traversal.inUse) {
+            if (traversal.next == null) {
+                traversal.next = new InsideBlockTraversal();
+            }
+            traversal = traversal.next;
+        }
+        traversal.inUse = true;
+        return traversal;
+    }
+
