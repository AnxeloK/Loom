+// Loom - traversal scratch is scoped to the physical call stack. Owner tasks can move between workers over
+// time, but a traversal never crosses a continuation; nested traversals on one worker borrow separate sets.
+final class BlockTraversalScratchPool {
+    private static final int MAX_RETAINED_SCRATCHES = 4;
+    private static final int MAX_RETAINED_BLOCKS = 4096;
+    private static final ThreadLocal<BlockTraversalScratchPool> LOCAL = ThreadLocal.withInitial(BlockTraversalScratchPool::new);
+
+    private final ArrayDeque<Scratch> available = new ArrayDeque<>();
+
+    static BlockTraversalScratchPool current() {
+        return LOCAL.get();
+    }
+
+    Scratch borrow() {
+        Scratch scratch = this.available.pollFirst();
+        if (scratch == null) {
+            scratch = new Scratch();
+        }
+        scratch.lastAcceptedIteration = 0;
+        return scratch;
+    }
+
+    void release(final Scratch scratch) {
+        if (this.available.size() >= MAX_RETAINED_SCRATCHES) {
+            return;
+        }
+
+        LongOpenHashSet visitedBlocks = scratch.visitedBlocks;
+        if (visitedBlocks != null) {
+            if (visitedBlocks.size() > MAX_RETAINED_BLOCKS) {
+                scratch.visitedBlocks = null;
+            } else {
+                visitedBlocks.clear();
+            }
+        }
+        scratch.lastAcceptedIteration = 0;
+        this.available.addFirst(scratch);
+    }
+
+    static final class Scratch {
+        private @Nullable LongOpenHashSet visitedBlocks;
+        int lastAcceptedIteration;
+
+        LongOpenHashSet visitedBlocks() {
+            if (this.visitedBlocks == null) {
+                this.visitedBlocks = new LongOpenHashSet();
+            }
+            return this.visitedBlocks;
+        }
+    }
