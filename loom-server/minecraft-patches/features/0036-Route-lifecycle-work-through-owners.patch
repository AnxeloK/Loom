+    // Loom start - owner-domain save transaction
+    public CompletableFuture<Boolean> saveEverythingAsync(final boolean silent, final boolean flush, final boolean force) {
+        net.minecraft.server.threading.runtime.OwnerDomainExecutor.assertGlobalOwner(this, "save-everything-async");
+        final CompletableFuture<Boolean> result = new CompletableFuture<>();
+        final CompletableFuture<?> precedingSave = this.pendingAsyncSave;
+        this.pendingAsyncSave = result;
+        if (precedingSave.isDone()) {
+            this.startAsyncSave(silent, flush, force, result);
+        } else {
+            precedingSave.whenComplete((ignored, failure) -> this.resumeAsyncSave(silent, flush, force, result));
+        }
+        return result;
+    }
+
+    private void resumeAsyncSave(
+        final boolean silent,
+        final boolean flush,
+        final boolean force,
+        final CompletableFuture<Boolean> result
+    ) {
+        try {
+            net.minecraft.server.threading.runtime.OwnerDomainExecutor.execute(
+                net.minecraft.server.threading.runtime.OwnerDomainExecutor.global(this, "resume-save-everything"),
+                () -> this.startAsyncSave(silent, flush, force, result)
+            );
+        } catch (final RejectedExecutionException rejected) {
+            result.completeExceptionally(rejected);
+        }
+    }
+
+    private void startAsyncSave(
+        final boolean silent,
+        final boolean flush,
+        final boolean force,
+        final CompletableFuture<Boolean> result
+    ) {
+        this.beginSaving();
+        final List<CompletableFuture<?>> barriers = new java.util.ArrayList<>();
+        final List<ServerLevel> levels = ImmutableList.copyOf(this.getAllLevels());
+        boolean savedAny = false;
+        Throwable schedulingFailure = null;
+        try {
+            barriers.add(this.getPlayerList().saveAllAsync());
+            // Capturing chunk and saved-data payloads remains owner-bound. Passing flush=false only
+            // removes the subsequent durability wait; every vanilla save is still scheduled.
+            savedAny = this.saveAllChunks(silent, false, force);
+            if (flush) {
+                barriers.add(this.getDataStorage().scheduleSave());
+                for (final ServerLevel level : levels) {
+                    barriers.add(level.getDataStorage().scheduleSave());
+                }
+                barriers.add(ca.spottedleaf.moonrise.patches.chunk_system.io.MoonriseRegionFileIO.flushAsync(this, levels));
+            }
+        } catch (final Throwable throwable) {
+            schedulingFailure = throwable;
+        }
+
+        final boolean saveResult = savedAny;
+        final Throwable initialFailure = schedulingFailure;
+        CompletableFuture.allOf(barriers.toArray(CompletableFuture[]::new)).whenComplete((ignored, asynchronousFailure) -> {
+            final Throwable failure = initialFailure != null ? initialFailure : asynchronousFailure;
+            try {
+                net.minecraft.server.threading.runtime.OwnerDomainExecutor.execute(
+                    net.minecraft.server.threading.runtime.OwnerDomainExecutor.global(this, "complete-save-everything"),
+                    () -> this.completeAsyncSave(levels, flush, saveResult, failure, result)
+                );
+            } catch (final RejectedExecutionException rejected) {
+                this.endSaving();
+                result.completeExceptionally(failure == null ? rejected : failure);
+            }
+        });
+    }
+
+    private void completeAsyncSave(
+        final List<ServerLevel> levels,
+        final boolean flush,
+        final boolean saveResult,
+        final @Nullable Throwable failure,
+        final CompletableFuture<Boolean> result
+    ) {
+        Throwable completionFailure = failure;
+        try {
+            if (completionFailure == null) {
+                if (flush) {
+                    this.logChunkSaveCompletion(levels);
+                }
+                this.warnOnLowDiskSpace();
+            }
+        } catch (final Throwable throwable) {
+            completionFailure = throwable;
+        } finally {
+            this.endSaving();
+        }
+
+        if (completionFailure == null) {
+            result.complete(saveResult);
+        } else {
+            LOGGER.error("Asynchronous save transaction failed", completionFailure);
+            result.completeExceptionally(completionFailure);
+        }
+    }
+
+    private void beginSaving() {
+        this.activeSaveOperations.incrementAndGet();
+    }
+
+    private void endSaving() {
+        final int remaining = this.activeSaveOperations.decrementAndGet();
+        if (remaining < 0) {
+            this.activeSaveOperations.set(0);
+            throw new IllegalStateException("Save operation accounting underflow");
         }
     }
+    // Loom end - owner-domain save transaction
 
