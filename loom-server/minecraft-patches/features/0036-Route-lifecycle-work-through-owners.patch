+    // Loom start - keep durability waits off every mutable owner domain
+    public static CompletableFuture<Void> flushAsync(final MinecraftServer server, final Collection<ServerLevel> worlds) {
+        final List<CompletableFuture<Void>> pendingTasks = new ArrayList<>();
+        for (final ServerLevel world : worlds) {
+            for (final RegionFileType type : CACHED_REGIONFILE_TYPES) {
+                pendingTasks.addAll(getControllerFor(world, type).snapshotTaskCompletions());
+            }
+        }
+
+        // Waiting for a live queue to become globally empty can starve while later ticks schedule
+        // unrelated saves. Snapshot the finite pre-barrier task set, then enqueue flush markers through
+        // each loaded region's ordered I/O lane. Later writes remain independent of this transaction.
+        return CompletableFuture.allOf(pendingTasks.toArray(CompletableFuture[]::new)).thenCompose(ignored -> {
+            final List<CompletableFuture<Void>> regionFlushes = new ArrayList<>();
+            for (final ServerLevel world : worlds) {
+                for (final RegionFileType type : CACHED_REGIONFILE_TYPES) {
+                    regionFlushes.addAll(getControllerFor(world, type).flushLoadedRegionsAsync(server));
+                }
+            }
+            return CompletableFuture.allOf(regionFlushes.toArray(CompletableFuture[]::new));
+        });
+    }
+    // Loom end - keep durability waits off every mutable owner domain
+
     public static void flush(final ServerLevel world) {
