     public void halt(final boolean wait, final boolean isRestarting) {
+        // Loom start - do not close region storage while a non-blocking durability barrier owns it
+        if (net.minecraft.server.threading.runtime.OwnerDomainExecutor.isGlobalOwner(this) && !this.pendingAsyncSave.isDone()) {
+            this.isRestarting |= isRestarting;
+            if (!this.shutdownQueuedAfterSave) {
+                this.shutdownQueuedAfterSave = true;
+                this.pendingAsyncSave.whenComplete((ignored, failure) -> {
+                    try {
+                        net.minecraft.server.threading.runtime.OwnerDomainExecutor.execute(
+                            net.minecraft.server.threading.runtime.OwnerDomainExecutor.global(this, "shutdown-after-save"),
+                            () -> {
+                                this.shutdownQueuedAfterSave = false;
+                                this.halt(false, this.isRestarting);
+                            }
+                        );
+                    } catch (final RejectedExecutionException rejected) {
+                        LOGGER.error("Could not resume shutdown after the active save transaction", rejected);
+                    }
+                });
+            }
+            return;
+        }
+        // Loom end - do not close region storage while a non-blocking durability barrier owns it
         this.isRestarting = isRestarting;
         this.hasLoggedStop = true; // Paper - Debugging
         if (this.isDebugging()) io.papermc.paper.util.TraceUtil.dumpTraceForThread("Server stopped"); // Paper - Debugging
