+
+    public void tickPreparedListener(final @Nullable TickablePacketListener listener) {
+        if (listener == null) {
+            return;
         }
+        net.minecraft.network.PacketProcessor.packetProcessing.push(listener);
+        try {
+            this.tickListenerInOwnerContext(listener, listener);
+        } finally {
+            // Other worlds may finish their listeners in a different order.
+            net.minecraft.network.PacketProcessor.packetProcessing.removeFirstOccurrence(listener);
+        }
+    }
 
+    public void finishTick() {
         if (!this.isConnected() && !this.disconnectionHandled) {
             this.handleDisconnectionInOwnerContext();
         }
