+    public static void runJoinedWorldPhase(
+        final MinecraftServer server,
+        final List<ServerLevel> worlds,
+        final java.util.function.Consumer<ServerLevel> action,
+        final String phase
+    ) {
+        if (OwnerDomainExecutor.currentDomain() != OwnerDomainExecutor.Domain.GLOBAL_CONTROL || currentContext() != null) {
+            throw new IllegalStateException("Joined world phases require the global owner outside a world context");
+        }
+        OwnerDomainExecutor.assertGlobalOwner(server, phase);
+        for (final ServerLevel world : worlds) {
+            if (world.getServer() != server) {
+                throw new IllegalArgumentException("World phase contains a world from another server");
+            }
+        }
+        runWorldPhaseInParallel(worlds, action, phase);
+    }
