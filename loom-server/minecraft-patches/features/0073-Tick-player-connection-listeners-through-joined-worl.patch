+    private void tickPlayerConnections(final List<PendingConnectionTick> ticks) {
+        final Map<ServerLevel, List<PendingConnectionTick>> byWorld = new LinkedHashMap<>();
+        for (final PendingConnectionTick tick : ticks) {
+            final ServerLevel world = tick.listener.player.level();
+            if (world.getServer() != this.server) {
+                throw new IllegalArgumentException("Player connection belongs to another server");
+            }
+            byWorld.computeIfAbsent(world, ignored -> new ArrayList<>()).add(tick);
+        }
+        if (!byWorld.isEmpty()) {
+            TickRegions.runJoinedWorldPhase(
+                this.server, new ArrayList<>(byWorld.keySet()), world -> {
+                    final TickRegions.RegionContext context = TickRegions.pushLevelContext(world);
+                    try {
+                        for (final PendingConnectionTick tick : byWorld.get(world)) {
+                            if (tick.listener.player.level() == world) {
+                                tick.executeListener();
+                            }
+                        }
+                    } finally {
+                        TickRegions.popContext(context);
+                    }
+                }, "connectionListener"
+            );
+        }
+        // Transfers wait for every world to finish. Connection removal and transport accounting
+        // retain the global owner and the original connection order.
+        for (final PendingConnectionTick tick : ticks) {
+            if (!tick.executed) {
+                tick.executeListener();
+            }
+            if (tick.failure != null) {
+                this.handleTickFailure(tick.connection, tick.failure);
+            } else {
+                try {
+                    tick.connection.finishTick();
+                } catch (Exception error) {
+                    this.handleTickFailure(tick.connection, error);
+                }
+            }
+        }
+    }
+
+    private void handleTickFailure(final Connection connection, final Exception error) {
+        if (connection.isMemoryConnection()) {
+            throw new ReportedException(CrashReport.forThrowable(error, "Ticking memory connection"));
+        }
+        LOGGER.warn("Failed to handle packet for {}", connection.getLoggableAddress(this.server.logIPs()), error);
+        final Component reason = Component.literal("Internal server error");
+        connection.send(new ClientboundDisconnectPacket(reason), PacketSendListener.thenRun(() -> connection.disconnect(reason)));
+        connection.setReadOnly();
+    }
+
+    private static final class PendingConnectionTick {
+        private final Connection connection;
+        private final ServerGamePacketListenerImpl listener;
+        private boolean executed;
+        private @Nullable Exception failure;
+
+        private PendingConnectionTick(final Connection connection, final ServerGamePacketListenerImpl listener) {
+            this.connection = connection;
+            this.listener = listener;
+        }
+
+        private void executeListener() {
+            this.executed = true;
+            if (this.connection.getPacketListener() != this.listener || !this.connection.isConnected()) {
+                return;
+            }
+            try {
+                this.connection.tickPreparedListener(this.listener);
+            } catch (Exception error) {
+                if (this.connection.isMemoryConnection()) {
+                    throw new ReportedException(CrashReport.forThrowable(error, "Ticking memory connection"));
+                }
+                this.failure = error;
+            }
+        }
+    }
