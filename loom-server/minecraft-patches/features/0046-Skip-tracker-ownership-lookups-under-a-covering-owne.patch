From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: anxelok <anxelok@localhost>
Date: Mon, 6 Jul 2026 15:48:40 +0000
Subject: [PATCH] Skip tracker ownership lookups under a covering owner context

The tracker's per-pair ownership check ran two lease lookups and
allocated two ChunkPos per tracked entity per viewing player per
tick, even though the serial tracker tick always runs under the
level's full-extent owner context where the answer is trivially yes.
A context-walk fast path answers those; sub-region workers keep the
precise per-chunk checks.

diff --git a/net/minecraft/server/level/ChunkMap.java b/net/minecraft/server/level/ChunkMap.java
index 0a0ee851a4889dbc4f09f5a1098c1ddef39b4cfb..3e540926d9cdc773a5f4030d2c68f675fca94137 100644
--- a/net/minecraft/server/level/ChunkMap.java
+++ b/net/minecraft/server/level/ChunkMap.java
@@ -1420,6 +1420,13 @@ public class ChunkMap extends SimpleRegionStorage implements ChunkHolder.PlayerP
             if (player.level() != ChunkMap.this.level) {
                 return ca.spottedleaf.moonrise.common.util.TickThread.isTickThreadFor(player);
             }
+            // Fast path: the serial tracker tick runs under the level's full-extent owner context (or
+            // the global owner on serial paths), which covers both endpoints by definition. This loop
+            // runs per tracked entity per viewing player per tick, so the two lease lookups and two
+            // ChunkPos allocations below are only paid on sub-region workers.
+            if (net.minecraft.server.threading.runtime.OwnerDomainExecutor.isCurrentFullLevelOwnerOrGlobal(ChunkMap.this.level)) {
+                return true;
+            }
             final ChunkPos entityChunk = this.entity.chunkPosition();
             final ChunkPos playerChunk = player.chunkPosition();
             return net.minecraft.server.threading.TickRegions.isCurrentThreadOwnerQuiet(ChunkMap.this.level, entityChunk.x(), entityChunk.z())
diff --git a/net/minecraft/server/threading/runtime/OwnerDomainExecutor.java b/net/minecraft/server/threading/runtime/OwnerDomainExecutor.java
index 58eab7e0724f7d88b647310131422a44f6edc77a..91ed7762292545c6bf838561d6263bef8b679a7e 100644
--- a/net/minecraft/server/threading/runtime/OwnerDomainExecutor.java
+++ b/net/minecraft/server/threading/runtime/OwnerDomainExecutor.java
@@ -214,6 +214,20 @@ public final class OwnerDomainExecutor {
         return owner != null && owner.domain() == Domain.REGION && owner.level() == level;
     }
 
+    // Allocation-free fast predicate for hot loops: true when the current context trivially covers any
+    // chunk of the level - the global owner, or the level's full-extent region owner (the world tick
+    // thread). Sub-region workers fall through to the caller's precise checks.
+    public static boolean isCurrentFullLevelOwnerOrGlobal(final ServerLevel level) {
+        final Owner owner = currentOwner();
+        if (owner == null) {
+            return false;
+        }
+        if (owner.domain() == Domain.GLOBAL_CONTROL) {
+            return true;
+        }
+        return isFullLevelRegion(owner, level);
+    }
+
     public static boolean isEntityOwner(final Entity entity) {
         Objects.requireNonNull(entity, "entity");
         if (entity instanceof ServerPlayer player) {
