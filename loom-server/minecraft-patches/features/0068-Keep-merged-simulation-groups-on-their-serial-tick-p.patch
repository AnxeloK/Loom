+    private final class EntityTickGroup implements Runnable {
+        private final java.util.List<Entity> entities;
+        private final java.util.concurrent.atomic.@Nullable AtomicLongArray timings;
+        private final int timingIndex;
+        private net.minecraft.server.threading.RegionTickStaging.@Nullable Session session;
+
+        private EntityTickGroup(final java.util.List<Entity> entities,
+                                final java.util.concurrent.atomic.@Nullable AtomicLongArray timings, final int timingIndex) {
+            this.entities = entities;
+            this.timings = timings;
+            this.timingIndex = timingIndex;
+        }
+
+        @Override
+        public void run() {
+            final var stagingSession = java.util.Objects.requireNonNull(this.session, "Entity tick group executed outside its dispatch");
+            final long start = this.timings == null ? 0L : System.nanoTime();
+            net.minecraft.server.threading.RegionTickStaging.begin(stagingSession);
+            try {
+                for (int i = 0, len = this.entities.size(); i < len; ++i) {
+                    ServerLevel.this.tickOneEntity(this.entities.get(i));
+                }
+            } finally {
+                net.minecraft.server.threading.RegionTickStaging.end();
+                if (this.timings != null) {
+                    this.timings.set(this.timingIndex, System.nanoTime() - start);
+                }
+            }
+        }
+    }
