+
+        public void runFromCurrentContext() {
+            if (this.buckets.isEmpty()) {
+                return;
+            }
+            final List<ContextLeaseBounds> suspended = suspendContextStackForWorld(this.world);
+            try {
+                if (this.isParallel()) {
+                    dispatchBucketsParticipating(this.buckets.size(), i -> this.buckets.get(i).run(this.stageName), this.stageName);
+                } else {
+                    for (int i = 0, len = this.buckets.size(); i < len; ++i) {
+                        this.buckets.get(i).run(this.stageName);
+                    }
+                }
+            } finally {
+                restoreContextStack(this.world, suspended);
+            }
         }
