+        private CompletableFuture<Void> taskCompletion() {
+            synchronized (this) {
+                if (this.taskComplete) {
+                    return CompletableFuture.completedFuture(null);
+                }
+                if (this.taskCompletion == null) {
+                    this.taskCompletion = new CompletableFuture<>();
+                }
+                return this.taskCompletion;
+            }
+        }
+
+        private void completeTask() {
+            final CompletableFuture<Void> completion;
+            synchronized (this) {
+                this.taskComplete = true;
+                completion = this.taskCompletion;
+            }
+            if (completion != null) {
+                completion.complete(null);
+            }
+        }
+
         public Priority getPriority() {
             synchronized (this) {
                 return this.priority;
@@ -1450,9 +1503,54 @@ public final class MoonriseRegionFileIO {
         }
 
         final void endTask(final ChunkIOTask task) {
+            task.completeTask();
             this.inProgressTasks.getAndDecrement();
         }
 
+        public List<CompletableFuture<Void>> snapshotTaskCompletions() {
+            final List<CompletableFuture<Void>> completions = new ArrayList<>();
+            for (final ChunkIOTask task : this.chunkTasks.values()) {
+                completions.add(task.taskCompletion());
+            }
+            return completions;
+        }
+
+        public List<CompletableFuture<Void>> flushLoadedRegionsAsync(final MinecraftServer server) {
+            final RegionFileStorage cache = this.getCache();
+            final long[] loadedRegions = cache.moonrise$getLoadedRegionKeys();
+
+            final List<CompletableFuture<Void>> completions = new ArrayList<>(loadedRegions.length);
+            for (final long regionKey : loadedRegions) {
+                final int chunkX = ChunkPos.getX(regionKey) << 5;
+                final int chunkZ = ChunkPos.getZ(regionKey) << 5;
+                final CompletableFuture<Void> completion = new CompletableFuture<>();
+                final PrioritisedExecutor.PrioritisedTask task = this.createRegionIoTask(
+                    chunkX,
+                    chunkZ,
+                    () -> {
+                        try (net.minecraft.server.threading.runtime.OwnerDomainExecutor.Scope ignored =
+                                 net.minecraft.server.threading.runtime.OwnerDomainExecutor.enter(
+                                     net.minecraft.server.threading.runtime.OwnerDomainExecutor.asyncIo(server, "flush-region-file")
+                                 )) {
+                            final RegionFile regionFile = cache.moonrise$getRegionFileIfLoaded(chunkX, chunkZ);
+                            if (regionFile != null) {
+                                regionFile.flush();
+                            }
+                            completion.complete(null);
+                        } catch (final Throwable throwable) {
+                            completion.completeExceptionally(throwable);
+                        }
+                    },
+                    Priority.BLOCKING
+                );
+                if (!task.queue()) {
+                    completion.completeExceptionally(new IllegalStateException("Region I/O executor rejected a durability barrier"));
+                }
+                completions.add(completion);
+            }
+            return completions;
+        }
+
         public boolean hasTasks() {
             return this.inProgressTasks.get() != 0L;
         }
