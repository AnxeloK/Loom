+    private static boolean consumeWakeup(final AtomicInteger remaining) {
+        int available;
+        while ((available = remaining.get()) > 0) {
+            if (remaining.compareAndSet(available, available - 1)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private static void replenishWakeups(final AtomicInteger remaining, final int maximum) {
+        int current;
+        int replenished;
+        do {
+            current = remaining.get();
+            replenished = Math.min(current + 1, maximum);
+            if (replenished == current) {
+                return;
+            }
+        } while (!remaining.compareAndSet(current, replenished));
+    }
 
