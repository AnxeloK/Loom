+        private void queueSendChunk(final long chunk, final long now) {
+            this.sendQueue.enqueue(chunk);
+            if (this.sendQueueEnqueueNanos != null) {
+                this.sendQueueEnqueueNanos.putIfAbsent(chunk, now);
+            }
+        }
+
+        private void queueSendChunk(final long chunk) {
+            this.sendQueue.enqueue(chunk);
+            if (this.sendQueueEnqueueNanos != null) {
+                this.sendQueueEnqueueNanos.putIfAbsent(chunk, System.nanoTime());
+            }
+        }
+
+        private long removeSendQueueAgeNanos(final long chunk, final long now) {
+            if (this.sendQueueEnqueueNanos == null) {
+                return Long.MIN_VALUE;
+            }
+            final long queuedAt = this.sendQueueEnqueueNanos.remove(chunk);
+            return queuedAt == Long.MIN_VALUE ? Long.MIN_VALUE : Math.max(0L, now - queuedAt);
+        }
+
