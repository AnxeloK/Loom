+
+        private void sampleNetwork(final boolean writable, final long pendingBytes, final int pendingWrites) {
+            if (!writable) {
+                ++this.networkNotWritablePlayers;
+            }
+            this.networkPendingBytes += pendingBytes;
+            this.networkMaxPendingBytes = Math.max(this.networkMaxPendingBytes, pendingBytes);
+            this.networkPendingWrites += pendingWrites;
+            this.networkMaxPendingWrites = Math.max(this.networkMaxPendingWrites, pendingWrites);
+        }
     }
 
     public static final class PlayerChunkLoaderData {
@@ -443,6 +466,27 @@ public final class RegionizedPlayerChunkLoader {
         private static final int LOOM_KEEPALIVE_HARD_SEND_MAX_PER_TICK = getIntProperty(
             "Loom.PlayerChunkSendKeepAliveHardMaxPerTick", 2
         );
+        private static final boolean LOOM_NETWORK_BACKPRESSURE = Boolean.parseBoolean(
+            System.getProperty("Loom.PlayerChunkSendNetworkBackpressure", "true")
+        );
+        private static final long LOOM_NETWORK_SOFT_PENDING_BYTES = getLongProperty(
+            "Loom.PlayerChunkSendNetworkSoftPendingBytes", 1_048_576L
+        );
+        private static final long LOOM_NETWORK_HARD_PENDING_BYTES = getLongProperty(
+            "Loom.PlayerChunkSendNetworkHardPendingBytes", 4_194_304L
+        );
+        private static final int LOOM_NETWORK_SOFT_PENDING_WRITES = getIntProperty(
+            "Loom.PlayerChunkSendNetworkSoftPendingWrites", 16
+        );
+        private static final int LOOM_NETWORK_HARD_PENDING_WRITES = getIntProperty(
+            "Loom.PlayerChunkSendNetworkHardPendingWrites", 64
+        );
+        private static final int LOOM_NETWORK_SOFT_SEND_MAX_PER_TICK = getIntProperty(
+            "Loom.PlayerChunkSendNetworkSoftMaxPerTick", 2
+        );
+        private static final int LOOM_NETWORK_HARD_SEND_MAX_PER_TICK = getNonNegativeIntProperty(
+            "Loom.PlayerChunkSendNetworkHardMaxPerTick", 0
+        );
 
         private final ServerPlayer player;
         private final ServerLevel world;
@@ -521,6 +565,30 @@ public final class RegionizedPlayerChunkLoader {
             }
         }
 
+        private static int getNonNegativeIntProperty(final String property, final int fallback) {
+            final String configured = System.getProperty(property);
+            if (configured == null) {
+                return fallback;
+            }
+            try {
+                return Math.max(0, Integer.parseInt(configured));
+            } catch (final NumberFormatException ignored) {
+                return fallback;
+            }
+        }
+
+        private static long getLongProperty(final String property, final long fallback) {
+            final String configured = System.getProperty(property);
+            if (configured == null) {
+                return fallback;
+            }
+            try {
+                return Math.max(0L, Long.parseLong(configured));
+            } catch (final NumberFormatException ignored) {
+                return fallback;
+            }
+        }
+
         private final StaggeredRateLimiter chunkSendLimiter = createChunkLimiter();
         private final StaggeredRateLimiter chunkLoadTicketLimiter = createChunkLimiter();
         private final StaggeredRateLimiter chunkGenerateTicketLimiter = createChunkLimiter();
@@ -769,7 +837,7 @@ public final class RegionizedPlayerChunkLoader {
             return configRate <= 0.0 || configRate > (double)MAX_RATE ? (double)MAX_RATE : Math.max(1.0, configRate);
         }
 
-        private long getMaxChunkSendsThisTick(final long now) {
+        private long getMaxChunkSendsThisTick(final long now, final TickDiagnostics diagnostics) {
             long maxSends = Math.max(0L, Math.min(Math.min(MAX_RATE, LOOM_PLAYER_CHUNK_SEND_MAX_PER_TICK), Math.min(this.sendQueue.size(), Integer.MAX_VALUE)));
             final net.minecraft.server.network.ServerGamePacketListenerImpl connection = this.player.connection;
             if (connection == null) {
@@ -783,6 +851,27 @@ public final class RegionizedPlayerChunkLoader {
                 maxSends = Math.min(maxSends, LOOM_KEEPALIVE_SOFT_SEND_MAX_PER_TICK);
             }
 
+            if (LOOM_NETWORK_BACKPRESSURE) {
+                final net.minecraft.network.Connection network = connection.connection;
+                final boolean writable = network.isLoomChannelWritable();
+                final long pendingBytes = network.getLoomOutboundPendingBytes();
+                final int pendingWrites = network.getLoomPendingEventLoopWrites();
+                if (diagnostics != null) {
+                    diagnostics.sampleNetwork(writable, pendingBytes, pendingWrites);
+                }
+                if (!writable || pendingBytes >= LOOM_NETWORK_HARD_PENDING_BYTES || pendingWrites >= LOOM_NETWORK_HARD_PENDING_WRITES) {
+                    if (diagnostics != null) {
+                        ++diagnostics.networkBackpressuredPlayers;
+                    }
+                    maxSends = Math.min(maxSends, LOOM_NETWORK_HARD_SEND_MAX_PER_TICK);
+                } else if (pendingBytes >= LOOM_NETWORK_SOFT_PENDING_BYTES || pendingWrites >= LOOM_NETWORK_SOFT_PENDING_WRITES) {
+                    if (diagnostics != null) {
+                        ++diagnostics.networkBackpressuredPlayers;
+                    }
+                    maxSends = Math.min(maxSends, LOOM_NETWORK_SOFT_SEND_MAX_PER_TICK);
+                }
+            }
+
             return maxSends;
         }
 
@@ -1062,7 +1151,7 @@ public final class RegionizedPlayerChunkLoader {
             }
 
             // try to pull sending chunks
-            final long maxSends = this.getMaxChunkSendsThisTick(time); // note: no logic to track concurrent sends
+            final long maxSends = this.getMaxChunkSendsThisTick(time, diagnostics); // note: no logic to track concurrent sends
             final long maxSendsThisTick = this.chunkSendLimiter.takeAllocation(maxSends);
             // we do not return sends that we took from the allocation back because we want to limit the max send rate, not target it
             for (long i = 0; i < maxSendsThisTick; ++i) {
diff --git a/net/minecraft/network/Connection.java b/net/minecraft/network/Connection.java
index f278e1371fb73157010bcb117058239e4546a12a..d953bb4edb1ae93667a3c8865cb3d2fc1354ada6 100644
--- a/net/minecraft/network/Connection.java
+++ b/net/minecraft/network/Connection.java
@@ -28,6 +28,7 @@ import java.nio.channels.ClosedChannelException;
 import java.util.Objects;
 import java.util.Queue;
 import java.util.concurrent.RejectedExecutionException;
+import java.util.concurrent.atomic.AtomicInteger;
 import java.util.function.Consumer;
 import javax.crypto.Cipher;
 import net.minecraft.SharedConstants;
@@ -68,6 +69,7 @@ public class Connection extends SimpleChannelInboundHandler<Packet<?>> {
     private final PacketFlow receiving;
     private volatile boolean sendLoginDisconnect = true;
     private final Queue<WrappedConsumer> pendingActions = Queues.newConcurrentLinkedQueue(); // Paper - Optimize network
+    private final AtomicInteger loomPendingEventLoopWrites = new AtomicInteger();
     public Channel channel;
     public SocketAddress address;
     // Spigot start
@@ -435,6 +437,29 @@ public class Connection extends SimpleChannelInboundHandler<Packet<?>> {
         }
     }
 
+    public boolean isLoomChannelWritable() {
+        final Channel channel = this.channel;
+        return channel == null || !channel.isActive() || channel.isWritable();
+    }
+
+    public long getLoomOutboundPendingBytes() {
+        final Channel channel = this.channel;
+        if (channel == null) {
+            return 0L;
+        }
+
+        try {
+            final io.netty.channel.ChannelOutboundBuffer outboundBuffer = channel.unsafe().outboundBuffer();
+            return outboundBuffer == null ? 0L : Math.max(0L, outboundBuffer.totalPendingWriteBytes());
+        } catch (final Throwable ignored) {
+            return 0L;
+        }
+    }
+
+    public int getLoomPendingEventLoopWrites() {
+        return this.loomPendingEventLoopWrites.get();
+    }
+
     public void runOnceConnected(final Consumer<Connection> action) {
         if (this.isConnected()) {
             this.flushQueue();
@@ -449,7 +474,19 @@ public class Connection extends SimpleChannelInboundHandler<Packet<?>> {
         if (this.channel.eventLoop().inEventLoop()) {
             this.doSendPacket(packet, listener, flush);
         } else {
-            this.channel.eventLoop().execute(() -> this.doSendPacket(packet, listener, flush));
+            this.loomPendingEventLoopWrites.incrementAndGet();
+            try {
+                this.channel.eventLoop().execute(() -> {
+                    try {
+                        this.doSendPacket(packet, listener, flush);
+                    } finally {
+                        this.loomPendingEventLoopWrites.decrementAndGet();
+                    }
+                });
+            } catch (final RuntimeException ex) {
+                this.loomPendingEventLoopWrites.decrementAndGet();
+                throw ex;
+            }
         }
     }
 
