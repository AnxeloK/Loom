@@ -952,27 +952,54 @@ public class ChunkMap extends SimpleRegionStorage implements ChunkHolder.PlayerP
         if (maxDistance <= 0) {
             return false;
         }
-        final double targetX = pos.getX();
-        final double targetY = pos.getY();
-        final double targetZ = pos.getZ();
+        final ca.spottedleaf.moonrise.common.misc.NearbyPlayers.NearbyMapType type;
+        if (maxDistance <= ca.spottedleaf.moonrise.common.misc.NearbyPlayers.GENERAL_REALLY_SMALL_AREA_VIEW_DISTANCE_BLOCKS) {
