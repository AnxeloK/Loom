+            type = ca.spottedleaf.moonrise.common.misc.NearbyPlayers.NearbyMapType.GENERAL_SMALL;
+        } else if (maxDistance <= ca.spottedleaf.moonrise.common.misc.NearbyPlayers.GENERAL_AREA_VIEW_DISTANCE_BLOCKS) {
+            type = ca.spottedleaf.moonrise.common.misc.NearbyPlayers.NearbyMapType.GENERAL;
+        } else {
+            type = null;
+        }
         final double maxDistanceSquared = (double)maxDistance * (double)maxDistance;
-
-        for (ServerPlayer player : this.playerMap.getAllPlayers()) {
-            if (player.isSpectator()) {
-                continue;
+        if (type == null) {
+            for (final ServerPlayer player : this.playerMap.getAllPlayers()) {
+                if (playerIsCloseEnough(player, pos, maxDistanceSquared)) {
+                    return true;
+                }
             }
-            final Vec3 playerPos = player.position();
-            final double deltaX = playerPos.x - targetX;
-            final double deltaY = playerPos.y - targetY;
-            final double deltaZ = playerPos.z - targetZ;
-            if (deltaX * deltaX + deltaY * deltaY + deltaZ * deltaZ < maxDistanceSquared) {
+            return false;
+        }
+
+        // These maps follow entity section changes and do not depend on view or spawn settings.
+        final ca.spottedleaf.moonrise.common.list.ReferenceList<ServerPlayer> players =
+            this.level.moonrise$getNearbyPlayers().getPlayers(pos, type);
+        if (players == null) {
+            return false;
+        }
+        final ServerPlayer[] raw = players.getRawDataUnchecked();
+        final int len = players.size();
+        Objects.checkFromIndexSize(0, len, raw.length);
+        for (int i = 0; i < len; ++i) {
+            if (playerIsCloseEnough(raw[i], pos, maxDistanceSquared)) {
                 return true;
             }
         }
-
         return false;
     }
 
+    private static boolean playerIsCloseEnough(final ServerPlayer player, final BlockPos pos, final double maxDistanceSquared) {
+        if (player.isSpectator()) {
+            return false;
+        }
+        final Vec3 playerPos = player.position();
+        final double deltaX = playerPos.x - pos.getX();
+        final double deltaY = playerPos.y - pos.getY();
+        final double deltaZ = playerPos.z - pos.getZ();
+        return deltaX * deltaX + deltaY * deltaY + deltaZ * deltaZ < maxDistanceSquared;
+    }
+
     private boolean anyPlayerCloseEnoughForSpawningInternal(final ChunkPos pos) {
         // Spigot start
         return this.anyPlayerCloseEnoughForSpawningInternal(pos, false);
