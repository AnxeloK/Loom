+                for (final Iterator<CrossRegionMessage> iterator = this.mailbox.iterator(); iterator.hasNext(); ) {
+                    final CrossRegionMessage message = iterator.next();
+                    if (message.plugin() == plugin) {
+                        iterator.remove();
+                        ++this.droppedMessageCount;
+                        MAILBOX_MESSAGES_DROPPED.getAndIncrement();
+                        incrementTypeCounter(MAILBOX_DROPPED_BY_TYPE, message.messageType());
+                    }
+                }
+            }
+        }
