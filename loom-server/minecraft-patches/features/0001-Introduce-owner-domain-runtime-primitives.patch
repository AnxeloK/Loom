+
+            private void add(final CrossRegionMessage message) {
+                this.messages.add(message);
+                this.minChunkX = Math.min(this.minChunkX, message.targetChunkX());
+                this.minChunkZ = Math.min(this.minChunkZ, message.targetChunkZ());
+                this.maxChunkX = Math.max(this.maxChunkX, message.targetChunkX());
+                this.maxChunkZ = Math.max(this.maxChunkZ, message.targetChunkZ());
+            }
+
+            private void run() {
+                final RegionContext context;
+                try {
+                    context = pushRegionContext(
+                        this.world,
+                        this.minChunkX,
+                        this.minChunkZ,
+                        this.maxChunkX,
+                        this.maxChunkZ
+                    );
+                } catch (final IllegalStateException ex) {
+                    for (int i = 0, len = this.messages.size(); i < len; ++i) {
+                        final CrossRegionMessage message = this.messages.get(i);
+                        message.owner().deferMailboxMessage(message, "Mailbox bucket claim failed: " + ex.getMessage());
+                    }
+                    return;
+                }
+
+                try {
+                    for (int i = 0, len = this.messages.size(); i < len; ++i) {
+                        final CrossRegionMessage message = this.messages.get(i);
