@@ -0,0 +1,79 @@
+package net.minecraft.server.threading.runtime;
+
+import com.mojang.logging.LogUtils;
+import java.lang.reflect.InvocationTargetException;
+import java.lang.reflect.Method;
+import org.bukkit.Bukkit;
+import org.slf4j.Logger;
+
+public final class ThreadedRegionsCompatibility {
+
+    private static final Logger LOGGER = LogUtils.getLogger();
+    @FunctionalInterface
+    public interface RegionizedServerInitHook {
+        void fire();
+    }
+
+    private static volatile RegionizedServerInitHook regionizedServerInitHook = () -> {
+    };
+    private static volatile boolean globalSchedulerTickMethodResolved;
+    private static volatile Method globalSchedulerTickMethod;
+
+    private ThreadedRegionsCompatibility() {
+    }
+
+    public static void registerRegionizedServerInitHook(final RegionizedServerInitHook hook) {
+        regionizedServerInitHook = hook == null ? () -> {
+        } : hook;
+    }
+
+    public static void fireRegionizedServerInitEvent() {
+        try {
+            regionizedServerInitHook.fire();
+        } catch (final Throwable exception) {
+            LOGGER.error("Failed to fire RegionizedServerInitEvent", exception);
+        }
+    }
+
+    public static void tickGlobalRegionScheduler() {
+        final Object scheduler = Bukkit.getGlobalRegionScheduler();
+        if (scheduler == null) {
+            return;
+        }
+
+        final Method tickMethod = resolveGlobalSchedulerTickMethod(scheduler);
+        if (tickMethod == null) {
+            return;
+        }
+
+        try {
+            tickMethod.invoke(scheduler);
+        } catch (final InvocationTargetException exception) {
+            LOGGER.error("Global region scheduler tick invocation failed", exception.getCause());
+        } catch (final IllegalAccessException exception) {
+            LOGGER.error("Global region scheduler tick invocation failed", exception);
+        }
+    }
+
+    private static Method resolveGlobalSchedulerTickMethod(final Object scheduler) {
+        if (globalSchedulerTickMethodResolved) {
+            return globalSchedulerTickMethod;
+        }
+
+        synchronized (ThreadedRegionsCompatibility.class) {
+            if (globalSchedulerTickMethodResolved) {
+                return globalSchedulerTickMethod;
+            }
+            Method resolved = null;
+            try {
+                resolved = scheduler.getClass().getMethod("tick");
+                resolved.setAccessible(true);
+            } catch (final NoSuchMethodException ignored) {
+                // No runtime tick method available.
+            }
+            globalSchedulerTickMethod = resolved;
+            globalSchedulerTickMethodResolved = true;
+            return resolved;
+        }
+    }
+}
