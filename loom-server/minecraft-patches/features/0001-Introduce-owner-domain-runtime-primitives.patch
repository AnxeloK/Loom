+package net.minecraft.server.threading.runtime;
+
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.server.level.ServerLevel;
+
+public final class DomainClock {
+
+    private DomainClock() {
+    }
+
+    public static int currentServerTick(final MinecraftServer server) {
+        return server == null ? 0 : server.getTickCount();
+    }
+
+    public static int currentServerTick() {
+        return currentServerTick(MinecraftServer.getServer());
+    }
+
+    public static int currentWorldTick(final ServerLevel level) {
+        final long gameTime = level.getGameTime();
+        return (int)(gameTime ^ (gameTime >>> 32));
+    }
+}
