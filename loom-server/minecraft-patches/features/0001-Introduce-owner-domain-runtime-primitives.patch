+    private static boolean isCurrentThreadOwnerByContext(
+        final ServerLevel world,
+        final int minChunkX,
+        final int minChunkZ,
+        final int maxChunkX,
+        final int maxChunkZ,
+        final long threadId
+    ) {
+        for (RegionContext context = CURRENT_CONTEXT.get(); context != null; context = context.previous()) {
+            if (context.ownerThreadId() == threadId
+                && context.world() == world
+                && context.contains(minChunkX, minChunkZ)
+                && context.contains(maxChunkX, maxChunkZ)) {
