+    private static void runRegionBoundTasks(
+        final ServerLevel world,
+        final List<RegionBoundTask> tasks,
+        final String stageName
+    ) {
+        final boolean containsMultiChunkTasks = containsMultiChunkRegionTasks(tasks);
+        final List<RegionBoundBucket> buckets = containsMultiChunkTasks
+            ? bucketRegionBoundTasksByOverlap(world, tasks)
+            : bucketRegionBoundTasksByDispatchChunk(world, tasks);
+
+        if (PARALLEL_SIMULATION_ENABLED && buckets.size() > 1) {
+            final List<CompletableFuture<Void>> futures = new ArrayList<>(buckets.size());
+            for (int i = 0, len = buckets.size(); i < len; ++i) {
+                final RegionBoundBucket bucket = buckets.get(i);
+                futures.add(CompletableFuture.runAsync(() -> bucket.run(stageName), REGION_SCHEDULER_EXECUTOR));
+            }
+            RuntimeException firstFailure = null;
+            Error firstError = null;
+            for (int i = 0, len = futures.size(); i < len; ++i) {
+                try {
+                    futures.get(i).join();
+                } catch (final java.util.concurrent.CompletionException ex) {
+                    final Throwable cause = unwrapParallelStageFailure(ex);
+                    if (cause instanceof Error error) {
+                        if (firstError == null) {
+                            firstError = error;
+                        }
+                        continue;
+                    }
+                    if (cause instanceof RuntimeException runtimeException) {
+                        if (firstFailure == null) {
+                            firstFailure = runtimeException;
+                        }
+                    } else if (firstFailure == null) {
+                        firstFailure = new RuntimeException("Parallel region task dispatch failed for " + stageName, cause);
+                    }
+                }
+            }
+            if (firstError != null) {
+                throw firstError;
+            }
+            if (firstFailure != null) {
+                throw firstFailure;
+            }
+            return;
+        }
+
+        for (int i = 0, len = buckets.size(); i < len; ++i) {
+            buckets.get(i).run(stageName);
+        }
+    }
+
+    private static boolean containsMultiChunkRegionTasks(final List<RegionBoundTask> tasks) {
+        for (int i = 0, len = tasks.size(); i < len; ++i) {
+            final RegionBoundTask task = tasks.get(i);
+            if (task.minChunkX() != task.maxChunkX() || task.minChunkZ() != task.maxChunkZ()) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private static List<RegionBoundBucket> bucketRegionBoundTasksByDispatchChunk(
+        final ServerLevel world,
+        final List<RegionBoundTask> tasks
+    ) {
+        final Map<Long, RegionBoundBucket> bucketMap = new HashMap<>();
+        for (int i = 0, len = tasks.size(); i < len; ++i) {
+            final RegionBoundTask task = tasks.get(i);
+            final long bucketKey = regionBucketKey(task.chunkX(), task.chunkZ());
+            bucketMap.computeIfAbsent(bucketKey, ignored -> new RegionBoundBucket(world)).add(task);
+        }
+
+        final List<Map.Entry<Long, RegionBoundBucket>> entries = new ArrayList<>(bucketMap.entrySet());
+        entries.sort(Map.Entry.comparingByKey());
+        final List<RegionBoundBucket> buckets = new ArrayList<>(entries.size());
+        for (int i = 0, len = entries.size(); i < len; ++i) {
+            buckets.add(entries.get(i).getValue());
+        }
+        return buckets;
+    }
+
+    private static List<RegionBoundBucket> bucketRegionBoundTasksByOverlap(
+        final ServerLevel world,
+        final List<RegionBoundTask> tasks
+    ) {
+        final List<RegionBoundBucket> buckets = new ArrayList<>();
+        for (int i = 0, len = tasks.size(); i < len; ++i) {
+            final RegionBoundTask task = tasks.get(i);
+            RegionBoundBucket target = null;
+            for (int bucketIndex = 0, bucketLen = buckets.size(); bucketIndex < bucketLen; ++bucketIndex) {
+                final RegionBoundBucket bucket = buckets.get(bucketIndex);
+                if (bucket.intersects(task)) {
+                    target = bucket;
+                    break;
+                }
+            }
+
+            if (target == null) {
+                target = new RegionBoundBucket(world);
+                buckets.add(target);
+            }
+            target.add(task);
+
+            for (int bucketIndex = buckets.size() - 1; bucketIndex >= 0; --bucketIndex) {
+                final RegionBoundBucket bucket = buckets.get(bucketIndex);
+                if (bucket == target || !target.intersects(bucket)) {
+                    continue;
+                }
+                target.absorb(bucket);
+                buckets.remove(bucketIndex);
+            }
+        }
+
+        buckets.sort(Comparator
+            .comparingInt(RegionBoundBucket::minChunkX)
+            .thenComparingInt(RegionBoundBucket::minChunkZ)
+            .thenComparingInt(RegionBoundBucket::maxChunkX)
+            .thenComparingInt(RegionBoundBucket::maxChunkZ));
+        return buckets;
+    }
+
+    private static Throwable unwrapParallelStageFailure(final Throwable throwable) {
+        Throwable cause = throwable;
+        while ((cause instanceof java.util.concurrent.CompletionException || cause instanceof java.util.concurrent.ExecutionException)
+            && cause.getCause() != null) {
+            cause = cause.getCause();
+        }
+        return cause;
+    }
+
+    private static List<ContextLeaseBounds> suspendContextStackForWorld(final ServerLevel world) {
+        RegionContext current = CURRENT_CONTEXT.get();
+        if (current == null) {
+            return List.of();
+        }
+        final List<ContextLeaseBounds> suspended = new ArrayList<>();
+        while (current != null) {
+            if (current.world() != world) {
+                throw new IllegalStateException(
+                    "Cannot suspend mixed-world context stack while dispatching parallel tasks for "
+                        + world.dimension().identifier()
+                );
+            }
+            suspended.add(new ContextLeaseBounds(
+                current.minChunkX(),
+                current.minChunkZ(),
+                current.maxChunkX(),
+                current.maxChunkZ()
+            ));
+            popContext(current);
+            current = CURRENT_CONTEXT.get();
+        }
+        return suspended;
+    }
+
+    private static void restoreContextStack(final ServerLevel world, final List<ContextLeaseBounds> suspended) {
+        for (int i = suspended.size() - 1; i >= 0; --i) {
+            final ContextLeaseBounds bounds = suspended.get(i);
+            pushRegionContext(
+                world,
+                bounds.minChunkX(),
+                bounds.minChunkZ(),
+                bounds.maxChunkX(),
+                bounds.maxChunkZ()
+            );
+        }
+    }
+
+    private static boolean isCurrentThreadOwnerByContext(
+        final ServerLevel world,
+        final int chunkX,
+        final int chunkZ,
+        final long threadId
+    ) {
+        for (RegionContext context = CURRENT_CONTEXT.get(); context != null; context = context.previous()) {
+            if (context.ownerThreadId() == threadId && context.world() == world && context.contains(chunkX, chunkZ)) {
+                return true;
+            }
+        }
+        return false;
