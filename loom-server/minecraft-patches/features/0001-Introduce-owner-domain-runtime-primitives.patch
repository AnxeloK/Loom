+package net.minecraft.server.threading.runtime;
+
+import ca.spottedleaf.moonrise.common.util.TickThread;
+import net.minecraft.server.threading.TickRegions;
+import org.bukkit.Server;
+import org.jetbrains.annotations.NotNull;
+
+public final class ExecutionContextGate {
+
+    public enum ExecutionDomain {
+        PRIMARY,
+        REGION,
+        ASYNC
+    }
+
+    private ExecutionContextGate() {
+    }
+
+    public static boolean canRunSynchronousCallbacks(final @NotNull Server server) {
+        return server.isPrimaryThread() || (TickThread.isTickThread() && TickRegions.currentContext() != null);
+    }
+
+    public static ExecutionDomain currentDomain(final @NotNull Server server) {
+        if (server.isPrimaryThread()) {
+            return ExecutionDomain.PRIMARY;
+        }
+        if (TickThread.isTickThread()) {
+            return ExecutionDomain.REGION;
+        }
+        return ExecutionDomain.ASYNC;
+    }
+
+    public static String describe(final @NotNull Server server) {
+        final TickRegions.RegionContext context = TickRegions.currentContext();
+        final String contextDetail;
+        if (context == null) {
+            contextDetail = "none";
+        } else {
+            contextDetail = context.world().dimension().identifier() + "[" + context.minChunkX() + "," + context.minChunkZ()
+                + " -> " + context.maxChunkX() + "," + context.maxChunkZ() + "]";
+        }
+
+        return "domain=" + currentDomain(server)
+            + ", thread=" + Thread.currentThread().getName()
+            + ", regionContext=" + contextDetail;
+    }
+}
