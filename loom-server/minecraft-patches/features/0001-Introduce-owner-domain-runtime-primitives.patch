+    public static void runRegionBoundTasksFromCurrentContext(
+        final ServerLevel world,
+        final List<RegionBoundTask> tasks,
+        final String stageName
+    ) {
+        Objects.requireNonNull(world, "World may not be null");
+        Objects.requireNonNull(tasks, "Tasks may not be null");
+        Objects.requireNonNull(stageName, "Stage name may not be null");
+        if (tasks.isEmpty()) {
+            return;
+        }
+
+        final List<ContextLeaseBounds> suspended = suspendContextStackForWorld(world);
+        try {
+            runRegionBoundTasks(world, tasks, stageName);
+        } finally {
+            restoreContextStack(world, suspended);
+        }
+    }
