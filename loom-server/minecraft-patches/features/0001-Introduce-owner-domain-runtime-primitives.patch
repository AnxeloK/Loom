+        private static final class TaskBucket {
+
+            private final ServerLevel world;
+            private final List<RegionScheduledTask> tasks = new ArrayList<>();
+            private int minChunkX = Integer.MAX_VALUE;
+            private int minChunkZ = Integer.MAX_VALUE;
+            private int maxChunkX = Integer.MIN_VALUE;
+            private int maxChunkZ = Integer.MIN_VALUE;
+
+            private TaskBucket(final ServerLevel world) {
+                this.world = world;
+            }
+
+            private void add(final RegionScheduledTask task) {
+                this.tasks.add(task);
+                this.minChunkX = Math.min(this.minChunkX, task.chunkX);
+                this.minChunkZ = Math.min(this.minChunkZ, task.chunkZ);
+                this.maxChunkX = Math.max(this.maxChunkX, task.chunkX);
+                this.maxChunkZ = Math.max(this.maxChunkZ, task.chunkZ);
+            }
+
+            private void run() {
+                final RegionContext context;
+                try {
+                    context = pushRegionContext(
+                        this.world,
+                        this.minChunkX,
+                        this.minChunkZ,
+                        this.maxChunkX,
+                        this.maxChunkZ
+                    );
+                } catch (final IllegalStateException ex) {
+                    for (int i = 0, len = this.tasks.size(); i < len; ++i) {
+                        this.tasks.get(i).owner.deferTask(this.tasks.get(i), "Bucket claim failed: " + ex.getMessage());
+                    }
+                    return;
+                }
+                try {
+                    for (int i = 0, len = this.tasks.size(); i < len; ++i) {
+                        this.tasks.get(i).owner.runScheduledTask(this.tasks.get(i));
+                    }
+                } finally {
+                    popContext(context);
+                }
+            }
+        }
+
+        private static final class MessageBucket {
+
+            private final ServerLevel world;
+            private final List<CrossRegionMessage> messages = new ArrayList<>();
+            private int minChunkX = Integer.MAX_VALUE;
+            private int minChunkZ = Integer.MAX_VALUE;
+            private int maxChunkX = Integer.MIN_VALUE;
+            private int maxChunkZ = Integer.MIN_VALUE;
+
+            private MessageBucket(final ServerLevel world) {
+                this.world = world;
