+                    DiagnosticType.CONTEXT_STACK_UNBALANCED,
+                    context.world(),
+                    context.minChunkX(),
+                    context.minChunkZ(),
+                    context.maxChunkX(),
+                    context.maxChunkZ(),
+                    "Unbalanced region context stack"
+                );
+                throw new IllegalStateException("Unbalanced region context stack");
+            }
+        }
+        CURRENT_CONTEXT.set(current.previous());
+        REGION_RUNTIME.releaseLease(current.world(), current.leaseId());
+    }
