+
+    private static long regionBucketKey(final int chunkX, final int chunkZ) {
+        final int bucketX = chunkX >> REGION_BUCKET_SHIFT;
+        final int bucketZ = chunkZ >> REGION_BUCKET_SHIFT;
+        return ((bucketX & 0xFFFFFFFFL) << 32) | (bucketZ & 0xFFFFFFFFL);
+    }
+
+    private static void recordDiagnostic(
+        final DiagnosticType type,
+        final @Nullable ServerLevel world,
+        final int minChunkX,
+        final int minChunkZ,
+        final int maxChunkX,
+        final int maxChunkZ,
+        final String detail
+    ) {
+        final Thread current = Thread.currentThread();
+        final DiagnosticEvent event = new DiagnosticEvent(
+            DIAGNOSTIC_SEQUENCE.incrementAndGet(),
+            System.nanoTime(),
+            current.getName(),
+            current.threadId(),
+            type,
+            worldId(world),
+            minChunkX,
+            minChunkZ,
+            maxChunkX,
+            maxChunkZ,
+            detail
+        );
+
+        {
+            DIAGNOSTIC_EVENTS.addLast(event);
+            while (DIAGNOSTIC_EVENTS.size() > DIAGNOSTIC_EVENT_LIMIT) {
+                DIAGNOSTIC_EVENTS.removeFirst();
+            }
+        }
+    }
