+
+        private void cancelTasks(final Plugin plugin) {
+            {
+                for (final List<RegionScheduledTask> tasks : this.tasksByDeadline.values()) {
+                    for (int i = 0, len = tasks.size(); i < len; ++i) {
+                        final RegionScheduledTask task = tasks.get(i);
+                        if (task.plugin == plugin) {
+                            final ScheduledTask.CancelledState cancelled = task.cancel();
+                            if (cancelled == ScheduledTask.CancelledState.CANCELLED_BY_CALLER
+                                || cancelled == ScheduledTask.CancelledState.NEXT_RUNS_CANCELLED) {
+                                ++this.cancelledTaskCount;
