+package net.minecraft.server.threading.runtime;
+
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.RejectedExecutionException;
+import java.util.function.Supplier;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.server.level.ServerPlayer;
+import net.minecraft.server.threading.TickRegions;
+import net.minecraft.world.level.ChunkPos;
+
+public final class OwnershipRouter {
+
+    private OwnershipRouter() {
+    }
+
+    public static void dispatchToServer(final MinecraftServer server, final Runnable task) {
+        if (server == null || server.hasStopped()) {
+            return;
+        }
+        if (server.isSameThread()) {
+            task.run();
+            return;
+        }
+        server.execute(task);
+    }
+
+    public static CompletableFuture<Void> runOnServer(final MinecraftServer server, final Runnable task) {
+        return supplyOnServer(server, () -> {
+            task.run();
+            return null;
+        });
+    }
+
+    public static <T> CompletableFuture<T> supplyOnServer(final MinecraftServer server, final Supplier<T> supplier) {
+        if (server == null || server.hasStopped()) {
+            return CompletableFuture.failedFuture(new RejectedExecutionException("Server is unavailable"));
+        }
+        if (server.isSameThread()) {
+            try {
+                return CompletableFuture.completedFuture(supplier.get());
+            } catch (final Throwable throwable) {
+                return CompletableFuture.failedFuture(throwable);
+            }
+        }
+        final CompletableFuture<T> future = new CompletableFuture<>();
+        server.execute(() -> {
+            try {
+                future.complete(supplier.get());
+            } catch (final Throwable throwable) {
+                future.completeExceptionally(throwable);
+            }
+        });
+        return future;
+    }
+
+    public static void dispatchToLevel(
+        final ServerLevel level,
+        final int chunkX,
+        final int chunkZ,
+        final String operation,
+        final Runnable task
+    ) {
+        if (TickRegions.isCurrentThreadOwnerQuiet(level, chunkX, chunkZ)) {
+            task.run();
+            return;
+        }
+        TickRegions.sendCrossRegionMessage(
+            level,
+            chunkX,
+            chunkZ,
+            "ownership-router:" + operation,
+            task
+        );
+    }
+
+    public static CompletableFuture<Void> runOnLevel(
+        final ServerLevel level,
+        final int chunkX,
+        final int chunkZ,
+        final String operation,
+        final Runnable task
+    ) {
+        final CompletableFuture<Void> future = new CompletableFuture<>();
+        dispatchToLevel(level, chunkX, chunkZ, operation, () -> {
+            try {
+                task.run();
+                future.complete(null);
+            } catch (final Throwable throwable) {
+                future.completeExceptionally(throwable);
+            }
+        });
+        return future;
+    }
+
+    public static void dispatchToPlayer(final ServerPlayer player, final String operation, final Runnable task) {
+        if (player == null || player.hasDisconnected()) {
+            return;
+        }
+        final ServerLevel level = player.level();
+        final ChunkPos chunkPos = player.chunkPosition();
+        dispatchToLevel(level, chunkPos.x(), chunkPos.z(), "player-" + operation, () -> {
+            if (!player.hasDisconnected()) {
+                task.run();
+            }
+        });
+    }
+}
