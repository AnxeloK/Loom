+package io.papermc.paper.threadedregions;
+
+import net.minecraft.server.level.ServerLevel;
+
+import java.util.Objects;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.atomic.AtomicLong;
+
+/**
+ * Runtime ownership registry for region execution leases.
+ *
+ * <p>Work scopes claim a lease for a chunk range, and thread checks validate
+ * access against those active leases. The implementation starts simple so it
+ * can stay easy to reason about while the region graph runtime grows.</p>
+ */
+public final class RegionRuntime {
+
+    private final AtomicLong nextLeaseId = new AtomicLong(1L);
+    private final AtomicLong leaseConflicts = new AtomicLong();
+    private final ConcurrentHashMap<ServerLevel, WorldOwnership> ownershipByWorld = new ConcurrentHashMap<>();
+
+    public long claimLease(
+        final ServerLevel world,
+        final int minChunkX,
+        final int minChunkZ,
+        final int maxChunkX,
+        final int maxChunkZ,
+        final Thread ownerThread
+    ) {
+        Objects.requireNonNull(world, "World may not be null");
+        Objects.requireNonNull(ownerThread, "Owner thread may not be null");
+        if (minChunkX > maxChunkX || minChunkZ > maxChunkZ) {
+            throw new IllegalArgumentException("Invalid lease bounds: min > max");
+        }
+
+        final long leaseId = this.nextLeaseId.getAndIncrement();
+        final Lease lease = new Lease(
+            leaseId,
+            minChunkX,
+            minChunkZ,
+            maxChunkX,
+            maxChunkZ,
+            ownerThread.threadId(),
+            ownerThread.getName()
+        );
+
+        this.ownershipByWorld
+            .computeIfAbsent(world, ignored -> new WorldOwnership())
+            .claimLease(lease, this.leaseConflicts);
+
+        return leaseId;
+    }
+
+    public void releaseLease(final ServerLevel world, final long leaseId) {
+        final WorldOwnership worldOwnership = this.ownershipByWorld.get(world);
+        if (worldOwnership == null) {
+            return;
+        }
+        worldOwnership.removeLease(leaseId);
+        if (worldOwnership.isEmpty()) {
+            this.ownershipByWorld.remove(world, worldOwnership);
+        }
+    }
+
+    public boolean isOwner(final ServerLevel world, final int chunkX, final int chunkZ, final Thread thread) {
+        final WorldOwnership worldOwnership = this.ownershipByWorld.get(world);
+        return worldOwnership != null && worldOwnership.isOwner(chunkX, chunkZ, thread.threadId());
+    }
+
+    public boolean isOwner(
+        final ServerLevel world,
+        final int minChunkX,
+        final int minChunkZ,
+        final int maxChunkX,
+        final int maxChunkZ,
+        final Thread thread
+    ) {
+        final WorldOwnership worldOwnership = this.ownershipByWorld.get(world);
+        return worldOwnership != null && worldOwnership.isOwner(minChunkX, minChunkZ, maxChunkX, maxChunkZ, thread.threadId());
+    }
+
+    public int activeLeases(final ServerLevel world) {
+        final WorldOwnership worldOwnership = this.ownershipByWorld.get(world);
+        return worldOwnership == null ? 0 : worldOwnership.size();
+    }
+
+    public long leaseConflictCount() {
+        return this.leaseConflicts.get();
+    }
+
+    public void clearWorld(final ServerLevel world) {
+        this.ownershipByWorld.remove(world);
+    }
+
+    private static final class WorldOwnership {
+
+        private final Object lock = new Object();
+        private final ConcurrentHashMap<Long, Lease> leases = new ConcurrentHashMap<>();
+
+        private void claimLease(final Lease lease, final AtomicLong conflictCounter) {
+            synchronized (this.lock) {
+                final Lease conflictingLease = this.findConflictingLease(lease);
+                if (conflictingLease != null) {
+                    conflictCounter.getAndIncrement();
+                    throw new IllegalStateException(
+                        "Region lease conflict: new lease " + lease.describeBounds()
+                            + " by thread " + lease.ownerThreadName + "[" + lease.ownerThreadId + "] overlaps existing lease "
+                            + conflictingLease.describeBounds() + " by thread "
+                            + conflictingLease.ownerThreadName + "[" + conflictingLease.ownerThreadId + "]"
+                    );
+                }
+
+                final Lease prev = this.leases.put(lease.id, lease);
+                if (prev != null) {
+                    throw new IllegalStateException("Duplicate lease id: " + lease.id);
+                }
+            }
+        }
+
+        private void removeLease(final long leaseId) {
+            synchronized (this.lock) {
+                this.leases.remove(leaseId);
+            }
+        }
+
+        private boolean isOwner(final int chunkX, final int chunkZ, final long threadId) {
+            for (final Lease lease : this.leases.values()) {
+                if (lease.ownerThreadId == threadId && lease.contains(chunkX, chunkZ)) {
+                    return true;
+                }
+            }
+            return false;
+        }
+
+        private boolean isOwner(
+            final int minChunkX,
+            final int minChunkZ,
+            final int maxChunkX,
+            final int maxChunkZ,
+            final long threadId
+        ) {
+            for (final Lease lease : this.leases.values()) {
+                if (lease.ownerThreadId == threadId
+                    && lease.contains(minChunkX, minChunkZ)
+                    && lease.contains(maxChunkX, maxChunkZ)) {
+                    return true;
+                }
+            }
+            return false;
+        }
+
+        private boolean isEmpty() {
+            synchronized (this.lock) {
+                return this.leases.isEmpty();
+            }
+        }
+
+        private int size() {
+            synchronized (this.lock) {
+                return this.leases.size();
+            }
+        }
+
+        private Lease findConflictingLease(final Lease lease) {
+            for (final Lease existing : this.leases.values()) {
+                if (existing.ownerThreadId == lease.ownerThreadId) {
+                    continue;
+                }
+                if (existing.intersects(lease.minChunkX, lease.minChunkZ, lease.maxChunkX, lease.maxChunkZ)) {
+                    return existing;
+                }
+            }
+            return null;
+        }
+    }
+
+    private static final class Lease {
+
+        private final long id;
+        private final int minChunkX;
+        private final int minChunkZ;
+        private final int maxChunkX;
+        private final int maxChunkZ;
+        private final long ownerThreadId;
+        @SuppressWarnings("unused")
+        private final String ownerThreadName;
+
+        private Lease(
+            final long id,
+            final int minChunkX,
+            final int minChunkZ,
+            final int maxChunkX,
+            final int maxChunkZ,
+            final long ownerThreadId,
+            final String ownerThreadName
+        ) {
+            this.id = id;
+            this.minChunkX = minChunkX;
+            this.minChunkZ = minChunkZ;
+            this.maxChunkX = maxChunkX;
+            this.maxChunkZ = maxChunkZ;
+            this.ownerThreadId = ownerThreadId;
+            this.ownerThreadName = ownerThreadName;
+        }
+
+        private boolean contains(final int chunkX, final int chunkZ) {
+            return chunkX >= this.minChunkX && chunkX <= this.maxChunkX
+                && chunkZ >= this.minChunkZ && chunkZ <= this.maxChunkZ;
+        }
+
+        private boolean intersects(
+            final int minChunkX,
+            final int minChunkZ,
+            final int maxChunkX,
+            final int maxChunkZ
+        ) {
+            return this.minChunkX <= maxChunkX
+                && this.maxChunkX >= minChunkX
+                && this.minChunkZ <= maxChunkZ
+                && this.maxChunkZ >= minChunkZ;
+        }
+
+        private String describeBounds() {
+            return "[" + this.minChunkX + "," + this.minChunkZ + " -> " + this.maxChunkX + "," + this.maxChunkZ + "]";
+        }
+    }
+}
