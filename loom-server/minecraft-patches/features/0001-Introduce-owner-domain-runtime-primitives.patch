+        private List<CrossRegionMessage> collectMailboxBudgeted() {
+            {
+                final int available = this.mailbox.size();
+                if (available == 0) {
+                    return List.of();
+                }
+
+                final int mailboxBudget = getAdaptiveMailboxBudget(available);
+                final int budgeted = Math.min(available, mailboxBudget);
+                final List<CrossRegionMessage> toDeliver = new ArrayList<>(budgeted);
+                for (int i = 0; i < budgeted; ++i) {
+                    final CrossRegionMessage message = this.mailbox.pollFirst();
+                    if (message == null) {
+                        break;
+                    }
+                    toDeliver.add(message);
+                }
+
+                if (available > budgeted) {
+                    MAILBOX_BUDGET_SKIPS.getAndIncrement();
+                    ++this.mailboxBudgetSkipCount;
+                    recordDiagnostic(
+                        DiagnosticType.MAILBOX_BUDGET_EXHAUSTED,
+                        this.world,
+                        Integer.MIN_VALUE,
+                        Integer.MIN_VALUE,
+                        Integer.MAX_VALUE,
+                        Integer.MAX_VALUE,
+                        "Mailbox budget exhausted: queued=" + available
+                            + ", budget=" + mailboxBudget
+                            + ", baseBudget=" + MAILBOX_MAX_MESSAGES_PER_TICK
+                    );
+                }
+                return toDeliver;
+            }
+        }
