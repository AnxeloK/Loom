+package net.minecraft.server.threading;
+
+import net.minecraft.server.level.ServerLevel;
+
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+import java.util.Set;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.atomic.AtomicLong;
+
+/**
+ * Runtime ownership registry for region execution leases.
+ *
+ * <p>Work scopes claim a lease for a chunk range, and thread checks validate
+ * access against those active leases. The implementation starts simple so it
+ * can stay easy to reason about while the region graph runtime grows.</p>
+ */
+public class RegionRuntime {
+
+    private final AtomicLong nextLeaseId = new AtomicLong(1L);
+    private final AtomicLong nextRegionId = new AtomicLong(1L);
+    private final AtomicLong leaseConflicts = new AtomicLong();
+    private final ConcurrentHashMap<Object, WorldOwnership> ownershipByWorld = new ConcurrentHashMap<>();
+
+    protected RegionRuntime() {
+    }
+
+    public long claimLease(
+        final ServerLevel world,
+        final int minChunkX,
+        final int minChunkZ,
+        final int maxChunkX,
+        final int maxChunkZ,
+        final Thread ownerThread
+    ) {
+        return this.claimLeaseInternal(world, minChunkX, minChunkZ, maxChunkX, maxChunkZ, ownerThread);
+    }
+
+    protected long claimLeaseForTesting(
+        final Object worldKey,
+        final int minChunkX,
+        final int minChunkZ,
+        final int maxChunkX,
+        final int maxChunkZ,
+        final Thread ownerThread
+    ) {
+        return this.claimLeaseInternal(worldKey, minChunkX, minChunkZ, maxChunkX, maxChunkZ, ownerThread);
+    }
+
+    private long claimLeaseInternal(
+        final Object worldKey,
+        final int minChunkX,
+        final int minChunkZ,
+        final int maxChunkX,
+        final int maxChunkZ,
+        final Thread ownerThread
+    ) {
+        Objects.requireNonNull(worldKey, "World key may not be null");
+        Objects.requireNonNull(ownerThread, "Owner thread may not be null");
+        if (minChunkX > maxChunkX || minChunkZ > maxChunkZ) {
+            throw new IllegalArgumentException("Invalid lease bounds: min > max");
+        }
+
+        final long leaseId = this.nextLeaseId.getAndIncrement();
+        this.ownershipByWorld
+            .computeIfAbsent(worldKey, ignored -> new WorldOwnership())
+            .claimLease(
+                leaseId,
+                minChunkX,
+                minChunkZ,
+                maxChunkX,
+                maxChunkZ,
+                ownerThread,
+                this.leaseConflicts,
+                this.nextRegionId
+            );
+
+        return leaseId;
+    }
+
+    public void releaseLease(final ServerLevel world, final long leaseId) {
+        this.releaseLeaseInternal(world, leaseId);
+    }
+
+    protected void releaseLeaseForTesting(final Object worldKey, final long leaseId) {
+        this.releaseLeaseInternal(worldKey, leaseId);
+    }
+
+    private void releaseLeaseInternal(final Object worldKey, final long leaseId) {
+        final WorldOwnership worldOwnership = this.ownershipByWorld.get(worldKey);
+        if (worldOwnership == null) {
+            return;
+        }
+        worldOwnership.removeLease(leaseId);
+    }
+
+    public boolean isOwner(final ServerLevel world, final int chunkX, final int chunkZ, final Thread thread) {
+        return this.isOwnerInternal(world, chunkX, chunkZ, thread);
+    }
+
+    protected boolean isOwnerForTesting(final Object worldKey, final int chunkX, final int chunkZ, final Thread thread) {
+        return this.isOwnerInternal(worldKey, chunkX, chunkZ, thread);
+    }
+
+    private boolean isOwnerInternal(final Object worldKey, final int chunkX, final int chunkZ, final Thread thread) {
+        final WorldOwnership worldOwnership = this.ownershipByWorld.get(worldKey);
+        return worldOwnership != null && worldOwnership.isOwner(chunkX, chunkZ, thread.threadId());
+    }
+
+    public boolean isOwner(
+        final ServerLevel world,
+        final int minChunkX,
+        final int minChunkZ,
+        final int maxChunkX,
+        final int maxChunkZ,
+        final Thread thread
+    ) {
+        return this.isOwnerInternal(world, minChunkX, minChunkZ, maxChunkX, maxChunkZ, thread);
+    }
+
+    protected boolean isOwnerForTesting(
+        final Object worldKey,
+        final int minChunkX,
+        final int minChunkZ,
+        final int maxChunkX,
+        final int maxChunkZ,
+        final Thread thread
+    ) {
+        return this.isOwnerInternal(worldKey, minChunkX, minChunkZ, maxChunkX, maxChunkZ, thread);
+    }
+
+    private boolean isOwnerInternal(
+        final Object worldKey,
+        final int minChunkX,
+        final int minChunkZ,
+        final int maxChunkX,
+        final int maxChunkZ,
+        final Thread thread
+    ) {
+        final WorldOwnership worldOwnership = this.ownershipByWorld.get(worldKey);
+        return worldOwnership != null && worldOwnership.isOwner(minChunkX, minChunkZ, maxChunkX, maxChunkZ, thread.threadId());
+    }
+
+    public int activeLeases(final ServerLevel world) {
+        return this.activeLeasesInternal(world);
+    }
+
+    protected int activeLeasesForTesting(final Object worldKey) {
+        return this.activeLeasesInternal(worldKey);
+    }
+
+    private int activeLeasesInternal(final Object worldKey) {
+        final WorldOwnership worldOwnership = this.ownershipByWorld.get(worldKey);
+        return worldOwnership == null ? 0 : worldOwnership.size();
+    }
+
+    public long leaseConflictCount() {
+        return this.leaseConflicts.get();
+    }
+
+    public void clearWorld(final ServerLevel world) {
+        this.clearWorldInternal(world);
+    }
+
+    protected void clearWorldForTesting(final Object worldKey) {
+        this.clearWorldInternal(worldKey);
+    }
+
+    private void clearWorldInternal(final Object worldKey) {
+        this.ownershipByWorld.remove(worldKey);
+    }
+
+    public RuntimeDiagnostics snapshotDiagnostics() {
+        final List<WorldDiagnostics> worlds = new ArrayList<>();
+        long totalActiveLeases = 0L;
+        long totalActiveRegions = 0L;
+        long totalCreatedRegions = 0L;
+        long totalSplitEvents = 0L;
+        long totalMergeEvents = 0L;
+        long totalRetiredRegions = 0L;
+        long totalReusedRegionAssignments = 0L;
+
+        for (final Map.Entry<Object, WorldOwnership> entry : this.ownershipByWorld.entrySet()) {
+            final WorldDiagnostics worldSnapshot = entry.getValue().snapshot(describeWorld(entry.getKey()));
+            worlds.add(worldSnapshot);
+            totalActiveLeases += worldSnapshot.activeLeases();
+            totalActiveRegions += worldSnapshot.activeRegions();
+            totalCreatedRegions += worldSnapshot.createdRegions();
+            totalSplitEvents += worldSnapshot.splitEvents();
+            totalMergeEvents += worldSnapshot.mergeEvents();
+            totalRetiredRegions += worldSnapshot.retiredRegions();
+            totalReusedRegionAssignments += worldSnapshot.reusedRegionAssignments();
+        }
+
+        worlds.sort(java.util.Comparator.comparing(WorldDiagnostics::worldId));
+
+        return new RuntimeDiagnostics(
+            worlds.size(),
+            totalActiveLeases,
+            totalActiveRegions,
+            totalCreatedRegions,
+            totalSplitEvents,
+            totalMergeEvents,
+            totalRetiredRegions,
+            totalReusedRegionAssignments,
+            List.copyOf(worlds)
+        );
+    }
+
+    public WorldDiagnostics snapshotWorldDiagnostics(final ServerLevel world) {
+        final WorldOwnership worldOwnership = this.ownershipByWorld.get(world);
+        return worldOwnership == null ? WorldDiagnostics.empty(describeWorld(world)) : worldOwnership.snapshot(describeWorld(world));
+    }
+
+    protected WorldDiagnostics snapshotWorldDiagnosticsForTesting(final Object worldKey) {
+        final WorldOwnership worldOwnership = this.ownershipByWorld.get(worldKey);
+        return worldOwnership == null ? WorldDiagnostics.empty(describeWorld(worldKey)) : worldOwnership.snapshot(describeWorld(worldKey));
+    }
+
+    private static String describeWorld(final Object worldKey) {
+        if (worldKey instanceof ServerLevel world) {
+            return String.valueOf(world.dimension().identifier());
+        }
+        return "testing@" + Integer.toHexString(System.identityHashCode(worldKey));
+    }
+
+    private static final class WorldOwnership {
+
+        private final java.util.concurrent.locks.ReentrantLock lock = new java.util.concurrent.locks.ReentrantLock();
+        private final Map<Long, Lease> leases = new HashMap<>();
+        private final Map<Long, RegionDescriptor> regions = new HashMap<>();
+        private final Map<Long, Integer> regionReferenceCounts = new HashMap<>();
+        private long createdRegions;
+        private long splitEvents;
+        private long mergeEvents;
+        private long retiredRegions;
+        private long reusedRegionAssignments;
+
+        private void claimLease(
+            final long leaseId,
+            final int minChunkX,
+            final int minChunkZ,
+            final int maxChunkX,
+            final int maxChunkZ,
+            final Thread ownerThread,
+            final AtomicLong conflictCounter,
+            final AtomicLong nextRegionId
+        ) {
+            this.lock.lock();
+            try {
+                final Lease conflictingLease = this.findConflictingLease(minChunkX, minChunkZ, maxChunkX, maxChunkZ, ownerThread.threadId());
+                if (conflictingLease != null) {
+                    conflictCounter.getAndIncrement();
+                    throw new IllegalStateException(
+                        "Region lease conflict: new lease [" + minChunkX + "," + minChunkZ + " -> " + maxChunkX + "," + maxChunkZ + "]"
+                            + " by thread " + ownerThread.getName() + "[" + ownerThread.threadId() + "] overlaps existing lease "
+                            + conflictingLease.describeBounds() + " by thread "
+                            + conflictingLease.ownerThreadName + "[" + conflictingLease.ownerThreadId + "]"
+                    );
+                }
+
+                final long regionId = this.resolveRegionId(minChunkX, minChunkZ, maxChunkX, maxChunkZ, nextRegionId);
+                final Lease lease = new Lease(
+                    leaseId,
+                    minChunkX,
+                    minChunkZ,
+                    maxChunkX,
+                    maxChunkZ,
+                    ownerThread.threadId(),
+                    ownerThread.getName(),
+                    regionId
+                );
+                final Lease prev = this.leases.put(lease.id, lease);
+                if (prev != null) {
+                    throw new IllegalStateException("Duplicate lease id: " + lease.id);
+                }
+                this.regionReferenceCounts.merge(regionId, 1, Integer::sum);
+
+                final RegionDescriptor regionDescriptor = this.regions.get(regionId);
+                if (regionDescriptor != null) {
+                    regionDescriptor.touch();
+                }
+            } finally {
+                this.lock.unlock();
+            }
+        }
+
+        private void removeLease(final long leaseId) {
+            this.lock.lock();
+            try {
+                final Lease removed = this.leases.remove(leaseId);
+                if (removed == null) {
+                    return;
+                }
+                final Integer refs = this.regionReferenceCounts.get(removed.regionId);
+                if (refs == null || refs <= 1) {
+                    this.regionReferenceCounts.remove(removed.regionId);
+                    if (this.regions.remove(removed.regionId) != null) {
+                        ++this.retiredRegions;
+                    }
+                } else {
+                    this.regionReferenceCounts.put(removed.regionId, refs - 1);
+                }
+            } finally {
+                this.lock.unlock();
+            }
+        }
+
+        private boolean isOwner(final int chunkX, final int chunkZ, final long threadId) {
+            this.lock.lock();
+            try {
+                for (final Lease lease : this.leases.values()) {
+                    if (lease.ownerThreadId == threadId && lease.contains(chunkX, chunkZ)) {
+                        return true;
+                    }
+                }
+            } finally {
+                this.lock.unlock();
+            }
+            return false;
+        }
+
+        private boolean isOwner(
+            final int minChunkX,
+            final int minChunkZ,
+            final int maxChunkX,
+            final int maxChunkZ,
+            final long threadId
+        ) {
+            this.lock.lock();
+            try {
+                for (final Lease lease : this.leases.values()) {
+                    if (lease.ownerThreadId == threadId
+                        && lease.contains(minChunkX, minChunkZ)
+                        && lease.contains(maxChunkX, maxChunkZ)) {
+                        return true;
+                    }
+                }
+            } finally {
+                this.lock.unlock();
+            }
+            return false;
+        }
+
+        private boolean isEmpty() {
+            this.lock.lock();
+            try {
+                return this.leases.isEmpty();
+            } finally {
+                this.lock.unlock();
+            }
+        }
+
+        private int size() {
+            this.lock.lock();
+            try {
+                return this.leases.size();
+            } finally {
+                this.lock.unlock();
+            }
+        }
+
+        private Lease findConflictingLease(
+            final int minChunkX,
+            final int minChunkZ,
+            final int maxChunkX,
+            final int maxChunkZ,
+            final long ownerThreadId
+        ) {
+            for (final Lease existing : this.leases.values()) {
+                if (existing.ownerThreadId == ownerThreadId) {
+                    continue;
+                }
+                if (existing.intersects(minChunkX, minChunkZ, maxChunkX, maxChunkZ)) {
+                    return existing;
+                }
+            }
+            return null;
+        }
+
+        private long resolveRegionId(
+            final int minChunkX,
+            final int minChunkZ,
+            final int maxChunkX,
+            final int maxChunkZ,
+            final AtomicLong nextRegionId
+        ) {
+            final Lease exact = this.findExactLease(minChunkX, minChunkZ, maxChunkX, maxChunkZ);
+            if (exact != null) {
+                return exact.regionId;
+            }
+
+            final Set<Long> overlappingRegions = new HashSet<>();
+            for (final Lease existing : this.leases.values()) {
+                if (existing.intersects(minChunkX, minChunkZ, maxChunkX, maxChunkZ)) {
+                    overlappingRegions.add(existing.regionId);
+                }
+            }
+
+            final long reusableRegionId = this.findContainingRegion(
+                overlappingRegions,
+                minChunkX,
+                minChunkZ,
+                maxChunkX,
+                maxChunkZ
+            );
+            if (reusableRegionId != Long.MIN_VALUE) {
+                ++this.reusedRegionAssignments;
+                final RegionDescriptor descriptor = this.regions.get(reusableRegionId);
+                if (descriptor != null) {
+                    descriptor.touch();
+                }
+                return reusableRegionId;
+            }
+
+            final long regionId = nextRegionId.getAndIncrement();
+            final RegionLifecycleEvent lifecycleEvent;
+            final List<Long> parentRegionIds;
+            if (overlappingRegions.isEmpty()) {
+                lifecycleEvent = RegionLifecycleEvent.CREATED;
+                parentRegionIds = List.of();
+            } else if (overlappingRegions.size() == 1) {
+                lifecycleEvent = RegionLifecycleEvent.SPLIT;
+                ++this.splitEvents;
+                parentRegionIds = List.copyOf(overlappingRegions);
+            } else {
+                lifecycleEvent = RegionLifecycleEvent.MERGE;
+                ++this.mergeEvents;
+                parentRegionIds = List.copyOf(overlappingRegions);
+            }
+
+            ++this.createdRegions;
+            this.regions.put(
+                regionId,
+                new RegionDescriptor(regionId, minChunkX, minChunkZ, maxChunkX, maxChunkZ, lifecycleEvent, parentRegionIds)
+            );
+            return regionId;
+        }
+
+        private long findContainingRegion(
+            final Set<Long> overlappingRegions,
+            final int minChunkX,
+            final int minChunkZ,
+            final int maxChunkX,
+            final int maxChunkZ
+        ) {
+            long selectedRegionId = Long.MIN_VALUE;
+            long selectedArea = Long.MAX_VALUE;
+            for (final Long regionId : overlappingRegions) {
+                final RegionDescriptor descriptor = this.regions.get(regionId);
+                if (descriptor == null || !descriptor.contains(minChunkX, minChunkZ, maxChunkX, maxChunkZ)) {
+                    continue;
+                }
+                final long area = descriptor.area();
+                if (selectedRegionId == Long.MIN_VALUE || area < selectedArea) {
+                    selectedRegionId = regionId.longValue();
+                    selectedArea = area;
+                }
+            }
+            return selectedRegionId;
+        }
+
+        private Lease findExactLease(final int minChunkX, final int minChunkZ, final int maxChunkX, final int maxChunkZ) {
+            for (final Lease lease : this.leases.values()) {
+                if (lease.matches(minChunkX, minChunkZ, maxChunkX, maxChunkZ)) {
+                    return lease;
+                }
+            }
+            return null;
+        }
+
+        private WorldDiagnostics snapshot(final String worldId) {
+            this.lock.lock();
+            try {
+                return new WorldDiagnostics(
+                    worldId,
+                    this.leases.size(),
