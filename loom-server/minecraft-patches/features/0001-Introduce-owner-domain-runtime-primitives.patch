+    private static final class WorldSchedulerState {
+
+        private final ServerLevel world;
+        private final Object lock = new Object();
+        private final Map<Long, List<RegionScheduledTask>> tasksByDeadline = new HashMap<>();
+        private final ArrayDeque<CrossRegionMessage> mailbox = new ArrayDeque<>();
+        private long tickCount;
+        private long scheduledTaskCount;
+        private long executedTaskCount;
+        private long deferredTaskCount;
+        private long cancelledTaskCount;
+        private long parallelTickCount;
+        private long schedulerBudgetSkipCount;
+        private long postedMessageCount;
+        private long deliveredMessageCount;
+        private long deferredMessageCount;
+        private long droppedMessageCount;
+        private long parallelMailboxDrainCount;
+        private long mailboxBudgetSkipCount;
+
+        private WorldSchedulerState(final ServerLevel world) {
+            this.world = world;
+        }
+
+        private void schedule(final RegionScheduledTask task, final long delayTicks) {
+            {
+                this.tasksByDeadline.computeIfAbsent(this.tickCount + delayTicks, ignored -> new ArrayList<>()).add(task);
+                ++this.scheduledTaskCount;
+            }
+            if (!task.plugin.isEnabled()) {
+                task.cancel();
+            }
+        }
+
+        private void tickScheduler() {
+            final List<RegionScheduledTask> toRun;
+            {
+                ++this.tickCount;
+                toRun = this.tasksByDeadline.remove(this.tickCount);
+            }
+            if (toRun == null || toRun.isEmpty()) {
+                return;
+            }
+
+            final List<RegionScheduledTask> budgeted = this.applySchedulerBudget(toRun);
+            if (budgeted.isEmpty()) {
+                return;
+            }
+
+            if (STRICT_RUNTIME_MODE) {
+                this.tickStrict(budgeted);
+                return;
+            }
+
+            if (this.tryTickParallel(budgeted)) {
+                return;
+            }
+
+            for (int i = 0, len = budgeted.size(); i < len; ++i) {
+                this.runScheduledTask(budgeted.get(i));
+            }
+        }
+
+        private List<RegionScheduledTask> applySchedulerBudget(final List<RegionScheduledTask> toRun) {
+            final int schedulerBudget = getAdaptiveSchedulerBudget(toRun.size());
+            if (toRun.size() <= schedulerBudget) {
+                return toRun;
+            }
+
+            SCHEDULER_BUDGET_SKIPS.getAndIncrement();
+            {
+                ++this.schedulerBudgetSkipCount;
+            }
+            recordDiagnostic(
+                DiagnosticType.SCHEDULER_BUDGET_EXHAUSTED,
+                this.world,
+                Integer.MIN_VALUE,
+                Integer.MIN_VALUE,
+                Integer.MAX_VALUE,
+                Integer.MAX_VALUE,
+                "Scheduler budget exhausted: due=" + toRun.size()
+                    + ", budget=" + schedulerBudget
+                    + ", baseBudget=" + SCHEDULER_MAX_TASKS_PER_TICK
+            );
+
+            final List<RegionScheduledTask> budgeted = new ArrayList<>(schedulerBudget);
+            for (int i = 0, len = toRun.size(); i < len; ++i) {
+                final RegionScheduledTask task = toRun.get(i);
+                if (i < schedulerBudget) {
+                    budgeted.add(task);
+                } else {
+                    this.schedule(task, 1L);
+                }
+            }
+            return budgeted;
+        }
+
+        private void tickStrict(final List<RegionScheduledTask> toRun) {
+            final List<TaskBucket> buckets = this.bucketTasks(toRun);
+            if (buckets.isEmpty()) {
+                return;
+            }
+
+            if (PARALLEL_SCHEDULER_ENABLED && buckets.size() > 1) {
+                this.recordParallelDispatch(buckets.size());
+                final List<CompletableFuture<Void>> futures = new ArrayList<>(buckets.size());
+                for (final TaskBucket bucket : buckets) {
+                    futures.add(CompletableFuture.runAsync(bucket::run, REGION_SCHEDULER_EXECUTOR));
+                }
+                CompletableFuture.allOf(futures.toArray(CompletableFuture[]::new)).join();
+                return;
+            }
+
+            for (int i = 0, len = buckets.size(); i < len; ++i) {
+                buckets.get(i).run();
+            }
+        }
+
+        private void drainMailbox() {
+            final List<CrossRegionMessage> toDeliver = this.collectMailboxBudgeted();
+            if (toDeliver.isEmpty()) {
+                return;
+            }
+
+            if (STRICT_RUNTIME_MODE) {
+                this.drainMailboxStrict(toDeliver);
+                return;
+            }
+
+            if (this.tryDrainMailboxParallel(toDeliver)) {
+                return;
+            }
+
+            for (int i = 0, len = toDeliver.size(); i < len; ++i) {
+                this.runMailboxMessage(toDeliver.get(i));
+            }
+        }
