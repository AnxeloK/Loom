+    static int computeAdaptiveDrainBudget(
+        final int available,
+        final int baseBudget,
+        final int burstBudget,
+        final int workerCount
+    ) {
+        if (baseBudget <= 0) {
+            throw new IllegalArgumentException("baseBudget must be > 0");
+        }
+        if (burstBudget < baseBudget) {
+            throw new IllegalArgumentException("burstBudget must be >= baseBudget");
+        }
+        if (available <= baseBudget || burstBudget == baseBudget) {
+            return baseBudget;
+        }
+
+        final int workers = Math.max(1, workerCount);
+        final int overload = available - baseBudget;
+        final int scaledBoost = (int)Math.ceil((double)overload / (double)workers);
+        return Math.max(baseBudget, Math.min(burstBudget, baseBudget + scaledBoost));
+    }
