+    private static final class RegionScheduledTask implements ScheduledTask {
+
+        private static final int STATE_IDLE = 0;
+        private static final int STATE_RUNNING = 1;
+        private static final int STATE_CANCELLED_RUNNING = 2;
+        private static final int STATE_FINISHED = 3;
+        private static final int STATE_CANCELLED = 4;
+        private static final VarHandle STATE_HANDLE = ConcurrentUtil.getVarHandle(RegionScheduledTask.class, "state", int.class);
+
+        private final WorldSchedulerState owner;
+        private final Plugin plugin;
+        private final int chunkX;
+        private final int chunkZ;
+        private final long repeatDelay;
+        private @Nullable Consumer<ScheduledTask> run;
+        private volatile int state = STATE_IDLE;
+
+        private RegionScheduledTask(
+            final WorldSchedulerState owner,
+            final Plugin plugin,
+            final int chunkX,
+            final int chunkZ,
+            final long repeatDelay,
+            final Consumer<ScheduledTask> run
+        ) {
+            this.owner = owner;
+            this.plugin = plugin;
+            this.chunkX = chunkX;
+            this.chunkZ = chunkZ;
+            this.repeatDelay = repeatDelay;
+            this.run = run;
+        }
+
+        private void runNow() {
+            if (this.compareAndExchangeState(STATE_IDLE, STATE_RUNNING) != STATE_IDLE) {
+                return;
+            }
+
+            final Consumer<ScheduledTask> callback = this.run;
+            if (callback == null || !this.plugin.isEnabled()) {
+                this.setState(STATE_CANCELLED);
+                this.run = null;
+                return;
+            }
+
+            try {
+                callback.accept(this);
+            } catch (final Throwable throwable) {
+                this.plugin.getLogger().log(java.util.logging.Level.WARNING, "Region task for " + this.plugin.getDescription().getFullName() + " generated an exception", throwable);
+            } finally {
+                boolean reschedule = false;
+                if (this.repeatDelay <= 0L) {
+                    this.setState(STATE_FINISHED);
+                } else if (!this.plugin.isEnabled()) {
+                    this.setState(STATE_CANCELLED);
+                } else if (this.compareAndExchangeState(STATE_RUNNING, STATE_IDLE) == STATE_RUNNING) {
+                    reschedule = true;
+                } else {
+                    this.setState(STATE_CANCELLED);
+                }
+
+                if (reschedule) {
+                    this.owner.schedule(this, this.repeatDelay);
+                } else {
+                    this.run = null;
+                }
+            }
+        }
+
+        private int getState() {
+            return (int) STATE_HANDLE.getVolatile(this);
+        }
+
+        private int compareAndExchangeState(final int expected, final int updated) {
+            return (int) STATE_HANDLE.compareAndExchange(this, expected, updated);
+        }
+
+        private void setState(final int updated) {
+            STATE_HANDLE.setVolatile(this, updated);
+        }
+
+        @Override
+        public Plugin getOwningPlugin() {
+            return this.plugin;
+        }
+
+        @Override
+        public boolean isRepeatingTask() {
+            return this.repeatDelay > 0L;
+        }
+
+        @Override
+        public CancelledState cancel() {
+            for (int current = this.getState();;) {
+                switch (current) {
+                    case STATE_IDLE -> {
+                        final int observed = this.compareAndExchangeState(STATE_IDLE, STATE_CANCELLED);
+                        if (observed != STATE_IDLE) {
+                            current = observed;
+                            continue;
+                        }
+                        this.run = null;
+                        return CancelledState.CANCELLED_BY_CALLER;
+                    }
+                    case STATE_RUNNING -> {
+                        if (this.repeatDelay <= 0L) {
+                            return CancelledState.RUNNING;
+                        }
+                        final int observed = this.compareAndExchangeState(STATE_RUNNING, STATE_CANCELLED_RUNNING);
+                        if (observed != STATE_RUNNING) {
+                            current = observed;
+                            continue;
+                        }
+                        return CancelledState.NEXT_RUNS_CANCELLED;
+                    }
+                    case STATE_CANCELLED_RUNNING -> {
+                        return CancelledState.NEXT_RUNS_CANCELLED_ALREADY;
+                    }
+                    case STATE_FINISHED -> {
+                        return CancelledState.ALREADY_EXECUTED;
+                    }
+                    case STATE_CANCELLED -> {
+                        return CancelledState.CANCELLED_ALREADY;
+                    }
+                    default -> throw new IllegalStateException("Unknown task state: " + current);
+                }
+            }
+        }
+
+        @Override
+        public ExecutionState getExecutionState() {
+            final int current = this.getState();
+            return switch (current) {
+                case STATE_IDLE -> ExecutionState.IDLE;
+                case STATE_RUNNING -> ExecutionState.RUNNING;
+                case STATE_CANCELLED_RUNNING -> ExecutionState.CANCELLED_RUNNING;
+                case STATE_FINISHED -> ExecutionState.FINISHED;
+                case STATE_CANCELLED -> ExecutionState.CANCELLED;
+                default -> throw new IllegalStateException("Unknown task state: " + current);
+            };
+        }
+    }
+
+    private static final class RegionSchedulerThreadFactory implements ThreadFactory {
+
+        private final AtomicInteger nextId = new AtomicInteger(1);
+
+        @Override
+        public Thread newThread(final Runnable runnable) {
+            final TickThread thread = new TickThread(runnable, "Region scheduler thread #" + this.nextId.getAndIncrement());
+            thread.setDaemon(true);
+            thread.setPriority(Thread.NORM_PRIORITY + 1);
+            return thread;
+        }
+    }
+
+    public enum CrossRegionMessageType {
+        ENTITY_TRANSFER,
+        BOUNDARY_BLOCK_UPDATE,
+        TICKET_DELTA,
+        PLUGIN_TASK,
+        INTERNAL
+    }
+
+    public enum DiagnosticType {
+        CONFIGURATION_WARNING,
+        OWNERSHIP_FAILURE,
+        LEASE_CLAIM_FAILURE,
+        CONTEXT_STACK_UNBALANCED,
+        SCHEDULER_BUDGET_EXHAUSTED,
+        SCHEDULER_TASK_DEFERRED,
+        MAILBOX_BUDGET_EXHAUSTED,
+        MAILBOX_QUEUE_OVERFLOW,
+        MAILBOX_MESSAGE_DEFERRED,
+        MAILBOX_MESSAGE_DROPPED,
+        PLUGIN_CONTEXT_VIOLATION
+    }
+
+    public static final record RuntimeDiagnostics(
+        boolean strictMode,
+        long ownershipChecks,
+        long ownershipFailures,
+        long leaseClaimFailures,
+        long schedulerTasksExecuted,
+        long schedulerTasksDeferred,
+        long schedulerParallelTicks,
+        long schedulerParallelBuckets,
+        long schedulerBudgetSkips,
+        long mailboxMessagesPosted,
+        long mailboxMessagesDelivered,
+        long mailboxMessagesDeferred,
+        long mailboxMessagesDropped,
+        long mailboxParallelDrains,
+        long mailboxParallelBuckets,
+        long mailboxBudgetSkips,
+        long simulationBatchTasks,
+        long simulationBatchOperations,
+        long simulationSerialFallbacks,
+        long simulationSerialOperations,
+        Map<CrossRegionMessageType, MailboxTypeDiagnostics> mailboxTypeDiagnostics,
+        RegionRuntime.RuntimeDiagnostics regionRuntime,
+        List<WorldSchedulerDiagnostics> schedulerWorlds,
+        List<DiagnosticEvent> recentEvents
+    ) {
+    }
+
+    public static final record MailboxTypeDiagnostics(
+        long posted,
+        long delivered,
+        long deferred,
+        long dropped
+    ) {
+    }
+
+    public static final record WorldSchedulerDiagnostics(
+        String worldId,
+        long tickCount,
+        long queuedTasks,
+        long scheduledTasks,
+        long executedTasks,
+        long deferredTasks,
+        long cancelledTasks,
+        long parallelTicks,
+        long schedulerBudgetSkips,
+        long queuedMailboxMessages,
+        long postedMailboxMessages,
+        long deliveredMailboxMessages,
+        long deferredMailboxMessages,
+        long droppedMailboxMessages,
+        long parallelMailboxDrains,
+        long mailboxBudgetSkips
+    ) {
+    }
+
+    public static final record DiagnosticEvent(
+        long sequence,
+        long nanoTime,
+        String threadName,
+        long threadId,
+        DiagnosticType type,
+        String worldId,
+        int minChunkX,
+        int minChunkZ,
+        int maxChunkX,
+        int maxChunkZ,
+        String detail
+    ) {
+    }
+
+    public static final record RegionBoundTask(
+        int chunkX,
+        int chunkZ,
+        int minChunkX,
+        int minChunkZ,
+        int maxChunkX,
+        int maxChunkZ,
+        Runnable task
+    ) {
+        public RegionBoundTask(final int chunkX, final int chunkZ, final Runnable task) {
+            this(chunkX, chunkZ, chunkX, chunkZ, chunkX, chunkZ, task);
+        }
+
+        public RegionBoundTask {
+            Objects.requireNonNull(task, "Task may not be null");
+            if (maxChunkX < minChunkX || maxChunkZ < minChunkZ) {
+                throw new IllegalArgumentException(
+                    "Invalid region bounds for task: ["
+                        + minChunkX + "," + minChunkZ + " -> " + maxChunkX + "," + maxChunkZ + "]"
+                );
+            }
+            if (chunkX < minChunkX || chunkX > maxChunkX || chunkZ < minChunkZ || chunkZ > maxChunkZ) {
+                throw new IllegalArgumentException(
+                    "Dispatch chunk (" + chunkX + "," + chunkZ + ") is outside task bounds ["
+                        + minChunkX + "," + minChunkZ + " -> " + maxChunkX + "," + maxChunkZ + "]"
+                );
+            }
+        }
+    }
+
+    public static final record RegionContext(
+        ServerLevel world,
+        int minChunkX,
+        int minChunkZ,
+        int maxChunkX,
+        int maxChunkZ,
+        @Nullable RegionContext previous,
+        long leaseId,
+        long ownerThreadId
+    ) {
+
+        public boolean contains(final int chunkX, final int chunkZ) {
+            return chunkX >= this.minChunkX && chunkX <= this.maxChunkX
+                && chunkZ >= this.minChunkZ && chunkZ <= this.maxChunkZ;
+        }
+    }
+
+    private static final class RegionBoundBucket {
+
+        private final ServerLevel world;
+        private final List<RegionBoundTask> tasks = new ArrayList<>();
+        private int minChunkX = Integer.MAX_VALUE;
+        private int minChunkZ = Integer.MAX_VALUE;
+        private int maxChunkX = Integer.MIN_VALUE;
+        private int maxChunkZ = Integer.MIN_VALUE;
+
+        private RegionBoundBucket(final ServerLevel world) {
+            this.world = world;
+        }
+
+        private void add(final RegionBoundTask task) {
+            this.tasks.add(task);
+            this.minChunkX = Math.min(this.minChunkX, task.minChunkX());
+            this.minChunkZ = Math.min(this.minChunkZ, task.minChunkZ());
+            this.maxChunkX = Math.max(this.maxChunkX, task.maxChunkX());
+            this.maxChunkZ = Math.max(this.maxChunkZ, task.maxChunkZ());
+        }
+
+        private boolean intersects(final RegionBoundTask task) {
+            return this.minChunkX <= task.maxChunkX()
+                && this.maxChunkX >= task.minChunkX()
+                && this.minChunkZ <= task.maxChunkZ()
+                && this.maxChunkZ >= task.minChunkZ();
+        }
+
+        private boolean intersects(final RegionBoundBucket other) {
+            return this.minChunkX <= other.maxChunkX
+                && this.maxChunkX >= other.minChunkX
+                && this.minChunkZ <= other.maxChunkZ
+                && this.maxChunkZ >= other.minChunkZ;
+        }
+
+        private void absorb(final RegionBoundBucket other) {
+            this.tasks.addAll(other.tasks);
+            this.minChunkX = Math.min(this.minChunkX, other.minChunkX);
+            this.minChunkZ = Math.min(this.minChunkZ, other.minChunkZ);
+            this.maxChunkX = Math.max(this.maxChunkX, other.maxChunkX);
+            this.maxChunkZ = Math.max(this.maxChunkZ, other.maxChunkZ);
+        }
+
+        private int minChunkX() {
+            return this.minChunkX;
+        }
+
+        private int minChunkZ() {
+            return this.minChunkZ;
+        }
+
+        private int maxChunkX() {
+            return this.maxChunkX;
+        }
+
+        private int maxChunkZ() {
+            return this.maxChunkZ;
+        }
+
+        private void run(final String stageName) {
+            final RegionContext context;
+            try {
+                context = pushRegionContext(this.world, this.minChunkX, this.minChunkZ, this.maxChunkX, this.maxChunkZ);
+            } catch (final IllegalStateException ex) {
+                throw new IllegalStateException(
+                    "Failed to claim region context for stage '" + stageName + "' in world "
+                        + this.world.dimension().identifier() + " bounds ["
+                        + this.minChunkX + "," + this.minChunkZ + " -> " + this.maxChunkX + "," + this.maxChunkZ + "]",
+                    ex
+                );
+            }
+            try {
+                for (int i = 0, len = this.tasks.size(); i < len; ++i) {
+                    this.tasks.get(i).task().run();
+                }
+            } finally {
+                popContext(context);
+            }
+        }
+    }
+
+    private static final record ContextLeaseBounds(
+        int minChunkX,
+        int minChunkZ,
+        int maxChunkX,
+        int maxChunkZ
+    ) {
+    }
+}
