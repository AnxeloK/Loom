+        private void recordParallelDispatch(final int bucketCount) {
+            SCHEDULER_PARALLEL_TICKS.getAndIncrement();
+            SCHEDULER_PARALLEL_BUCKETS.getAndAdd(bucketCount);
+            {
+                ++this.parallelTickCount;
+            }
+        }
+
+        private void recordParallelMailboxDrain(final int bucketCount) {
+            MAILBOX_PARALLEL_DRAINS.getAndIncrement();
+            MAILBOX_PARALLEL_BUCKETS.getAndAdd(bucketCount);
+            {
+                ++this.parallelMailboxDrainCount;
+            }
+        }
+
+        private void enqueueMailbox(final CrossRegionMessage message) {
+            {
+                this.enqueueMailboxInternal(message, true);
+            }
+        }
+
+        private void enqueueMailboxInternal(final CrossRegionMessage message, final boolean countAsPosted) {
+            if (this.mailbox.size() >= MAILBOX_MAX_QUEUED_MESSAGES) {
+                final CrossRegionMessage dropped = this.mailbox.pollFirst();
+                ++this.droppedMessageCount;
+                MAILBOX_MESSAGES_DROPPED.getAndIncrement();
+                if (dropped != null) {
+                    incrementTypeCounter(MAILBOX_DROPPED_BY_TYPE, dropped.messageType());
+                }
+                recordDiagnostic(
+                    DiagnosticType.MAILBOX_QUEUE_OVERFLOW,
+                    this.world,
+                    message.targetChunkX(),
+                    message.targetChunkZ(),
+                    message.targetChunkX(),
+                    message.targetChunkZ(),
+                    "Mailbox queue overflow, dropping oldest message"
+                );
+            }
+            this.mailbox.addLast(message);
+            if (countAsPosted) {
+                ++this.postedMessageCount;
+                MAILBOX_MESSAGES_POSTED.getAndIncrement();
+                incrementTypeCounter(MAILBOX_POSTED_BY_TYPE, message.messageType());
+            }
+        }
+
+        private void runScheduledTask(final RegionScheduledTask task) {
+            if (isCurrentThreadOwnerNoFailure(this.world, task.chunkX, task.chunkZ)) {
+                SCHEDULER_TASKS_EXECUTED.getAndIncrement();
+                {
+                    ++this.executedTaskCount;
+                }
+                task.runNow();
+                return;
+            }
+
+            this.deferTask(task, "No owner context available for scheduled task");
+        }
+
+        private void runMailboxMessage(final CrossRegionMessage message) {
+            final Plugin plugin = message.plugin();
+            if (plugin != null && !plugin.isEnabled()) {
+                this.dropMailboxMessage(message, "Owning plugin is disabled");
+                return;
+            }
+            if (isCurrentThreadOwnerNoFailure(this.world, message.targetChunkX(), message.targetChunkZ())) {
+                this.deliverMailboxMessage(message);
+                return;
+            }
+
+            this.deferMailboxMessage(message, "No owner context available for mailbox message");
+        }
+
+        private void deliverMailboxMessage(final CrossRegionMessage message) {
+            try {
+                message.action().run();
+            } catch (final Throwable throwable) {
+                final Plugin plugin = message.plugin();
+                if (plugin != null) {
+                    plugin.getLogger().log(
+                        java.util.logging.Level.WARNING,
+                        "Cross-region mailbox message '" + message.describeType() + "' generated an exception",
+                        throwable
+                    );
+                } else {
+                    recordDiagnostic(
+                        DiagnosticType.MAILBOX_MESSAGE_DROPPED,
+                        this.world,
+                        message.targetChunkX(),
+                        message.targetChunkZ(),
+                        message.targetChunkX(),
+                        message.targetChunkZ(),
+                        "Internal mailbox message threw exception: " + throwable
+                    );
+                }
+            } finally {
+                MAILBOX_MESSAGES_DELIVERED.getAndIncrement();
+                incrementTypeCounter(MAILBOX_DELIVERED_BY_TYPE, message.messageType());
+                {
+                    ++this.deliveredMessageCount;
+                }
+            }
+        }
+
+        private void deferMailboxMessage(final CrossRegionMessage message, final String detail) {
+            MAILBOX_MESSAGES_DEFERRED.getAndIncrement();
+            incrementTypeCounter(MAILBOX_DEFERRED_BY_TYPE, message.messageType());
+            {
+                ++this.deferredMessageCount;
+                this.enqueueMailboxInternal(message, false);
+            }
+            recordDiagnostic(
+                DiagnosticType.MAILBOX_MESSAGE_DEFERRED,
+                this.world,
+                message.targetChunkX(),
+                message.targetChunkZ(),
+                message.targetChunkX(),
+                message.targetChunkZ(),
+                detail + ", type=" + message.describeType()
+            );
+        }
+
+        private void dropMailboxMessage(final CrossRegionMessage message, final String detail) {
+            MAILBOX_MESSAGES_DROPPED.getAndIncrement();
+            incrementTypeCounter(MAILBOX_DROPPED_BY_TYPE, message.messageType());
+            {
+                ++this.droppedMessageCount;
+            }
+            recordDiagnostic(
+                DiagnosticType.MAILBOX_MESSAGE_DROPPED,
+                this.world,
+                message.targetChunkX(),
+                message.targetChunkZ(),
+                message.targetChunkX(),
+                message.targetChunkZ(),
+                detail + ", type=" + message.describeType()
+            );
+        }
+
+        private void deferTask(final RegionScheduledTask task, final String detail) {
+            SCHEDULER_TASKS_DEFERRED.getAndIncrement();
+            {
+                ++this.deferredTaskCount;
+            }
+            recordDiagnostic(
+                DiagnosticType.SCHEDULER_TASK_DEFERRED,
+                this.world,
+                task.chunkX,
+                task.chunkZ,
+                task.chunkX,
+                task.chunkZ,
+                detail
