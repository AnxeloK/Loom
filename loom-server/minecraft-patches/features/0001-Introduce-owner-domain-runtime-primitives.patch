+    private static boolean isEquivalentContextStack(RegionContext current, RegionContext expected) {
+        while (current != null && expected != null) {
+            if (current.world() != expected.world()
+                || current.minChunkX() != expected.minChunkX()
+                || current.minChunkZ() != expected.minChunkZ()
+                || current.maxChunkX() != expected.maxChunkX()
+                || current.maxChunkZ() != expected.maxChunkZ()
+                || current.ownerThreadId() != expected.ownerThreadId()) {
+                return false;
+            }
+            current = current.previous();
+            expected = expected.previous();
+        }
