+        private List<TaskBucket> bucketTasks(final List<RegionScheduledTask> toRun) {
+            final Map<Long, TaskBucket> bucketMap = new HashMap<>();
+            for (int i = 0, len = toRun.size(); i < len; ++i) {
+                final RegionScheduledTask task = toRun.get(i);
+                final long bucketKey = regionBucketKey(task.chunkX, task.chunkZ);
+                bucketMap.computeIfAbsent(bucketKey, ignored -> new TaskBucket(this.world)).add(task);
+            }
+
+            final List<Map.Entry<Long, TaskBucket>> entries = new ArrayList<>(bucketMap.entrySet());
+            entries.sort(Map.Entry.comparingByKey());
+
+            final List<TaskBucket> buckets = new ArrayList<>(entries.size());
+            for (int i = 0, len = entries.size(); i < len; ++i) {
+                buckets.add(entries.get(i).getValue());
+            }
+            return buckets;
+        }
+
+        private List<MessageBucket> bucketMessages(final List<CrossRegionMessage> messages) {
+            final Map<Long, MessageBucket> bucketMap = new HashMap<>();
+            for (int i = 0, len = messages.size(); i < len; ++i) {
+                final CrossRegionMessage message = messages.get(i);
+                final long bucketKey = regionBucketKey(message.targetChunkX(), message.targetChunkZ());
+                bucketMap.computeIfAbsent(bucketKey, ignored -> new MessageBucket(this.world)).add(message);
+            }
+
+            final List<Map.Entry<Long, MessageBucket>> entries = new ArrayList<>(bucketMap.entrySet());
+            entries.sort(Map.Entry.comparingByKey());
+
+            final List<MessageBucket> buckets = new ArrayList<>(entries.size());
+            for (int i = 0, len = entries.size(); i < len; ++i) {
+                buckets.add(entries.get(i).getValue());
+            }
+            return buckets;
+        }
