From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: anxelok <anxelok@localhost>
Date: Wed, 10 Jun 2026 21:08:00 +0000
Subject: [PATCH] Reduce AsyncCatcher owner-check allocation


diff --git a/net/minecraft/server/threading/runtime/OwnerDomainExecutor.java b/net/minecraft/server/threading/runtime/OwnerDomainExecutor.java
index d19434e74fb49f0cd21ff25553adaa27df7a40f4..846fa4072955da6853a1f9bb3711e7824b8ce4f8 100644
--- a/net/minecraft/server/threading/runtime/OwnerDomainExecutor.java
+++ b/net/minecraft/server/threading/runtime/OwnerDomainExecutor.java
@@ -183,7 +183,60 @@ public final class OwnerDomainExecutor {
     }
 
     public static boolean isGlobalOwner(final MinecraftServer server) {
-        return isOwner(global(server, "global-owner-check"));
+        for (OwnerContext context = CURRENT_OWNER.get(); context != null; context = context.previous()) {
+            final Owner owner = context.owner();
+            if (owner.domain() == Domain.GLOBAL_CONTROL && owner.server() == server) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    public static boolean isRegionOwner(final ServerLevel level, final int chunkX, final int chunkZ) {
+        for (OwnerContext context = CURRENT_OWNER.get(); context != null; context = context.previous()) {
+            final Owner owner = context.owner();
+            if (owner.domain() == Domain.REGION
+                && owner.level() == level
+                && chunkX >= owner.minChunkX()
+                && chunkX <= owner.maxChunkX()
+                && chunkZ >= owner.minChunkZ()
+                && chunkZ <= owner.maxChunkZ()) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    public static boolean isCurrentRegionOwnerForLevel(final ServerLevel level) {
+        final Owner owner = currentOwner();
+        return owner != null && owner.domain() == Domain.REGION && owner.level() == level;
+    }
+
+    public static boolean isEntityOwner(final Entity entity) {
+        Objects.requireNonNull(entity, "entity");
+        if (entity instanceof ServerPlayer player) {
+            return isPlayerOwner(player);
+        }
+
+        final Level level = entity.level();
+        if (level instanceof ServerLevel serverLevel) {
+            final net.minecraft.world.level.ChunkPos chunk = entity.chunkPosition();
+            return isRegionOwner(serverLevel, chunk.x(), chunk.z());
+        }
+
+        final MinecraftServer server = MinecraftServer.getServer();
+        return server != null && isGlobalOwner(server);
+    }
+
+    public static boolean isPlayerOwner(final ServerPlayer player) {
+        final UUID playerId = player.getUUID();
+        for (OwnerContext context = CURRENT_OWNER.get(); context != null; context = context.previous()) {
+            final Owner owner = context.owner();
+            if (owner.domain() == Domain.PLAYER && Objects.equals(owner.playerId(), playerId)) {
+                return true;
+            }
+        }
+        return false;
     }
 
     public static void assertOwner(final Owner owner, final String operation) {
