+                    if (event instanceof org.bukkit.event.block.BlockFromToEvent fromTo) {
+                        block = fromTo.getToBlock();
+                    } else if (event instanceof org.bukkit.event.block.BlockEvent blockEvent) {
+                        block = blockEvent.getBlock();
+                    }
+                    if (block != null) {
+                        vetoed.add(BlockPos.asLong(block.getX(), block.getY(), block.getZ()));
+                    }
+                }
+            }
+        }
+        int vetoedWrites = 0;
+        for (int b = 0; b < blen; ++b) {
+            final List<StagedWrite> writes = buffers.get(b).writes;
+            for (int i = 0, len = writes.size(); i < len; ++i) {
+                final StagedWrite w = writes.get(i);
+                if (vetoed.isEmpty() || !vetoed.contains(w.pos().asLong())) {
+                    applyStagedWrite(w);
+                } else {
+                    vetoedWrites++;
+                }
+            }
+        }
+        if (VETO_DEBUG && vetoedWrites > 0) {
+            LOGGER.info("Loom parallel veto: skipped {} staged writes from cancelled events this phase", vetoedWrites);
+        }
+        for (int b = 0; b < blen; ++b) {
+            final List<StagedTick> ticks = buffers.get(b).ticks;
+            for (int i = 0, len = ticks.size(); i < len; ++i) {
+                final StagedTick t = ticks.get(i);
+                t.ticks().schedule(t.tick());
+            }
+        }
+        // (4) MOVES — strictly BEFORE removes. moveEntity() reads the entity's CURRENT section coords (the
+        // ones recorded when the entity entered its section this tick); applying a remove first would unmap
+        // the entity and corrupt a later move of the same/related entity. We replay one applyMove() per
+        // coalesced entity, in this buffer's first-seen order, then across buffers in buffer-discovery order.
+        // MOVE guard: skip if the entity has already been removed (a remove staged later in the same tick that
+        // applyAndClear has not reached yet cannot have run, but an entity removed inline earlier — e.g. during
+        // a not-staged path — would be stale; the guard is belt-and-suspenders and matches the design).
+        for (int b = 0; b < blen; ++b) {
+            for (final EntityLookup.EntityCallback callback : buffers.get(b).moves.keySet()) {
+                if (callback.isStale()) {
+                    continue;
+                }
+                callback.applyMove();
+            }
+        }
+        // (5) REMOVES — after moves, before spawns. REMOVE DE-DUP GUARD: an entity can be discarded twice in a
+        // single tick (checkDespawn followed by guardEntityTick's removal path), staging two removes for the
+        // same entity. applyRemove() unmaps the entity from entityById; isStale() then reports it as gone, so
+        // the redundant second remove is skipped — no double-remove.
+        for (int b = 0; b < blen; ++b) {
+            final List<StagedRemove> removes = buffers.get(b).removes;
+            for (int i = 0, len = removes.size(); i < len; ++i) {
+                final StagedRemove r = removes.get(i);
+                if (r.callback().isStale()) {
+                    continue;
+                }
+                r.callback().applyRemove(r.reason());
+            }
+        }
+        // (6) spawns — last, so a freshly added entity is never observed mid-replay while moves/removes of the
+        // pre-existing population are still settling.
+        for (int b = 0; b < blen; ++b) {
+            final List<StagedSpawn> spawns = buffers.get(b).spawns;
+            for (int i = 0, len = spawns.size(); i < len; ++i) {
+                final StagedSpawn s = spawns.get(i);
+                s.level().addFreshEntity(s.entity(), s.reason());
+            }
+        }
+    }
+
+    // Replay one staged block write on the thread that owns the target chunk's region. The calling thread
+    // holds the owning world's full-level lease, so for a write into this world it already owns the target
+    // region and takes the inline fast path. The cross-region routing is a defensive fallback: if a write's
+    // target chunk is somehow not owned by the calling thread (e.g. a cross-region edge write into a region
+    // this thread does not currently lease), hand it to the owning region's mailbox so the mutation lands on
+    // the lease-holder instead of tripping the AsyncCatcher owner-domain guard.
+    private static void applyStagedWrite(final StagedWrite w) {
+        final Level level = w.level();
+        final int chunkX = SectionPos.blockToSectionCoord(w.pos().getX());
+        final int chunkZ = SectionPos.blockToSectionCoord(w.pos().getZ());
+        if (!(level instanceof ServerLevel serverLevel)
+            || net.minecraft.server.threading.runtime.OwnerDomainExecutor.isRegionOwner(serverLevel, chunkX, chunkZ)) {
+            // Inline fast path: thread already owns the target region (the common case during replay), or the
+            // level is not a ServerLevel and has no region domain to route through.
+            level.setBlock(w.pos(), w.state(), w.flags(), w.updateLimit());
+            return;
+        }
+        net.minecraft.server.threading.runtime.OwnerDomainExecutor.execute(
+            net.minecraft.server.threading.runtime.OwnerDomainExecutor.region(serverLevel, chunkX, chunkZ, "staged-setBlock"),
+            () -> serverLevel.setBlock(w.pos(), w.state(), w.flags(), w.updateLimit()));
+    }
+}
