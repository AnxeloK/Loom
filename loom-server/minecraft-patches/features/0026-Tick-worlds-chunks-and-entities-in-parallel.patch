+        // Loom start - intra-world parallel chunk ticking: dispatch per-region tasks when there is more than
+        // one ticking chunk; a single chunk stays on the serial fast path below.
+        if (size > 1) {
+            // Group the entity-ticking chunks by region and dispatch ONE task per region (each ticking all of
+            // its chunks under a single staging buffer), instead of one task per chunk. This keeps the per-tick
+            // dispatch/staging overhead proportional to the (small) number of regions, not the chunk count.
+            final int shift = net.minecraft.server.threading.TickRegions.getRegionChunkShift();
+            final it.unimi.dsi.fastutil.longs.Long2ObjectMap<java.util.List<net.minecraft.world.level.chunk.LevelChunk>> byRegion =
+                new it.unimi.dsi.fastutil.longs.Long2ObjectOpenHashMap<>();
+            for (int i = 0; i < size; ++i) {
+                final net.minecraft.world.level.chunk.LevelChunk chunk = raw[i];
+                final net.minecraft.world.level.ChunkPos pos = chunk.getPos();
+                final long key = (((long) (pos.x() >> shift)) << 32) | ((pos.z() >> shift) & 0xFFFFFFFFL);
+                byRegion.computeIfAbsent(key, k -> new java.util.ArrayList<>()).add(chunk);
+            }
+            // One staging session per dispatch: workers register their buffers into THIS session only, so the
+            // serial replay below drains only this world's buffers — never another world ticking in parallel.
+            final net.minecraft.server.threading.RegionTickStaging.Session stagingSession =
+                net.minecraft.server.threading.RegionTickStaging.newSession();
+            final java.util.List<net.minecraft.server.threading.TickRegions.RegionBoundTask> tasks = new java.util.ArrayList<>(byRegion.size());
+            for (final java.util.List<net.minecraft.world.level.chunk.LevelChunk> regionChunks : byRegion.values()) {
+                int minX = Integer.MAX_VALUE, minZ = Integer.MAX_VALUE, maxX = Integer.MIN_VALUE, maxZ = Integer.MIN_VALUE;
+                for (int j = 0, n = regionChunks.size(); j < n; ++j) {
+                    final net.minecraft.world.level.ChunkPos p = regionChunks.get(j).getPos();
+                    if (p.x() < minX) { minX = p.x(); }
+                    if (p.x() > maxX) { maxX = p.x(); }
+                    if (p.z() < minZ) { minZ = p.z(); }
+                    if (p.z() > maxZ) { maxZ = p.z(); }
+                }
+                final int fMinX = minX, fMinZ = minZ, fMaxX = maxX, fMaxZ = maxZ;
+                tasks.add(new net.minecraft.server.threading.TickRegions.RegionBoundTask(fMinX, fMinZ, fMinX, fMinZ, fMaxX, fMaxZ, () -> {
+                    // Buffer this region's side effects on the worker; they are replayed serially below.
+                    net.minecraft.server.threading.RegionTickStaging.begin(stagingSession);
+                    try {
