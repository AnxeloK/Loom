+// Loom - per-region tick staging for parallel chunk ticking (Stage 3).
+//
+// During the parallel chunk-tick phase, region workers run on separate threads. If they applied side
+// effects directly they would write into chunks outside their region's lease and race on shared per-world
+// state (the scheduled-tick scheduler, neighbour updater, broadcast set, etc.). Instead, each worker
+// BUFFERS its side effects per-thread; after the parallel phase joins, the buffers are replayed serially
+// on the owning thread, reusing the normal single-threaded machinery unchanged.
+//
+// Block writes are buffered (which also defers the neighbour updates, broadcasts and navigation recompute
+// they trigger). Scheduled (block/fluid) ticks are buffered and re-scheduled serially. Reads during the
+// parallel phase therefore see pre-mutation state; for random ticks this is an acceptable, non-corrupting
+// behavioural divergence, because every actual mutation happens serially.
+//
+// Buffers are owned by a per-dispatch {@link Session}, NOT a process-global set. Each dispatch site (one
+// world's parallel chunk-tick or entity-tick phase) creates its own Session, threads it into the worker
+// closures (which register their buffer into that Session), and drains ONLY that Session in applyAndClear.
+// This is what lets two worlds tick in parallel safely: world A's applyAndClear can never see — and never
+// replays — world B's staged writes, even though their workers run concurrently.
+public final class RegionTickStaging {
+
+    private RegionTickStaging() {
+    }
+
+    private record StagedWrite(Level level, BlockPos pos, BlockState state, int flags, int updateLimit) {
+    }
+
+    @SuppressWarnings("rawtypes")
+    private record StagedTick(LevelTicks ticks, ScheduledTick tick) {
+    }
+
+    private record StagedSpawn(ServerLevel level, Entity entity, org.bukkit.event.entity.CreatureSpawnEvent.SpawnReason reason) {
+    }
+
+    // A deferred entity removal. Stores the Moonrise EntityLookup$EntityCallback (which carries the entity and
+    // the back-reference to its owning lookup) and the RemovalReason, so the replay re-invokes the original
+    // onRemove logic verbatim on the owning thread.
+    private record StagedRemove(EntityLookup.EntityCallback callback, Entity.RemovalReason reason) {
+    }
+
+    private static final class Buffer {
+        final List<StagedWrite> writes = new ArrayList<>();
+        final List<StagedTick> ticks = new ArrayList<>();
+        final List<StagedSpawn> spawns = new ArrayList<>();
+        final List<org.bukkit.event.Event> events = new ArrayList<>();
+        // Deferred entity moves, COALESCED per entity: an entity may setPos() many times in one tick, but a
+        // single applyMove() at replay reads its current (final) position and re-sections it once. The map is
+        // keyed by the EntityCallback instance (one per live entity, reference identity — Entity.equals is
+        // id-based, so the callback, not the entity, is the identity key) and is a LinkedHashMap to preserve
+        // first-seen insertion order across distinct entities within this buffer (the order in which a
+        // vehicle and its passengers were ticked on this one worker thread).
+        final LinkedHashMap<EntityLookup.EntityCallback, EntityLookup.EntityCallback> moves = new LinkedHashMap<>();
+        // Deferred entity removals, kept in insertion order. An entity may be discarded more than once in a
+        // tick (checkDespawn + guardEntityTick), so duplicates can appear here; applyAndClear's de-dup guard
+        // skips the redundant ones.
+        final List<StagedRemove> removes = new ArrayList<>();
+    }
+
+    // A single parallel dispatch's staging scope. Owns the set of per-worker buffers produced during that
+    // dispatch and nothing else; drained exactly once by the owning thread in applyAndClear.
+    public static final class Session {
+        private final Set<Buffer> active = ConcurrentHashMap.newKeySet();
+
+        private Session() {
+        }
+    }
+
+    private static final org.slf4j.Logger LOGGER = org.slf4j.LoggerFactory.getLogger("Loom/RegionTickStaging");
+    private static final boolean VETO_DEBUG = Boolean.getBoolean("loom.debugVeto");
+
+    // Points to the buffer for whatever staged task the current worker thread is presently running. A worker
+    // only runs one task (hence one Session's buffer) at a time, so this stays correct even when several
+    // Sessions are alive across different worlds at once.
+    private static final ThreadLocal<Buffer> CURRENT = new ThreadLocal<>();
+
+    // Set true while a previously-deferred event is being re-dispatched on the owner thread (see
+    // deferEventToOwner). The re-dispatch must run the listeners INLINE — never defer again — or it would
+    // loop forever. The owner-domain re-entry restores a REGION owner context, so without this guard
+    // deferEventToOwner could wrongly re-classify the replay as "off-owner" and re-enqueue it.
+    private static final ThreadLocal<Boolean> REPLAYING_DEFERRED_EVENT = ThreadLocal.withInitial(() -> Boolean.FALSE);
+
+    private static final boolean DEFER_DEBUG = Boolean.getBoolean("loom.debugDefer");
+    private static final java.util.concurrent.atomic.AtomicLong DEFERRED_EVENTS = new java.util.concurrent.atomic.AtomicLong();
+
+    public static Session newSession() {
+        return new Session();
+    }
+
+    public static boolean isStaging() {
+        return CURRENT.get() != null;
+    }
+
+    // Begin staging on the current worker thread for the given dispatch session (idempotent within a thread).
+    public static void begin(final Session session) {
+        if (CURRENT.get() == null) {
+            final Buffer buffer = new Buffer();
+            CURRENT.set(buffer);
+            session.active.add(buffer);
+        }
+    }
+
+    // Stop intercepting on the current worker thread; the buffer stays registered in its Session for the
+    // serial replay.
+    public static void end() {
+        CURRENT.remove();
+    }
+
+    // Returns true if buffered; false if not staging (caller applies normally).
+    public static boolean stageSetBlock(final Level level, final BlockPos pos, final BlockState state, final int flags, final int updateLimit) {
+        final Buffer buffer = CURRENT.get();
+        if (buffer == null) {
+            return false;
+        }
+        buffer.writes.add(new StagedWrite(level, pos.immutable(), state, flags, updateLimit));
+        return true;
+    }
+
+    @SuppressWarnings("rawtypes")
+    public static boolean stageScheduledTick(final LevelTicks ticks, final ScheduledTick tick) {
+        final Buffer buffer = CURRENT.get();
+        if (buffer == null) {
+            return false;
+        }
+        buffer.ticks.add(new StagedTick(ticks, tick));
+        return true;
+    }
+
+    // Buffer an entity spawn so it is added (and tracked) serially, never half-linked off-thread.
+    public static boolean stageSpawn(final ServerLevel level, final Entity entity, final org.bukkit.event.entity.CreatureSpawnEvent.SpawnReason reason) {
+        final Buffer buffer = CURRENT.get();
+        if (buffer == null) {
+            return false;
+        }
+        buffer.spawns.add(new StagedSpawn(level, entity, reason));
+        return true;
+    }
+
+    // Buffer an entity move (cross-section / cross-region re-sectioning) so the shared per-world entity
+    // tracking tables are mutated serially on the owning thread, never off-main on a region worker. Coalesced
+    // per entity: re-registering the same callback keeps only the first insertion slot, because a single
+    // applyMove() reads the entity's current position at replay time and re-sections it once regardless of how
+    // many setPos() calls happened this tick. Returns false (caller runs onMove inline) when not staging.
+    public static boolean stageEntityMove(final EntityLookup.EntityCallback callback, final Entity entity) {
+        final Buffer buffer = CURRENT.get();
+        if (buffer == null) {
+            return false;
+        }
+        buffer.moves.putIfAbsent(callback, callback);
+        return true;
+    }
+
+    // Buffer an entity removal (despawn/death) so it is unmapped from the shared per-world tracking tables
+    // serially on the owning thread. Removals are kept ordered (and may legitimately duplicate within a tick;
+    // applyAndClear de-dups them). Returns false (caller runs onRemove inline) when not staging.
+    public static boolean stageEntityRemove(final EntityLookup.EntityCallback callback, final Entity entity, final Entity.RemovalReason reason) {
+        final Buffer buffer = CURRENT.get();
+        if (buffer == null) {
+            return false;
+        }
+        buffer.removes.add(new StagedRemove(callback, reason));
+        return true;
+    }
+
+    // Buffer a Bukkit event fired during the parallel phase so its plugin listeners are dispatched on the
+    // owning (main) thread during the serial replay — exactly where serial ticking fires them — instead of
+    // running plugin handlers on a region worker thread. This keeps legacy (main-thread-only) plugins safe
+    // with the parallel flags on. Returns false (caller fires normally) when not staging.
+    public static boolean stageEvent(final org.bukkit.event.Event event) {
+        final Buffer buffer = CURRENT.get();
+        if (buffer == null) {
+            return false;
+        }
+        buffer.events.add(event);
+        return true;
+    }
+
+    // Fix 1c — route a non-async event fired on a genuinely OFF-OWNER region worker thread (but OUTSIDE any
+    // staging window, so stageEvent did not catch it) back to the owning thread, where its plugin listeners
+    // run single-threaded exactly as under serial ticking. Chunk-system events such as ChunkLoadEvent /
+    // ChunkUnloadEvent fire on region workers in the chunk pipeline, not inside the random-tick/entity-tick
+    // begin/end window, so CURRENT is null and they would otherwise run inline on a worker thread (and the
+    // legacy compat layer then refuses them on apartment contention). We hand the whole event off to the
+    // current region's mailbox via OwnerDomainExecutor.execute — a FIRE-AND-FORGET enqueue, drained by the
+    // owner in postWorldTick(world).drainMailbox() once the parallel phase joins. It must be fire-and-forget:
+    // the owner is hard-blocked in futures.join() during the parallel phase, so a synchronous round-trip
+    // would deadlock.
+    //
+    // Returns true if the event was deferred (caller must return without dispatching inline); false if the
+    // caller should dispatch the event inline on the current thread (the serial / on-owner / replay case).
+    //
+    // Conditions to defer (ALL must hold):
+    //   - we are NOT already replaying a previously-deferred event (else infinite loop),
+    //   - the current thread is inside a REGION owner context whose world is a real ServerLevel, AND
+    //   - the current thread does NOT already own (hold the lease for) the full extent of that world's
+    //     tick — i.e. it is a sub-region worker running in the parallel phase, not the owning thread that
+    //     suspended its full-level lease to dispatch the workers.
+    // On the owning/main thread under serial ticking the current owner is GLOBAL_CONTROL or the full-level
+    // REGION owner, so this returns false and dispatch stays byte-identical to today.
+    public static boolean deferEventToOwner(final org.bukkit.event.Event event) {
+        if (REPLAYING_DEFERRED_EVENT.get()) {
+            return false;
+        }
+        // Do NOT defer the STAGED-VETO class — events whose cancellation must SYNCHRONOUSLY suppress a side
+        // effect at the firing site (block physics, fluid spread, pre-spawn, block change by an entity).
+        // Deferring them would run the plugin's veto AFTER the side effect already happened, silently losing
+        // the cancellation. Correctly handling those requires the firing site itself to stage its side effect
+        // and honour a replayed veto (the 0029/0044 random-tick mechanism, generalized) — out of scope here.
+        // Returning false leaves them on the existing (now non-latching) path so they never silently mis-fire
+        // and never poison the plugin for the post-facto events this method DOES handle.
+        if (isStagedVetoClass(event)) {
+            return false;
+        }
+        final net.minecraft.server.threading.runtime.OwnerDomainExecutor.Owner owner =
+            net.minecraft.server.threading.runtime.OwnerDomainExecutor.currentOwner();
+        if (owner == null
+            || owner.domain() != net.minecraft.server.threading.runtime.OwnerDomainExecutor.Domain.REGION
+            || !(owner.level() instanceof ServerLevel level)) {
+            // Not a region worker (global owner / player / async / login / no context) — dispatch inline.
+            return false;
+        }
+        // A full-level region owner ([MIN..MAX]) is the world's own tick thread, even when it has suspended
+        // that lease to fan out sub-region workers; events it fires must run inline on it (it IS the owner).
+        // Only a bounded sub-region owner is an off-owner parallel worker that must hand back.
+        final boolean fullLevel = owner.minChunkX() == Integer.MIN_VALUE
+            && owner.minChunkZ() == Integer.MIN_VALUE
+            && owner.maxChunkX() == Integer.MAX_VALUE
+            && owner.maxChunkZ() == Integer.MAX_VALUE;
+        if (fullLevel) {
+            return false;
+        }
+        // Hand the event to the GLOBAL server queue (the main/Server thread), not the current sub-region:
+        // OwnerDomainExecutor.execute runs INLINE when the caller already owns the target, and a sub-region
+        // worker DOES own its own sub-region — so enqueuing to that region would just run on the worker,
+        // defeating the hand-off. The Server thread is never the current worker, so the global enqueue is a
+        // true cross-thread hand-off; it is drained by the main thread in its normal task loop (runAllTasks /
+        // pollTask), which is exactly where serial ticking would have fired these notifications.
+        final net.minecraft.server.MinecraftServer server = level.getServer();
+        net.minecraft.server.threading.runtime.OwnerDomainExecutor.execute(
+            net.minecraft.server.threading.runtime.OwnerDomainExecutor.global(server, "deferred-event:" + event.getEventName()),
+            () -> {
+                final Boolean previous = REPLAYING_DEFERRED_EVENT.get();
+                REPLAYING_DEFERRED_EVENT.set(Boolean.TRUE);
+                try {
+                    org.bukkit.Bukkit.getPluginManager().callEvent(event);
+                } catch (final Throwable t) {
+                    LOGGER.error("Deferred (off-owner) event dispatch failed for {}", event.getEventName(), t);
+                } finally {
+                    REPLAYING_DEFERRED_EVENT.set(previous);
+                }
+            });
+        if (DEFER_DEBUG) {
+            final long n = DEFERRED_EVENTS.incrementAndGet();
+            if ((n & 0x3FF) == 0L) {
+                LOGGER.info("Loom off-owner event deferral: {} events routed to owner so far (latest {})", n, event.getEventName());
+            }
+        }
+        return true;
+    }
+
+    // The staged-veto class: cancellable events whose cancellation must synchronously suppress a side effect
+    // at the point they fire. These cannot be deferred (the side effect would already be applied). They are
+    // the documented remaining follow-up; handling them needs the firing site to stage its side effect and
+    // honour a replayed veto.
+    public static boolean isStagedVetoClass(final org.bukkit.event.Event event) {
+        return event instanceof org.bukkit.event.block.BlockPhysicsEvent
+            || event instanceof org.bukkit.event.block.BlockFromToEvent
+            || event instanceof org.bukkit.event.entity.EntityChangeBlockEvent
+            || event instanceof org.bukkit.event.entity.CreatureSpawnEvent
+            || event instanceof org.bukkit.event.entity.EntitySpawnEvent;
+    }
+
+    // Apply every side effect staged in the given dispatch session serially on the calling (owning) thread,
+    // then clear it. Must be called after that session's parallel phase has joined and with staging disabled
+    // on this thread. {@code owningWorld} is the world this dispatch ticked; it is the world whose full-level
+    // lease the calling thread holds, and the world whose regions own the staged writes.
+    @SuppressWarnings("unchecked")
+    public static void applyAndClear(final Session session, final ServerLevel owningWorld) {
+        final Set<Buffer> active = session.active;
+        if (active.isEmpty()) {
+            return;
+        }
+        final List<Buffer> buffers = new ArrayList<>(active);
+        active.clear();
+        final int blen = buffers.size();
+        // Dispatch deferred Bukkit events first, on this (the owning/main) thread, now that the workers have
+        // joined — so plugin handlers run single-threaded exactly as under serial ticking. A handler that
+        // throws must not abort the rest of the replay. If a handler cancels a block event, record the target
+        // position so the staged write it gated is skipped below — honouring the plugin's veto.
+        final java.util.Set<Long> vetoed = new java.util.HashSet<>();
+        for (int b = 0; b < blen; ++b) {
+            final List<org.bukkit.event.Event> events = buffers.get(b).events;
+            for (int i = 0, len = events.size(); i < len; ++i) {
+                final org.bukkit.event.Event event = events.get(i);
+                try {
+                    org.bukkit.Bukkit.getPluginManager().callEvent(event);
+                } catch (final Throwable t) {
+                    LOGGER.error("Deferred event dispatch failed", t);
+                }
+                if (event instanceof org.bukkit.event.Cancellable cancellable && cancellable.isCancelled()) {
