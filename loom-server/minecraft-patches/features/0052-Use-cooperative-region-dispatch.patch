+    private static final class ParallelTaskBatch implements Runnable {
+        private final int count;
+        private final IntConsumer action;
+        private final String stageName;
+        private final boolean worldBatch;
+        private final boolean createdInsideWorldTick;
+        private final AtomicInteger cursor = new AtomicInteger();
+        private final AtomicInteger remaining;
+        private final @Nullable Throwable[] indexedFailures;
+        private final @Nullable AtomicReference<Error> firstError;
+        private final @Nullable AtomicReference<RuntimeException> firstFailure;
+        private volatile @Nullable Thread waiter;
+
+        private ParallelTaskBatch(
+            final int count,
+            final IntConsumer action,
+            final String stageName,
+            final boolean worldBatch
+        ) {
+            this.count = count;
+            this.action = action;
+            this.stageName = stageName;
+            this.worldBatch = worldBatch;
+            this.createdInsideWorldTick = RUNNING_WORLD_TICK.get();
+            this.remaining = new AtomicInteger(count);
+            this.indexedFailures = worldBatch ? new Throwable[count] : null;
+            this.firstError = worldBatch ? null : new AtomicReference<>();
+            this.firstFailure = worldBatch ? null : new AtomicReference<>();
+        }
+
+        private void start() {
+            final int helpers = Math.min(REGION_WORKER_COUNT, this.count);
+            for (int i = 0; i < helpers; ++i) {
+                this.enqueue();
+            }
+        }
+
+        private void enqueue() {
+            try {
+                REGION_SCHEDULER_EXECUTOR.execute(this);
+                if (!this.worldBatch) {
+                    final Thread worldPhaseHelper = WORLD_PHASE_HELPER;
+                    if (worldPhaseHelper != null) {
+                        LockSupport.unpark(worldPhaseHelper);
+                    }
+                }
+            } catch (final RejectedExecutionException ignored) {
+                // The participating caller can still drain every unclaimed item during shutdown.
+            }
+        }
+
+        @Override
+        public void run() {
+            this.runScheduledTurn();
+        }
+
+        private boolean runScheduledTurn() {
+            if (!this.runOne()) {
+                return false;
+            }
+            // Only a consumed executor turn replaces itself. Participating callers claim work
+            // directly without multiplying queued copies, keeping runnable tokens bounded by the
+            // worker count and avoiding stale queue traffic at the phase boundary.
+            if (this.cursor.get() < this.count) {
+                this.enqueue();
+            }
+            return true;
+        }
+
+        private boolean runOne() {
+            final int index = this.claimIndex();
+            if (index < 0) {
+                return false;
+            }
+            final boolean installWorldTick = this.worldBatch || this.createdInsideWorldTick;
+            boolean previousWorldTick = false;
+            if (installWorldTick) {
+                previousWorldTick = RUNNING_WORLD_TICK.get();
+                RUNNING_WORLD_TICK.set(Boolean.TRUE);
+            }
+            try {
+                this.action.accept(index);
+            } catch (final Throwable throwable) {
+                this.recordFailure(index, throwable);
+            } finally {
+                if (installWorldTick) {
+                    RUNNING_WORLD_TICK.set(previousWorldTick);
+                }
+                if (this.remaining.decrementAndGet() == 0) {
+                    final Thread waitingThread = this.waiter;
+                    if (waitingThread != null) {
+                        LockSupport.unpark(waitingThread);
+                    }
+                }
+            }
+            return true;
+        }
+
+        private int claimIndex() {
+            int index = this.cursor.get();
+            while (index < this.count) {
+                if (this.cursor.compareAndSet(index, index + 1)) {
+                    return index;
+                }
+                index = this.cursor.get();
+            }
+            return -1;
+        }
+
+        private void recordFailure(final int index, final Throwable throwable) {
+            if (this.indexedFailures != null) {
+                this.indexedFailures[index] = unwrapParallelStageFailure(throwable);
+                return;
+            }
+            if (throwable instanceof Error error) {
+                Objects.requireNonNull(this.firstError).compareAndSet(null, error);
+            } else if (throwable instanceof RuntimeException runtimeException) {
+                Objects.requireNonNull(this.firstFailure).compareAndSet(null, runtimeException);
+            } else {
+                Objects.requireNonNull(this.firstFailure).compareAndSet(
+                    null,
+                    new RuntimeException("Parallel region task dispatch failed for " + this.stageName, throwable)
+                );
+            }
+        }
+
+        private boolean isComplete() {
+            return this.remaining.get() == 0;
+        }
+
+        private void rethrowFailure() {
+            final Error error = this.firstError == null ? null : this.firstError.get();
+            if (error != null) {
+                throw error;
+            }
+            final RuntimeException failure = this.firstFailure == null ? null : this.firstFailure.get();
+            if (failure != null) {
+                throw failure;
+            }
+        }
+
+        private void rethrowIndexedWorldFailure() {
+            Error firstError = null;
+            RuntimeException firstFailure = null;
+            for (int i = 0; i < this.count; ++i) {
+                final Throwable failure = Objects.requireNonNull(this.indexedFailures)[i];
+                if (failure instanceof Error error) {
+                    if (firstError == null) {
+                        firstError = error;
+                    }
+                } else if (failure instanceof RuntimeException runtimeException) {
+                    if (firstFailure == null) {
+                        firstFailure = runtimeException;
+                    }
+                } else if (failure != null && firstFailure == null) {
+                    firstFailure = new RuntimeException("Parallel world tick failed", failure);
+                }
+            }
+            if (firstError != null) {
+                throw firstError;
+            }
+            if (firstFailure != null) {
+                throw firstFailure;
+            }
         }
     }
 
