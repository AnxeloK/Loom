+    private static boolean runQueuedCooperativeTask(final boolean alreadyTickingWorld) {
+        final java.util.concurrent.BlockingQueue<Runnable> queue = REGION_SCHEDULER_EXECUTOR.getQueue();
+        final int attempts = queue.size();
+        for (int i = 0; i < attempts; ++i) {
+            final Runnable task = queue.poll();
+            if (task == null) {
+                return false;
+            }
+            if (!(task instanceof ParallelTaskBatch batch)) {
+                queue.offer(task);
+                continue;
+            }
+            if (alreadyTickingWorld && batch.worldBatch) {
+                queue.offer(task);
+                continue;
+            }
+            if (batch.runScheduledTurn()) {
+                return true;
+            }
+        }
+        return false;
+    }
