From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: anxelok <anxelok@localhost>
Date: Mon, 6 Jul 2026 14:53:45 +0000
Subject: [PATCH] Revert "Cap coalesced writes per flush so backpressure stays
 quiet"

This reverts commit cf6f0608704ef2bc9d197d7f9edba4b8cbe73184.

diff --git a/net/minecraft/network/Connection.java b/net/minecraft/network/Connection.java
index 9cc3415125999fdd5f2ecf06082389a786971efd..669164b419143dbf1aa4572f95e9fd977c0ea4dd 100644
--- a/net/minecraft/network/Connection.java
+++ b/net/minecraft/network/Connection.java
@@ -76,10 +76,6 @@ public class Connection extends SimpleChannelInboundHandler<Packet<?>> {
     // coalesce per event-loop burst.
     private volatile boolean loomFlushBatchable;
     private final java.util.concurrent.atomic.AtomicBoolean loomFlushScheduled = new java.util.concurrent.atomic.AtomicBoolean();
-    // Mutated on the event loop only. Caps how many writes may coalesce before an inline flush, so the
-    // outbound buffer stays small enough that pending-byte backpressure never engages between flushes.
-    private int loomUnflushedWrites;
-    private static final int LOOM_MAX_UNFLUSHED_WRITES = Integer.getInteger("loom.maxUnflushedWrites", 64);
     public Channel channel;
     public SocketAddress address;
     // Spigot start
@@ -495,12 +491,7 @@ public class Connection extends SimpleChannelInboundHandler<Packet<?>> {
             try {
                 this.channel.eventLoop().execute(() -> {
                     try {
-                        if (batchFlush && ++this.loomUnflushedWrites >= LOOM_MAX_UNFLUSHED_WRITES) {
-                            this.loomUnflushedWrites = 0;
-                            this.doSendPacket(packet, listener, true);
-                        } else {
-                            this.doSendPacket(packet, listener, batchFlush ? false : flush);
-                        }
+                        this.doSendPacket(packet, listener, batchFlush ? false : flush);
                     } finally {
                         this.loomPendingEventLoopWrites.decrementAndGet();
                     }
@@ -508,7 +499,6 @@ public class Connection extends SimpleChannelInboundHandler<Packet<?>> {
                 if (batchFlush && this.loomFlushScheduled.compareAndSet(false, true)) {
                     this.channel.eventLoop().execute(() -> {
                         this.loomFlushScheduled.set(false);
-                        this.loomUnflushedWrites = 0;
                         this.channel.flush();
                     });
                 }
