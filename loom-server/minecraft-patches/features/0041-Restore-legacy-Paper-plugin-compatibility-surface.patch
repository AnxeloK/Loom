+            case LevelCaptureContext.TREE -> this.captureTreeGeneration;
+            case LevelCaptureContext.BLOCK_STATES -> this.captureBlockStates;
+            case LevelCaptureContext.DROPS -> this.captureDrops != null;
+            default -> false;
+        };
+        return flag
+            && Thread.currentThread() == net.minecraft.server.MinecraftServer.getServer().getRunningThread()
