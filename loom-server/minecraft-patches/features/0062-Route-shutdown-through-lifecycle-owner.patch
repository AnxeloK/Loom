Subject: [PATCH] Route shutdown through lifecycle owner


diff --git a/net/minecraft/server/MinecraftServer.java b/net/minecraft/server/MinecraftServer.java
index cb3dbb2b74c6be2d47848ed5a196fe9e10b3aa29..d21a2932aff446f65dbdf2beaf0c614b50db19f2 100644
--- a/net/minecraft/server/MinecraftServer.java
+++ b/net/minecraft/server/MinecraftServer.java
@@ -2472,6 +2472,16 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
         return super.scheduleExecutables() && !this.isStopped();
     }
 
+    public boolean enqueueGlobalOwnerTask(final Runnable command) {
+        if (this.isStopped() || this.hasStopped()) {
+            return false;
+        }
+        // Owner handoffs must never use Executor.execute here: BlockableEventLoop executes inline after
+        // shutdown begins, which would attach a GLOBAL_CONTROL token to the submitting thread.
+        this.schedule(new TickTask(this.tickTaskTickCount.get(), command));
+        return true;
+    }
+
     @Override
     public void executeIfPossible(final Runnable command) {
         if (this.isStopped()) {
diff --git a/net/minecraft/server/players/PlayerList.java b/net/minecraft/server/players/PlayerList.java
index c95020c8b2207f6409c99d41ab99fdc754bf0029..6c9dcc756e128ccf0feb6b8401b42d732a5bc122 100644
--- a/net/minecraft/server/players/PlayerList.java
+++ b/net/minecraft/server/players/PlayerList.java
@@ -1174,20 +1174,41 @@ public abstract class PlayerList {
     }
     public void saveAll(final int interval) {
         // Paper end - Incremental chunk and player saving
-        io.papermc.paper.util.MCUtil.ensureMain("Save Players" , () -> { // Paper - Ensure main
+        // Loom - the global player list must only be traversed by the lifecycle owner. A void API can
+        // hand off without blocking its caller; lifecycle/autosave calls already hold GLOBAL_CONTROL and
+        // retain their synchronous behavior. This replaces Paper's processQueue + Waitable round trip,
+        // which deadlocks when shutdown is initiated after the server thread has stalled.
+        if (!net.minecraft.server.threading.runtime.OwnerDomainExecutor.isGlobalOwner(this.server)) {
+            net.minecraft.server.threading.runtime.OwnerDomainExecutor.execute(
+                net.minecraft.server.threading.runtime.OwnerDomainExecutor.global(this.server, "save-all-players"),
+                () -> this.saveAllOwned(interval)
+            );
+            return;
+        }
+        this.saveAllOwned(interval);
+    }
+
+    private void saveAllOwned(final int interval) {
         // Paper start - Incremental chunk and player saving
-            int numSaved = 0;
-            final long now = DomainClock.currentServerTick(this.server);
-            for (final ServerPlayer player : this.players) {
-            if (interval == -1 || now - player.lastSave >= interval) {
-                this.save(player);
-                if (interval != -1 && ++numSaved >= io.papermc.paper.configuration.GlobalConfiguration.get().playerAutoSave.maxPerTick()) {
-                    break;
+        net.minecraft.server.threading.runtime.OwnerDomainExecutor.assertGlobalOwner(this.server, "save-all-players");
+        int numSaved = 0;
+        final long now = DomainClock.currentServerTick(this.server);
+        for (final ServerPlayer player : this.players) {
+            boolean saved = false;
+            try (net.minecraft.server.threading.runtime.OwnerDomainExecutor.Scope ignored =
+                     net.minecraft.server.threading.runtime.OwnerDomainExecutor.enter(
+                         net.minecraft.server.threading.runtime.OwnerDomainExecutor.player(player, "save-player")
+                     )) {
+                if (interval == -1 || now - player.lastSave >= interval) {
+                    this.save(player);
+                    saved = true;
                 }
             }
+            if (saved && interval != -1 && ++numSaved >= io.papermc.paper.configuration.GlobalConfiguration.get().playerAutoSave.maxPerTick()) {
+                break;
             }
+        }
         // Paper end - Incremental chunk and player saving
-        return null; }); // Paper - ensure main
     }
 
     public UserWhiteList getWhiteList() {
diff --git a/net/minecraft/server/threading/runtime/OwnerDomainExecutor.java b/net/minecraft/server/threading/runtime/OwnerDomainExecutor.java
index 6b7cad2ff1b2490090e18925e4380d3202350527..ffc7103102639214c60201a213df3ad042a05c85 100644
--- a/net/minecraft/server/threading/runtime/OwnerDomainExecutor.java
