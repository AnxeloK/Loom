@@ -396,10 +396,9 @@ public final class OwnerDomainExecutor {
 
     private static void enqueueGlobal(final Owner owner, final Runnable task) {
         final MinecraftServer server = owner.server();
-        if (server == null || server.hasStopped()) {
+        if (server == null || !server.enqueueGlobalOwnerTask(wrap(owner, task))) {
             throw new RejectedExecutionException("Server is unavailable for " + owner.describe());
         }
-        server.execute(wrap(owner, task));
     }
 
     private static void enqueueRegion(final Owner owner, final Runnable task) {
