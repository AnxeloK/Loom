+            chunkX - 1,
+            chunkZ - 1,
+            chunkX + 1,
+            chunkZ + 1,
+            ca.spottedleaf.concurrentutil.util.Priority.HIGHER,
+            "player-respawn-block",
+            ignored -> positionFuture.complete(
+                findRespawnAndUseSpawnBlock(respawnLevel, respawnConfig, consumeSpawnBlock).orElse(null)
+            )
+        ).whenComplete((ignored, throwable) -> {
+            if (throwable != null) {
+                positionFuture.completeExceptionally(throwable);
+            }
+        });
+
+        return positionFuture.thenCompose(respawnPosAngle -> {
+            if (respawnPosAngle == null) {
+                return this.findDefaultRespawnAsync(true, postTeleportTransition, respawnReason);
