+    private CompletableFuture<@Nullable RespawnResult> findConfiguredRespawnAsync(
+        final ServerLevel respawnLevel,
+        final ServerPlayer.RespawnConfig respawnConfig,
+        final boolean consumeSpawnBlock,
+        final TeleportTransition.PostTeleportTransition postTeleportTransition,
+        final org.bukkit.event.player.PlayerRespawnEvent.RespawnReason respawnReason
+    ) {
+        final BlockPos respawnBlockPosition = respawnConfig.respawnData().pos();
+        final int chunkX = respawnBlockPosition.getX() >> 4;
+        final int chunkZ = respawnBlockPosition.getZ() >> 4;
+        final CompletableFuture<@Nullable RespawnPosAngle> positionFuture = new CompletableFuture<>();
+        net.minecraft.server.threading.runtime.OwnershipRouter.runWhenChunksReady(
