+
+            final TeleportTransition transition = new TeleportTransition(
+                respawnLevel,
+                respawnPosAngle.position(),
+                Vec3.ZERO,
+                respawnPosAngle.yaw(),
+                respawnPosAngle.pitch(),
+                postTeleportTransition
+            );
+            return CompletableFuture.completedFuture(
+                this.completeRespawnResult(
+                    transition,
+                    respawnPosAngle.isBedSpawn(),
+                    respawnPosAngle.isAnchorSpawn(),
+                    respawnPosAngle.consumeAnchorCharge(),
+                    respawnBlockPosition,
+                    respawnReason
+                )
+            );
+        });
+    }
