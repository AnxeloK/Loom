+    private static void runWithTeleportOwnerContext(final ServerLevel level, final ChunkPos currentChunk, final Vec3 targetPosition, final Runnable action) {
+        final int targetChunkX = Mth.floor(targetPosition.x()) >> 4;
+        final int targetChunkZ = Mth.floor(targetPosition.z()) >> 4;
+        final int ownerRadius = ca.spottedleaf.moonrise.patches.chunk_tick_iteration.ChunkTickConstants.PLAYER_SPAWN_TRACK_RANGE;
+        final int currentMinChunkX = currentChunk.x() - ownerRadius;
+        final int currentMinChunkZ = currentChunk.z() - ownerRadius;
+        final int currentMaxChunkX = currentChunk.x() + ownerRadius;
+        final int currentMaxChunkZ = currentChunk.z() + ownerRadius;
+        final int targetMinChunkX = targetChunkX - ownerRadius;
+        final int targetMinChunkZ = targetChunkZ - ownerRadius;
+        final int targetMaxChunkX = targetChunkX + ownerRadius;
+        final int targetMaxChunkZ = targetChunkZ + ownerRadius;
+        net.minecraft.server.threading.TickRegions.RegionContext currentContext = null;
+        net.minecraft.server.threading.TickRegions.RegionContext targetContext = null;
+        if (!net.minecraft.server.threading.TickRegions.isCurrentThreadOwnerQuiet(level, currentMinChunkX, currentMinChunkZ, currentMaxChunkX, currentMaxChunkZ)) {
+            currentContext = net.minecraft.server.threading.TickRegions.pushRegionContext(
+                level, currentMinChunkX, currentMinChunkZ, currentMaxChunkX, currentMaxChunkZ
+            );
+        }
+        if (!net.minecraft.server.threading.TickRegions.isCurrentThreadOwnerQuiet(level, targetMinChunkX, targetMinChunkZ, targetMaxChunkX, targetMaxChunkZ)) {
+            targetContext = net.minecraft.server.threading.TickRegions.pushRegionContext(level, targetMinChunkX, targetMinChunkZ, targetMaxChunkX, targetMaxChunkZ);
+        }
+        try {
+            action.run();
+        } finally {
+            if (targetContext != null) {
+                net.minecraft.server.threading.TickRegions.popContext(targetContext);
+            }
+            if (currentContext != null) {
+                net.minecraft.server.threading.TickRegions.popContext(currentContext);
+            }
+        }
+    }
+
