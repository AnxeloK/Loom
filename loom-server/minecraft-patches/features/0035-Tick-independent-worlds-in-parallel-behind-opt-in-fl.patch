+    // Loom - experimental, opt-in parallel world ticking. Default off preserves the vanilla serial level loop.
+    // When enabled, independent worlds (overworld/nether/end and any others) tick concurrently on the region
+    // pool, each on a single thread holding its own full-level lease. Each world stays internally serial.
+    public static final boolean PARALLEL_WORLDS_ENABLED = Boolean.getBoolean("loom.parallelWorlds");
     private static final int DIAGNOSTIC_EVENT_LIMIT = Math.max(
         64,
         Integer.getInteger("paper.threadedregions.diagnostics.eventLimit", 512)
@@ -1022,6 +1026,48 @@ public class TickRegions {
         stateFor(world).drainMailbox();
     }
 
+    // Loom - experimental parallel world ticking. Ticks each world on the region pool (one task per
+    // world, each holding its own full-level lease) and waits for all of them. A single world runs on
+    // the calling thread. The first failure is rethrown, mirroring the serial loop's crash behaviour.
+    public static void tickWorldsInParallel(final List<ServerLevel> worlds, final java.util.function.Consumer<ServerLevel> worldTick) {
+        if (worlds.size() <= 1) {
+            for (final ServerLevel world : worlds) {
+                worldTick.accept(world);
+            }
+            return;
+        }
+        final List<CompletableFuture<Void>> futures = new ArrayList<>(worlds.size());
+        for (final ServerLevel world : worlds) {
+            futures.add(CompletableFuture.runAsync(() -> worldTick.accept(world), REGION_SCHEDULER_EXECUTOR));
+        }
+        RuntimeException firstFailure = null;
+        Error firstError = null;
+        for (int i = 0, len = futures.size(); i < len; ++i) {
+            try {
+                futures.get(i).join();
+            } catch (final java.util.concurrent.CompletionException ex) {
+                final Throwable cause = unwrapParallelStageFailure(ex);
+                if (cause instanceof final Error error) {
+                    if (firstError == null) {
+                        firstError = error;
+                    }
+                } else if (cause instanceof final RuntimeException runtimeException) {
+                    if (firstFailure == null) {
+                        firstFailure = runtimeException;
+                    }
+                } else if (firstFailure == null) {
+                    firstFailure = new RuntimeException("Parallel world tick failed", cause);
+                }
+            }
+        }
+        if (firstError != null) {
+            throw firstError;
+        }
+        if (firstFailure != null) {
+            throw firstFailure;
+        }
+    }
+
