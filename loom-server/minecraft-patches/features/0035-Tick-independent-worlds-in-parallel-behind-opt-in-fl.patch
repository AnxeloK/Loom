diff --git a/net/minecraft/server/MinecraftServer.java b/net/minecraft/server/MinecraftServer.java
index a7aa7bd36b2fc47242fe9a3d6b3d6a5b3cead034..c5c331ebec003c980b7224600fa54331fd5be332 100644
--- a/net/minecraft/server/MinecraftServer.java
+++ b/net/minecraft/server/MinecraftServer.java
@@ -2031,6 +2031,37 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
         this.updateEffectiveRespawnData();
 
         this.isIteratingOverLevels = true; // Paper - Throw exception on world create while being ticked
+        if (net.minecraft.server.threading.TickRegions.PARALLEL_WORLDS_ENABLED) {
+            // Loom start - experimental parallel world ticking
+            // The per-level latches below read shared, global handler lists, so they are set serially on the
+            // main thread before any world ticks. Per-world profiler scoping is skipped because the profiler
+            // is main-thread only; each world's own tick still records into its thread-local profiler.
+            final java.util.List<ServerLevel> parallelLevels = new java.util.ArrayList<>();
+            for (ServerLevel level : this.getAllLevels()) {
+                level.hasPhysicsEvent = org.bukkit.event.block.BlockPhysicsEvent.getHandlerList().getRegisteredListeners().length > 0; // Paper - BlockPhysicsEvent
+                level.hasEntityMoveEvent = io.papermc.paper.event.entity.EntityMoveEvent.getHandlerList().getRegisteredListeners().length > 0; // Paper - Add EntityMoveEvent
+                level.updateLagCompensationTick(); // Paper - lag compensation
+                net.minecraft.world.level.block.entity.HopperBlockEntity.skipHopperEvents = level.paperConfig().hopper.disableMoveEvent || org.bukkit.event.inventory.InventoryMoveItemEvent.getHandlerList().getRegisteredListeners().length == 0; // Paper - Perf: Optimize Hoppers
+                parallelLevels.add(level);
+            }
+            net.minecraft.server.threading.TickRegions.tickWorldsInParallel(parallelLevels, level -> {
+                net.minecraft.server.threading.TickRegions.tickWorld(level);
+                final net.minecraft.server.threading.TickRegions.RegionContext tickRegionContext =
+                    net.minecraft.server.threading.TickRegions.pushLevelContext(level);
+                try {
+                    level.tick(haveTime);
+                } catch (Throwable throwable) {
+                    CrashReport report = CrashReport.forThrowable(throwable, "Exception ticking world");
+                    level.fillReportDetails(report);
+                    throw new ReportedException(report);
+                } finally {
+                    net.minecraft.server.threading.TickRegions.popContext(tickRegionContext);
+                }
+                net.minecraft.server.threading.TickRegions.postWorldTick(level);
+                level.explosionDensityCache.clear(); // Paper - Optimize explosions
+            });
+            // Loom end
+        } else {
         for (ServerLevel level : this.getAllLevels()) {
             level.hasPhysicsEvent = org.bukkit.event.block.BlockPhysicsEvent.getHandlerList().getRegisteredListeners().length > 0; // Paper - BlockPhysicsEvent
             level.hasEntityMoveEvent = io.papermc.paper.event.entity.EntityMoveEvent.getHandlerList().getRegisteredListeners().length > 0; // Paper - Add EntityMoveEvent
@@ -2057,6 +2088,7 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
             profiler.pop();
             level.explosionDensityCache.clear(); // Paper - Optimize explosions
         }
+        }
         this.isIteratingOverLevels = false; // Paper - Throw exception on world create while being ticked
 
         profiler.popPush("connection");
