From: anxelok <anxelok@localhost>
Date: Mon, 6 Jul 2026 13:50:49 +0000
Subject: [PATCH] Revert "Consolidate flushes issued outside channel reads"

This reverts commit 327c4248cfb42cad977236256d7b9cdcea72332b.

diff --git a/net/minecraft/server/network/ServerConnectionListener.java b/net/minecraft/server/network/ServerConnectionListener.java
index b33f970a0e28866de33311d76a0c98520213e375..92bda2d0638411ed23cc4a2499b8100ca8f7adfb 100644
--- a/net/minecraft/server/network/ServerConnectionListener.java
+++ b/net/minecraft/server/network/ServerConnectionListener.java
@@ -99,7 +99,7 @@ public class ServerConnectionListener {
                                     } catch (ChannelException var5) {
                                     }
 
-                                    if (!disableFlushConsolidation) channel.pipeline().addFirst(new io.netty.handler.flush.FlushConsolidationHandler(io.netty.handler.flush.FlushConsolidationHandler.DEFAULT_EXPLICIT_FLUSH_AFTER_FLUSHES, true)); // Paper - Optimize network // Loom - also consolidate flushes issued outside a read: under parallel ticking the entity tracker's packets arrive as write tasks from region threads, and the read-scoped default passes every one of those flushes straight to a syscall
+                                    if (!disableFlushConsolidation) channel.pipeline().addFirst(new io.netty.handler.flush.FlushConsolidationHandler()); // Paper - Optimize network
                                     ChannelPipeline pipeline = channel.pipeline().addLast(HandlerNames.TIMEOUT, new ReadTimeoutHandler(Connection.READ_TIMEOUT_SECONDS));
                                     if (ServerConnectionListener.this.server.repliesToStatus()) {
                                         pipeline.addLast(HandlerNames.LEGACY_QUERY, new LegacyQueryHandler(ServerConnectionListener.this.getServer()));
