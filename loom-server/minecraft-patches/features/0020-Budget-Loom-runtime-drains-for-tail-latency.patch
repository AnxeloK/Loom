+
+        private int limitCount(
+            final int requested,
+            final long elapsedNanos,
+            final long budgetNanos,
+            final int minPerPlayer,
+            final int completedThisPlayer,
+            final int minPerTick,
+            final int completedThisTick,
+            final int maxPerPlayer,
+            final BudgetPhase phase
+        ) {
+            if (requested <= 0) {
+                return 0;
+            }
+
+            final int perPlayerFloorRemaining = Math.max(0, minPerPlayer - completedThisPlayer);
+            final int perTickFloorRemaining = Math.max(0, minPerTick - completedThisTick);
+            final int floorRemaining = Math.min(perPlayerFloorRemaining, perTickFloorRemaining);
+            final int limit = elapsedNanos >= budgetNanos ? floorRemaining : Math.max(floorRemaining, maxPerPlayer);
+            final int allowed = Math.min(requested, limit);
+            if (allowed < requested) {
+                this.recordBudgetSkip(phase);
+            }
+            return allowed;
+        }
+
+        private boolean canContinue(
+            final long elapsedNanos,
+            final long budgetNanos,
+            final int minPerPlayer,
+            final int completedThisPlayer,
+            final int minPerTick,
+            final int completedThisTick,
+            final BudgetPhase phase
+        ) {
+            if (elapsedNanos < budgetNanos
+                || (completedThisPlayer < minPerPlayer && completedThisTick < minPerTick)) {
+                return true;
+            }
+            this.recordBudgetSkip(phase);
+            return false;
+        }
+
+        private void recordBudgetSkip(final BudgetPhase phase) {
+            switch (phase) {
+                case LOAD_SCHEDULE -> ++this.loadScheduleBudgetSkips;
+                case GENERATION_ADMISSION -> ++this.generationAdmissionBudgetSkips;
+                case POST_PROCESS -> ++this.postProcessBudgetSkips;
+                case SEND -> ++this.sendBudgetSkips;
+            }
+        }
+    }
