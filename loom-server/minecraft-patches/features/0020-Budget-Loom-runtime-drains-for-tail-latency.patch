+    private static int getNonNegativeIntProperty(final String property, final int fallback) {
+        final String configured = System.getProperty(property);
+        if (configured == null) {
+            return fallback;
+        }
+        try {
+            return Math.max(0, Integer.parseInt(configured));
+        } catch (final NumberFormatException ignored) {
+            return fallback;
+        }
+    }
+
+    private static int getPositiveIntProperty(final String property, final int fallback) {
+        final String configured = System.getProperty(property);
+        if (configured == null) {
+            return fallback;
+        }
+        try {
+            return Math.max(1, Integer.parseInt(configured));
+        } catch (final NumberFormatException ignored) {
+            return fallback;
+        }
+    }
+
+    private static long getNonNegativeMillisPropertyNanos(final String property, final long fallback) {
+        final String configured = System.getProperty(property);
+        if (configured == null) {
+            return TimeUnit.MILLISECONDS.toNanos(fallback);
+        }
+        try {
+            return TimeUnit.MILLISECONDS.toNanos(Math.max(0L, Long.parseLong(configured)));
+        } catch (final NumberFormatException ignored) {
+            return TimeUnit.MILLISECONDS.toNanos(fallback);
+        }
+    }
