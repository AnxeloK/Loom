+    // Loom start - index randomly ticking chunk sections
+    private void loom$setRandomlyTickingBlockSection(final int sectionIndex, final boolean active) {
+        if (sectionIndex < Long.SIZE) {
+            this.loom$randomlyTickingBlockSections = RandomTickingBlockSectionIndex.setBase(
+                this.loom$randomlyTickingBlockSections, sectionIndex, active
+            );
+            return;
+        }
+        this.loom$randomlyTickingBlockSectionsOverflow = RandomTickingBlockSectionIndex.setOverflow(
+            this.loom$randomlyTickingBlockSectionsOverflow, sectionIndex, active
+        );
+    }
+
+    public final int loom$getNextRandomlyTickingBlockSectionIndex(final int fromSectionIndex) {
+        return RandomTickingBlockSectionIndex.next(
+            this.loom$randomlyTickingBlockSections,
+            this.loom$randomlyTickingBlockSectionsOverflow,
+            fromSectionIndex
+        );
+    }
+    // Loom end - index randomly ticking chunk sections
