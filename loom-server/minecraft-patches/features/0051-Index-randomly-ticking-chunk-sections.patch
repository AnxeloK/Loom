diff --git a/net/minecraft/world/level/chunk/RandomTickingBlockSectionIndex.java b/net/minecraft/world/level/chunk/RandomTickingBlockSectionIndex.java
new file mode 100644
index 0000000000000000000000000000000000000000..cb84ef15ed19485a82c41517679d8e2a8ab43b05
--- /dev/null
+++ b/net/minecraft/world/level/chunk/RandomTickingBlockSectionIndex.java
@@ -0,0 +1,80 @@
+package net.minecraft.world.level.chunk;
+
+import java.util.Arrays;
+import org.jspecify.annotations.Nullable;
+
+final class RandomTickingBlockSectionIndex {
+
+    private static final int BASE_SECTION_COUNT = Long.SIZE;
+
+    private RandomTickingBlockSectionIndex() {
+    }
+
+    static long setBase(final long sections, final int sectionIndex, final boolean active) {
+        final long mask = 1L << sectionIndex;
+        return active ? sections | mask : sections & ~mask;
+    }
+
+    static long @Nullable [] setOverflow(
+        final long @Nullable [] sections,
+        final int sectionIndex,
+        final boolean active
+    ) {
+        final int overflowIndex = sectionIndex - BASE_SECTION_COUNT;
+        final int wordIndex = overflowIndex >>> 6;
+        if (!active && (sections == null || wordIndex >= sections.length)) {
+            return sections;
+        }
+
+        final long[] updated;
+        if (sections == null) {
+            updated = new long[wordIndex + 1];
+        } else if (wordIndex >= sections.length) {
+            updated = Arrays.copyOf(sections, wordIndex + 1);
+        } else {
+            updated = sections;
+        }
+
+        final long mask = 1L << overflowIndex;
+        if (active) {
+            updated[wordIndex] |= mask;
+        } else {
+            updated[wordIndex] &= ~mask;
+        }
+        return updated;
+    }
+
+    static int next(
+        final long baseSections,
+        final long @Nullable [] overflowSections,
+        final int fromSectionIndex
+    ) {
+        final int fromIndex = Math.max(0, fromSectionIndex);
+        if (fromIndex < BASE_SECTION_COUNT) {
+            final long remainingBase = baseSections & (-1L << fromIndex);
+            if (remainingBase != 0L) {
+                return Long.numberOfTrailingZeros(remainingBase);
+            }
+        }
+        if (overflowSections == null) {
+            return -1;
+        }
+
+        final int overflowIndex = Math.max(0, fromIndex - BASE_SECTION_COUNT);
+        int wordIndex = overflowIndex >>> 6;
+        if (wordIndex >= overflowSections.length) {
+            return -1;
+        }
+
+        long remaining = overflowSections[wordIndex] & (-1L << overflowIndex);
+        while (true) {
+            if (remaining != 0L) {
+                return BASE_SECTION_COUNT + (wordIndex << 6) + Long.numberOfTrailingZeros(remaining);
+            }
+            if (++wordIndex >= overflowSections.length) {
+                return -1;
+            }
+            remaining = overflowSections[wordIndex];
+        }
+    }
+}
