From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: anxelok <anxelok@localhost>
Date: Sat, 11 Jul 2026 10:36:11 +0000
Subject: [PATCH] Confine parallel world state

Isolate transient world, structure-generation, and captured-mutation state so parallel owners cannot observe another worker session.

diff --git a/net/minecraft/core/Rotations.java b/net/minecraft/core/Rotations.java
index 0d5805a9002854ea2666ef3bc792e61f016ffd34..cc55597996d1c84a1a345dac110c68c1d7abb756 100644
--- a/net/minecraft/core/Rotations.java
+++ b/net/minecraft/core/Rotations.java
@@ -27,17 +27,24 @@ public record Rotations(float x, float y, float z) {
         }
     };
     // Paper start - add internal method for skipping validation for plugins using userdev
-    private static boolean SKIP_VALIDATION = false;
+    private static final ThreadLocal<Boolean> SKIP_VALIDATION = new ThreadLocal<>();
     public static Rotations createWithoutValidityChecks(float x, float y, float z) {
-        SKIP_VALIDATION = true;
-        Rotations rotations = new Rotations(x, y, z);
-        SKIP_VALIDATION = false;
-        return rotations;
+        final Boolean previous = SKIP_VALIDATION.get();
+        SKIP_VALIDATION.set(Boolean.TRUE);
+        try {
+            return new Rotations(x, y, z);
+        } finally {
+            if (previous == null) {
+                SKIP_VALIDATION.remove();
+            } else {
+                SKIP_VALIDATION.set(previous);
+            }
+        }
     }
     // Paper end - add internal method for skipping validation for plugins using userdev
 
     public Rotations {
-        if (!SKIP_VALIDATION) { // Paper - add internal method for skipping validation for plugins using userdev
+        if (SKIP_VALIDATION.get() != Boolean.TRUE) { // Paper - add internal method for skipping validation for plugins using userdev; Loom - thread-confined
         x = !Float.isInfinite(x) && !Float.isNaN(x) ? x % 360.0F : 0.0F;
         y = !Float.isInfinite(y) && !Float.isNaN(y) ? y % 360.0F : 0.0F;
         z = !Float.isInfinite(z) && !Float.isNaN(z) ? z % 360.0F : 0.0F;
