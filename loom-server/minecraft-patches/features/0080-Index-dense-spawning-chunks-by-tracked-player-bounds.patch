+        private boolean collectDense(final List<LevelChunk> output) {
+            if (this.denseChunks == null
+                || !net.minecraft.server.threading.runtime.OwnerDomainExecutor.isRegionOwner(this.chunkMap.level,
+                    Integer.MIN_VALUE, Integer.MIN_VALUE, Integer.MAX_VALUE, Integer.MAX_VALUE)
+                || !net.minecraft.server.threading.TickRegions.isCurrentThreadOwnerQuiet(this.chunkMap.level,
+                    Integer.MIN_VALUE, Integer.MIN_VALUE, Integer.MAX_VALUE, Integer.MAX_VALUE)) {
+                return false;
+            }
+            java.util.Arrays.fill(this.included, false);
+            for (final var tracked : this.chunkMap.level.moonrise$getNearbyPlayers().getSpawnRangesSnapshot()) {
+                final ServerPlayer player = tracked.player();
+                final var event = player.playerNaturallySpawnedEvent;
+                if (event == null || event.isCancelled() || player.isSpectator()) {
+                    continue;
+                }
+                final Vec3 position = player.position();
+                if (!Double.isFinite(position.x) || !Double.isFinite(position.z)) {
+                    continue;
+                }
+                final int blocks = event.getSpawnRadius() << 4;
+                this.denseChunks.include(tracked, position, (double)(blocks * blocks), this.included);
+            }
+            for (int index = 0; index < this.sourceChunks.length; ++index) {
+                if (this.included[index]) {
+                    output.add(this.sourceChunks[index]);
+                }
+            }
+            return true;
+        }
+
+        private static final class DenseSpawningChunks {
+            private static final int MAX_CELLS = 65_536;
+            private final int minX;
+            private final int minZ;
+            private final int width;
+            private final int height;
+            private final int[] sourceIndices;
+
+            private DenseSpawningChunks(final int minX, final int minZ, final int width, final int height) {
+                this.minX = minX;
+                this.minZ = minZ;
+                this.width = width;
+                this.height = height;
+                this.sourceIndices = new int[width * height];
+                java.util.Arrays.fill(this.sourceIndices, -1);
+            }
+
+            private static @Nullable DenseSpawningChunks create(final LevelChunk[] chunks) {
+                if (chunks.length < 578) {
+                    return null;
+                }
+                int minX = Integer.MAX_VALUE, minZ = Integer.MAX_VALUE;
+                int maxX = Integer.MIN_VALUE, maxZ = Integer.MIN_VALUE;
+                for (final LevelChunk chunk : chunks) {
+                    minX = Math.min(minX, chunk.locX);
+                    minZ = Math.min(minZ, chunk.locZ);
+                    maxX = Math.max(maxX, chunk.locX);
+                    maxZ = Math.max(maxZ, chunk.locZ);
+                }
+                final long width = (long)maxX - minX + 1L;
+                final long height = (long)maxZ - minZ + 1L;
+                if (width > MAX_CELLS || height > MAX_CELLS || width * height > MAX_CELLS
+                    || width * height > chunks.length * 2L) {
+                    return null;
+                }
+                final DenseSpawningChunks grid = new DenseSpawningChunks(minX, minZ, (int)width, (int)height);
+                for (int index = 0; index < chunks.length; ++index) {
+                    final LevelChunk chunk = chunks[index];
+                    final int cell = (chunk.locZ - minZ) * grid.width + chunk.locX - minX;
+                    if (grid.sourceIndices[cell] != -1) {
+                        return null;
+                    }
+                    grid.sourceIndices[cell] = index;
+                }
+                return grid;
+            }
+
+            private void include(
+                final ca.spottedleaf.moonrise.common.misc.NearbyPlayers.SpawnRange tracked,
+                final Vec3 position, final double range, final boolean[] included
+            ) {
+                // Membership follows the last tracking update, while distance uses the current position.
+                // Those centres can differ during movement or transfer; neither can replace the other.
+                final long minX = Math.max(this.minX, (long)tracked.chunkX() - tracked.radius());
+                final long maxX = Math.min((long)this.minX + this.width - 1L, (long)tracked.chunkX() + tracked.radius());
+                final long minZ = Math.max(this.minZ, (long)tracked.chunkZ() - tracked.radius());
+                final long maxZ = Math.min((long)this.minZ + this.height - 1L, (long)tracked.chunkZ() + tracked.radius());
+                for (long z = minZ; z <= maxZ; ++z) {
+                    final double dz = (double)((int)z << 4) + 8.0 - position.z;
+                    if (dz * dz >= range) {
+                        continue;
+                    }
+                    final int row = (int)(z - this.minZ) * this.width;
+                    for (long x = minX; x <= maxX; ++x) {
+                        final int index = this.sourceIndices[row + (int)(x - this.minX)];
+                        if (index >= 0 && !included[index]) {
+                            final double dx = (double)((int)x << 4) + 8.0 - position.x;
+                            if (dx * dx + dz * dz < range) {
+                                included[index] = true;
+                            }
+                        }
+                    }
+                }
+            }
+        }
+
         private boolean collectByPlayer(final List<LevelChunk> output) {
             final int width = PLAYER_RADIUS_CHUNKS * 2 + 1;
             if (this.sourceChunks.length < width * width * 2
