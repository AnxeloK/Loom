+    /** Detached bounds from the same trackers that maintain SPAWN_RANGE membership. Requires the world owner. */
+    public SpawnRange[] getSpawnRangesSnapshot() {
+        final ArrayList<SpawnRange> ranges = new ArrayList<>(this.players.size());
+        for (final TrackedPlayer[] trackers : this.players.values()) {
+            final TrackedPlayer tracker = trackers[NearbyMapType.SPAWN_RANGE.ordinal()];
+            if (tracker != null && tracker.getLastDistance() != SingleUserAreaMap.NOT_SET) {
+                ranges.add(new SpawnRange(tracker.getParameter(), tracker.getLastChunkX(), tracker.getLastChunkZ(), tracker.getLastDistance()));
+            }
+        }
+        return ranges.toArray(new SpawnRange[0]);
+    }
+
+    public record SpawnRange(ServerPlayer player, int chunkX, int chunkZ, int radius) {
+    }
+
