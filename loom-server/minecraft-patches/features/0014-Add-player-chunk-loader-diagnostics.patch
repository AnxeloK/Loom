@@ -305,15 +312,104 @@ public final class RegionizedPlayerChunkLoader {
 
     public void tick() {
         TickThread.ensureTickThread(this.world, "Cannot tick player chunk loader async");
-        long currTime = System.nanoTime();
+        final long currTime = System.nanoTime();
+        final TickDiagnostics diagnostics = LOOM_PLAYER_CHUNK_LOADER_DIAGNOSTICS ? new TickDiagnostics() : null;
         for (final ServerPlayer player : new java.util.ArrayList<>(this.world.players())) {
             final PlayerChunkLoaderData loader = ((ChunkSystemServerPlayer)player).moonrise$getChunkLoader();
             if (loader == null || loader.removed || loader.world != this.world) {
                 // not our problem anymore
                 continue;
             }
+            if (diagnostics != null) {
+                ++diagnostics.players;
+            }
+            final long updateStart = diagnostics == null ? 0L : System.nanoTime();
             loader.update(); // can't invoke plugin logic
-            loader.updateQueues(currTime);
+            if (diagnostics != null) {
+                diagnostics.updateNanos += System.nanoTime() - updateStart;
+            }
+            final long queueStart = diagnostics == null ? 0L : System.nanoTime();
+            loader.updateQueues(currTime, diagnostics);
+            if (diagnostics != null) {
+                diagnostics.queueNanos += System.nanoTime() - queueStart;
+            }
+        }
+        if (diagnostics != null) {
+            diagnostics.tickNanos = System.nanoTime() - currTime;
+            this.logDiagnostics(currTime, diagnostics);
+        }
+    }
+
+    private void logDiagnostics(final long currTime, final TickDiagnostics diagnostics) {
+        if ((currTime - this.loomLastPlayerChunkLoaderDiagnosticNanos) < LOOM_PLAYER_CHUNK_LOADER_DIAGNOSTIC_INTERVAL_NANOS) {
+            return;
+        }
+        this.loomLastPlayerChunkLoaderDiagnosticNanos = currTime;
+        LOOM_DIAGNOSTICS_LOGGER.info(
+            "[loom.player-chunk-loader] world={} players={} tick_ms={} update_ms={} queue_ms={} ticket_ms={} load_schedule_ms={} " +
+                "loads_done={} loads_start={} loads_schedule={} gens_done={} gens_start={} ticking_start={} sent={} post={} post_ms={} send_ms={} " +
+                "queues(load/loading/gen/generating/send/ticking)={}/{}/{}/{}/{}/{}",
+            this.world.dimension(),
+            diagnostics.players,
+            formatMillis(diagnostics.tickNanos),
+            formatMillis(diagnostics.updateNanos),
+            formatMillis(diagnostics.queueNanos),
+            formatMillis(diagnostics.ticketUpdateNanos),
+            formatMillis(diagnostics.loadScheduleNanos),
+            diagnostics.loadCompletions,
+            diagnostics.loadTickets,
+            diagnostics.loadSchedules,
+            diagnostics.generationCompletions,
+            diagnostics.generationTickets,
+            diagnostics.tickingTickets,
+            diagnostics.sentChunks,
+            diagnostics.postProcessedChunks,
+            formatMillis(diagnostics.postProcessNanos),
+            formatMillis(diagnostics.sendChunkNanos),
+            diagnostics.loadQueueSize,
+            diagnostics.loadingQueueSize,
+            diagnostics.genQueueSize,
+            diagnostics.generatingQueueSize,
+            diagnostics.sendQueueSize,
+            diagnostics.tickingQueueSize
+        );
+    }
+
+    private static String formatMillis(final long nanos) {
+        return String.format(java.util.Locale.ROOT, "%.3f", (double)nanos / 1_000_000.0D);
+    }
+
+    private static final class TickDiagnostics {
+        private int players;
+        private long tickNanos;
+        private long updateNanos;
+        private long queueNanos;
+        private long ticketUpdateNanos;
+        private long loadScheduleNanos;
+        private long postProcessNanos;
+        private long sendChunkNanos;
+        private long loadQueueSize;
+        private long loadingQueueSize;
+        private long genQueueSize;
+        private long generatingQueueSize;
+        private long sendQueueSize;
+        private long tickingQueueSize;
+        private int loadCompletions;
+        private int loadTickets;
+        private int loadSchedules;
+        private int generationCompletions;
+        private int generationTickets;
+        private int tickingTickets;
+        private int sentChunks;
+        private int postProcessedChunks;
+
+        private void sampleQueues(final PlayerChunkLoaderData loader) {
+            this.loadQueueSize += loader.loadQueue.size();
+            this.loadingQueueSize += loader.loadingQueue.size();
+            this.genQueueSize += loader.genQueue.size();
+            this.generatingQueueSize += loader.generatingQueue.size();
+            this.sendQueueSize += loader.sendQueue.size();
+            this.tickingQueueSize += loader.tickingQueue.size();
         }
     }
 
