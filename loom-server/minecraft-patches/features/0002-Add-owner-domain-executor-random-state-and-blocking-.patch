+package net.minecraft.server.threading.runtime;
+
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.locks.Condition;
+import java.util.function.BooleanSupplier;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.server.threading.TickRegions;
+import net.minecraft.util.thread.BlockableEventLoop;
+import net.minecraft.world.level.chunk.status.ChunkStatus;
+
+public final class ThreadedRegionsBlockingBarrier {
+
+    private ThreadedRegionsBlockingBarrier() {
+    }
+
+    public static boolean isStartupChunkLoadBarrier(final ServerLevel level) {
+        final MinecraftServer server = level.getServer();
+        return server != null
+            && Thread.currentThread() == server.serverThread
+            && ca.spottedleaf.moonrise.common.util.TickThread.isTickThread()
+            && !server.isReady()
+            && server.getTickCount() == 0;
+    }
+
+    public static boolean isShutdownThread(final MinecraftServer server) {
+        return Thread.currentThread() == server.serverThread;
+    }
+
+    public static void awaitStartupChunkLoad(
+        final BlockableEventLoop<?> owner,
+        final BooleanSupplier done,
+        final ServerLevel level,
+        final int chunkX,
+        final int chunkZ,
+        final ChunkStatus status
+    ) {
+        if (done.getAsBoolean()) {
+            return;
+        }
+        if (!isStartupChunkLoadBarrier(level)) {
+            throw new IllegalStateException(
+                "Non-blocking runtime cannot synchronously wait for chunk " + chunkX + "," + chunkZ + " status " + status
+            );
+        }
+        final TickRegions.RegionContext context = TickRegions.pushLevelContext(level);
+        try {
+            owner.managedBlock(done);
+        } finally {
+            TickRegions.popContext(context);
+        }
+    }
+
+    public static void awaitPluginFuture(final Condition condition) throws InterruptedException {
+        assertOffOwnerDomain("plugin future wait");
+        condition.await();
+    }
+
+    public static boolean awaitPluginFuture(final Condition condition, final long time, final TimeUnit unit) throws InterruptedException {
+        assertOffOwnerDomain("timed plugin future wait");
+        return condition.await(time, unit);
+    }
+
+    public static <T> T awaitNonOwnerFuture(final CompletableFuture<T> future, final String operation) {
+        assertOffOwnerDomain(operation);
+        return future.join();
+    }
+
+    private static void assertOffOwnerDomain(final String operation) {
