+package net.minecraft.server.threading.runtime;
+
+import java.util.HashMap;
+import java.util.Map;
+import net.minecraft.commands.CommandSourceStack;
+import net.minecraft.core.BlockPos;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.util.RandomSource;
+import net.minecraft.world.phys.Vec3;
+
+public final class DomainRandom {
+
+    private static final ThreadLocal<Map<String, RandomSource>> DOMAIN_RANDOMS = ThreadLocal.withInitial(HashMap::new);
+
+    private DomainRandom() {
+    }
+
+    public static RandomSource forCommand(final CommandSourceStack source, final String salt) {
+        final ServerLevel level = source.getLevel();
+        final Vec3 position = source.getPosition();
+        final BlockPos blockPos = BlockPos.containing(position);
+        return RandomSource.create(seed(level, blockPos, salt));
+    }
+
+    public static RandomSource forLevel(final ServerLevel level, final String salt) {
+        return RandomSource.create(seed(level, BlockPos.ZERO, salt));
+    }
+
+    public static RandomSource forRuntimeLevel(final ServerLevel level, final RandomSource fallback) {
+        final OwnerDomainExecutor.Owner owner = OwnerDomainExecutor.currentOwner();
+        if (owner == null) {
+            return fallback;
+        }
+        final String key = level.dimension().identifier() + "|" + owner.domain()
+            + "|" + owner.minChunkX() + "," + owner.minChunkZ()
+            + "|" + owner.maxChunkX() + "," + owner.maxChunkZ()
+            + "|" + owner.playerId();
+        return DOMAIN_RANDOMS.get().computeIfAbsent(key, ignored -> RandomSource.create(seed(level, BlockPos.ZERO, key)));
+    }
+
+    private static long seed(final ServerLevel level, final BlockPos blockPos, final String salt) {
+        long seed = level.dimension().identifier().hashCode();
+        seed = 31L * seed + level.getGameTime();
+        seed = 31L * seed + blockPos.asLong();
+        seed = 31L * seed + (long)salt.hashCode();
+        return seed;
+    }
+}
