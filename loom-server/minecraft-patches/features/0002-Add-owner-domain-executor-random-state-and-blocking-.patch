diff --git a/net/minecraft/server/threading/runtime/OwnerDomainExecutor.java b/net/minecraft/server/threading/runtime/OwnerDomainExecutor.java
new file mode 100644
index 0000000000000000000000000000000000000000..a0fccf9062f7e9faa96aaa4deeb5de13d61924ee
--- /dev/null
+++ b/net/minecraft/server/threading/runtime/OwnerDomainExecutor.java
@@ -0,0 +1,356 @@
+package net.minecraft.server.threading.runtime;
+
+import java.util.Objects;
+import java.util.UUID;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.Executor;
+import java.util.concurrent.Executors;
+import java.util.concurrent.RejectedExecutionException;
+import java.util.concurrent.ThreadFactory;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.function.Supplier;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.server.level.ServerPlayer;
+import net.minecraft.server.threading.TickRegions;
+import net.minecraft.util.Util;
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.level.Level;
+import org.jspecify.annotations.Nullable;
+
+public final class OwnerDomainExecutor {
+
+    public enum Domain {
+        GLOBAL_CONTROL,
+        REGION,
+        PLAYER,
+        LOGIN,
+        ASYNC_IO
+    }
+
+    private static final ThreadLocal<@Nullable OwnerContext> CURRENT_OWNER = new ThreadLocal<>();
+    private static final Executor LOGIN_EXECUTOR = Executors.newSingleThreadExecutor(new NamedThreadFactory("Owner domain login"));
+
+    private OwnerDomainExecutor() {
+    }
+
+    public static Owner global(final MinecraftServer server, final String operation) {
+        return new Owner(Domain.GLOBAL_CONTROL, Objects.requireNonNull(server, "server"), null, 0, 0, 0, 0, null, null, operation);
+    }
+
+    public static Owner region(final ServerLevel level, final int chunkX, final int chunkZ, final String operation) {
+        return region(level, chunkX, chunkZ, chunkX, chunkZ, operation);
+    }
+
+    public static Owner region(
+        final ServerLevel level,
+        final int minChunkX,
+        final int minChunkZ,
+        final int maxChunkX,
+        final int maxChunkZ,
+        final String operation
+    ) {
+        if (maxChunkX < minChunkX || maxChunkZ < minChunkZ) {
+            throw new IllegalArgumentException("Invalid owner region bounds");
+        }
+        return new Owner(Domain.REGION, level.getServer(), Objects.requireNonNull(level, "level"), minChunkX, minChunkZ, maxChunkX, maxChunkZ, null, null, operation);
+    }
+
+    public static Owner player(final ServerPlayer player, final String operation) {
+        return new Owner(
+            Domain.PLAYER,
+            player.level().getServer(),
+            player.level(),
+            player.chunkPosition().x(),
+            player.chunkPosition().z(),
+            player.chunkPosition().x(),
+            player.chunkPosition().z(),
+            player.getUUID(),
+            player,
+            operation
+        );
+    }
+
+    public static Owner entity(final Entity entity, final String operation) {
+        Objects.requireNonNull(entity, "entity");
+        if (entity instanceof ServerPlayer player) {
+            return player(player, operation);
+        }
+
+        final Level level = entity.level();
+        if (level instanceof ServerLevel serverLevel) {
+            return region(serverLevel, entity.chunkPosition().x(), entity.chunkPosition().z(), operation);
+        }
+
+        return global(MinecraftServer.getServer(), operation);
+    }
+
+    public static Owner login(final MinecraftServer server, final String operation) {
+        return new Owner(Domain.LOGIN, Objects.requireNonNull(server, "server"), null, 0, 0, 0, 0, null, null, operation);
+    }
+
+    public static Owner asyncIo(final MinecraftServer server, final String operation) {
+        return new Owner(Domain.ASYNC_IO, Objects.requireNonNull(server, "server"), null, 0, 0, 0, 0, null, null, operation);
+    }
+
+    public static Scope enterGlobal(final MinecraftServer server, final String operation) {
+        return enter(global(server, operation));
+    }
+
+    public static Scope enterRegion(
+        final ServerLevel level,
+        final int minChunkX,
+        final int minChunkZ,
+        final int maxChunkX,
+        final int maxChunkZ,
+        final String operation
+    ) {
+        return enter(region(level, minChunkX, minChunkZ, maxChunkX, maxChunkZ, operation));
+    }
+
+    public static Scope enter(final Owner owner) {
+        final OwnerContext previous = CURRENT_OWNER.get();
+        CURRENT_OWNER.set(new OwnerContext(owner, previous));
+        return new Scope(previous);
+    }
+
+    public static @Nullable Owner currentOwner() {
+        final OwnerContext context = CURRENT_OWNER.get();
+        return context == null ? null : context.owner();
+    }
+
+    public static Domain currentDomain() {
+        final OwnerContext context = CURRENT_OWNER.get();
+        return context == null ? Domain.ASYNC_IO : context.owner().domain();
+    }
+
+    public static boolean canRunSynchronousCallbacks() {
+        final Domain domain = currentDomain();
+        return domain == Domain.GLOBAL_CONTROL || domain == Domain.REGION || domain == Domain.PLAYER;
+    }
+
+    public static boolean isOwner(final Owner owner) {
+        for (OwnerContext context = CURRENT_OWNER.get(); context != null; context = context.previous()) {
+            if (context.owner().contains(owner)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    public static boolean isGlobalOwner(final MinecraftServer server) {
+        return isOwner(global(server, "global-owner-check"));
+    }
+
+    public static void assertOwner(final Owner owner, final String operation) {
+        if (!isOwner(owner)) {
+            throw new IllegalStateException("Owner-domain violation: " + operation + " requires " + owner.describe());
+        }
+    }
+
+    public static void assertGlobalOwner(final MinecraftServer server, final String operation) {
+        assertOwner(global(server, operation), operation);
+    }
+
+    public static void runRegionNow(
+        final ServerLevel level,
+        final int minChunkX,
+        final int minChunkZ,
+        final int maxChunkX,
+        final int maxChunkZ,
+        final String operation,
+        final Runnable task
+    ) {
+        Objects.requireNonNull(level, "level");
+        Objects.requireNonNull(operation, "operation");
+        Objects.requireNonNull(task, "task");
+        final TickRegions.RegionContext context = TickRegions.pushRegionContext(level, minChunkX, minChunkZ, maxChunkX, maxChunkZ);
+        try {
+            try (Scope ignored = enterRegion(level, minChunkX, minChunkZ, maxChunkX, maxChunkZ, operation)) {
+                task.run();
+            }
+        } finally {
+            TickRegions.popContext(context);
+        }
+    }
+
+    public static void execute(final Owner owner, final Runnable task) {
+        Objects.requireNonNull(owner, "owner");
+        Objects.requireNonNull(task, "task");
+        if (isOwner(owner)) {
+            task.run();
+            return;
+        }
+
+        switch (owner.domain()) {
+            case GLOBAL_CONTROL -> enqueueGlobal(owner, task);
+            case REGION -> enqueueRegion(owner, task);
+            case PLAYER -> enqueuePlayer(owner, task);
+            case LOGIN -> LOGIN_EXECUTOR.execute(wrap(owner, task));
+            case ASYNC_IO -> Util.nonCriticalIoPool().execute(wrap(owner, task));
+        }
+    }
+
+    public static CompletableFuture<Void> submit(final Owner owner, final Runnable task) {
+        return supply(owner, () -> {
+            task.run();
+            return null;
+        });
+    }
+
+    public static <T> CompletableFuture<T> supply(final Owner owner, final Supplier<T> supplier) {
+        Objects.requireNonNull(owner, "owner");
+        Objects.requireNonNull(supplier, "supplier");
+        if (isOwner(owner)) {
+            try {
+                return CompletableFuture.completedFuture(supplier.get());
+            } catch (final Throwable throwable) {
+                return CompletableFuture.failedFuture(throwable);
+            }
+        }
+
+        final CompletableFuture<T> future = new CompletableFuture<>();
+        execute(owner, () -> {
+            try {
+                future.complete(supplier.get());
+            } catch (final Throwable throwable) {
+                future.completeExceptionally(throwable);
+            }
+        });
+        return future;
+    }
+
+    private static void enqueueGlobal(final Owner owner, final Runnable task) {
+        final MinecraftServer server = owner.server();
+        if (server == null || server.hasStopped()) {
+            throw new RejectedExecutionException("Server is unavailable for " + owner.describe());
+        }
+        server.execute(wrap(owner, task));
+    }
+
+    private static void enqueueRegion(final Owner owner, final Runnable task) {
+        final ServerLevel level = owner.level();
+        if (level == null) {
+            throw new RejectedExecutionException("Region owner has no level: " + owner.describe());
+        }
+        TickRegions.sendCrossRegionMessage(
+            level,
+            owner.chunkX(),
+            owner.chunkZ(),
+            "owner-domain:" + owner.operation(),
+            wrap(owner, task)
+        );
+    }
+
+    private static void enqueuePlayer(final Owner owner, final Runnable task) {
+        final ServerPlayer player = owner.player();
+        if (player == null || player.hasDisconnected()) {
+            return;
+        }
+        final Owner currentLocation = player(player, owner.operation());
+        enqueueRegion(currentLocation, () -> {
+            if (!player.hasDisconnected() && player.getUUID().equals(owner.playerId())) {
+                wrap(currentLocation, task).run();
+            }
+        });
+    }
+
+    private static Runnable wrap(final Owner owner, final Runnable task) {
+        return () -> {
+            try (Scope ignored = enter(owner)) {
+                task.run();
+            }
+        };
+    }
+
+    private record OwnerContext(Owner owner, @Nullable OwnerContext previous) {
+    }
+
+    public static final class Scope implements AutoCloseable {
+        private final @Nullable OwnerContext previous;
+        private boolean closed;
+
+        private Scope(final @Nullable OwnerContext previous) {
+            this.previous = previous;
+        }
+
+        @Override
+        public void close() {
+            if (this.closed) {
+                return;
+            }
+            this.closed = true;
+            CURRENT_OWNER.set(this.previous);
+        }
+    }
+
+    public record Owner(
+        Domain domain,
+        @Nullable MinecraftServer server,
+        @Nullable ServerLevel level,
+        int minChunkX,
+        int minChunkZ,
+        int maxChunkX,
+        int maxChunkZ,
+        @Nullable UUID playerId,
+        @Nullable ServerPlayer player,
+        String operation
+    ) {
+
+        private boolean contains(final Owner requested) {
+            if (this.domain == Domain.PLAYER && requested.domain == Domain.PLAYER) {
+                return Objects.equals(this.playerId, requested.playerId);
+            }
+            if (this.domain != requested.domain) {
+                return false;
+            }
+            if (this.server != requested.server) {
+                return false;
+            }
+            if (this.domain == Domain.REGION || this.domain == Domain.PLAYER) {
+                return this.level == requested.level
+                    && requested.minChunkX >= this.minChunkX
+                    && requested.maxChunkX <= this.maxChunkX
+                    && requested.minChunkZ >= this.minChunkZ
+                    && requested.maxChunkZ <= this.maxChunkZ;
+            }
+            return true;
+        }
+
+        private int chunkX() {
+            return this.minChunkX;
+        }
+
+        private int chunkZ() {
+            return this.minChunkZ;
+        }
+
+        private String describe() {
+            return switch (this.domain) {
+                case GLOBAL_CONTROL -> "GLOBAL_CONTROL(" + this.operation + ")";
+                case REGION -> "REGION(" + this.level.dimension().identifier() + " ["
+                    + this.minChunkX + "," + this.minChunkZ + " -> " + this.maxChunkX + "," + this.maxChunkZ + "], "
+                    + this.operation + ")";
+                case PLAYER -> "PLAYER(" + this.playerId + ", " + this.operation + ")";
+                case LOGIN -> "LOGIN(" + this.operation + ")";
+                case ASYNC_IO -> "ASYNC_IO(" + this.operation + ")";
+            };
+        }
+    }
+
+    private static final class NamedThreadFactory implements ThreadFactory {
+        private final String namePrefix;
+        private final AtomicInteger nextId = new AtomicInteger(1);
+
+        private NamedThreadFactory(final String namePrefix) {
+            this.namePrefix = namePrefix;
+        }
+
+        @Override
+        public Thread newThread(final Runnable runnable) {
+            final Thread thread = new Thread(runnable, this.namePrefix + " #" + this.nextId.getAndIncrement());
+            thread.setDaemon(true);
+            return thread;
+        }
+    }
+}
