+    // Loom start - shared per-entity tick body + experimental parallel entity ticking (Stage 3)
+    private void tickOneEntity(final Entity entity) {
+        if (entity.isRemoved() || this.tickRateManager().isEntityFrozen(entity)) {
+            return;
+        }
+        entity.checkDespawn();
+        final Entity vehicle = entity.getVehicle();
+        if (vehicle != null) {
+            if (!vehicle.isRemoved() && vehicle.hasPassenger(entity)) {
+                return;
+            }
+            entity.stopRiding();
+        }
+        this.guardEntityTick(this::tickNonPassenger, entity);
+    }
+
+    // Tick entities bucketed by region, running non-adjacent regions concurrently. The non-adjacency
+    // buffer keeps parallel regions far enough apart that an entity's bounded per-tick movement and its
+    // interaction range stay inside its own region; cross-region side effects (block writes, scheduled
+    // ticks, spawns) are staged and replayed serially after the parallel phase.
+    private void tickEntitiesInParallel() {
+        final java.util.List<Entity> toTick = new java.util.ArrayList<>();
+        this.entityTickList.forEach(toTick::add);
+        final int count = toTick.size();
+        final int shift = net.minecraft.server.threading.TickRegions.getRegionChunkShift();
+        final it.unimi.dsi.fastutil.longs.Long2ObjectMap<java.util.List<Entity>> byRegion =
+            new it.unimi.dsi.fastutil.longs.Long2ObjectOpenHashMap<>();
+        for (int i = 0; i < count; ++i) {
+            final Entity e = toTick.get(i);
+            final ChunkPos cp = e.chunkPosition();
+            final long key = (((long) (cp.x() >> shift)) << 32) | ((cp.z() >> shift) & 0xFFFFFFFFL);
+            byRegion.computeIfAbsent(key, k -> new java.util.ArrayList<>()).add(e);
+        }
+        if (byRegion.size() <= 1) {
+            for (int i = 0; i < count; ++i) {
+                this.tickOneEntity(toTick.get(i));
+            }
+            return;
+        }
+        final java.util.List<net.minecraft.server.threading.TickRegions.RegionBoundTask> tasks = new java.util.ArrayList<>(byRegion.size());
+        for (final java.util.List<Entity> regionEntities : byRegion.values()) {
+            int minX = Integer.MAX_VALUE, minZ = Integer.MAX_VALUE, maxX = Integer.MIN_VALUE, maxZ = Integer.MIN_VALUE;
+            for (int i = 0, n = regionEntities.size(); i < n; ++i) {
+                final ChunkPos cp = regionEntities.get(i).chunkPosition();
+                if (cp.x() < minX) { minX = cp.x(); }
+                if (cp.x() > maxX) { maxX = cp.x(); }
+                if (cp.z() < minZ) { minZ = cp.z(); }
+                if (cp.z() > maxZ) { maxZ = cp.z(); }
+            }
+            final int fMinX = minX, fMinZ = minZ, fMaxX = maxX, fMaxZ = maxZ;
+            tasks.add(new net.minecraft.server.threading.TickRegions.RegionBoundTask(fMinX, fMinZ, fMinX, fMinZ, fMaxX, fMaxZ, () -> {
+                net.minecraft.server.threading.RegionTickStaging.begin();
+                try {
+                    for (int i = 0, n = regionEntities.size(); i < n; ++i) {
+                        this.tickOneEntity(regionEntities.get(i));
+                    }
+                } finally {
+                    net.minecraft.server.threading.RegionTickStaging.end();
+                }
+            }));
+        }
+        net.minecraft.server.threading.TickRegions.runRegionBoundTasksFromCurrentContext(this, tasks, "entityTick");
+        net.minecraft.server.threading.RegionTickStaging.applyAndClear();
+    }
+    // Loom end
+
     public void tickNonPassenger(final Entity entity) {
         // Paper start - log detailed entity tick information
         ca.spottedleaf.moonrise.common.util.TickThread.ensureTickThread(entity, "Cannot tick an entity off-main");
