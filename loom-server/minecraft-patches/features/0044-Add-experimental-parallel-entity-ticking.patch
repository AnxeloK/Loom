-        this.moonrise$midTickTasks(); // Paper - rewrite chunk system
+        // Loom - inside the parallel entity-tick phase a region worker only holds its region sub-lease;
+        // draining mid-tick tasks here would try to claim the full-level lease and conflict with the other
+        // workers. Skip it under staging; the owning thread drains these tasks after the parallel phase.
+        if (!net.minecraft.server.threading.RegionTickStaging.isStaging()) {
+            this.moonrise$midTickTasks(); // Paper - rewrite chunk system
+        }
     }
 
