From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: anxelok <anxelok@localhost>
Date: Wed, 17 Jun 2026 22:18:51 +0000
Subject: [PATCH] Add non-adjacency buffer to region-task bucketing


diff --git a/net/minecraft/server/threading/TickRegions.java b/net/minecraft/server/threading/TickRegions.java
index 3e6f5f09c05d29035bc73515d9d01c25a06c978b..e2be7edb8c284abedbe4dd43a4e2929cb2642e68 100644
--- a/net/minecraft/server/threading/TickRegions.java
+++ b/net/minecraft/server/threading/TickRegions.java
@@ -114,6 +114,11 @@ public class TickRegions {
     // When enabled, independent worlds (overworld/nether/end and any others) tick concurrently on the region
     // pool, each on a single thread holding its own full-level lease. Each world stays internally serial.
     public static final boolean PARALLEL_WORLDS_ENABLED = Boolean.getBoolean("loom.parallelWorlds");
+    // Loom - non-adjacency buffer (in chunks) between region-task buckets that run in parallel. A block
+    // update fans out at most ~1 chunk, so buckets within this many chunks of each other are merged to tick
+    // together, guaranteeing parallel buckets cannot race on a shared edge chunk. This is the load-bearing
+    // safety primitive for intra-world parallel ticking. Higher = safer but coarser (less parallelism).
+    static final int REGION_TASK_BUFFER_CHUNKS = Math.max(0, Integer.getInteger("loom.regionTaskBufferChunks", 1));
     private static final int DIAGNOSTIC_EVENT_LIMIT = Math.max(
         64,
         Integer.getInteger("paper.threadedregions.diagnostics.eventLimit", 512)
@@ -2172,17 +2177,21 @@ public class TickRegions {
         }
 
         private boolean intersects(final RegionBoundTask task) {
-            return this.minChunkX <= task.maxChunkX()
-                && this.maxChunkX >= task.minChunkX()
-                && this.minChunkZ <= task.maxChunkZ()
-                && this.maxChunkZ >= task.minChunkZ();
+            // Loom - expand by the non-adjacency buffer so buckets within REGION_TASK_BUFFER_CHUNKS of each
+            // other are treated as overlapping and merged; parallel buckets are then guaranteed a chunk gap.
+            final int b = REGION_TASK_BUFFER_CHUNKS;
+            return this.minChunkX - b <= task.maxChunkX()
+                && this.maxChunkX + b >= task.minChunkX()
+                && this.minChunkZ - b <= task.maxChunkZ()
+                && this.maxChunkZ + b >= task.minChunkZ();
         }
 
         private boolean intersects(final RegionBoundBucket other) {
-            return this.minChunkX <= other.maxChunkX
-                && this.maxChunkX >= other.minChunkX
-                && this.minChunkZ <= other.maxChunkZ
-                && this.maxChunkZ >= other.minChunkZ;
+            final int b = REGION_TASK_BUFFER_CHUNKS;
+            return this.minChunkX - b <= other.maxChunkX
+                && this.maxChunkX + b >= other.minChunkX
+                && this.minChunkZ - b <= other.maxChunkZ
+                && this.maxChunkZ + b >= other.minChunkZ;
         }
 
         private void absorb(final RegionBoundBucket other) {
