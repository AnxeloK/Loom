+        private void indexLease(final Lease lease) {
+            this.leasesByThread.compute(lease.ownerThreadId, (ignored, existing) -> {
+                if (existing == null) {
+                    return new Lease[] { lease };
+                }
+                final Lease[] next = java.util.Arrays.copyOf(existing, existing.length + 1);
+                next[existing.length] = lease;
+                return next;
+            });
+        }
+
+        private void unindexLease(final Lease lease) {
+            this.leasesByThread.computeIfPresent(lease.ownerThreadId, (ignored, existing) -> {
+                int index = -1;
+                for (int i = 0, len = existing.length; i < len; ++i) {
+                    if (existing[i].id == lease.id) {
+                        index = i;
+                        break;
+                    }
+                }
+                if (index < 0) {
+                    return existing;
+                }
+                if (existing.length == 1) {
+                    return null;
+                }
+                final Lease[] next = new Lease[existing.length - 1];
+                System.arraycopy(existing, 0, next, 0, index);
+                System.arraycopy(existing, index + 1, next, index, existing.length - 1 - index);
+                return next;
+            });
+        }
+
