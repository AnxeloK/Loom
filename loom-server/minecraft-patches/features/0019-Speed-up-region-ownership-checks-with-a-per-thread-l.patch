From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: anxelok <anxelok@localhost>
Date: Fri, 3 Jul 2026 11:48:23 +0000
Subject: [PATCH] Speed up region ownership checks with a per-thread lease
 index

Ownership checks previously took the per-world lease lock and scanned
every active lease on each query. Under parallel ticking every worker
funnels through that lock on the hottest path in the runtime, so the
lock becomes a serialization point.

Keep a copy-on-write array of leases per owner thread id, maintained
under the existing lock on claim and release. Reads are self-queries
(a thread asking about its own leases), so they now fetch their own
array from a concurrent map and scan it without locking.

diff --git a/net/minecraft/server/threading/RegionRuntime.java b/net/minecraft/server/threading/RegionRuntime.java
index 6acf234a7d52822bb9df4b41667eeee7ad6083d2..463821f22568665845bfca3213f79775b9bdaebe 100644
--- a/net/minecraft/server/threading/RegionRuntime.java
+++ b/net/minecraft/server/threading/RegionRuntime.java
@@ -232,6 +232,11 @@ public class RegionRuntime {
 
         private final java.util.concurrent.locks.ReentrantLock lock = new java.util.concurrent.locks.ReentrantLock();
         private final Map<Long, Lease> leases = new HashMap<>();
+        // Loom - per-thread copy-on-write lease index for lock-free ownership reads. Ownership checks are
+        // the hottest path in the runtime and are always self-queries (a thread asking about its own
+        // leases), so reads scan a small immutable array fetched by thread id instead of taking the world
+        // lock that claim/release use. Mutated only while holding `lock`.
+        private final ConcurrentHashMap<Long, Lease[]> leasesByThread = new ConcurrentHashMap<>();
         private final Map<Long, RegionDescriptor> regions = new HashMap<>();
         private final Map<Long, Integer> regionReferenceCounts = new HashMap<>();
         private long createdRegions;
@@ -275,6 +280,7 @@ public class RegionRuntime {
                     if (prev != null) {
                         throw new IllegalStateException("Duplicate lease id: " + lease.id);
                     }
+                    this.indexLease(lease);
                     this.regionReferenceCounts.put(regionId, 1);
                     return;
                 }
@@ -305,6 +311,7 @@ public class RegionRuntime {
                 if (prev != null) {
                     throw new IllegalStateException("Duplicate lease id: " + lease.id);
                 }
+                this.indexLease(lease);
                 this.regionReferenceCounts.merge(regionId, 1, Integer::sum);
 
                 final RegionDescriptor regionDescriptor = this.regions.get(regionId);
