From: anxelok <anxelok@localhost>
Date: Tue, 9 Jun 2026 23:05:18 +0000
Subject: [PATCH] Add tick-start chunk drain diagnostics


diff --git a/ca/spottedleaf/moonrise/patches/chunk_system/scheduling/ChunkTaskScheduler.java b/ca/spottedleaf/moonrise/patches/chunk_system/scheduling/ChunkTaskScheduler.java
index e2fa3cfd9361880ff23dfb3e2935f7416e2a4647..fe6353566092a4248426a351c2392cc3eb9ae016 100644
--- a/ca/spottedleaf/moonrise/patches/chunk_system/scheduling/ChunkTaskScheduler.java
+++ b/ca/spottedleaf/moonrise/patches/chunk_system/scheduling/ChunkTaskScheduler.java
@@ -340,13 +340,22 @@ public final class ChunkTaskScheduler {
 
     // run only tasks queued before this function was invoked
     public void executeAllRecentlyQueuedMainThreadTasks() {
+        this.executeAllRecentlyQueuedMainThreadTasksCount();
+    }
+
+    // run only tasks queued before this function was invoked
+    public long executeAllRecentlyQueuedMainThreadTasksCount() {
         // note: order of retrieval is important to avoid race conditions
         final long executed = this.mainThreadExecutor.getTotalTasksExecuted();
         final long scheduled = this.mainThreadExecutor.getTotalTasksScheduled();
 
         final long left = scheduled - executed;
         // may execute more tasks than expected due to recursion
-        for (long i = 0; i < left && this.mainThreadExecutor.executeTask(); ++i);
+        long ran = 0L;
+        for (long i = 0; i < left && this.mainThreadExecutor.executeTask(); ++i) {
+            ++ran;
+        }
+        return ran;
     }
 
     public void raisePriority(final int x, final int z, final Priority priority) {
diff --git a/net/minecraft/server/MinecraftServer.java b/net/minecraft/server/MinecraftServer.java
index b8ca941fcf03019c6ee2871ca1bf25914c34a70c..5fb98e98f87d03a472acba516b004ffd4c15c7de 100644
--- a/net/minecraft/server/MinecraftServer.java
+++ b/net/minecraft/server/MinecraftServer.java
@@ -210,6 +210,11 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
         250_000L,
         Long.getLong("Loom.PacketTickStartBudgetNanos", 2_000_000L)
     );
+    private static final boolean LOOM_TICK_START_DRAIN_DIAGNOSTICS = Boolean.getBoolean("Loom.TickStartDrainDiagnostics");
+    private static final long LOOM_TICK_START_DRAIN_DIAGNOSTIC_INTERVAL_NANOS = Math.max(
+        1_000_000_000L,
+        Long.getLong("Loom.TickStartDrainDiagnosticIntervalNanos", 5_000_000_000L)
+    );
     private static final long OVERLOADED_THRESHOLD_NANOS = 30L * TimeUtil.NANOSECONDS_PER_SECOND / 20L; // CraftBukkit
     private static final int OVERLOADED_TICKS_THRESHOLD = 20;
     private static final long OVERLOADED_WARNING_INTERVAL_NANOS = 10L * TimeUtil.NANOSECONDS_PER_SECOND;
@@ -1233,9 +1238,97 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
         private long nanos;
     }
 
+    private long loomLastTickStartDrainDiagnosticNanos;
+    private long loomTickStartDrainDiagnosticTicks;
+    private long loomTickStartDrainWorlds;
+    private long loomTickStartDrainTicketUpdateNanos;
+    private long loomTickStartDrainTicketUpdateMaxNanos;
+    private long loomTickStartDrainLegacyTasks;
+    private long loomTickStartDrainLegacyTasksMax;
+    private long loomTickStartDrainLegacyTaskNanos;
+    private long loomTickStartDrainLegacyTaskMaxNanos;
+    private long loomTickStartDrainChunkTasks;
+    private long loomTickStartDrainChunkTasksMax;
+    private long loomTickStartDrainChunkTaskNanos;
+    private long loomTickStartDrainChunkTaskMaxNanos;
+
+    private static final class TickStartChunkDrain {
+        private int worlds;
+        private long ticketUpdateNanos;
+        private long legacyTasks;
+        private long legacyTaskNanos;
+        private long chunkTasks;
+        private long chunkTaskNanos;
+    }
+
+    private void recordTickStartChunkDrain(final TickStartChunkDrain drain) {
+        if (!LOOM_TICK_START_DRAIN_DIAGNOSTICS) {
+            return;
+        }
+
+        final long now = Util.getNanos();
+        if (this.loomLastTickStartDrainDiagnosticNanos == 0L) {
+            this.loomLastTickStartDrainDiagnosticNanos = now;
+        }
+
+        ++this.loomTickStartDrainDiagnosticTicks;
+        this.loomTickStartDrainWorlds += drain.worlds;
+        this.loomTickStartDrainTicketUpdateNanos += drain.ticketUpdateNanos;
+        this.loomTickStartDrainTicketUpdateMaxNanos = Math.max(this.loomTickStartDrainTicketUpdateMaxNanos, drain.ticketUpdateNanos);
+        this.loomTickStartDrainLegacyTasks += drain.legacyTasks;
+        this.loomTickStartDrainLegacyTasksMax = Math.max(this.loomTickStartDrainLegacyTasksMax, drain.legacyTasks);
+        this.loomTickStartDrainLegacyTaskNanos += drain.legacyTaskNanos;
+        this.loomTickStartDrainLegacyTaskMaxNanos = Math.max(this.loomTickStartDrainLegacyTaskMaxNanos, drain.legacyTaskNanos);
+        this.loomTickStartDrainChunkTasks += drain.chunkTasks;
+        this.loomTickStartDrainChunkTasksMax = Math.max(this.loomTickStartDrainChunkTasksMax, drain.chunkTasks);
+        this.loomTickStartDrainChunkTaskNanos += drain.chunkTaskNanos;
+        this.loomTickStartDrainChunkTaskMaxNanos = Math.max(this.loomTickStartDrainChunkTaskMaxNanos, drain.chunkTaskNanos);
+
+        if ((now - this.loomLastTickStartDrainDiagnosticNanos) < LOOM_TICK_START_DRAIN_DIAGNOSTIC_INTERVAL_NANOS) {
+            return;
+        }
+
+        final long ticks = Math.max(1L, this.loomTickStartDrainDiagnosticTicks);
+        LOGGER.info(
+            "[loom.tick-start-drain] ticks={} worlds={} ticket_ms(avg_tick/max_tick)={}/{} " +
+                "legacy_tasks(total/max_tick)={}/{} legacy_ms(avg_tick/max_tick)={}/{} " +
+                "chunk_tasks(total/max_tick)={}/{} chunk_ms(avg_tick/max_tick)={}/{}",
+            ticks,
+            this.loomTickStartDrainWorlds,
+            formatNanosAsMillis(this.loomTickStartDrainTicketUpdateNanos / ticks),
+            formatNanosAsMillis(this.loomTickStartDrainTicketUpdateMaxNanos),
+            this.loomTickStartDrainLegacyTasks,
+            this.loomTickStartDrainLegacyTasksMax,
+            formatNanosAsMillis(this.loomTickStartDrainLegacyTaskNanos / ticks),
+            formatNanosAsMillis(this.loomTickStartDrainLegacyTaskMaxNanos),
+            this.loomTickStartDrainChunkTasks,
+            this.loomTickStartDrainChunkTasksMax,
+            formatNanosAsMillis(this.loomTickStartDrainChunkTaskNanos / ticks),
+            formatNanosAsMillis(this.loomTickStartDrainChunkTaskMaxNanos)
+        );
+        this.loomLastTickStartDrainDiagnosticNanos = now;
+        this.loomTickStartDrainDiagnosticTicks = 0L;
+        this.loomTickStartDrainWorlds = 0L;
+        this.loomTickStartDrainTicketUpdateNanos = 0L;
+        this.loomTickStartDrainTicketUpdateMaxNanos = 0L;
+        this.loomTickStartDrainLegacyTasks = 0L;
+        this.loomTickStartDrainLegacyTasksMax = 0L;
+        this.loomTickStartDrainLegacyTaskNanos = 0L;
+        this.loomTickStartDrainLegacyTaskMaxNanos = 0L;
+        this.loomTickStartDrainChunkTasks = 0L;
+        this.loomTickStartDrainChunkTasksMax = 0L;
+        this.loomTickStartDrainChunkTaskNanos = 0L;
+        this.loomTickStartDrainChunkTaskMaxNanos = 0L;
+    }
+
+    private static String formatNanosAsMillis(final long nanos) {
+        return String.format(Locale.ROOT, "%.3f", (double)nanos / 1_000_000.0D);
+    }
+
     private void runAllTasksAtTickStart() {
         this.startMeasuringTaskExecutionTime();
         final TickStartPacketDrain packetDrain = new TickStartPacketDrain();
+        final TickStartChunkDrain chunkDrain = LOOM_TICK_START_DRAIN_DIAGNOSTICS ? new TickStartChunkDrain() : null;
 
         // note: To avoid possibly spinning forever, only execute tasks that are roughly available at the beginning
         //       of this call. Packet processing and chunk system tasks are possibly always being queued.
@@ -1271,11 +1364,30 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
             try {
                 // note: legacy tasks may expect a distance manager update
                 profiler.push("moonrise:distance_manager_update");
+                final long ticketStart = chunkDrain == null ? 0L : Util.getNanos();
                 ((ca.spottedleaf.moonrise.patches.chunk_system.level.ChunkSystemServerLevel)world).moonrise$getChunkTaskScheduler().chunkHolderManager.processTicketUpdates();
+                if (chunkDrain != null) {
+                    ++chunkDrain.worlds;
+                    chunkDrain.ticketUpdateNanos += Math.max(0L, Util.getNanos() - ticketStart);
+                }
                 profiler.popPush("moonrise:legacy_chunk_tasks");
-                world.getChunkSource().mainThreadProcessor.executeAllRecentInternalTasks();
+                if (chunkDrain == null) {
+                    world.getChunkSource().mainThreadProcessor.executeAllRecentInternalTasks();
+                } else {
+                    final long legacyStart = Util.getNanos();
+                    final int legacyTasks = world.getChunkSource().mainThreadProcessor.executeAllRecentInternalTasksCount();
+                    chunkDrain.legacyTasks += legacyTasks;
+                    chunkDrain.legacyTaskNanos += Math.max(0L, Util.getNanos() - legacyStart);
+                }
                 profiler.popPush("moonrise:chunk_system_tasks");
-                ((ca.spottedleaf.moonrise.patches.chunk_system.level.ChunkSystemServerLevel)world).moonrise$getChunkTaskScheduler().executeAllRecentlyQueuedMainThreadTasks();
+                if (chunkDrain == null) {
+                    ((ca.spottedleaf.moonrise.patches.chunk_system.level.ChunkSystemServerLevel)world).moonrise$getChunkTaskScheduler().executeAllRecentlyQueuedMainThreadTasks();
+                } else {
+                    final long chunkStart = Util.getNanos();
+                    final long chunkTasks = ((ca.spottedleaf.moonrise.patches.chunk_system.level.ChunkSystemServerLevel)world).moonrise$getChunkTaskScheduler().executeAllRecentlyQueuedMainThreadTasksCount();
+                    chunkDrain.chunkTasks += chunkTasks;
+                    chunkDrain.chunkTaskNanos += Math.max(0L, Util.getNanos() - chunkStart);
+                }
                 profiler.pop();
             } finally {
                 net.minecraft.server.threading.TickRegions.popContext(tickStartContext);
@@ -1287,6 +1399,9 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
         profiler.pop(); // moonrise:run_all_chunk
         profiler.pop(); // moonrise:run_all_tasks
 
+        if (chunkDrain != null) {
+            this.recordTickStartChunkDrain(chunkDrain);
+        }
         this.recordTickStartPacketDrain(packetDrain);
         this.finishMeasuringTaskExecutionTime();
     }
