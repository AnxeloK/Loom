From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: anxelok <anxelok@localhost>
Date: Fri, 19 Jun 2026 16:42:01 +0000
Subject: [PATCH] Tick multipart/boss entities on the region owner under
 parallel entity ticking

The Ender Dragon (EnderDragon) and its EnderDragonPart sub-entities move
and remove across region boundaries within a single tick. When ticked in a
parallel region bucket on a region scheduler thread, that cross-region
move/remove fails Moonrise's per-region off-main thread check
(EntityLookup$EntityCallback.onRemove / onMove).

Partition the parallel entity-tick list: parallel-safe entities go through
the region buckets as before; entities that must tick on the region owner
(currently EnderDragon + EnderDragonPart) are excluded from the buckets and
ticked serially on the world-owning thread after the parallel phase joins.
The owning thread holds the full-level lease there, so their cross-region
move/remove passes the thread check. The serial (flags-off) path is
unchanged.


diff --git a/net/minecraft/server/level/ServerLevel.java b/net/minecraft/server/level/ServerLevel.java
index 352d3a455e77b742dcbf6c0427b7c3222fd0b71d..8085c43e442ef59c33a9b29eba62ea60ca6236e0 100644
--- a/net/minecraft/server/level/ServerLevel.java
+++ b/net/minecraft/server/level/ServerLevel.java
@@ -1420,10 +1420,21 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
         this.guardEntityTick(this::tickNonPassenger, entity);
     }
 
+    // Multipart/boss entities (e.g. the Ender Dragon and its EnderDragonPart sub-entities) move and remove
+    // across region boundaries within a single tick, which violates Moonrise's per-region "off-main" thread
+    // check when ticked in a parallel region bucket. Such entities must be ticked on the world-owning thread,
+    // which holds the full-level lease, so their cross-region move/remove always passes the thread check.
+    private static boolean mustTickOnRegionOwner(final Entity entity) {
+        return entity instanceof net.minecraft.world.entity.boss.enderdragon.EnderDragon
+            || entity instanceof net.minecraft.world.entity.boss.enderdragon.EnderDragonPart;
+    }
+
     // Tick entities bucketed by region, running non-adjacent regions concurrently. The non-adjacency
     // buffer keeps parallel regions far enough apart that an entity's bounded per-tick movement and its
     // interaction range stay inside its own region; cross-region side effects (block writes, scheduled
-    // ticks, spawns) are staged and replayed serially after the parallel phase.
+    // ticks, spawns) are staged and replayed serially after the parallel phase. Entities that are unsafe to
+    // tick off-main (see mustTickOnRegionOwner) are excluded from the parallel buckets and ticked serially on
+    // the world-owning thread after the parallel phase joins.
     private void tickEntitiesInParallel() {
         final java.util.List<Entity> toTick = new java.util.ArrayList<>();
         this.entityTickList.forEach(toTick::add);
@@ -1431,13 +1442,23 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
         final int shift = net.minecraft.server.threading.TickRegions.getRegionChunkShift();
         final it.unimi.dsi.fastutil.longs.Long2ObjectMap<java.util.List<Entity>> byRegion =
             new it.unimi.dsi.fastutil.longs.Long2ObjectOpenHashMap<>();
+        java.util.List<Entity> ownerTick = null;
         for (int i = 0; i < count; ++i) {
             final Entity e = toTick.get(i);
+            if (mustTickOnRegionOwner(e)) {
+                if (ownerTick == null) {
+                    ownerTick = new java.util.ArrayList<>();
+                }
+                ownerTick.add(e);
+                continue;
+            }
             final ChunkPos cp = e.chunkPosition();
             final long key = (((long) (cp.x() >> shift)) << 32) | ((cp.z() >> shift) & 0xFFFFFFFFL);
             byRegion.computeIfAbsent(key, k -> new java.util.ArrayList<>()).add(e);
         }
         if (byRegion.size() <= 1) {
+            // Only one parallel region (or none): no parallelism to gain, so tick everything — including the
+            // owner-bound entities — serially on this (the world-owning) thread.
             for (int i = 0; i < count; ++i) {
                 this.tickOneEntity(toTick.get(i));
             }
@@ -1471,6 +1492,13 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
         }
         net.minecraft.server.threading.TickRegions.runRegionBoundTasksFromCurrentContext(this, tasks, "entityTick");
         net.minecraft.server.threading.RegionTickStaging.applyAndClear(stagingSession, this);
+        // The parallel phase has joined; we are back on the world-owning thread holding the full-level lease.
+        // Tick the owner-bound (multipart/boss) entities here so their cross-region move/remove is on-owner.
+        if (ownerTick != null) {
+            for (int i = 0, n = ownerTick.size(); i < n; ++i) {
+                this.tickOneEntity(ownerTick.get(i));
+            }
+        }
     }
     // Loom end
 
