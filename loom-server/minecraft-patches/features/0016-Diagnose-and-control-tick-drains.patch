diff --git a/net/minecraft/server/level/LoomTickSectionDiagnostics.java b/net/minecraft/server/level/LoomTickSectionDiagnostics.java
new file mode 100644
index 0000000000000000000000000000000000000000..85da845af413754031e7ebfb94e2f7bd20412a22
--- /dev/null
+++ b/net/minecraft/server/level/LoomTickSectionDiagnostics.java
@@ -0,0 +1,161 @@
+package net.minecraft.server.level;
+
+import com.mojang.logging.LogUtils;
+import java.util.Arrays;
+import java.util.Locale;
+import org.slf4j.Logger;
+
+final class LoomTickSectionDiagnostics {
+    static final boolean ENABLED = Boolean.getBoolean("Loom.TickSectionDiagnostics");
+
+    static final int WORLD_SETUP = 0;
+    static final int PENDING_TICKS = 1;
+    static final int RAID = 2;
+    static final int CHUNK_SOURCE = 3;
+    static final int BLOCK_EVENTS = 4;
+    static final int ENTITY_ACTIVATION = 5;
+    static final int ENTITY_DESPAWN = 6;
+    static final int ENTITY_TICK = 7;
+    static final int BLOCK_ENTITIES = 8;
+    static final int ENTITY_MANAGEMENT = 9;
+    static final int DEBUG = 10;
+    static final int CHUNK_DISTANCE = 11;
+    static final int CHUNK_PLAYER_LOADER = 12;
+    static final int CHUNK_TICK_CHUNKS = 13;
+    static final int CHUNK_MAP_TICK = 14;
+    static final int CHUNK_UNLOAD = 15;
+    static final int CHUNK_CLEAR_CACHE = 16;
+    static final int CHUNK_NATURAL_SPAWN_COUNT = 17;
+    static final int CHUNK_SPAWN_SETUP = 18;
+    static final int CHUNK_COLLECT_SPAWNING = 19;
+    static final int CHUNK_SHUFFLE_SPAWNING = 20;
+    static final int CHUNK_SPAWNING_CHUNKS = 21;
+    static final int CHUNK_BROADCAST = 22;
+    static final int CHUNK_TICKING_CHUNKS = 23;
+    static final int CHUNK_CUSTOM_SPAWNERS = 24;
+
+    private static final int SECTION_COUNT = 25;
+    private static final long LOG_INTERVAL_NANOS = Math.max(
+        1_000_000_000L, Long.getLong("Loom.TickSectionDiagnosticIntervalNanos", 5_000_000_000L)
+    );
+    private static final Logger LOGGER = LogUtils.getLogger();
+    private static final String[] SECTION_NAMES = {
+        "world_setup",
+        "pending_ticks",
+        "raid",
+        "chunk_source",
+        "block_events",
+        "entity_activation",
+        "entity_despawn",
+        "entity_tick",
+        "block_entities",
+        "entity_management",
+        "debug",
+        "chunk_distance",
+        "chunk_player_loader",
+        "chunk_tick_chunks",
+        "chunk_map_tick",
+        "chunk_unload",
+        "chunk_clear_cache",
+        "chunk_natural_spawn_count",
+        "chunk_spawn_setup",
+        "chunk_collect_spawning",
+        "chunk_shuffle_spawning",
+        "chunk_spawning_chunks",
+        "chunk_broadcast",
+        "chunk_ticking_chunks",
+        "chunk_custom_spawners",
+    };
+
+    private final long[] currentNanos = new long[SECTION_COUNT];
+    private final long[] totalNanos = new long[SECTION_COUNT];
+    private final long[] maxNanos = new long[SECTION_COUNT];
+    private final long[] worstTickNanos = new long[SECTION_COUNT];
+    private long intervalStartNanos = System.nanoTime();
+    private long tickCount;
+    private long totalTickNanos;
+    private long maxTickNanos;
+    private long ticksOver50Millis;
+    private long ticksOver100Millis;
+
+    static LoomTickSectionDiagnostics create() {
+        return ENABLED ? new LoomTickSectionDiagnostics() : null;
+    }
+
+    void beginTick() {
+        Arrays.fill(this.currentNanos, 0L);
+    }
+
+    void record(final int section, final long nanos) {
+        if (nanos <= 0L) {
+            return;
+        }
+        this.currentNanos[section] += nanos;
+        this.totalNanos[section] += nanos;
+        this.maxNanos[section] = Math.max(this.maxNanos[section], nanos);
+    }
+
+    void endTick(final ServerLevel level, final long tickStartNanos) {
+        final long now = System.nanoTime();
+        final long tickNanos = now - tickStartNanos;
+        ++this.tickCount;
+        this.totalTickNanos += tickNanos;
+        if (tickNanos > this.maxTickNanos) {
+            this.maxTickNanos = tickNanos;
+            System.arraycopy(this.currentNanos, 0, this.worstTickNanos, 0, SECTION_COUNT);
+        }
+        if (tickNanos >= 50_000_000L) {
+            ++this.ticksOver50Millis;
+        }
+        if (tickNanos >= 100_000_000L) {
+            ++this.ticksOver100Millis;
+        }
+        if ((now - this.intervalStartNanos) >= LOG_INTERVAL_NANOS) {
+            this.logAndReset(level, now);
+        }
+    }
+
+    private void logAndReset(final ServerLevel level, final long now) {
+        if (this.tickCount == 0L) {
+            return;
+        }
+
+        LOGGER.info(
+            "[loom.tick-sections] world={} ticks={} tick_avg_ms={} tick_max_ms={} ticks_over_50ms={} ticks_over_100ms={} avg_ms={} max_ms={} worst_tick_ms={}",
+            level.dimension(),
+            this.tickCount,
+            formatMillis(this.totalTickNanos / this.tickCount),
+            formatMillis(this.maxTickNanos),
+            this.ticksOver50Millis,
+            this.ticksOver100Millis,
+            this.formatSections(this.totalNanos, this.tickCount),
+            this.formatSections(this.maxNanos, 1L),
+            this.formatSections(this.worstTickNanos, 1L)
+        );
+
+        Arrays.fill(this.totalNanos, 0L);
+        Arrays.fill(this.maxNanos, 0L);
+        Arrays.fill(this.worstTickNanos, 0L);
+        this.intervalStartNanos = now;
+        this.tickCount = 0L;
+        this.totalTickNanos = 0L;
+        this.maxTickNanos = 0L;
+        this.ticksOver50Millis = 0L;
+        this.ticksOver100Millis = 0L;
+    }
+
+    private String formatSections(final long[] values, final long divisor) {
+        final StringBuilder builder = new StringBuilder(384);
+        for (int i = 0; i < SECTION_COUNT; ++i) {
+            if (i != 0) {
+                builder.append(',');
+            }
+            builder.append(SECTION_NAMES[i]).append('=').append(formatMillis(values[i] / divisor));
+        }
+        return builder.toString();
+    }
+
+    private static String formatMillis(final long nanos) {
+        return String.format(Locale.ROOT, "%.3f", nanos / 1_000_000.0D);
+    }
+}
