-        } else {
+        }
+        if (!multipleRegions) {
+            this.tickChunksSerially(raw, size, world, randomTickSpeed);
+            return;
+        }
+
+        // Group the entity-ticking chunks by region and dispatch ONE task per region (each ticking all of
+        // its chunks under a single staging buffer), instead of one task per chunk. This keeps the per-tick
