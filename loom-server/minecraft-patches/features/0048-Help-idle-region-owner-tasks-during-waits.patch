+                for (final RegionBoundTask candidate : this.regionContinuations) {
+                    if (!this.cooperativeContinuationClaims.contains(candidate) && predicate.test(candidate.task())) {
+                        selectedContinuation = candidate;
+                        break;
+                    }
+                }
+                if (selectedContinuation != null) {
+                    selectedContinuation = orderedPredecessor(
+                        this.regionContinuations,
+                        this.cooperativeContinuationClaims,
+                        selectedContinuation,
+                        RegionBoundTask::task
+                    );
+                }
+                if (selectedContinuation == null) {
