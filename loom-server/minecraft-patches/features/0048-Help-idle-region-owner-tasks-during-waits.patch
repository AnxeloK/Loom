+    /**
+     * Runs one queued task the caller does not already own, under a freshly claimed lease for that task's
+     * region. Only bounded regions are eligible, and only while no other thread owns them and they do not
+     * intersect a region the caller already holds. A region between ticks has no worker of its own, so
+     * without this a waiter can hold an owner thread for work that nothing is scheduled to run.
+     */
+    public static boolean helpQueuedOwnerTask(final Predicate<Runnable> predicate) {
+        Objects.requireNonNull(predicate, "Predicate may not be null");
+        for (final WorldSchedulerState state : SCHEDULER_STATES.values()) {
+            if (state.helpQueuedOwnerTask(predicate)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private static boolean intersectsHeldContext(
+        final ServerLevel world,
+        final int minChunkX,
+        final int minChunkZ,
+        final int maxChunkX,
+        final int maxChunkZ
+    ) {
+        for (RegionContext context = CURRENT_CONTEXT.get(); context != null; context = context.previous()) {
+            if (context.world() == world
+                && minChunkX <= context.maxChunkX()
+                && maxChunkX >= context.minChunkX()
+                && minChunkZ <= context.maxChunkZ()
+                && maxChunkZ >= context.minChunkZ()) {
+                return true;
+            }
+        }
+        return false;
+    }
