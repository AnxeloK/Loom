+        private static <T> boolean removeByIdentity(final ArrayDeque<T> queue, final T expected) {
+            for (final Iterator<T> iterator = queue.iterator(); iterator.hasNext(); ) {
+                if (iterator.next() == expected) {
+                    iterator.remove();
+                    return true;
+                }
+            }
+            return false;
+        }
+
+        private static <T> @Nullable T orderedPredecessor(
+            final ArrayDeque<T> queue,
+            final java.util.Set<T> cooperativeClaims,
+            final T target,
+            final java.util.function.Function<T, Runnable> task
+        ) {
+            final Runnable targetTask = task.apply(target);
+            for (final T candidate : queue) {
+                if (candidate == target) {
+                    return target;
+                }
+                if (OwnerDomainExecutor.mustRunBefore(task.apply(candidate), targetTask)) {
+                    if (cooperativeClaims.contains(candidate)) {
+                        return null;
+                    }
+                    return candidate;
+                }
+            }
+            throw new IllegalStateException("Cooperative owner target vanished while holding the scheduler lock");
+        }
