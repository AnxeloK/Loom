+    /**
+     * Last-resort progress for a wait whose result depends on an owner nothing is currently running. A region
+     * that is between ticks has no worker, so the task completing this future would otherwise sit queued while
+     * this thread holds its own owner. Only the exact task that finishes the awaited future is eligible, and
+     * only under a lease claimed for a region this thread does not already hold.
+     */
+    private static boolean helpForeignOwnerTask(final int[] depth, final CompletableFuture<?> future) {
+        if (depth[1] >= MAX_COOPERATIVE_HELP_DEPTH) {
+            return false;
+        }
+        ++depth[1];
+        try {
+            return TickRegions.helpQueuedOwnerTask(
+                task -> task instanceof OwnerTask ownerTask && ownerTask.completes(future)
+            );
+        } finally {
+            --depth[1];
+        }
+    }
