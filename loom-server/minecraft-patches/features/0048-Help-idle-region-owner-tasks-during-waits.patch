+        private boolean helpQueuedOwnerTask(final Predicate<Runnable> predicate) {
+            while (true) {
+                RegionBoundTask continuation = null;
+                CrossRegionMessage message = null;
+                synchronized (this.lock) {
+                    for (final RegionBoundTask candidate : this.regionContinuations) {
+                        if (predicate.test(candidate.task())) {
+                            continuation = candidate;
+                            break;
+                        }
+                    }
+                    if (continuation == null) {
+                        for (final CrossRegionMessage candidate : this.mailbox) {
+                            if (predicate.test(candidate.action())) {
+                                message = candidate;
+                                break;
+                            }
+                        }
+                    }
+                }
+                if (continuation == null && message == null) {
+                    return false;
+                }
+
+                final int minChunkX;
+                final int minChunkZ;
+                final int maxChunkX;
+                final int maxChunkZ;
+                if (continuation != null) {
+                    minChunkX = continuation.minChunkX();
+                    minChunkZ = continuation.minChunkZ();
+                    maxChunkX = continuation.maxChunkX();
+                    maxChunkZ = continuation.maxChunkZ();
+                } else {
+                    minChunkX = maxChunkX = message.targetChunkX();
+                    minChunkZ = maxChunkZ = message.targetChunkZ();
+                }
+                if (intersectsHeldContext(this.world, minChunkX, minChunkZ, maxChunkX, maxChunkZ)) {
+                    return false;
+                }
+
+                final RegionContext context = tryPushRegionContext(this.world, minChunkX, minChunkZ, maxChunkX, maxChunkZ);
+                if (context == null) {
+                    // The region has a live owner that will run this itself.
+                    return false;
+                }
+                try {
+                    final boolean claimed;
+                    synchronized (this.lock) {
+                        claimed = continuation != null
+                            ? this.regionContinuations.remove(continuation)
+                            : this.mailbox.remove(message);
+                    }
+                    if (!claimed) {
+                        // Its owner took the task between the scan and the lease claim.
+                        continue;
+                    }
+                    if (continuation != null) {
+                        try {
+                            continuation.task().run();
+                        } catch (final Throwable throwable) {
+                            recordDiagnostic(
+                                DiagnosticType.MAILBOX_MESSAGE_DROPPED,
+                                this.world,
+                                minChunkX,
+                                minChunkZ,
+                                maxChunkX,
+                                maxChunkZ,
+                                "Owner continuation threw exception during cooperative help: " + throwable
+                            );
+                        }
+                    } else {
+                        this.deliverMailboxMessage(message);
+                    }
+                    return true;
+                } finally {
+                    popContext(context);
+                }
+            }
+        }
