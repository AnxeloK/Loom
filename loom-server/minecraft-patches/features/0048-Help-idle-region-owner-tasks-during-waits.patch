+    /**
+     * Pushes a region context only when the bounds are free, returning null when another thread holds an
+     * overlapping lease. Used by callers that can decline the work, so losing the race is an ordinary outcome
+     * rather than a lease-claim failure.
+     */
+    public static @Nullable RegionContext tryPushRegionContext(
+        final ServerLevel world,
+        final int minChunkX,
+        final int minChunkZ,
+        final int maxChunkX,
+        final int maxChunkZ
+    ) {
+        final RegionContext previous = CURRENT_CONTEXT.get();
+        final Thread currentThread = Thread.currentThread();
+        final long leaseId = REGION_RUNTIME.tryClaimLease(world, minChunkX, minChunkZ, maxChunkX, maxChunkZ, currentThread);
+        if (leaseId == RegionRuntime.NO_LEASE) {
+            return null;
+        }
+        final OwnerDomainExecutor.Scope ownerScope = OwnerDomainExecutor.enterRegion(
+            world,
+            minChunkX,
+            minChunkZ,
+            maxChunkX,
+            maxChunkZ,
+            "region-context"
+        );
+        final RegionContext next = new RegionContext(
+            world,
+            minChunkX,
+            minChunkZ,
+            maxChunkX,
+            maxChunkZ,
+            previous,
+            leaseId,
+            currentThread.threadId(),
+            ownerScope
+        );
+        CURRENT_CONTEXT.set(next);
+        return next;
+    }
