+    /**
+     * Run {@code count} independent buckets across the region pool with the dispatching thread
+     * helping instead of parking at the join. The caller and the submitted pool workers all pull
+     * the next bucket index from a shared cursor and run it, so every bucket runs exactly once -
+     * either on a pool thread or on the caller. The caller only blocks once the cursor is drained,
+     * waiting on whatever buckets other threads are still finishing. This is the work-pulling form
+     * of the same barrier: the phase is complete when this method returns, so nothing about the
+     * apply-serial commit model or the chunk/entity phase ordering changes.
+     *
+     * <p>The first {@link Error} (else the first {@link RuntimeException}) seen across all buckets is
+     * rethrown after every bucket has been attempted, matching the submit-all-then-join path which
+     * also runs every bucket before surfacing the first failure.
+     */
+    private static void dispatchBucketsParticipating(final int count, final IntConsumer runBucket, final String stageName) {
+        final AtomicInteger cursor = new AtomicInteger(0);
+        final java.util.concurrent.CountDownLatch done = new java.util.concurrent.CountDownLatch(count);
+        final AtomicReference<Error> firstError = new AtomicReference<>();
+        final AtomicReference<RuntimeException> firstFailure = new AtomicReference<>();
+        final Runnable worker = () -> {
+            int index;
+            while ((index = cursor.getAndIncrement()) < count) {
+                try {
+                    runBucket.accept(index);
+                } catch (final Error error) {
+                    firstError.compareAndSet(null, error);
+                } catch (final RuntimeException runtimeException) {
+                    firstFailure.compareAndSet(null, runtimeException);
+                } catch (final Throwable other) {
+                    firstFailure.compareAndSet(null, new RuntimeException("Parallel region task dispatch failed for " + stageName, other));
+                } finally {
+                    done.countDown();
+                }
+            }
+        };
+        // Submit at most one pool worker per bucket; the cursor stops extra workers immediately. This
+        // is never more tasks than the submit-all path queued, and usually fewer.
+        final int helpers = Math.min(REGION_WORKER_COUNT, count);
+        for (int i = 0; i < helpers; ++i) {
+            CompletableFuture.runAsync(worker, REGION_SCHEDULER_EXECUTOR);
+        }
+        // The dispatching thread participates only when it is itself a region tick thread (the world
+        // owner or the single-world server thread, both TickThreads). Any other caller just waits, so
+        // bucket compute never runs on a non-tick thread.
+        if (Thread.currentThread() instanceof TickThread) {
+            worker.run();
+        }
+        // Wait on bucket completion, not on the pool tasks. After a participating caller drains the
+        // cursor every remaining bucket is actively running on a pool thread and will finish, so this
+        // never blocks on a pool task that has not been scheduled yet (which is what makes a nested
+        // dispatch with more worlds than pool threads safe).
+        try {
+            done.await();
+        } catch (final InterruptedException ex) {
+            Thread.currentThread().interrupt();
+            throw new RuntimeException("Interrupted while waiting for parallel region tasks for " + stageName, ex);
+        }
+        final Error error = firstError.get();
+        if (error != null) {
+            throw error;
+        }
+        final RuntimeException failure = firstFailure.get();
+        if (failure != null) {
+            throw failure;
+        }
+    }
+
