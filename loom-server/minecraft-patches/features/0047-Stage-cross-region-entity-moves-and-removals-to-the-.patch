@@ -954,7 +954,9 @@ public abstract class EntityLookup implements LevelEntityGetter<Entity> {
         }
     }
 
-    protected final class EntityCallback implements EntityInLevelCallback {
+    // Loom - public (was protected) so RegionTickStaging in net.minecraft.server.threading can hold the
+    // callback as a staged-op handle and re-invoke applyMove()/applyRemove() on the owning thread.
+    public final class EntityCallback implements EntityInLevelCallback {
 
         public final Entity entity;
 
@@ -964,6 +966,23 @@ public abstract class EntityLookup implements LevelEntityGetter<Entity> {
 
         @Override
         public void onMove() {
+            // Loom start - stage cross-section/cross-region entity moves to the owner thread under parallel
+            // entity ticking. moveEntity()/entityStatusChange() mutate shared per-world entity-tracking state
+            // and Moonrise's per-region "off-main" thread checks would trip if run on a region worker. When
+            // staging (parallel phase active on this worker), defer to the per-dispatch session; the deferred
+            // op is replayed verbatim by applyMove() on the world-owning thread. When NOT staging
+            // (serial/default path), stageEntityMove returns false and the original body runs inline, byte-
+            // identical to upstream.
+            if (net.minecraft.server.threading.RegionTickStaging.stageEntityMove(this, this.entity)) {
+                return;
+            }
+            this.applyMove();
+            // Loom end
+        }
+
+        // Loom - original Moonrise onMove() body, factored out so the staged replay re-invokes it verbatim on
+        // the world-owning thread. Package-visible so RegionTickStaging.applyAndClear can call it.
+        public void applyMove() {
             final Entity entity = this.entity;
             final Visibility oldVisibility = getEntityStatus(entity);
             final ChunkEntitySlices newSlices = EntityLookup.this.moveEntity(this.entity);
@@ -979,6 +998,21 @@ public abstract class EntityLookup implements LevelEntityGetter<Entity> {
 
         @Override
         public void onRemove(final Entity.RemovalReason reason) {
+            // Loom start - stage entity removals (despawn/death) to the owner thread under parallel entity
+            // ticking, for the same reason as onMove above: removeEntity() unmaps the entity from shared
+            // per-world tracking tables and trips Moonrise's per-region thread check off-main. When staging,
+            // defer to the per-dispatch session and replay via applyRemove() on the owning thread; otherwise
+            // the original body runs inline, byte-identical to upstream.
+            if (net.minecraft.server.threading.RegionTickStaging.stageEntityRemove(this, this.entity, reason)) {
+                return;
+            }
+            this.applyRemove(reason);
+            // Loom end
+        }
+
+        // Loom - original Moonrise onRemove() body, factored out so the staged replay re-invokes it verbatim
+        // on the world-owning thread. Package-visible so RegionTickStaging.applyAndClear can call it.
+        public void applyRemove(final Entity.RemovalReason reason) {
             final Entity entity = this.entity;
             EntityLookup.this.checkThread(entity, "Cannot remove entity off-main");
             final Visibility tickingState = EntityLookup.getEntityStatus(entity);
@@ -991,6 +1025,18 @@ public abstract class EntityLookup implements LevelEntityGetter<Entity> {
 
             this.entity.setLevelCallback(NoOpCallback.INSTANCE);
         }
+
+        // Loom - de-dup / staleness guard for the staged replay. An entity can be discarded more than once in
+        // a single tick (e.g. checkDespawn followed by guardEntityTick's removal path), each scheduling a
+        // staged remove; and a staged move may be queued for an entity that is removed later in the same tick.
+        // Once applyRemove() has run for this entity, removeEntity() has unmapped it from entityById (and set
+        // its section coords to Integer.MIN_VALUE). Detect that here so applyAndClear can skip a second remove
+        // or a move whose entity is already gone. Reference-equality lookup: a freshly-spawned entity that
+        // reused this id would not be == this.entity.
+        public boolean isStale() {
+            final Entity entity = this.entity;
+            return EntityLookup.this.entityById.get((long) entity.getId()) != entity;
+        }
     }
 
     protected static final class NoOpCallback implements EntityInLevelCallback {
