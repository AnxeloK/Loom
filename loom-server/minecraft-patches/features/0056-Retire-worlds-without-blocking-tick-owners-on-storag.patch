diff --git a/net/minecraft/server/level/WorldLifecycle.java b/net/minecraft/server/level/WorldLifecycle.java
new file mode 100644
index 0000000000000000000000000000000000000000..b53bdd0ff382a9c1016374f96702820e2e525ad0
--- /dev/null
+++ b/net/minecraft/server/level/WorldLifecycle.java
@@ -0,0 +1,57 @@
+package net.minecraft.server.level;
+
+import java.util.concurrent.atomic.AtomicInteger;
+import org.jspecify.annotations.Nullable;
+
+/** Serializes retirement against transfers that may temporarily release their owner. */
+public final class WorldLifecycle {
+    private final AtomicInteger transfers = new AtomicInteger();
+
+    public boolean isUnloading() {
+        return this.transfers.get() < 0;
+    }
+
+    public boolean tryBeginUnload() {
+        return this.transfers.compareAndSet(0, -1);
+    }
+
+    public @Nullable Transfer tryBeginTransfer() {
+        return this.retain() ? new Transfer(this) : null;
+    }
+
+    private boolean retain() {
+        for (;;) {
+            final int current = this.transfers.get();
+            if (current < 0) return false;
+            if (current == Integer.MAX_VALUE) throw new IllegalStateException("Too many concurrent world transfers");
+            if (this.transfers.compareAndSet(current, current + 1)) return true;
+        }
+    }
+
+    public static final class Transfer implements AutoCloseable {
+        private @Nullable WorldLifecycle destination;
+
+        private Transfer(final WorldLifecycle destination) {
+            this.destination = destination;
+        }
+
+        public boolean retarget(final WorldLifecycle next) {
+            final WorldLifecycle previous = this.destination;
+            if (previous == null) throw new IllegalStateException("World transfer is already complete");
+            if (previous == next) return true;
+            if (!next.retain()) return false;
+            this.destination = next;
+            previous.transfers.decrementAndGet();
+            return true;
+        }
+
+        @Override
+        public void close() {
+            final WorldLifecycle previous = this.destination;
+            if (previous != null) {
+                this.destination = null;
+                previous.transfers.decrementAndGet();
+            }
+        }
+    }
+}
diff --git a/net/minecraft/server/level/WorldUnloadOperation.java b/net/minecraft/server/level/WorldUnloadOperation.java
new file mode 100644
index 0000000000000000000000000000000000000000..f35dc10b651fc790410266b050ff743fcd385461
--- /dev/null
+++ b/net/minecraft/server/level/WorldUnloadOperation.java
@@ -0,0 +1,135 @@
+package net.minecraft.server.level;
+
+import ca.spottedleaf.moonrise.patches.chunk_system.io.MoonriseRegionFileIO;
+import ca.spottedleaf.moonrise.patches.chunk_system.scheduling.ChunkTaskScheduler;
+import java.io.IOException;
+import java.util.List;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.CompletionException;
+import java.util.concurrent.TimeUnit;
+import net.minecraft.server.threading.TickRegions;
+import net.minecraft.server.threading.runtime.OwnerDomainExecutor;
+
+/** An owner-driven retirement transaction; only storage and executor waits run on I/O owners. */
+public final class WorldUnloadOperation {
+    private final ServerLevel world;
+    private final boolean save;
+    private final CompletableFuture<Boolean> result = new CompletableFuture<>();
+    private CompletableFuture<?> work;
+    private boolean captured;
+
+    public WorldUnloadOperation(final ServerLevel world, final boolean save) {
+        this.world = world;
+        this.save = save;
+    }
+
+    public boolean savesChunks() {
+        return this.save;
+    }
+
+    public CompletableFuture<Boolean> result() {
+        return this.result.copy();
+    }
+
+    public boolean isStarted() {
+        return this.work != null;
+    }
+
+    public boolean isDone() {
+        return this.result.isDone();
+    }
+
+    public void refuse() {
+        this.result.complete(false);
+    }
+
+    public void fail(final Throwable failure) {
+        net.minecraft.server.MinecraftServer.LOGGER.error("Failed to unload world {}", this.world.dimension().identifier(), failure);
+        this.result.completeExceptionally(unwrap(failure));
+    }
+
+    public void start() {
+        OwnerDomainExecutor.assertGlobalOwner(this.world.getServer(), "begin-world-unload");
+        if (!this.world.lifecycle.isUnloading()) throw new IllegalStateException("World retirement was not admitted");
+        this.work = OwnerDomainExecutor.supply(
+            OwnerDomainExecutor.asyncIo(this.world.getServer(), "drain-world-generation"),
+            () -> {
+                if (!this.scheduler().halt(true, TimeUnit.SECONDS.toNanos(60))) {
+                    throw new IllegalStateException("World generation did not stop for " + this.world.dimension().identifier());
+                }
+                return null;
+            }
+        );
+    }
+
+    public void tick() {
+        OwnerDomainExecutor.assertGlobalOwner(this.world.getServer(), "advance-world-unload");
+        if (this.result.isDone()) return;
+        try {
+            if (!this.captured) {
+                // Completion callbacks queued by generation still need their original level owner.
+                // The level no longer simulates, but its finite existing task set must finish.
+                try (var ignored = OwnerDomainExecutor.enter(OwnerDomainExecutor.region(
+                    this.world, Integer.MIN_VALUE, Integer.MIN_VALUE, Integer.MAX_VALUE, Integer.MAX_VALUE, "drain-world-unload"
+                ))) {
+                    this.scheduler().executeAllRecentlyQueuedMainThreadTasks();
+                    TickRegions.drainWorldForUnload(this.world);
+                }
+            }
+            if (!this.work.isDone() || (!this.captured && (this.scheduler().hasPendingMainThreadTasks() || TickRegions.hasWorldUnloadWork(this.world)))) return;
+            this.work.getNow(null);
+            if (!this.captured) {
+                this.captured = true;
+                this.captureAndClose();
+                return;
+            }
+            TickRegions.clearWorldState(this.world);
+            this.result.complete(true);
+        } catch (final Throwable failure) {
+            this.fail(failure);
+        }
+    }
+
+    private void captureAndClose() {
+        final ChunkTaskScheduler scheduler = this.scheduler();
+        // No simulation or new loads can change this world after retirement. Capture mutable
+        // data and unload events here, while storage completion stays outside the tick owner.
+        if (this.save) {
+            this.world.save(null, false, false);
+            scheduler.chunkHolderManager.saveAllChunks(false, true, false, false);
+        }
+        final CompletableFuture<?> savedData = this.world.getDataStorage().closeAsync();
+        final CompletableFuture<Void> chunks = MoonriseRegionFileIO.flushAsync(this.world.getServer(), List.of(this.world));
+        this.work = CompletableFuture.allOf(savedData, chunks, this.world.getServer().pendingSave()).handle((ignored, failure) ->
+            OwnerDomainExecutor.supply(OwnerDomainExecutor.asyncIo(this.world.getServer(), "close-world-storage"), () -> {
+                this.closeStorage(failure);
+                return null;
+            })
+        ).thenCompose(future -> future);
+    }
+
+    private void closeStorage(final Throwable priorFailure) {
