+        final var admission = this.world.lifecycle.tryAcquire();
+        if (admission == null) {
+            if (onComplete != null) onComplete.accept(null);
+            return;
+        }
+        try {
+            this.scheduleAdmittedChunkLoad(chunkX, chunkZ, toStatus, addTicket, priority, chunk -> {
