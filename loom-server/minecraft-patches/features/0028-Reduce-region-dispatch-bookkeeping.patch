                 return ca.spottedleaf.moonrise.common.util.TickThread.isTickThreadFor(player);
             }
+            // Fast path: the serial tracker tick runs under the level's full-extent owner context (or
+            // the global owner on serial paths), which covers both endpoints by definition. This loop
+            // runs per tracked entity per viewing player per tick, so the two lease lookups and two
