diff --git a/net/minecraft/server/threading/LoomProfileTrace.java b/net/minecraft/server/threading/LoomProfileTrace.java
new file mode 100644
index 0000000000000000000000000000000000000000..75775c51898cce856c6e7d02025fc747aef31e08
--- /dev/null
+++ b/net/minecraft/server/threading/LoomProfileTrace.java
@@ -0,0 +1,121 @@
+package net.minecraft.server.threading;
+
+import java.util.concurrent.atomic.AtomicLong;
+import jdk.jfr.Category;
+import jdk.jfr.Enabled;
+import jdk.jfr.Event;
+import jdk.jfr.Label;
+import jdk.jfr.Name;
+import jdk.jfr.StackTrace;
+import jdk.jfr.Timespan;
+
+/** Opt-in correlation spans. Disabled execution does not allocate or read thread-local state. */
+public final class LoomProfileTrace {
+    public static final boolean ENABLED = Boolean.getBoolean("Loom.ProfileTrace");
+    private static final AtomicLong IDS = new AtomicLong();
+    private static final ThreadLocal<Span> CURRENT = new ThreadLocal<>();
+
+    private LoomProfileTrace() {}
+
+    public static long nextId() { return ENABLED ? IDS.incrementAndGet() : 0L; }
+    public static long currentId() {
+        if (!ENABLED) return 0L;
+        final Span span = CURRENT.get();
+        return span == null ? 0L : span.event.id;
+    }
+    public static String currentWorld() {
+        if (!ENABLED) return "";
+        final Span span = CURRENT.get();
+        return span == null ? "" : span.event.world;
+    }
+
+    public static Span begin(final String phase, final String operation, final String world, final long tick) {
+        return begin(phase, operation, world, tick, currentId(), 0L, -1, 0, 0L);
+    }
+
+    public static Span begin(final String phase, final String operation, final String world, final long tick,
+                             final long parent, final long batch, final int task, final int count, final long submittedNanos) {
+        if (!ENABLED) return null;
+        final PhaseEvent event = new PhaseEvent();
+        if (!event.isEnabled()) return null;
+        event.id = nextId();
+        event.parent = parent;
+        event.batch = batch;
+        event.task = task;
+        event.count = count;
+        event.phase = phase;
+        event.operation = operation;
+        event.world = world.isEmpty() ? currentWorld() : world;
+        event.tick = tick;
+        event.queueNanos = submittedNanos == 0L ? 0L : Math.max(0L, System.nanoTime() - submittedNanos);
+        final Span span = new Span(event, CURRENT.get());
+        CURRENT.set(span);
+        event.begin();
+        return span;
+    }
+
+    public static void section(final String operation, final long elapsedNanos, final long tick) {
+        if (!ENABLED) return;
+        final SectionEvent event = new SectionEvent();
+        if (!event.isEnabled()) return;
+        event.parent = currentId();
+        event.world = currentWorld();
+        event.operation = operation;
+        event.tick = tick;
+        event.elapsedNanos = elapsedNanos;
+        event.commit();
+    }
+
+    public static final class Span implements AutoCloseable {
+        private final PhaseEvent event;
+        private final Span previous;
+        private boolean closed;
+        private Span(final PhaseEvent event, final Span previous) {
+            this.event = event;
+            this.previous = previous;
+        }
+        public void bounds(final int minX, final int minZ, final int maxX, final int maxZ) {
+            this.event.minChunkX = minX;
+            this.event.minChunkZ = minZ;
+            this.event.maxChunkX = maxX;
+            this.event.maxChunkZ = maxZ;
+        }
+        @Override public void close() {
+            if (this.closed) return;
+            this.closed = true;
+            this.event.end();
+            if (this.previous == null) CURRENT.remove(); else CURRENT.set(this.previous);
+            this.event.commit();
+        }
+    }
+
+    @Name("loom.TickPhase") @Label("Tick phase") @Category({"Loom", "Ticking"})
+    @Enabled(true) @StackTrace(false)
+    public static final class PhaseEvent extends Event {
+        public long id;
+        public long parent;
+        public long batch;
+        public long tick;
+        public int task;
+        public int count;
+        public int minChunkX;
+        public int minChunkZ;
+        public int maxChunkX;
+        public int maxChunkZ;
+        public String phase;
+        public String operation;
+        public String world;
+        @Timespan(Timespan.NANOSECONDS) public long queueNanos;
+    }
+
+    // Section timers overlap by design; elapsedNanos is an inclusive duration ending at this event.
+    @Name("loom.TickSection") @Label("Tick section") @Category({"Loom", "Ticking"})
+    @Enabled(true) @StackTrace(false)
+    public static final class SectionEvent extends Event {
+        public long parent;
+        public long tick;
+        public String world;
+        public String operation;
+        @Timespan(Timespan.NANOSECONDS) public long elapsedNanos;
+    }
+}
