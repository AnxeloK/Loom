diff --git a/net/minecraft/server/threading/LoomProfileTrace.java b/net/minecraft/server/threading/LoomProfileTrace.java
new file mode 100644
index 0000000000000000000000000000000000000000..6a3b79674dc85a9ddfa09aeb854bbc2c12679524
--- /dev/null
+++ b/net/minecraft/server/threading/LoomProfileTrace.java
@@ -0,0 +1,233 @@
+package net.minecraft.server.threading;
+
+import java.util.concurrent.atomic.AtomicLong;
+import java.util.concurrent.atomic.LongAdder;
+import java.util.WeakHashMap;
+import jdk.jfr.Category;
+import jdk.jfr.Enabled;
+import jdk.jfr.Event;
+import jdk.jfr.FlightRecorder;
+import jdk.jfr.Label;
+import jdk.jfr.Name;
+import jdk.jfr.Period;
+import jdk.jfr.StackTrace;
+import jdk.jfr.Timespan;
+
+/** Opt-in correlation spans. Disabled execution does not allocate or read thread-local state. */
+public final class LoomProfileTrace {
+    public static final boolean ENABLED = Boolean.getBoolean("Loom.ProfileTrace");
+    private static final AtomicLong IDS = new AtomicLong();
+    private static final ThreadLocal<Span> CURRENT = new ThreadLocal<>();
+    private static final WeakHashMap<java.util.concurrent.CompletableFuture<?>, Long> FUTURES = new WeakHashMap<>();
+    private static final LongAdder POLLS = new LongAdder();
+    private static final LongAdder POLL_WORK = new LongAdder();
+    private static final LongAdder POLL_NANOS = new LongAdder();
+    private static final AtomicLong POLL_MAX = new AtomicLong();
+
+    static {
+        if (ENABLED) FlightRecorder.addPeriodicEvent(OperationCounterEvent.class, () -> {
+            final OperationCounterEvent event = new OperationCounterEvent();
+            if (!event.isEnabled()) return;
+            event.operation = "chunkTaskPoll";
+            // Cumulative counters avoid reset races; adjacent samples may be slightly skewed.
+            event.calls = POLLS.sum();
+            event.successes = POLL_WORK.sum();
+            event.elapsedNanos = POLL_NANOS.sum();
+            event.maxNanos = POLL_MAX.get();
+            event.commit();
+        });
+    }
+
+    private LoomProfileTrace() {}
+
+    public static long futureId(final java.util.concurrent.CompletableFuture<?> future) {
+        if (!ENABLED || future == null) return 0L;
+        synchronized (FUTURES) {
+            return FUTURES.computeIfAbsent(future, ignored -> nextId());
+        }
+    }
+
+    public static void awaiting(final java.util.concurrent.CompletableFuture<?> future) {
+        if (!ENABLED) return;
+        final Span span = CURRENT.get();
+        if (span != null) span.event.awaited = futureId(future);
+    }
+
+    public static void dependency(final java.util.concurrent.CompletableFuture<?> awaited,
+                                  final java.util.concurrent.CompletableFuture<?> prerequisite) {
+        if (!ENABLED) return;
+        final DependencyEvent event = new DependencyEvent();
+        if (!event.isEnabled()) return;
+        event.parent = currentId();
+        event.awaited = futureId(awaited);
+        event.prerequisite = futureId(prerequisite);
+        event.commit();
+    }
+
+    public static void chunkPoll(final long startedNanos, final boolean didWork) {
+        if (!ENABLED) return;
+        final long elapsed = Math.max(0L, System.nanoTime() - startedNanos);
+        POLLS.increment();
+        if (didWork) POLL_WORK.increment();
+        POLL_NANOS.add(elapsed);
+        POLL_MAX.accumulateAndGet(elapsed, Math::max);
+    }
+
+    public static void leaseConflict(final long lease, final long holderSpan, final long holderThread,
+                                     final int minX, final int minZ, final int maxX, final int maxZ) {
+        if (!ENABLED) return;
+        final LeaseConflictEvent event = new LeaseConflictEvent();
+        if (!event.isEnabled()) return;
+        event.parent = currentId();
+        event.lease = lease;
+        event.holderSpan = holderSpan;
+        event.holderThread = holderThread;
+        event.world = currentWorld();
+        event.minChunkX = minX;
+        event.minChunkZ = minZ;
+        event.maxChunkX = maxX;
+        event.maxChunkZ = maxZ;
+        event.commit();
+    }
+
+    public static long nextId() { return ENABLED ? IDS.incrementAndGet() : 0L; }
+    public static long currentId() {
+        if (!ENABLED) return 0L;
+        final Span span = CURRENT.get();
+        return span == null ? 0L : span.event.id;
+    }
+    public static String currentWorld() {
+        if (!ENABLED) return "";
+        final Span span = CURRENT.get();
+        return span == null ? "" : span.event.world;
+    }
+
+    public static Span begin(final String phase, final String operation, final String world, final long tick) {
+        return begin(phase, operation, world, tick, currentId(), 0L, -1, 0, 0L);
+    }
+
+    public static Span begin(final String phase, final String operation, final String world, final long tick,
+                             final long parent, final long batch, final int task, final int count, final long submittedNanos) {
+        if (!ENABLED) return null;
+        final PhaseEvent event = new PhaseEvent();
+        if (!event.isEnabled()) return null;
+        event.id = nextId();
+        event.parent = parent;
+        event.batch = batch;
+        event.task = task;
+        event.count = count;
+        event.phase = phase;
+        event.operation = operation;
+        event.world = world.isEmpty() ? currentWorld() : world;
+        event.tick = tick;
+        event.queueNanos = submittedNanos == 0L ? 0L : Math.max(0L, System.nanoTime() - submittedNanos);
+        final Span span = new Span(event, CURRENT.get());
+        CURRENT.set(span);
+        event.begin();
+        return span;
+    }
+
+    public static void section(final String operation, final long elapsedNanos, final long tick) {
+        if (!ENABLED) return;
+        final SectionEvent event = new SectionEvent();
+        if (!event.isEnabled()) return;
+        event.parent = currentId();
+        event.world = currentWorld();
+        event.operation = operation;
+        event.tick = tick;
+        event.elapsedNanos = elapsedNanos;
+        event.commit();
+    }
+
+    public static final class Span implements AutoCloseable {
+        private final PhaseEvent event;
+        private final Span previous;
+        private boolean closed;
+        private Span(final PhaseEvent event, final Span previous) {
+            this.event = event;
+            this.previous = previous;
+        }
+        public void bounds(final int minX, final int minZ, final int maxX, final int maxZ) {
+            this.event.minChunkX = minX;
+            this.event.minChunkZ = minZ;
+            this.event.maxChunkX = maxX;
+            this.event.maxChunkZ = maxZ;
+        }
+        public void owner(final String domain, final long completion) {
+            this.event.domain = domain;
+            this.event.completion = completion;
+        }
+        @Override public void close() {
+            if (this.closed) return;
+            this.closed = true;
+            this.event.end();
+            if (this.previous == null) CURRENT.remove(); else CURRENT.set(this.previous);
+            this.event.commit();
+        }
+    }
+
+    @Name("loom.TickPhase") @Label("Tick phase") @Category({"Loom", "Ticking"})
+    @Enabled(true) @StackTrace(false)
+    public static final class PhaseEvent extends Event {
+        public long id;
+        public long parent;
+        public long batch;
+        public long tick;
+        public long awaited;
+        public long completion;
+        public int task;
+        public int count;
+        public int minChunkX;
+        public int minChunkZ;
+        public int maxChunkX;
+        public int maxChunkZ;
+        public String phase;
+        public String operation;
+        public String world;
+        public String domain;
+        @Timespan(Timespan.NANOSECONDS) public long queueNanos;
+    }
+
+    // Section timers overlap by design; elapsedNanos is an inclusive duration ending at this event.
+    @Name("loom.TickSection") @Label("Tick section") @Category({"Loom", "Ticking"})
+    @Enabled(true) @StackTrace(false)
+    public static final class SectionEvent extends Event {
+        public long parent;
+        public long tick;
+        public String world;
+        public String operation;
+        @Timespan(Timespan.NANOSECONDS) public long elapsedNanos;
+    }
+
+    @Name("loom.OwnerDependency") @Label("Owner future dependency") @Category({"Loom", "Ticking"})
+    @Enabled(true) @StackTrace(false)
+    public static final class DependencyEvent extends Event {
+        public long parent;
+        public long awaited;
+        public long prerequisite;
+    }
+
+    @Name("loom.OperationCounter") @Label("Operation counters") @Category({"Loom", "Ticking"})
+    @Enabled(true) @StackTrace(false) @Period("1 s")
+    public static final class OperationCounterEvent extends Event {
+        public String operation;
+        public long calls;
+        public long successes;
+        @Timespan(Timespan.NANOSECONDS) public long elapsedNanos;
+        @Timespan(Timespan.NANOSECONDS) public long maxNanos;
+    }
+
+    @Name("loom.LeaseConflict") @Label("Conflicting region lease") @Category({"Loom", "Ticking"})
+    @Enabled(true) @StackTrace(false)
+    public static final class LeaseConflictEvent extends Event {
+        public long parent;
+        public long lease;
+        public long holderSpan;
+        public long holderThread;
+        public String world;
+        public int minChunkX;
+        public int minChunkZ;
+        public int maxChunkX;
+        public int maxChunkZ;
+    }
+}
