+            this.constructed = true;
         }
 
-        public RandomRandomSource(long seed) {
-            super(seed);
+        private static ca.spottedleaf.moonrise.common.util.ThreadUnsafeRandom current() {
+            final Thread thread = Thread.currentThread();
+            return thread instanceof ca.spottedleaf.moonrise.common.util.TickThread tickThread
+                ? tickThread.entityRandom
+                : FALLBACK_RANDOM.get();
         }
 
-        // Paper end - replace random
-        private boolean locked = false;
+        @Override
+        public RandomSource fork() {
+            return current().fork();
+        }
 
         @Override
