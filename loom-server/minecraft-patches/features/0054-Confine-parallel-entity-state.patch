             final boolean tickMarkers = world.paperConfig().entities.markers.tick;
             for (final Entity entity : entities) {
                 if (!tickMarkers && entity instanceof Marker) {
                     continue;
                 }
 
-                ActivationRange.activateEntity(entity);
+                ActivationRange.activateEntity(
+                    entity,
+                    playerBox,
+                    worldHeight,
+                    waterActivationRange,
+                    flyingActivationRange,
+                    villagerActivationRange,
+                    monsterActivationRange,
+                    animalActivationRange,
+                    raiderActivationRange,
+                    miscActivationRange
+                );
             }
         }
     }
@@ -183,14 +205,57 @@ public final class ActivationRange {
      *
      * @param entity
      */
-    private static void activateEntity(final Entity entity) {
+    private static void activateEntity(
+        final Entity entity,
+        final AABB playerBox,
+        final int worldHeight,
+        final int waterActivationRange,
+        final int flyingActivationRange,
+        final int villagerActivationRange,
+        final int monsterActivationRange,
+        final int animalActivationRange,
+        final int raiderActivationRange,
+        final int miscActivationRange
+    ) {
         final int currentTick = currentTick(entity);
         if (currentTick > entity.activatedTick) {
             if (entity.defaultActivationState) {
                 entity.activatedTick = currentTick;
                 return;
             }
-            if (entity.activationType.boundingBox.intersects(entity.getBoundingBox())) {
+            final int activationRange = switch (entity.activationType) {
+                case WATER -> waterActivationRange;
+                case FLYING_MONSTER -> flyingActivationRange;
+                case VILLAGER -> villagerActivationRange;
+                case MONSTER -> monsterActivationRange;
+                case ANIMAL -> animalActivationRange;
+                case RAIDER -> raiderActivationRange;
+                case MISC -> miscActivationRange;
+            };
+            double minX = playerBox.minX - activationRange;
+            double minZ = playerBox.minZ - activationRange;
+            double maxX = playerBox.maxX + activationRange;
+            double maxZ = playerBox.maxZ + activationRange;
+            // AABB's constructor normalizes inverted bounds. Preserve that behavior for negative configured
+            // ranges without allocating the per-category box on the normal positive-range path.
+            if (minX > maxX) {
+                final double swap = minX;
+                minX = maxX;
+                maxX = swap;
+            }
+            if (minZ > maxZ) {
+                final double swap = minZ;
+                minZ = maxZ;
+                maxZ = swap;
+            }
+            if (entity.getBoundingBox().intersects(
+                minX,
+                playerBox.minY - worldHeight,
+                minZ,
+                maxX,
+                playerBox.maxY + worldHeight,
+                maxZ
+            )) {
                 entity.activatedTick = currentTick;
             }
         }
