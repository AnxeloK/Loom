     public void entityStatusChange(final Entity entity, final ChunkEntitySlices slices, final Visibility oldVisibility, final Visibility newVisibility, final boolean moved,
                                    final boolean created, final boolean destroyed) {
-        this.checkThread(entity, "Entity status change must only happen on the main thread");
+        this.entityStatusChange(entity, slices, oldVisibility, newVisibility, moved, created, destroyed, true);
+    }
+
+    private void entityStatusChange(final Entity entity, final ChunkEntitySlices slices, final Visibility oldVisibility, final Visibility newVisibility, final boolean moved,
+                                    final boolean created, final boolean destroyed, final boolean checkThread) {
+        if (checkThread) {
+            this.checkThread(entity, "Entity status change must only happen on the main thread");
+        }
 
         if (((ChunkSystemEntity)entity).moonrise$isUpdatingSectionStatus()) {
             // recursive status update
@@ -1030,12 +1037,15 @@ public abstract class EntityLookup implements LevelEntityGetter<Entity> {
         // on the world-owning thread. Package-visible so RegionTickStaging.applyAndClear can call it.
         public void applyRemove(final Entity.RemovalReason reason) {
             final Entity entity = this.entity;
-            EntityLookup.this.checkThread(entity, "Cannot remove entity off-main");
             final Visibility tickingState = EntityLookup.getEntityStatus(entity);
 
+            // removeEntity validates the source lookup's stored section before clearing it. A cross-world
+            // entity may already point at its destination level here, so checking the mutable entity level
+            // would validate the wrong owner. Reuse the successful source-section check for the immediately
+            // following status callbacks.
             EntityLookup.this.removeEntity(entity);
 
-            EntityLookup.this.entityStatusChange(entity, null, tickingState, Visibility.HIDDEN, false, false, reason.shouldDestroy());
+            EntityLookup.this.entityStatusChange(entity, null, tickingState, Visibility.HIDDEN, false, false, reason.shouldDestroy(), false);
 
             EntityLookup.this.removeEntityCallback(entity);
 
