+        }
+
+        @Override
+        public void setSeed(final long seed) {
+            if (!this.constructed) {
+                // ThreadUnsafeRandom invokes this override from its constructor before the facade is published.
                 super.setSeed(seed);
-                locked = true;
+                return;
             }
+            // Once published there is no single mutable stream that can be reseeded without racing workers.
+            LOGGER.error("Ignoring setSeed on Entity.SHARED_RANDOM", new Throwable());
+        }
+
+        @Override
