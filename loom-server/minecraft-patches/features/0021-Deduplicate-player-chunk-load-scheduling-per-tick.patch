From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: anxelok <anxelok@localhost>
Date: Wed, 3 Jun 2026 20:47:26 +0000
Subject: [PATCH] Deduplicate player chunk load scheduling per tick


diff --git a/ca/spottedleaf/moonrise/patches/chunk_system/player/RegionizedPlayerChunkLoader.java b/ca/spottedleaf/moonrise/patches/chunk_system/player/RegionizedPlayerChunkLoader.java
index 04f39c3859aa41944285cb9811adacfad9e01a60..bed702a5df280d0b76b7d967d7616c64630b0100 100644
--- a/ca/spottedleaf/moonrise/patches/chunk_system/player/RegionizedPlayerChunkLoader.java
+++ b/ca/spottedleaf/moonrise/patches/chunk_system/player/RegionizedPlayerChunkLoader.java
@@ -315,6 +315,7 @@ public final class RegionizedPlayerChunkLoader {
         TickThread.ensureTickThread(this.world, "Cannot tick player chunk loader async");
         final long currTime = System.nanoTime();
         final TickDiagnostics diagnostics = LOOM_PLAYER_CHUNK_LOADER_DIAGNOSTICS ? new TickDiagnostics() : null;
+        final LongOpenHashSet scheduledLoadChunks = new LongOpenHashSet();
         for (final ServerPlayer player : new java.util.ArrayList<>(this.world.players())) {
             final PlayerChunkLoaderData loader = ((ChunkSystemServerPlayer)player).moonrise$getChunkLoader();
             if (loader == null || loader.removed || loader.world != this.world) {
@@ -330,7 +331,7 @@ public final class RegionizedPlayerChunkLoader {
                 diagnostics.updateNanos += System.nanoTime() - updateStart;
             }
             final long queueStart = diagnostics == null ? 0L : System.nanoTime();
-            loader.updateQueues(currTime, diagnostics);
+            loader.updateQueues(currTime, diagnostics, scheduledLoadChunks);
             if (diagnostics != null) {
                 diagnostics.queueNanos += System.nanoTime() - queueStart;
             }
@@ -941,6 +942,10 @@ public final class RegionizedPlayerChunkLoader {
         }
 
         void updateQueues(final long time, final TickDiagnostics diagnostics) {
+            this.updateQueues(time, diagnostics, null);
+        }
+
+        void updateQueues(final long time, final TickDiagnostics diagnostics, final LongOpenHashSet scheduledLoadChunks) {
             TickThread.ensureTickThread(this.player, "Cannot tick player chunk loader async");
             if (this.removed) {
                 throw new IllegalStateException("Ticking removed player chunk loader");
@@ -1027,19 +1032,24 @@ public final class RegionizedPlayerChunkLoader {
                 }
 
                 final long loadScheduleStart = diagnostics == null ? 0L : System.nanoTime();
+                int loadSchedules = 0;
                 for (int i = 0; i < maxLoadsThisTick; ++i) {
                     final long queuedLoadChunk = chunks.getLong(i);
+                    if (scheduledLoadChunks != null && !scheduledLoadChunks.add(queuedLoadChunk)) {
+                        continue;
+                    }
                     final int queuedChunkX = CoordinateUtils.getChunkX(queuedLoadChunk);
                     final int queuedChunkZ = CoordinateUtils.getChunkZ(queuedLoadChunk);
                     ((ChunkSystemServerLevel)this.world).moonrise$getChunkTaskScheduler().scheduleChunkLoad(
                         queuedChunkX, queuedChunkZ, ChunkStatus.EMPTY, false, Priority.NORMAL, null
                     );
+                    ++loadSchedules;
                     if (this.removed) {
                         return;
                     }
                 }
                 if (diagnostics != null) {
-                    diagnostics.loadSchedules += maxLoadsThisTick;
+                    diagnostics.loadSchedules += loadSchedules;
                     diagnostics.loadScheduleNanos += System.nanoTime() - loadScheduleStart;
                 }
             }
