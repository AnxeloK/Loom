From: anxelok <anxelok@localhost>
Date: Sat, 11 Jul 2026 00:42:27 +0000
Subject: [PATCH] Route result-bearing entity ticks


diff --git a/net/minecraft/server/level/ServerLevel.java b/net/minecraft/server/level/ServerLevel.java
index 1b10a17b09d62423ec70044b740cf5b3a5726c12..c24a8a2b926601cba21daffce336efcd3e3cc54d 100644
--- a/net/minecraft/server/level/ServerLevel.java
+++ b/net/minecraft/server/level/ServerLevel.java
@@ -1491,13 +1491,25 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
         this.guardEntityTick(this.tickNonPassengerConsumer, entity);
     }
 
-    // Multipart/boss entities (e.g. the Ender Dragon and its EnderDragonPart sub-entities) move and remove
-    // across region boundaries within a single tick, which violates Moonrise's per-region "off-main" thread
-    // check when ticked in a parallel region bucket. Such entities must be ticked on the world-owning thread,
-    // which holds the full-level lease, so their cross-region move/remove always passes the thread check.
+    // Entities may require an immediate ordered callback result or mutate beyond a bounded region. Multipart
+    // dragon entities also move/remove across region boundaries. Tick either case on the world-owning thread,
+    // which holds the full-level lease and runs outside the staging window.
     private static boolean mustTickOnRegionOwner(final Entity entity) {
-        return entity instanceof net.minecraft.world.entity.boss.enderdragon.EnderDragon
-            || entity instanceof net.minecraft.world.entity.boss.enderdragon.EnderDragonPart;
+        if (entity.requiresFullLevelTickOwnership()
+            || entity instanceof net.minecraft.world.entity.boss.enderdragon.EnderDragon
+            || entity instanceof net.minecraft.world.entity.boss.enderdragon.EnderDragonPart) {
+            return true;
+        }
+
+        // Passenger entries are skipped by tickOneEntity and tick recursively with their root vehicle. Route
+        // the whole tree to the owner if any descendant needs it, or that descendant would still tick staged.
+        final java.util.List<Entity> passengers = entity.getPassengers();
+        for (int i = 0, len = passengers.size(); i < len; ++i) {
+            if (mustTickOnRegionOwner(passengers.get(i))) {
+                return true;
+            }
+        }
+        return false;
     }
 
     // Tick entities bucketed by region, running non-adjacent regions concurrently. The non-adjacency
@@ -1622,7 +1634,7 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
             loomEntityDiagnostics.record(LoomTickSectionDiagnostics.ENTITY_REPLAY, System.nanoTime() - loomReplayStart);
         }
         // The parallel phase has joined; we are back on the world-owning thread holding the full-level lease.
-        // Tick the owner-bound (multipart/boss) entities here so their cross-region move/remove is on-owner.
+        // Tick owner-bound entities here so callbacks observe their result immediately and any wide mutation is on-owner.
         if (ownerTick != null) {
             for (int i = 0, n = ownerTick.size(); i < n; ++i) {
                 this.tickOneEntity(ownerTick.get(i));
diff --git a/net/minecraft/server/level/ServerPlayer.java b/net/minecraft/server/level/ServerPlayer.java
index ce4306652209372e68243ecdbf73f82832b57d40..a1b5815050cc6100739eb4848ded4160635e9eb0 100644
--- a/net/minecraft/server/level/ServerPlayer.java
+++ b/net/minecraft/server/level/ServerPlayer.java
@@ -723,6 +723,15 @@ public class ServerPlayer extends Player implements ca.spottedleaf.moonrise.patc
         return new ServerItemCooldowns(this);
     }
 
+    @Override
+    public boolean requiresFullLevelTickOwnership() {
+        // A player tick can synchronously complete delayed block destruction, transfer dimensions, and update
+        // player-nearby/chunk-tracking state. Those operations require their immediate result and cannot be
+        // represented by the generic region staging buffer, so keep the player (and its vehicle tree) in the
+        // serial owner phase.
+        return true;
+    }
+
     @Override
     public void tick() {
         // CraftBukkit start
diff --git a/net/minecraft/world/entity/Entity.java b/net/minecraft/world/entity/Entity.java
index e25eebd203ed32c8708b16524cdcaa3a411e9cc8..435b625e67ffa02947b8f094820ccc9028f32ca2 100644
--- a/net/minecraft/world/entity/Entity.java
+++ b/net/minecraft/world/entity/Entity.java
@@ -5545,6 +5545,12 @@ public abstract class Entity
         return false;
     }
 
+    // Loom - entities whose tick requires an immediate result from globally ordered callbacks, or otherwise
+    // mutates beyond a bounded region, can opt out of shard staging and run under the world's full lease.
+    public boolean requiresFullLevelTickOwnership() {
+        return false;
+    }
+
     public boolean mayInteract(final ServerLevel level, final BlockPos pos) {
         return true;
     }
