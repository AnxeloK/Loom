+    private static boolean commitTreeStates(
+        final StagedTreeDecision decision,
+        final ServerLevel owningWorld,
+        int stateIndex,
+        final Runnable completion
+    ) {
+        final List<org.bukkit.block.BlockState> states = decision.states;
+        while (stateIndex < states.size()) {
+            final org.bukkit.craftbukkit.block.CraftBlockState state =
+                (org.bukkit.craftbukkit.block.CraftBlockState) states.get(stateIndex);
+            final LevelAccessor target = state.getWorldHandle();
+            if (target instanceof ServerLevel targetLevel && state.isPlaced()) {
+                final int chunkX = SectionPos.blockToSectionCoord(state.getX());
+                final int chunkZ = SectionPos.blockToSectionCoord(state.getZ());
+                if (!hasReadyOwner(targetLevel, chunkX, chunkZ)) {
+                    deferTreeState(targetLevel, chunkX, chunkZ, decision, owningWorld, stateIndex, completion);
+                    return false;
+                }
+            }
+
+            state.place(state.getFlags());
+            final int observerChunkX = SectionPos.blockToSectionCoord(state.getX());
+            final int observerChunkZ = SectionPos.blockToSectionCoord(state.getZ());
+            if (!hasReadyOwner(decision.observerLevel, observerChunkX, observerChunkZ)) {
+                deferTreeObserver(decision, owningWorld, stateIndex, completion);
+                return false;
+            }
+            decision.observerLevel.checkCapturedTreeStateForObserverNotify(decision.observerPos, state);
+            ++stateIndex;
+        }
+        return true;
+    }
+
+    private static boolean hasReadyOwner(final ServerLevel level, final int chunkX, final int chunkZ) {
+        return level.getChunkSource().getChunkAtIfLoadedImmediately(chunkX, chunkZ) != null
+            && net.minecraft.server.threading.runtime.OwnerDomainExecutor.isRegionOwner(level, chunkX, chunkZ)
+            && net.minecraft.server.threading.TickRegions.isCurrentThreadOwnerQuiet(level, chunkX, chunkZ);
+    }
+
+    private static void deferTreeState(
+        final ServerLevel level,
+        final int chunkX,
+        final int chunkZ,
+        final StagedTreeDecision decision,
+        final ServerLevel owningWorld,
+        final int stateIndex,
+        final Runnable completion
+    ) {
+        final Runnable continuation = () -> resumeTreeCommit(decision, owningWorld, stateIndex, completion);
+        if (level.getChunkSource().getChunkAtIfLoadedImmediately(chunkX, chunkZ) == null) {
+            net.minecraft.server.threading.runtime.OwnershipRouter.runWhenChunksReady(
+                level,
+                chunkX,
+                chunkZ,
+                chunkX,
+                chunkZ,
+                Priority.HIGHER,
+                "staged-tree-commit",
+                ignored -> continuation.run()
+            ).whenComplete((ignored, failure) -> {
+                if (failure != null) {
+                    LOGGER.error("Deferred tree chunk load failed", failure);
+                    runTreeCompletion(completion);
+                }
+            });
+            return;
+        }
+        net.minecraft.server.threading.runtime.OwnerDomainExecutor.execute(
+            net.minecraft.server.threading.runtime.OwnerDomainExecutor.region(level, chunkX, chunkZ, "staged-tree-commit"),
+            continuation
+        );
+    }
+
+    private static void deferTreeObserver(
+        final StagedTreeDecision decision,
+        final ServerLevel owningWorld,
+        final int stateIndex,
+        final Runnable completion
+    ) {
+        final org.bukkit.craftbukkit.block.CraftBlockState state =
+            (org.bukkit.craftbukkit.block.CraftBlockState) decision.states.get(stateIndex);
+        final int chunkX = SectionPos.blockToSectionCoord(state.getX());
+        final int chunkZ = SectionPos.blockToSectionCoord(state.getZ());
+        final Runnable continuation = () -> {
+            try {
+                decision.observerLevel.checkCapturedTreeStateForObserverNotify(decision.observerPos, state);
+            } catch (final Throwable throwable) {
+                LOGGER.error("Deferred tree observer notification failed", throwable);
+                runTreeCompletion(completion);
+                return;
+            }
+            resumeTreeCommit(decision, owningWorld, stateIndex + 1, completion);
+        };
+        final ServerLevel observerLevel = decision.observerLevel;
+        if (observerLevel.getChunkSource().getChunkAtIfLoadedImmediately(chunkX, chunkZ) == null) {
+            net.minecraft.server.threading.runtime.OwnershipRouter.runWhenChunksReady(
+                observerLevel,
+                chunkX,
+                chunkZ,
+                chunkX,
+                chunkZ,
+                Priority.HIGHER,
+                "staged-tree-observer",
+                ignored -> continuation.run()
+            ).whenComplete((ignored, failure) -> {
+                if (failure != null) {
+                    LOGGER.error("Deferred tree observer chunk load failed", failure);
+                    runTreeCompletion(completion);
+                }
+            });
+            return;
+        }
+        net.minecraft.server.threading.runtime.OwnerDomainExecutor.execute(
+            net.minecraft.server.threading.runtime.OwnerDomainExecutor.region(observerLevel, chunkX, chunkZ, "staged-tree-observer"),
+            continuation
+        );
+    }
+
+    private static void resumeTreeCommit(
+        final StagedTreeDecision decision,
+        final ServerLevel owningWorld,
+        final int stateIndex,
+        final Runnable completion
+    ) {
+        final boolean completed;
+        try {
+            completed = commitTreeStates(decision, owningWorld, stateIndex, completion);
+        } catch (final Throwable throwable) {
+            LOGGER.error("Deferred tree commit failed", throwable);
+            runTreeCompletion(completion);
+            return;
+        }
+        if (completed) {
+            runTreeCompletion(completion);
+        }
+    }
+
+    private static void runTreeCompletion(final Runnable completion) {
+        try {
+            completion.run();
+        } catch (final Throwable throwable) {
+            LOGGER.error("Deferred tree replay continuation failed", throwable);
+        }
+    }
+
+    private static void replayTreeDecision(final StagedTreeDecision decision) {
+        final org.bukkit.event.world.StructureGrowEvent structureEvent = decision.structureEvent();
+        if (structureEvent != null) {
+            try {
+                org.bukkit.Bukkit.getPluginManager().callEvent(structureEvent);
+            } catch (final Throwable t) {
+                LOGGER.error("Deferred StructureGrowEvent dispatch failed", t);
+            }
+        }
+
+        final org.bukkit.event.block.BlockFertilizeEvent fertilizeEvent = decision.fertilizeEvent();
+        if (fertilizeEvent != null) {
+            fertilizeEvent.setCancelled(structureEvent != null && structureEvent.isCancelled());
+            try {
+                org.bukkit.Bukkit.getPluginManager().callEvent(fertilizeEvent);
+            } catch (final Throwable t) {
+                LOGGER.error("Deferred BlockFertilizeEvent dispatch failed", t);
+            }
+            decision.approved = !fertilizeEvent.isCancelled();
+        } else {
+            decision.approved = structureEvent == null || !structureEvent.isCancelled();
+        }
+    }
