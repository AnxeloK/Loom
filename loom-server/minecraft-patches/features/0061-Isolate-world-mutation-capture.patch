diff --git a/net/minecraft/world/level/LevelCaptureContext.java b/net/minecraft/world/level/LevelCaptureContext.java
new file mode 100644
index 0000000000000000000000000000000000000000..1ebba24d14416afad1f8fd156c42bbb91e7598ff
--- /dev/null
+++ b/net/minecraft/world/level/LevelCaptureContext.java
@@ -0,0 +1,331 @@
+package net.minecraft.world.level;
+
+import ca.spottedleaf.moonrise.common.util.TickThread;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+import net.minecraft.core.BlockPos;
+import net.minecraft.world.entity.item.ItemEntity;
+import net.minecraft.world.level.block.entity.BlockEntity;
+import org.bukkit.TreeType;
+import org.bukkit.craftbukkit.block.CraftBlockState;
+import org.jspecify.annotations.Nullable;
+
+/**
+ * Thread-confined state for one world mutation capture operation.
+ *
+ * <p>Frames form a stack on the physical tick thread rather than on a level. This isolates concurrent
+ * operations in different owner domains while retaining inexpensive, allocation-free lookup when there is
+ * no active capture. Only the top frame may intercept an operation; a child for another level or a frozen
+ * frame is an isolation barrier and never exposes an older frame underneath it.</p>
+ */
+public final class LevelCaptureContext {
+
+    public static final int BLOCK_STATES = 1;
+    public static final int TREE = 1 << 1;
+    public static final int DROPS = 1 << 2;
+    private static final int ALL_MODES = BLOCK_STATES | TREE | DROPS;
+
+    private LevelCaptureContext() {
+    }
+
+    static Scope begin(final Level level, final int modes) {
+        Objects.requireNonNull(level, "level");
+        if (modes == 0 || (modes & ~ALL_MODES) != 0) {
+            throw new IllegalArgumentException("Invalid level capture modes: " + modes);
+        }
+        if ((modes & (BLOCK_STATES | DROPS)) != 0
+            && net.minecraft.server.threading.RegionTickStaging.isStaging()) {
+            throw new IllegalStateException("Mutable level capture cannot begin during region tick staging");
+        }
+
+        TickThread.ensureTickThread(level, "Cannot begin a level capture outside its owner domain");
+        final TickThread creator = TickThread.getCurrentTickThread();
+        final Frame frame = new Frame(level, modes, creator, creator.levelCaptureContext);
+        creator.levelCaptureContext = frame;
+        return new Scope(frame);
+    }
+
+    static @Nullable Frame current(final Level level) {
+        final Thread thread = Thread.currentThread();
+        if (!(thread instanceof TickThread tickThread)) {
+            return null;
+        }
+
+        final Frame frame = tickThread.levelCaptureContext;
+        return frame != null && frame.level == level && frame.state == State.ACTIVE ? frame : null;
+    }
+
+    private enum State {
+        ACTIVE,
+        FROZEN,
+        CLOSED
+    }
+
+    public static final class Frame {
+        private final Level level;
+        private final int modes;
+        private final TickThread creator;
+        private final @Nullable Frame previous;
+        private State state = State.ACTIVE;
+        private @Nullable LinkedHashMap<BlockPos, CraftBlockState> blockStates;
+        private @Nullable LinkedHashMap<BlockPos, BlockEntity> blockEntities;
+        private @Nullable ArrayList<ItemEntity> drops;
+        private @Nullable TreeType treeType;
+        private @Nullable BlockPos openSign;
+
+        private Frame(final Level level, final int modes, final TickThread creator, final @Nullable Frame previous) {
+            this.level = level;
+            this.modes = modes;
+            this.creator = creator;
+            this.previous = previous;
+        }
+
+        public Level level() {
+            return this.level;
+        }
+
+        public int modes() {
+            return this.modes;
+        }
+
+        public boolean hasMode(final int mode) {
+            return (this.modes & mode) != 0;
+        }
+
+        public boolean hasCapturedBlockStates() {
+            this.ensureActiveOnCreator();
+            return this.blockStates != null && !this.blockStates.isEmpty();
+        }
+
+        public @Nullable CraftBlockState getCapturedBlockState(final BlockPos pos) {
+            this.ensureActiveOnCreator();
+            return this.blockStates == null ? null : this.blockStates.get(pos);
+        }
+
+        public @Nullable CraftBlockState putCapturedBlockState(final BlockPos pos, final CraftBlockState state) {
+            this.ensureActiveOnCreator();
+            this.requireAnyMode(BLOCK_STATES | TREE, "block states");
+            if (this.blockStates == null) {
+                this.blockStates = new LinkedHashMap<>();
+            }
+            return this.blockStates.put(pos.immutable(), Objects.requireNonNull(state, "state"));
+        }
+
+        public @Nullable CraftBlockState removeCapturedBlockState(final BlockPos pos) {
+            this.ensureActiveOnCreator();
+            return this.blockStates == null ? null : this.blockStates.remove(pos);
+        }
+
+        public boolean hasCapturedBlockEntities() {
+            this.ensureActiveOnCreator();
+            return this.blockEntities != null && !this.blockEntities.isEmpty();
+        }
+
+        public @Nullable BlockEntity getCapturedBlockEntity(final BlockPos pos) {
+            this.ensureActiveOnCreator();
+            return this.blockEntities == null ? null : this.blockEntities.get(pos);
+        }
+
+        public @Nullable BlockEntity putCapturedBlockEntity(final BlockPos pos, final BlockEntity blockEntity) {
+            this.ensureActiveOnCreator();
+            this.requireAnyMode(BLOCK_STATES, "block entities");
+            if (this.blockEntities == null) {
+                this.blockEntities = new LinkedHashMap<>();
+            }
+            return this.blockEntities.put(pos.immutable(), Objects.requireNonNull(blockEntity, "blockEntity"));
+        }
+
+        public void captureDrop(final ItemEntity item) {
+            this.ensureActiveOnCreator();
+            this.requireAnyMode(DROPS, "drops");
+            if (this.drops == null) {
+                this.drops = new ArrayList<>();
+            }
+            this.drops.add(Objects.requireNonNull(item, "item"));
+        }
+
+        public @Nullable TreeType treeType() {
+            this.ensureActiveOnCreator();
+            return this.treeType;
+        }
+
+        public void setTreeType(final TreeType treeType) {
+            this.ensureActiveOnCreator();
+            this.requireAnyMode(TREE, "tree type");
+            this.treeType = Objects.requireNonNull(treeType, "treeType");
+        }
+
+        public @Nullable BlockPos openSign() {
+            this.ensureActiveOnCreator();
+            return this.openSign;
+        }
+
+        public void setOpenSign(final BlockPos openSign) {
+            this.ensureActiveOnCreator();
+            this.requireAnyMode(BLOCK_STATES, "open sign position");
+            this.openSign = Objects.requireNonNull(openSign, "openSign").immutable();
+        }
+
+        private Result freeze() {
+            this.ensureActiveOnCreator();
+            final Result result = new Result(
+                this.level,
+                this.modes,
+                this.blockStates,
+                this.blockEntities,
+                this.drops,
+                this.treeType,
+                this.openSign
+            );
+            this.blockStates = null;
+            this.blockEntities = null;
+            this.drops = null;
+            this.treeType = null;
+            this.openSign = null;
+            this.state = State.FROZEN;
+            return result;
+        }
+
+        private void discard() {
+            this.blockStates = null;
+            this.blockEntities = null;
+            this.drops = null;
+            this.treeType = null;
+            this.openSign = null;
+        }
+
+        private void ensureActiveOnCreator() {
+            if (Thread.currentThread() != this.creator) {
+                throw new IllegalStateException("Level capture accessed from a thread other than its creator");
+            }
+            if (this.creator.levelCaptureContext != this) {
+                throw new IllegalStateException("Level capture is not the current operation");
+            }
+            if (this.state != State.ACTIVE) {
+                throw new IllegalStateException("Level capture is not active: " + this.state);
+            }
+        }
+
+        private void requireAnyMode(final int required, final String value) {
+            if ((this.modes & required) == 0) {
+                throw new IllegalStateException("Capture mode " + this.modes + " does not collect " + value);
+            }
+        }
+    }
+
+    public static final class Scope implements AutoCloseable {
+        private final Frame frame;
+        private boolean closed;
+
+        private Scope(final Frame frame) {
+            this.frame = frame;
+        }
+
+        public Frame frame() {
+            return this.frame;
+        }
+
+        /**
+         * Transfers the captured values to a result while leaving a non-capturing isolation barrier on the
+         * creator thread. The barrier is removed by {@link #close()}.
+         */
+        public Result freeze() {
+            this.ensureCreator();
+            if (this.closed) {
+                throw new IllegalStateException("Level capture scope is closed");
+            }
+            return this.frame.freeze();
+        }
+
+        @Override
+        public void close() {
+            this.ensureCreator();
+            if (this.closed) {
+                return;
+            }
+            if (this.frame.creator.levelCaptureContext != this.frame) {
+                throw new IllegalStateException("Level capture scopes must close in stack order");
+            }
+            if (this.frame.state == State.CLOSED) {
+                throw new IllegalStateException("Level capture frame was already closed");
+            }
+            if (this.frame.state == State.ACTIVE) {
+                this.frame.discard();
+            }
+
+            this.frame.creator.levelCaptureContext = this.frame.previous;
+            this.frame.state = State.CLOSED;
+            this.closed = true;
+        }
+
+        private void ensureCreator() {
+            if (Thread.currentThread() != this.frame.creator) {
+                throw new IllegalStateException("Level capture scope must be completed by its creator thread");
+            }
+        }
+    }
+
+    public static final class Result {
+        private final Level level;
+        private final int modes;
+        private final @Nullable LinkedHashMap<BlockPos, CraftBlockState> blockStates;
+        private final @Nullable LinkedHashMap<BlockPos, BlockEntity> blockEntities;
+        private final @Nullable List<ItemEntity> drops;
+        private final @Nullable TreeType treeType;
+        private final @Nullable BlockPos openSign;
+
+        private Result(
+            final Level level,
+            final int modes,
+            final @Nullable LinkedHashMap<BlockPos, CraftBlockState> blockStates,
+            final @Nullable LinkedHashMap<BlockPos, BlockEntity> blockEntities,
+            final @Nullable List<ItemEntity> drops,
+            final @Nullable TreeType treeType,
+            final @Nullable BlockPos openSign
+        ) {
+            this.level = level;
+            this.modes = modes;
+            this.blockStates = blockStates;
+            this.blockEntities = blockEntities;
+            this.drops = drops;
+            this.treeType = treeType;
+            this.openSign = openSign;
+        }
+
+        public Level level() {
+            return this.level;
+        }
+
+        public int modes() {
+            return this.modes;
+        }
+
+        public boolean hasMode(final int mode) {
+            return (this.modes & mode) != 0;
+        }
+
+        public Map<BlockPos, CraftBlockState> blockStates() {
+            return this.blockStates == null ? Collections.emptyMap() : this.blockStates;
+        }
+
+        public Map<BlockPos, BlockEntity> blockEntities() {
+            return this.blockEntities == null ? Collections.emptyMap() : this.blockEntities;
+        }
+
+        public List<ItemEntity> drops() {
+            return this.drops == null ? Collections.emptyList() : this.drops;
+        }
+
+        public @Nullable TreeType treeType() {
+            return this.treeType;
+        }
+
+        public @Nullable BlockPos openSign() {
+            return this.openSign;
+        }
+    }
+}
