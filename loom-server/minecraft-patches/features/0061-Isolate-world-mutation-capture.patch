+            completed = commitTreeStates(decision, owningWorld, stateIndex, completion);
+        } catch (final Throwable throwable) {
+            LOGGER.error("Deferred tree commit failed", throwable);
+            runTreeCompletion(completion);
+            return;
+        }
+        if (completed) {
+            runTreeCompletion(completion);
+        }
+    }
+
+    private static void runTreeCompletion(final Runnable completion) {
+        try {
+            completion.run();
+        } catch (final Throwable throwable) {
+            LOGGER.error("Deferred tree replay continuation failed", throwable);
+        }
+    }
+
+    private static void replayTreeDecision(final StagedTreeDecision decision) {
+        final org.bukkit.event.world.StructureGrowEvent structureEvent = decision.structureEvent();
+        if (structureEvent != null) {
+            try {
+                org.bukkit.Bukkit.getPluginManager().callEvent(structureEvent);
+            } catch (final Throwable t) {
+                LOGGER.error("Deferred StructureGrowEvent dispatch failed", t);
+            }
+        }
+
+        final org.bukkit.event.block.BlockFertilizeEvent fertilizeEvent = decision.fertilizeEvent();
+        if (fertilizeEvent != null) {
+            fertilizeEvent.setCancelled(structureEvent != null && structureEvent.isCancelled());
+            try {
+                org.bukkit.Bukkit.getPluginManager().callEvent(fertilizeEvent);
+            } catch (final Throwable t) {
+                LOGGER.error("Deferred BlockFertilizeEvent dispatch failed", t);
+            }
+            decision.approved = !fertilizeEvent.isCancelled();
+        } else {
+            decision.approved = structureEvent == null || !structureEvent.isCancelled();
+        }
+    }
