+    // Stage a tree-growth decision without synchronously crossing back to the owner. Both events are optional:
+    // natural growth only has StructureGrowEvent, while a growth operation without a known tree type may have
+    // only BlockFertilizeEvent (or neither event but still needs an ordered owner-side commit). When both are
+    // present they replay in vanilla order, with StructureGrowEvent cancellation copied to BlockFertilizeEvent
+    // before fertilize listeners run. The action executes once at this exact block-write boundary only when the
+    // final applicable event permits it. Returns false outside a staging window and performs no work itself.
+    public static boolean stageTreeDecision(
+        final org.bukkit.event.world.StructureGrowEvent structureEvent,
+        final org.bukkit.event.block.BlockFertilizeEvent fertilizeEvent,
+        final List<org.bukkit.block.BlockState> states,
+        final ServerLevel observerLevel,
+        final BlockPos observerPos
+    ) {
+        final Buffer buffer = CURRENT.get();
+        if (buffer == null) {
+            return false;
+        }
+        java.util.Objects.requireNonNull(states, "states");
+        java.util.Objects.requireNonNull(observerLevel, "observerLevel");
+        java.util.Objects.requireNonNull(observerPos, "observerPos");
+        if (buffer.events == null) {
+            buffer.events = new ArrayList<>();
+        }
+        if (buffer.conditionalCommits == null) {
+            buffer.conditionalCommits = new ArrayList<>();
+        }
+        final int writesStart = size(buffer.writes);
+        final StagedTreeDecision decision = new StagedTreeDecision(
+            structureEvent,
+            fertilizeEvent,
+            writesStart,
+            size(buffer.ticks),
+            size(buffer.spawns),
+            states,
+            observerLevel,
+            observerPos.immutable()
