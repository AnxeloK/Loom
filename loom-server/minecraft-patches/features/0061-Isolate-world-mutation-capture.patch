+        final org.bukkit.craftbukkit.block.CraftBlockState state =
+            (org.bukkit.craftbukkit.block.CraftBlockState) decision.states.get(stateIndex);
+        final int chunkX = SectionPos.blockToSectionCoord(state.getX());
+        final int chunkZ = SectionPos.blockToSectionCoord(state.getZ());
