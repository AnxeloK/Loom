@@ -24,6 +25,12 @@ import net.minecraft.world.ticks.ScheduledTick;
 // they trigger). Scheduled (block/fluid) ticks are buffered and re-scheduled serially. Reads during the
 // parallel phase therefore see pre-mutation state; for random ticks this is an acceptable, non-corrupting
 // behavioural divergence, because every actual mutation happens serially.
+//
+// Buffers are owned by a per-dispatch {@link Session}, NOT a process-global set. Each dispatch site (one
+// world's parallel chunk-tick or entity-tick phase) creates its own Session, threads it into the worker
+// closures (which register their buffer into that Session), and drains ONLY that Session in applyAndClear.
+// This is what lets two worlds tick in parallel safely: world A's applyAndClear can never see — and never
+// replays — world B's staged writes, even though their workers run concurrently.
 public final class RegionTickStaging {
 
     private RegionTickStaging() {
@@ -46,26 +53,42 @@ public final class RegionTickStaging {
         final List<org.bukkit.event.Event> events = new ArrayList<>();
     }
 
+    // A single parallel dispatch's staging scope. Owns the set of per-worker buffers produced during that
+    // dispatch and nothing else; drained exactly once by the owning thread in applyAndClear.
+    public static final class Session {
+        private final Set<Buffer> active = ConcurrentHashMap.newKeySet();
+
+        private Session() {
+        }
+    }
+
     private static final org.slf4j.Logger LOGGER = org.slf4j.LoggerFactory.getLogger("Loom/RegionTickStaging");
     private static final boolean VETO_DEBUG = Boolean.getBoolean("loom.debugVeto");
 
+    // Points to the buffer for whatever staged task the current worker thread is presently running. A worker
+    // only runs one task (hence one Session's buffer) at a time, so this stays correct even when several
+    // Sessions are alive across different worlds at once.
     private static final ThreadLocal<Buffer> CURRENT = new ThreadLocal<>();
-    private static final Set<Buffer> ACTIVE = ConcurrentHashMap.newKeySet();
+
+    public static Session newSession() {
+        return new Session();
+    }
 
     public static boolean isStaging() {
         return CURRENT.get() != null;
     }
 
-    // Begin staging on the current worker thread (idempotent within a thread).
-    public static void begin() {
+    // Begin staging on the current worker thread for the given dispatch session (idempotent within a thread).
+    public static void begin(final Session session) {
         if (CURRENT.get() == null) {
             final Buffer buffer = new Buffer();
             CURRENT.set(buffer);
-            ACTIVE.add(buffer);
+            session.active.add(buffer);
         }
     }
 
-    // Stop intercepting on the current worker thread; the buffer stays registered for the serial replay.
+    // Stop intercepting on the current worker thread; the buffer stays registered in its Session for the
+    // serial replay.
     public static void end() {
         CURRENT.remove();
     }
@@ -113,15 +136,18 @@ public final class RegionTickStaging {
         return true;
     }
 
-    // Apply every staged side effect serially on the calling (owning) thread, then clear. Must be called
-    // after the parallel chunk-tick phase has joined and with staging disabled on this thread.
+    // Apply every side effect staged in the given dispatch session serially on the calling (owning) thread,
