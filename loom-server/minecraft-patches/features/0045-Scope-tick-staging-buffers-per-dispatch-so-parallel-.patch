diff --git a/net/minecraft/server/threading/RegionTickStaging.java b/net/minecraft/server/threading/RegionTickStaging.java
index 44290bf7b2df954404e46a0dc8268317493756e5..92b98206707f4ccb922880851771795efe3e16ff 100644
--- a/net/minecraft/server/threading/RegionTickStaging.java
