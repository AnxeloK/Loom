+
+    // Loom - generation post-processing can reach the one-chunk halo through neighbour shapes, fluids,
+    // and block updates. If that halo is not ready, load it asynchronously and resume under one bounded
+    // REGION owner instead of entering ServerChunkCache's forbidden synchronous wait.
+    public final boolean moonrise$ensurePostProcessing(final ServerLevel level) {
+        if (this.postProcessingDone) {
+            return true;
+        }
+
+        final ChunkPos pos = this.getPos();
+        final int minChunkX = pos.x() - 1;
+        final int minChunkZ = pos.z() - 1;
+        final int maxChunkX = pos.x() + 1;
+        final int maxChunkZ = pos.z() + 1;
+        final boolean haloReady = this.moonrise$isPostProcessingHaloReady(level, minChunkX, minChunkZ, maxChunkX, maxChunkZ);
+        if (!POST_PROCESSING_SCHEDULED.compareAndSet(this, 0, 1)) {
+            return false;
+        }
+        if (this.postProcessingDone) {
+            POST_PROCESSING_SCHEDULED.set(this, 0);
+            return true;
+        }
+
+        if (haloReady
+            && net.minecraft.server.threading.runtime.OwnerDomainExecutor.isRegionOwner(
+                level, minChunkX, minChunkZ, maxChunkX, maxChunkZ
+            )
+            && net.minecraft.server.threading.TickRegions.isCurrentThreadOwnerQuiet(
+                level, minChunkX, minChunkZ, maxChunkX, maxChunkZ
+            )) {
+            try {
+                this.postProcessGeneration(level);
+            } finally {
+                POST_PROCESSING_SCHEDULED.set(this, 0);
+            }
+            return true;
+        }
+
+        net.minecraft.server.threading.runtime.OwnershipRouter.runWhenChunksReady(
+            level,
+            minChunkX,
+            minChunkZ,
+            maxChunkX,
+            maxChunkZ,
+            ca.spottedleaf.concurrentutil.util.Priority.HIGHER,
+            "chunk-post-processing",
+            ignored -> this.moonrise$resumePostProcessing(level)
+        ).whenComplete((ignored, throwable) -> {
+            if (throwable != null) {
+                POST_PROCESSING_SCHEDULED.set(this, 0);
+                LOGGER.error("Failed to resume post-processing for chunk {}", pos, throwable);
+            }
+        });
+        return false;
+    }
+
+    private boolean moonrise$isPostProcessingHaloReady(
+        final ServerLevel level,
+        final int minChunkX,
+        final int minChunkZ,
+        final int maxChunkX,
+        final int maxChunkZ
+    ) {
+        final ChunkPos pos = this.getPos();
+        for (int chunkX = minChunkX; chunkX <= maxChunkX; ++chunkX) {
+            for (int chunkZ = minChunkZ; chunkZ <= maxChunkZ; ++chunkZ) {
+                final LevelChunk loaded = level.getChunkSource().getChunkAtIfLoadedImmediately(chunkX, chunkZ);
+                if (loaded == null || (chunkX == pos.x() && chunkZ == pos.z() && loaded != this)) {
+                    return false;
+                }
+            }
+        }
+        return true;
+    }
+
+    private void moonrise$resumePostProcessing(final ServerLevel level) {
+        try {
+            final ChunkPos pos = this.getPos();
+            if (level.getChunkSource().getChunkAtIfLoadedImmediately(pos.x(), pos.z()) == this
+                && !this.postProcessingDone) {
+                this.postProcessGeneration(level);
+            }
+        } finally {
+            POST_PROCESSING_SCHEDULED.set(this, 0);
+        }
+        final ca.spottedleaf.moonrise.patches.chunk_system.scheduling.NewChunkHolder holder = this.chunkAndHolder;
+        if (holder != null) {
+            holder.moonrise$requeueFullStatusChange();
+        }
+    }
     // Paper end - rewrite chunk system
     // Paper start - get block chunk optimisation
