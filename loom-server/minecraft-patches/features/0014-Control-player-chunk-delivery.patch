+            formatMillis(diagnostics.sendQueueAgeSamples == 0 ? 0L : diagnostics.sendQueueAgeNanos / diagnostics.sendQueueAgeSamples),
+            formatMillis(diagnostics.maxSendQueueAgeNanos),
+            diagnostics.postProcessedChunks,
+            formatMillis(diagnostics.postProcessNanos),
+            formatMillis(diagnostics.sendChunkNanos),
+            diagnostics.networkBackpressuredPlayers,
+            diagnostics.networkNotWritablePlayers,
+            diagnostics.networkPendingWrites,
+            diagnostics.networkMaxPendingWrites,
+            diagnostics.networkPendingBytes,
+            diagnostics.networkMaxPendingBytes,
+            diagnostics.loadQueueSize,
+            diagnostics.loadingQueueSize,
