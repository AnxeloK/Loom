From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: anxelok <anxelok@localhost>
Date: Wed, 10 Jun 2026 20:46:00 +0000
Subject: [PATCH] Fast path empty region lease claims


diff --git a/net/minecraft/server/threading/RegionRuntime.java b/net/minecraft/server/threading/RegionRuntime.java
index 67ef35a877fa5c418d65d446c397093f5906f10f..6acf234a7d52822bb9df4b41667eeee7ad6083d2 100644
--- a/net/minecraft/server/threading/RegionRuntime.java
+++ b/net/minecraft/server/threading/RegionRuntime.java
@@ -252,12 +252,39 @@ public class RegionRuntime {
         ) {
             this.lock.lock();
             try {
-                final Lease conflictingLease = this.findConflictingLease(minChunkX, minChunkZ, maxChunkX, maxChunkZ, ownerThread.threadId());
+                final long ownerThreadId = ownerThread.threadId();
+                final String ownerThreadName = ownerThread.getName();
+                if (this.leases.isEmpty()) {
+                    final long regionId = nextRegionId.getAndIncrement();
+                    ++this.createdRegions;
+                    this.regions.put(
+                        regionId,
+                        new RegionDescriptor(regionId, minChunkX, minChunkZ, maxChunkX, maxChunkZ, RegionLifecycleEvent.CREATED, List.of())
+                    );
+                    final Lease lease = new Lease(
+                        leaseId,
+                        minChunkX,
+                        minChunkZ,
+                        maxChunkX,
+                        maxChunkZ,
+                        ownerThreadId,
+                        ownerThreadName,
+                        regionId
+                    );
+                    final Lease prev = this.leases.put(lease.id, lease);
+                    if (prev != null) {
+                        throw new IllegalStateException("Duplicate lease id: " + lease.id);
+                    }
+                    this.regionReferenceCounts.put(regionId, 1);
+                    return;
+                }
+
+                final Lease conflictingLease = this.findConflictingLease(minChunkX, minChunkZ, maxChunkX, maxChunkZ, ownerThreadId);
                 if (conflictingLease != null) {
                     conflictCounter.getAndIncrement();
                     throw new IllegalStateException(
                         "Region lease conflict: new lease [" + minChunkX + "," + minChunkZ + " -> " + maxChunkX + "," + maxChunkZ + "]"
-                            + " by thread " + ownerThread.getName() + "[" + ownerThread.threadId() + "] overlaps existing lease "
+                            + " by thread " + ownerThreadName + "[" + ownerThreadId + "] overlaps existing lease "
                             + conflictingLease.describeBounds() + " by thread "
                             + conflictingLease.ownerThreadName + "[" + conflictingLease.ownerThreadId + "]"
                     );
@@ -270,8 +297,8 @@ public class RegionRuntime {
                     minChunkZ,
                     maxChunkX,
                     maxChunkZ,
-                    ownerThread.threadId(),
-                    ownerThread.getName(),
+                    ownerThreadId,
+                    ownerThreadName,
                     regionId
                 );
                 final Lease prev = this.leases.put(lease.id, lease);
@@ -649,4 +676,4 @@ public class RegionRuntime {
             return new WorldDiagnostics(worldId, 0, 0, 0L, 0L, 0L, 0L, 0L);
         }
     }
-}
\ No newline at end of file
+}
