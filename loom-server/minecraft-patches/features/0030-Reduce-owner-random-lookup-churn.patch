Subject: [PATCH] Reduce owner random lookup churn


diff --git a/net/minecraft/server/threading/runtime/DomainRandom.java b/net/minecraft/server/threading/runtime/DomainRandom.java
index 07662ceab1f69ddc68029df0477ae88437b59b8e..4d4026f15d187ff70ef1c736b92a590887bfd4a7 100644
--- a/net/minecraft/server/threading/runtime/DomainRandom.java
+++ b/net/minecraft/server/threading/runtime/DomainRandom.java
@@ -27,14 +27,10 @@ public final class DomainRandom {
     }
 
     public static RandomSource forRuntimeLevel(final ServerLevel level, final RandomSource fallback) {
-        final OwnerDomainExecutor.Owner owner = OwnerDomainExecutor.currentOwner();
-        if (owner == null) {
+        final String key = OwnerDomainExecutor.currentRandomKey(level);
+        if (key == null) {
             return fallback;
         }
-        final String key = level.dimension().identifier() + "|" + owner.domain()
-            + "|" + owner.minChunkX() + "," + owner.minChunkZ()
-            + "|" + owner.maxChunkX() + "," + owner.maxChunkZ()
-            + "|" + owner.playerId();
         return DOMAIN_RANDOMS.get().computeIfAbsent(key, ignored -> RandomSource.create(seed(level, BlockPos.ZERO, key)));
     }
 
diff --git a/net/minecraft/server/threading/runtime/OwnerDomainExecutor.java b/net/minecraft/server/threading/runtime/OwnerDomainExecutor.java
index 58d6eb3e87ddc3e1473bcd76efe7e77c349c6bdc..d19434e74fb49f0cd21ff25553adaa27df7a40f4 100644
--- a/net/minecraft/server/threading/runtime/OwnerDomainExecutor.java
+++ b/net/minecraft/server/threading/runtime/OwnerDomainExecutor.java
@@ -126,6 +126,43 @@ public final class OwnerDomainExecutor {
         return context == null ? null : context.owner();
     }
 
+    static @Nullable String currentRandomKey(final ServerLevel level) {
+        final OwnerContext context = CURRENT_OWNER.get();
+        if (context == null) {
+            return null;
+        }
+        if (context.randomLevel == level) {
+            return context.randomUseFallback ? null : context.randomKey;
+        }
+
+        final Owner owner = context.owner();
+        if (isFullLevelRegion(owner, level)
+            && TickRegions.isCurrentThreadOwnerQuiet(level, Integer.MIN_VALUE, Integer.MIN_VALUE, Integer.MAX_VALUE, Integer.MAX_VALUE)) {
+            context.randomLevel = level;
+            context.randomKey = null;
+            context.randomUseFallback = true;
+            return null;
+        }
+
+        final String key = level.dimension().identifier() + "|" + owner.domain()
+            + "|" + owner.minChunkX() + "," + owner.minChunkZ()
+            + "|" + owner.maxChunkX() + "," + owner.maxChunkZ()
+            + "|" + owner.playerId();
+        context.randomLevel = level;
+        context.randomKey = key;
+        context.randomUseFallback = false;
+        return key;
+    }
+
+    private static boolean isFullLevelRegion(final Owner owner, final ServerLevel level) {
+        return owner.domain() == Domain.REGION
+            && owner.level() == level
+            && owner.minChunkX() == Integer.MIN_VALUE
+            && owner.minChunkZ() == Integer.MIN_VALUE
+            && owner.maxChunkX() == Integer.MAX_VALUE
+            && owner.maxChunkZ() == Integer.MAX_VALUE;
+    }
+
     public static Domain currentDomain() {
         final OwnerContext context = CURRENT_OWNER.get();
         return context == null ? Domain.ASYNC_IO : context.owner().domain();
@@ -319,7 +356,25 @@ public final class OwnerDomainExecutor {
     ) {
     }
 
-    private record OwnerContext(Owner owner, @Nullable OwnerContext previous) {
+    private static final class OwnerContext {
+        private final Owner owner;
+        private final @Nullable OwnerContext previous;
+        private @Nullable ServerLevel randomLevel;
+        private @Nullable String randomKey;
+        private boolean randomUseFallback;
+
+        private OwnerContext(final Owner owner, final @Nullable OwnerContext previous) {
+            this.owner = owner;
+            this.previous = previous;
+        }
+
+        private Owner owner() {
+            return this.owner;
+        }
+
+        private @Nullable OwnerContext previous() {
+            return this.previous;
+        }
     }
 
     public static final class Scope implements AutoCloseable {
