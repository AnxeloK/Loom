From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: anxelok <anxelok@localhost>
Date: Sat, 1 Aug 2026 22:40:13 +0000
Subject: [PATCH] Bound entity push queries


diff --git a/net/minecraft/world/entity/LivingEntity.java b/net/minecraft/world/entity/LivingEntity.java
index c9aa469f2b8c9d232c13adc6effeefe1ac1b58e1..a2ae441cce2333c7ad127b1722a33ee2541c5ad4 100644
--- a/net/minecraft/world/entity/LivingEntity.java
+++ b/net/minecraft/world/entity/LivingEntity.java
@@ -3902,34 +3902,54 @@ public abstract class LivingEntity extends Entity implements Attackable, Waypoin
             return;
         }
 
-        int maxCramming = ((ServerLevel) this.level()).getGameRules().get(GameRules.MAX_ENTITY_CRAMMING);
-        if (maxCramming <= 0 && this.level().paperConfig().collisions.maxEntityCollisions <= 0) {
+        final Level level = this.level();
+        final int maxCramming = ((ServerLevel)level).getGameRules().get(GameRules.MAX_ENTITY_CRAMMING);
+        final int maxEntityCollisions = level.paperConfig().collisions.maxEntityCollisions;
+        if (maxCramming <= 0 && maxEntityCollisions <= 0) {
             return;
         }
         // Paper end - don't run getEntities if we're not going to use its result
-        List<Entity> pushableEntities = this.level().getPushableEntities(this, this.getBoundingBox());
+        // Loom start - the collision cap needs only the first configured candidates, while cramming needs
+        // only to know whether its non-passenger threshold was reached. Keep the same entity iteration order
+        // and random-call timing without scanning and retaining every entity in a dense collision cluster.
+        final Predicate<Entity> pushable = EntitySelector.pushableBy(this);
+        final int queryLimit = Math.max(maxCramming, maxEntityCollisions);
+        final AABB collisionBox = this.getBoundingBox();
+        final List<Entity> pushableEntities = level.getEntities(this, collisionBox, pushable, queryLimit);
+        // Loom end - bound dense entity collision queries
         if (!pushableEntities.isEmpty()) {
-            if (this.level() instanceof ServerLevel serverLevel) {
+            if (level instanceof ServerLevel serverLevel) {
                 // Paper - don't run getEntities if we're not going to use its result; moved up
-                if (maxCramming > 0 && pushableEntities.size() > maxCramming - 1 && this.random.nextInt(4) == 0) {
+                if (maxCramming > 0 && pushableEntities.size() >= maxCramming && this.random.nextInt(4) == 0) {
                     int count = 0;
 
                     for (Entity entity : pushableEntities) {
-                        if (!entity.isPassenger()) {
-                            count++;
+                        if (!entity.isPassenger() && ++count >= maxCramming) {
+                            break;
                         }
                     }
 
-                    if (count > maxCramming - 1) {
+                    // Loom - a bounded prefix can contain passengers while qualifying entities exist later.
+                    // Re-query only on the one-in-four cramming check and only when the first query was full.
+                    if (count < maxCramming && pushableEntities.size() == queryLimit) {
+                        count = level.getEntities(
+                            this,
+                            collisionBox,
+                            candidate -> !candidate.isPassenger() && pushable.test(candidate),
+                            maxCramming
+                        ).size();
+                    }
+
+                    if (count >= maxCramming) {
                         this.hurtServer(serverLevel, this.damageSources().cramming(), 6.0F);
                     }
                 }
             }
 
             // Paper start - Cap entity collisions
-            this.numCollisions = Math.max(0, this.numCollisions - this.level().paperConfig().collisions.maxEntityCollisions);
+            this.numCollisions = Math.max(0, this.numCollisions - maxEntityCollisions);
             for (Entity entity : pushableEntities) {
-                if (this.numCollisions >= this.level().paperConfig().collisions.maxEntityCollisions) {
+                if (this.numCollisions >= maxEntityCollisions) {
                     break;
                 }
 
diff --git a/net/minecraft/world/level/Level.java b/net/minecraft/world/level/Level.java
index c8bed7a9782c84ea1cb174ae12e86db058e9ec4a..12f8d218deb671c0ef943d7178954dd847f2f3fa 100644
--- a/net/minecraft/world/level/Level.java
+++ b/net/minecraft/world/level/Level.java
@@ -1967,6 +1967,32 @@ public abstract class Level implements LevelAccessor, AutoCloseable, ca.spottedl
         // Paper end - rewrite chunk system
     }
 
+    // Loom start - bound internal entity queries whose callers need only an ordered prefix
+    public List<Entity> getEntities(
+        final @Nullable Entity except,
+        final AABB bb,
+        final Predicate<? super Entity> selector,
+        final int maxCount
+    ) {
+        Profiler.get().incrementCounter("getEntities");
+        if (maxCount <= 0) {
+            return List.of();
+        }
+
+        final List<Entity> ret = new java.util.ArrayList<>(Math.min(maxCount, 16));
+        ((ca.spottedleaf.moonrise.patches.chunk_system.level.ChunkSystemLevel)this)
+            .moonrise$getEntityLookup().getEntities(except, bb, ret, selector, maxCount);
+
+        if (ret.size() < maxCount) {
+            ca.spottedleaf.moonrise.common.PlatformHooks.get().addToGetEntities((Level)(Object)this, except, bb, selector, ret);
+            if (ret.size() > maxCount) {
+                ret.subList(maxCount, ret.size()).clear();
+            }
+        }
+        return ret;
+    }
+    // Loom end - bound internal entity queries whose callers need only an ordered prefix
+
     @Override
     public <T extends Entity> List<T> getEntities(final EntityTypeTest<Entity, T> type, final AABB bb, final Predicate<? super T> selector) {
         List<T> output = Lists.newArrayList();
