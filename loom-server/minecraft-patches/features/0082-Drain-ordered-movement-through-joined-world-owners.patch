+        /** Movement is ordered within each world. Every other packet ends the joined prefix. */
+        public DrainResult executeWorldPackets(final net.minecraft.server.MinecraftServer server, final int limit) {
+            if (!PacketProcessor.this.isSameThread() || this.closed) {
+                throw new IllegalStateException("Packet batch used outside its packet owner or after close");
+            }
+            if (limit < 1 || limit > 256) {
+                throw new IllegalArgumentException("Packet batch size must be between 1 and 256");
+            }
+            if (PacketProcessor.this.worldPacketsInFlight) {
+                throw new IllegalStateException("Cannot recursively enter a joined packet batch");
+            }
+            this.releaseWorld();
+            if (net.minecraft.server.threading.runtime.OwnerDomainExecutor.currentDomain()
+                != net.minecraft.server.threading.runtime.OwnerDomainExecutor.Domain.GLOBAL_CONTROL
+                || net.minecraft.server.threading.TickRegions.currentContext() != null) {
+                throw new IllegalStateException("Joined packet batches require the global owner outside a world context");
+            }
+            net.minecraft.server.threading.runtime.OwnerDomainExecutor.assertGlobalOwner(server, "packet-world-batch");
+            if (PacketProcessor.this.closed) {
+                return new DrainResult(0, 0);
+            }
+            final ListenerAndPacket<?> first = PacketProcessor.this.packetsToBeHandled.peek();
+            if (first == null || !first.isWorldMovementPacket()
+                || !(first.listener() instanceof net.minecraft.server.network.ServerGamePacketListenerImpl)) {
+                final boolean urgent = PacketProcessor.this.hasUrgentPacketAtHead();
+                return this.executeSinglePacket() ? new DrainResult(1, urgent ? 1 : 0) : new DrainResult(0, 0);
+            }
+
+            final List<PendingWorldPacket> pending = new ArrayList<>();
+            final Map<net.minecraft.server.level.ServerLevel, List<PendingWorldPacket>> byWorld = new LinkedHashMap<>();
+            PacketProcessor.this.worldPacketsInFlight = true;
+            try {
+                for (int index = 0; index < limit; ++index) {
+                    final ListenerAndPacket<?> head = PacketProcessor.this.packetsToBeHandled.peek();
+                    if (head == null || !head.isWorldMovementPacket()
+                        || !(head.listener() instanceof net.minecraft.server.network.ServerGamePacketListenerImpl listener)) {
+                        break;
+                    }
+                    final net.minecraft.server.level.ServerPlayer player = listener.player;
+                    final net.minecraft.server.level.ServerLevel world = player.level();
+                    if (world.getServer() != server) {
+                        throw new IllegalArgumentException("Player packet belongs to another server");
+                    }
+                    PacketProcessor.this.packetsToBeHandled.remove();
+                    final PendingWorldPacket task = new PendingWorldPacket(head, player);
+                    pending.add(task);
+                    byWorld.computeIfAbsent(world, ignored -> new ArrayList<>()).add(task);
+                }
+                net.minecraft.server.threading.TickRegions.runJoinedWorldPhase(
+                    server, new ArrayList<>(byWorld.keySet()), world -> {
+                        final var context = net.minecraft.server.threading.TickRegions.pushLevelContext(world);
+                        try {
+                            // A transfer or replacement defers this connection's remaining prefix together.
+                            final Map<PacketListener, Boolean> deferred = new IdentityHashMap<>();
+                            for (final PendingWorldPacket task : byWorld.get(world)) {
+                                if (PacketProcessor.this.closed) {
+                                    break;
+                                }
+                                final var listener = (net.minecraft.server.network.ServerGamePacketListenerImpl)task.task.listener();
+                                if (deferred.containsKey(listener) || listener.player != task.player || task.player.level() != world) {
+                                    deferred.put(listener, Boolean.TRUE);
+                                } else {
+                                    task.executed = true;
+                                    task.task.handle();
+                                }
+                            }
+                        } finally {
+                            net.minecraft.server.threading.TickRegions.popContext(context);
+                        }
+                    }, "packetMovement"
+                );
+                int packets = 0;
+                int urgentPackets = 0;
+                for (final PendingWorldPacket task : pending) {
+                    if (!task.executed && !PacketProcessor.this.closed) {
+                        task.executed = true;
+                        this.executeTask(task.task);
+                    }
+                    if (task.executed) {
+                        ++packets;
+                        if (task.task.isUrgentControlPacket()) {
+                            ++urgentPackets;
+                        }
+                    }
+                }
+                return new DrainResult(packets, urgentPackets);
+            } finally {
+                // A failing callback or close must not lose or replay the unstarted part of the prefix.
+                try {
+                    for (int index = pending.size() - 1; index >= 0; --index) {
+                        final PendingWorldPacket task = pending.get(index);
+                        if (!task.executed) {
+                            PacketProcessor.this.packetsToBeHandled.addFirst(task.task);
+                        }
+                    }
+                } finally {
+                    PacketProcessor.this.worldPacketsInFlight = false;
+                }
+            }
         }
 
