@@ -5,6 +5,7 @@ import java.util.concurrent.CompletableFuture;
 import java.util.concurrent.CompletionException;
 import net.minecraft.core.BlockPos;
 import net.minecraft.server.level.ServerLevel;
+import net.minecraft.server.threading.runtime.OwnershipRouter;
 import net.minecraft.world.level.block.Portal;
 import net.minecraft.world.level.portal.TeleportTransition;
 import org.jspecify.annotations.Nullable;
@@ -48,7 +49,8 @@ public class PortalProcessor {
 
             CompletableFuture<@Nullable TeleportTransition> destination = this.pendingDestination;
             this.pendingDestination = null;
-            return completePortalDestination(destination);
+            final TeleportTransition transition = completePortalDestination(destination);
+            return transition == null ? null : this.ensureDestinationChunksReady(entity, transition);
         }
 
         CompletableFuture<@Nullable TeleportTransition> destination = this.portal.getPortalDestinationAsync(serverLevel, entity, this.entryPosition);
@@ -58,7 +60,8 @@ public class PortalProcessor {
             return null;
         }
 
-        return completePortalDestination(destination);
+        final TeleportTransition transition = completePortalDestination(destination);
+        return transition == null ? null : this.ensureDestinationChunksReady(entity, transition);
     }
 
     private static @Nullable TeleportTransition completePortalDestination(final CompletableFuture<@Nullable TeleportTransition> destination) {
@@ -75,6 +78,42 @@ public class PortalProcessor {
         return this.destinationPending;
     }
 
+    private @Nullable TeleportTransition ensureDestinationChunksReady(final Entity entity, final TeleportTransition transition) {
+        final ServerLevel destinationLevel = transition.newLevel();
+        final net.minecraft.world.phys.Vec3 destinationPos = transition.position();
+        final net.minecraft.world.phys.AABB destinationBox = entity.getBoundingBoxAt(destinationPos.x(), destinationPos.y(), destinationPos.z());
+        if (destinationLevel.areChunksLoadedForMove(destinationBox)) {
+            return transition;
+        }
+
+        final CompletableFuture<@Nullable TeleportTransition> destination = new CompletableFuture<>();
+        OwnershipRouter.runWhenMoveChunksReady(
+            destinationLevel,
+            destinationBox,
+            ca.spottedleaf.concurrentutil.util.Priority.HIGHER,
+            "portal-destination-chunks-ready",
+            chunks -> {
+                final net.minecraft.server.level.ServerChunkCache chunkCache = destinationLevel.getChunkSource();
+                for (final net.minecraft.world.level.chunk.ChunkAccess chunk : chunks) {
+                    chunkCache.addTicketAtLevel(
+                        net.minecraft.server.level.TicketType.POST_TELEPORT,
+                        chunk.getPos(),
+                        net.minecraft.server.level.ChunkLevel.FULL_CHUNK_LEVEL
+                    );
+                }
+                destination.complete(transition);
+            }
+        ).whenComplete((ignored, throwable) -> {
+            if (throwable != null) {
+                destination.completeExceptionally(throwable);
+            }
+        });
+
+        this.pendingDestination = destination;
+        this.destinationPending = true;
+        return null;
+    }
+
     public Portal.Transition getPortalLocalTransition() {
         return this.portal.getLocalTransition();
     }
