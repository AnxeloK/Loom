 import java.util.concurrent.CompletableFuture;
+import java.util.function.Consumer;
 import java.util.function.Supplier;
 import net.minecraft.server.MinecraftServer;
 import net.minecraft.server.level.ServerLevel;
 import net.minecraft.server.level.ServerPlayer;
+import net.minecraft.util.Mth;
+import net.minecraft.world.level.ChunkPos;
+import net.minecraft.world.level.chunk.ChunkAccess;
+import net.minecraft.world.level.chunk.status.ChunkStatus;
+import net.minecraft.world.phys.AABB;
 
 public final class OwnershipRouter {
 
@@ -46,4 +57,366 @@ public final class OwnershipRouter {
     public static void dispatchToPlayer(final ServerPlayer player, final String operation, final Runnable task) {
         OwnerDomainExecutor.execute(OwnerDomainExecutor.player(player, operation), task);
     }
+
+    public static CompletableFuture<Void> runWhenMoveChunksReady(
+        final ServerLevel level,
+        final AABB box,
+        final Priority priority,
+        final String operation,
+        final Consumer<List<ChunkAccess>> onReady
+    ) {
+        Objects.requireNonNull(level, "level");
+        Objects.requireNonNull(box, "box");
+        Objects.requireNonNull(priority, "priority");
+        Objects.requireNonNull(operation, "operation");
+        Objects.requireNonNull(onReady, "onReady");
+
+        // Keep ownership bounds aligned with ServerLevel#loadChunksForMoveAsync's expansion.
+        final int minBlockX = Mth.floor(box.minX - 1.0E-7) - 3;
+        final int minBlockZ = Mth.floor(box.minZ - 1.0E-7) - 3;
+        final int maxBlockX = Mth.floor(box.maxX + 1.0E-7) + 3;
+        final int maxBlockZ = Mth.floor(box.maxZ + 1.0E-7) + 3;
+        final int minChunkX = minBlockX >> 4;
+        final int minChunkZ = minBlockZ >> 4;
+        final int maxChunkX = maxBlockX >> 4;
+        final int maxChunkZ = maxBlockZ >> 4;
+
+        return runWhenChunksReady(
+            level, minChunkX, minChunkZ, maxChunkX, maxChunkZ, priority, operation, onReady
+        );
+    }
+
+    public static CompletableFuture<Void> runWhenChunksReady(
+        final ServerLevel level,
+        final int minChunkX,
+        final int minChunkZ,
+        final int maxChunkX,
+        final int maxChunkZ,
+        final Priority priority,
+        final String operation,
+        final Consumer<List<ChunkAccess>> onReady
+    ) {
+        return runWhenChunksReady(
+            level, minChunkX, minChunkZ, maxChunkX, maxChunkZ, ChunkStatus.FULL, priority, operation, onReady
+        );
+    }
+
+    public static CompletableFuture<Void> runWhenChunksReady(
+        final ServerLevel level,
+        final int minChunkX,
+        final int minChunkZ,
+        final int maxChunkX,
+        final int maxChunkZ,
+        final ChunkStatus chunkStatus,
+        final Priority priority,
+        final String operation,
+        final Consumer<List<ChunkAccess>> onReady
+    ) {
+        Objects.requireNonNull(level, "level");
+        Objects.requireNonNull(chunkStatus, "chunkStatus");
+        Objects.requireNonNull(priority, "priority");
+        Objects.requireNonNull(operation, "operation");
+        Objects.requireNonNull(onReady, "onReady");
+        if (maxChunkX < minChunkX || maxChunkZ < minChunkZ) {
+            throw new IllegalArgumentException("Invalid chunk bounds for runWhenChunksReady");
+        }
+
+        final CompletableFuture<Void> future = new CompletableFuture<>();
+        loadAndDispatch(
+            future, level, minChunkX, minChunkZ, maxChunkX, maxChunkZ, chunkStatus, priority, operation, onReady
+        );
+        return future;
+    }
+
+    public static <T> CompletableFuture<T> supplyWhenChunksReady(
+        final ServerLevel level,
+        final int minChunkX,
+        final int minChunkZ,
+        final int maxChunkX,
+        final int maxChunkZ,
+        final ChunkStatus chunkStatus,
+        final Priority priority,
+        final String operation,
+        final Supplier<T> supplier
+    ) {
+        Objects.requireNonNull(supplier, "supplier");
+        final CompletableFuture<T> result = new CompletableFuture<>();
+        runWhenChunksReady(
+            level,
+            minChunkX,
+            minChunkZ,
+            maxChunkX,
+            maxChunkZ,
+            chunkStatus,
+            priority,
+            operation,
+            chunks -> result.complete(supplier.get())
+        ).whenComplete((ignored, throwable) -> {
+            if (throwable != null) {
+                result.completeExceptionally(throwable);
+            }
+        });
+        return result;
+    }
+
+    private static void loadAndDispatch(
+        final CompletableFuture<Void> future,
+        final ServerLevel level,
+        final int minChunkX,
+        final int minChunkZ,
+        final int maxChunkX,
+        final int maxChunkZ,
+        final ChunkStatus chunkStatus,
+        final Priority priority,
+        final String operation,
+        final Consumer<List<ChunkAccess>> onReady
+    ) {
+        if (future.isDone()) {
+            return;
+        }
+
+        level.moonrise$loadChunksAsync(minChunkX, maxChunkX, minChunkZ, maxChunkZ, chunkStatus, priority, chunks -> {
+            if (future.isDone()) {
+                return;
+            }
+            if (OwnerDomainExecutor.isRegionOwner(level, minChunkX, minChunkZ, maxChunkX, maxChunkZ)
+                && areChunksReady(level, minChunkX, minChunkZ, maxChunkX, maxChunkZ, chunkStatus)) {
+                try {
+                    validateLoadedChunks(minChunkX, minChunkZ, maxChunkX, maxChunkZ, chunks);
+                    completeChunkReadyCallback(future, chunks, onReady);
+                } catch (final Throwable throwable) {
+                    future.completeExceptionally(throwable);
+                }
+                return;
+            }
+
+            final ChunkReadyLease lease;
+            try {
+                lease = ChunkReadyLease.acquire(
