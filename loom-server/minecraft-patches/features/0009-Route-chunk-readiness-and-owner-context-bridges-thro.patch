+        try {
+            OwnerDomainExecutor.execute(
+                OwnerDomainExecutor.asyncIo(level.getServer(), operation + "-chunk-ready-retry"),
+                () -> dispatchReadyCallback(
+                    future, level, minChunkX, minChunkZ, maxChunkX, maxChunkZ, chunkStatus, operation, chunks, onReady, lease
+                )
+            );
+        } catch (final Throwable throwable) {
+            lease.close();
+            future.completeExceptionally(throwable);
+        }
+    }
+
+    static boolean areChunksReady(
+        final ServerLevel level,
+        final int minChunkX,
+        final int minChunkZ,
+        final int maxChunkX,
+        final int maxChunkZ,
+        final ChunkStatus chunkStatus
