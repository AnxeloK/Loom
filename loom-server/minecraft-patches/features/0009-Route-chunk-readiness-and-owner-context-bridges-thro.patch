 public final class OwnershipRouter {
 
@@ -46,4 +57,307 @@ public final class OwnershipRouter {
     public static void dispatchToPlayer(final ServerPlayer player, final String operation, final Runnable task) {
         OwnerDomainExecutor.execute(OwnerDomainExecutor.player(player, operation), task);
     }
+
+    public static CompletableFuture<Void> runWhenMoveChunksReady(
+        final ServerLevel level,
+        final AABB box,
+        final Priority priority,
+        final String operation,
+        final Consumer<List<ChunkAccess>> onReady
+    ) {
+        Objects.requireNonNull(level, "level");
+        Objects.requireNonNull(box, "box");
+        Objects.requireNonNull(priority, "priority");
+        Objects.requireNonNull(operation, "operation");
+        Objects.requireNonNull(onReady, "onReady");
+
+        // Keep ownership bounds aligned with ServerLevel#loadChunksForMoveAsync's expansion.
+        final int minBlockX = Mth.floor(box.minX - 1.0E-7) - 3;
+        final int minBlockZ = Mth.floor(box.minZ - 1.0E-7) - 3;
+        final int maxBlockX = Mth.floor(box.maxX + 1.0E-7) + 3;
+        final int maxBlockZ = Mth.floor(box.maxZ + 1.0E-7) + 3;
+        final int minChunkX = minBlockX >> 4;
+        final int minChunkZ = minBlockZ >> 4;
+        final int maxChunkX = maxBlockX >> 4;
+        final int maxChunkZ = maxBlockZ >> 4;
+
+        return runWhenChunksReady(
+            level, minChunkX, minChunkZ, maxChunkX, maxChunkZ, priority, operation, onReady
+        );
+    }
+
+    public static CompletableFuture<Void> runWhenChunksReady(
+        final ServerLevel level,
+        final int minChunkX,
+        final int minChunkZ,
+        final int maxChunkX,
+        final int maxChunkZ,
+        final Priority priority,
+        final String operation,
+        final Consumer<List<ChunkAccess>> onReady
+    ) {
+        Objects.requireNonNull(level, "level");
+        Objects.requireNonNull(priority, "priority");
+        Objects.requireNonNull(operation, "operation");
+        Objects.requireNonNull(onReady, "onReady");
+        if (maxChunkX < minChunkX || maxChunkZ < minChunkZ) {
+            throw new IllegalArgumentException("Invalid chunk bounds for runWhenChunksReady");
+        }
+
+        final CompletableFuture<Void> future = new CompletableFuture<>();
+        loadAndDispatch(
+            future, level, minChunkX, minChunkZ, maxChunkX, maxChunkZ, priority, operation, onReady
+        );
+        return future;
+    }
+
+    private static void loadAndDispatch(
+        final CompletableFuture<Void> future,
+        final ServerLevel level,
+        final int minChunkX,
+        final int minChunkZ,
+        final int maxChunkX,
+        final int maxChunkZ,
+        final Priority priority,
+        final String operation,
+        final Consumer<List<ChunkAccess>> onReady
+    ) {
+        if (future.isDone()) {
+            return;
+        }
+
+        level.loadChunks(minChunkX, minChunkZ, maxChunkX, maxChunkZ, priority, chunks -> {
+            if (future.isDone()) {
+                return;
+            }
+            if (OwnerDomainExecutor.isRegionOwner(level, minChunkX, minChunkZ, maxChunkX, maxChunkZ)
+                && areChunksReady(level, minChunkX, minChunkZ, maxChunkX, maxChunkZ)) {
+                try {
+                    validateLoadedChunks(minChunkX, minChunkZ, maxChunkX, maxChunkZ, chunks);
+                    completeChunkReadyCallback(future, chunks, onReady);
+                } catch (final Throwable throwable) {
+                    future.completeExceptionally(throwable);
+                }
+                return;
+            }
+
+            final ChunkReadyLease lease;
+            try {
+                lease = ChunkReadyLease.acquire(
+                    level, minChunkX, minChunkZ, maxChunkX, maxChunkZ, chunks
+                );
+            } catch (final Throwable throwable) {
+                future.completeExceptionally(throwable);
+                return;
+            }
+
+            dispatchReadyCallback(
+                future, level, minChunkX, minChunkZ, maxChunkX, maxChunkZ, operation, chunks, onReady, lease
+            );
+        });
+    }
+
+    private static void dispatchReadyCallback(
+        final CompletableFuture<Void> future,
+        final ServerLevel level,
+        final int minChunkX,
+        final int minChunkZ,
+        final int maxChunkX,
+        final int maxChunkZ,
+        final String operation,
+        final List<ChunkAccess> chunks,
+        final Consumer<List<ChunkAccess>> onReady,
+        final ChunkReadyLease lease
+    ) {
+        if (future.isDone()) {
+            lease.close();
+            return;
+        }
+
+        try {
+            OwnerDomainExecutor.execute(
+                OwnerDomainExecutor.region(level, minChunkX, minChunkZ, maxChunkX, maxChunkZ, operation),
+                () -> {
+                    if (future.isDone()) {
+                        lease.close();
+                        return;
+                    }
+                    if (!areChunksReady(level, minChunkX, minChunkZ, maxChunkX, maxChunkZ)) {
+                        retryReadyCallback(
+                            future, level, minChunkX, minChunkZ, maxChunkX, maxChunkZ, operation, chunks, onReady, lease
+                        );
+                        return;
+                    }
+
+                    try (lease) {
+                        completeChunkReadyCallback(future, chunks, onReady);
+                    }
+                }
+            );
+        } catch (final Throwable throwable) {
+            lease.close();
+            future.completeExceptionally(throwable);
+        }
+    }
+
+    private static void retryReadyCallback(
+        final CompletableFuture<Void> future,
+        final ServerLevel level,
+        final int minChunkX,
+        final int minChunkZ,
+        final int maxChunkX,
+        final int maxChunkZ,
+        final String operation,
+        final List<ChunkAccess> chunks,
+        final Consumer<List<ChunkAccess>> onReady,
+        final ChunkReadyLease lease
+    ) {
+        if (level.getServer().isStopped()) {
+            lease.close();
+            future.completeExceptionally(new IllegalStateException("Server stopped before chunks became owner-ready"));
+            return;
+        }
+
+        try {
+            OwnerDomainExecutor.execute(
+                OwnerDomainExecutor.asyncIo(level.getServer(), operation + "-chunk-ready-retry"),
+                () -> dispatchReadyCallback(
+                    future, level, minChunkX, minChunkZ, maxChunkX, maxChunkZ, operation, chunks, onReady, lease
+                )
+            );
+        } catch (final Throwable throwable) {
+            lease.close();
+            future.completeExceptionally(throwable);
+        }
+    }
+
+    private static boolean areChunksReady(
+        final ServerLevel level,
+        final int minChunkX,
+        final int minChunkZ,
+        final int maxChunkX,
+        final int maxChunkZ
+    ) {
+        for (int chunkX = minChunkX; chunkX <= maxChunkX; ++chunkX) {
+            for (int chunkZ = minChunkZ; chunkZ <= maxChunkZ; ++chunkZ) {
+                if (level.getChunkSource().getChunkAtIfLoadedImmediately(chunkX, chunkZ) == null) {
+                    return false;
+                }
+            }
+        }
+        return true;
+    }
+
+    private static void validateLoadedChunks(
+        final int minChunkX,
+        final int minChunkZ,
+        final int maxChunkX,
+        final int maxChunkZ,
+        final List<ChunkAccess> chunks
+    ) {
+        Objects.requireNonNull(chunks, "loaded chunks");
+        final long width = (long)maxChunkX - (long)minChunkX + 1L;
+        final long depth = (long)maxChunkZ - (long)minChunkZ + 1L;
+        if (width > Integer.MAX_VALUE || depth > Integer.MAX_VALUE || width > Integer.MAX_VALUE / depth) {
+            throw new IllegalArgumentException("Chunk readiness bounds are too large");
+        }
+        final long expectedCountLong = width * depth;
+        final int expectedCount = (int)expectedCountLong;
+        if (chunks.size() != expectedCount) {
+            throw new IllegalStateException(
+                "Chunk load completed without all requested chunks: expected " + expectedCount + ", got " + chunks.size()
+            );
+        }
+
+        final boolean[] positions = new boolean[expectedCount];
+        for (final ChunkAccess chunk : chunks) {
+            final ChunkPos pos = Objects.requireNonNull(chunk, "loaded chunk").getPos();
+            if (pos.x() < minChunkX || pos.x() > maxChunkX || pos.z() < minChunkZ || pos.z() > maxChunkZ) {
+                throw new IllegalStateException("Chunk load completed with an unexpected or duplicate chunk: " + pos);
+            }
+            final int index = (int)(((long)pos.x() - minChunkX) * depth + ((long)pos.z() - minChunkZ));
+            if (positions[index]) {
+                throw new IllegalStateException("Chunk load completed with an unexpected or duplicate chunk: " + pos);
+            }
+            positions[index] = true;
+        }
+    }
+
+    private static void completeChunkReadyCallback(
+        final CompletableFuture<Void> future,
+        final List<ChunkAccess> chunks,
+        final Consumer<List<ChunkAccess>> onReady
+    ) {
+        try {
+            onReady.accept(chunks);
+            future.complete(null);
+        } catch (final Throwable throwable) {
+            future.completeExceptionally(throwable);
+        }
+    }
+
+    private static final class ChunkReadyLease implements AutoCloseable {
+        private final ChunkHolderManager chunkHolderManager;
+        private final List<ChunkAccess> chunks;
+        private final int ticketLevel;
+        private final Long identifier;
+        private boolean closed;
+
+        private ChunkReadyLease(
+            final ChunkHolderManager chunkHolderManager,
+            final List<ChunkAccess> chunks,
+            final int ticketLevel,
+            final Long identifier
+        ) {
+            this.chunkHolderManager = chunkHolderManager;
+            this.chunks = chunks;
+            this.ticketLevel = ticketLevel;
+            this.identifier = identifier;
+        }
+
+        private static ChunkReadyLease acquire(
+            final ServerLevel level,
+            final int minChunkX,
+            final int minChunkZ,
+            final int maxChunkX,
+            final int maxChunkZ,
+            final List<ChunkAccess> chunks
+        ) {
+            validateLoadedChunks(minChunkX, minChunkZ, maxChunkX, maxChunkZ, chunks);
+
+            final ChunkHolderManager chunkHolderManager = level.moonrise$getChunkTaskScheduler().chunkHolderManager;
+            final int ticketLevel = ChunkTaskScheduler.getTicketLevel(ChunkStatus.FULL);
