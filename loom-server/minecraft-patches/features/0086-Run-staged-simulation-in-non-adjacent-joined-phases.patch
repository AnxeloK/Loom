+    /**
+     * Prepare staged simulation in joined, non-adjacent phases. Callers must stage cross-region effects
+     * until every phase completes; unlike general region jobs, their groups may run in a different order.
+     */
+    public static RegionTaskPlan prepareSimulationRegionTasks(
+        final ServerLevel world,
+        final List<RegionBoundTask> tasks,
+        final String stageName
+    ) {
+        Objects.requireNonNull(world, "World may not be null");
+        Objects.requireNonNull(tasks, "Tasks may not be null");
+        Objects.requireNonNull(stageName, "Stage name may not be null");
+        final List<RegionBoundBucket> buckets = new ArrayList<>(tasks.size());
+        for (final RegionBoundTask task : tasks) {
+            final RegionBoundBucket bucket = new RegionBoundBucket(world);
+            bucket.add(task);
+            buckets.add(bucket);
+        }
+        buckets.sort(Comparator
+            .comparingInt(RegionBoundBucket::minChunkX)
+            .thenComparingInt(RegionBoundBucket::minChunkZ)
+            .thenComparingInt(RegionBoundBucket::maxChunkX)
+            .thenComparingInt(RegionBoundBucket::maxChunkZ));
+
+        final List<List<RegionBoundBucket>> phases = new ArrayList<>();
+        for (final RegionBoundBucket bucket : buckets) {
+            List<RegionBoundBucket> selected = null;
+            for (final List<RegionBoundBucket> phase : phases) {
+                boolean conflicts = false;
+                for (final RegionBoundBucket other : phase) {
+                    if (bucket.intersects(other)) {
+                        conflicts = true;
+                        break;
+                    }
+                }
+                if (!conflicts) {
+                    selected = phase;
+                    break;
+                }
+            }
+            if (selected == null) {
+                selected = new ArrayList<>();
+                phases.add(selected);
+            }
+            selected.add(bucket);
+        }
+        return new RegionTaskPlan(world, stageName, phases);
     }
 
