From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: anxelok <anxelok@localhost>
Date: Sun, 5 Jul 2026 21:24:44 +0000
Subject: [PATCH] Key the per-thread lease index by thread instead of thread id

Ownership checks fetched the lease array with a boxed Long key, so the
hottest read path in the runtime allocated a Long per query and paid
the long hash. Key the index by the Thread object itself: identity
hashing, no boxing, and the thread is already in hand at every call
site. Leases keep the owner thread reference for index maintenance;
conflict checks still compare thread ids.

diff --git a/net/minecraft/server/threading/RegionRuntime.java b/net/minecraft/server/threading/RegionRuntime.java
index 463821f22568665845bfca3213f79775b9bdaebe..50fa9abae92ac9275c3041913dda16f8e6371b96 100644
--- a/net/minecraft/server/threading/RegionRuntime.java
+++ b/net/minecraft/server/threading/RegionRuntime.java
@@ -108,7 +108,7 @@ public class RegionRuntime {
 
     private boolean isOwnerInternal(final Object worldKey, final int chunkX, final int chunkZ, final Thread thread) {
         final WorldOwnership worldOwnership = this.ownershipByWorld.get(worldKey);
-        return worldOwnership != null && worldOwnership.isOwner(chunkX, chunkZ, thread.threadId());
+        return worldOwnership != null && worldOwnership.isOwner(chunkX, chunkZ, thread);
     }
 
     public boolean isOwner(
@@ -142,7 +142,7 @@ public class RegionRuntime {
         final Thread thread
     ) {
         final WorldOwnership worldOwnership = this.ownershipByWorld.get(worldKey);
-        return worldOwnership != null && worldOwnership.isOwner(minChunkX, minChunkZ, maxChunkX, maxChunkZ, thread.threadId());
+        return worldOwnership != null && worldOwnership.isOwner(minChunkX, minChunkZ, maxChunkX, maxChunkZ, thread);
     }
 
     public int activeLeases(final ServerLevel world) {
@@ -234,9 +234,10 @@ public class RegionRuntime {
         private final Map<Long, Lease> leases = new HashMap<>();
         // Loom - per-thread copy-on-write lease index for lock-free ownership reads. Ownership checks are
         // the hottest path in the runtime and are always self-queries (a thread asking about its own
-        // leases), so reads scan a small immutable array fetched by thread id instead of taking the world
-        // lock that claim/release use. Mutated only while holding `lock`.
-        private final ConcurrentHashMap<Long, Lease[]> leasesByThread = new ConcurrentHashMap<>();
+        // leases), so reads scan a small immutable array fetched by thread instead of taking the world
+        // lock that claim/release use. Keyed by the Thread object, not the thread id, so the lookup does
+        // not box a Long per query. Mutated only while holding `lock`.
+        private final ConcurrentHashMap<Thread, Lease[]> leasesByThread = new ConcurrentHashMap<>();
         private final Map<Long, RegionDescriptor> regions = new HashMap<>();
         private final Map<Long, Integer> regionReferenceCounts = new HashMap<>();
         private long createdRegions;
@@ -272,7 +273,7 @@ public class RegionRuntime {
                         minChunkZ,
                         maxChunkX,
                         maxChunkZ,
-                        ownerThreadId,
+                        ownerThread,
                         ownerThreadName,
                         regionId
                     );
@@ -303,7 +304,7 @@ public class RegionRuntime {
                     minChunkZ,
                     maxChunkX,
                     maxChunkZ,
-                    ownerThreadId,
+                    ownerThread,
                     ownerThreadName,
                     regionId
                 );
@@ -345,8 +346,8 @@ public class RegionRuntime {
             }
         }
 
-        private boolean isOwner(final int chunkX, final int chunkZ, final long threadId) {
-            final Lease[] own = this.leasesByThread.get(threadId);
+        private boolean isOwner(final int chunkX, final int chunkZ, final Thread thread) {
+            final Lease[] own = this.leasesByThread.get(thread);
             if (own == null) {
                 return false;
             }
@@ -363,9 +364,9 @@ public class RegionRuntime {
             final int minChunkZ,
             final int maxChunkX,
             final int maxChunkZ,
-            final long threadId
+            final Thread thread
         ) {
-            final Lease[] own = this.leasesByThread.get(threadId);
+            final Lease[] own = this.leasesByThread.get(thread);
             if (own == null) {
                 return false;
             }
@@ -378,7 +379,7 @@ public class RegionRuntime {
         }
 
         private void indexLease(final Lease lease) {
-            this.leasesByThread.compute(lease.ownerThreadId, (ignored, existing) -> {
+            this.leasesByThread.compute(lease.ownerThread, (ignored, existing) -> {
                 if (existing == null) {
                     return new Lease[] { lease };
                 }
@@ -389,7 +390,7 @@ public class RegionRuntime {
         }
 
         private void unindexLease(final Lease lease) {
-            this.leasesByThread.computeIfPresent(lease.ownerThreadId, (ignored, existing) -> {
+            this.leasesByThread.computeIfPresent(lease.ownerThread, (ignored, existing) -> {
                 int index = -1;
                 for (int i = 0, len = existing.length; i < len; ++i) {
                     if (existing[i].id == lease.id) {
@@ -563,6 +564,7 @@ public class RegionRuntime {
         private final int minChunkZ;
         private final int maxChunkX;
         private final int maxChunkZ;
+        private final Thread ownerThread;
         private final long ownerThreadId;
         @SuppressWarnings("unused")
         private final String ownerThreadName;
@@ -574,7 +576,7 @@ public class RegionRuntime {
             final int minChunkZ,
             final int maxChunkX,
             final int maxChunkZ,
-            final long ownerThreadId,
+            final Thread ownerThread,
             final String ownerThreadName,
             final long regionId
         ) {
@@ -583,7 +585,8 @@ public class RegionRuntime {
             this.minChunkZ = minChunkZ;
             this.maxChunkX = maxChunkX;
             this.maxChunkZ = maxChunkZ;
-            this.ownerThreadId = ownerThreadId;
+            this.ownerThread = ownerThread;
+            this.ownerThreadId = ownerThread.threadId();
             this.ownerThreadName = ownerThreadName;
             this.regionId = regionId;
         }
