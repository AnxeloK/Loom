From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: anxelok <anxelok@localhost>
Date: Thu, 18 Jun 2026 01:59:05 +0000
Subject: [PATCH] Defer parallel-tick Bukkit events to the main-thread serial
 replay, honouring cancellation


diff --git a/net/minecraft/server/threading/RegionTickStaging.java b/net/minecraft/server/threading/RegionTickStaging.java
index e8f595529c212b9c31f3f21b46078098898fc158..44290bf7b2df954404e46a0dc8268317493756e5 100644
--- a/net/minecraft/server/threading/RegionTickStaging.java
+++ b/net/minecraft/server/threading/RegionTickStaging.java
@@ -43,8 +43,12 @@ public final class RegionTickStaging {
         final List<StagedWrite> writes = new ArrayList<>();
         final List<StagedTick> ticks = new ArrayList<>();
         final List<StagedSpawn> spawns = new ArrayList<>();
+        final List<org.bukkit.event.Event> events = new ArrayList<>();
     }
 
+    private static final org.slf4j.Logger LOGGER = org.slf4j.LoggerFactory.getLogger("Loom/RegionTickStaging");
+    private static final boolean VETO_DEBUG = Boolean.getBoolean("loom.debugVeto");
+
     private static final ThreadLocal<Buffer> CURRENT = new ThreadLocal<>();
     private static final Set<Buffer> ACTIVE = ConcurrentHashMap.newKeySet();
 
@@ -96,6 +100,19 @@ public final class RegionTickStaging {
         return true;
     }
 
+    // Buffer a Bukkit event fired during the parallel phase so its plugin listeners are dispatched on the
+    // owning (main) thread during the serial replay — exactly where serial ticking fires them — instead of
+    // running plugin handlers on a region worker thread. This keeps legacy (main-thread-only) plugins safe
+    // with the parallel flags on. Returns false (caller fires normally) when not staging.
+    public static boolean stageEvent(final org.bukkit.event.Event event) {
+        final Buffer buffer = CURRENT.get();
+        if (buffer == null) {
+            return false;
+        }
+        buffer.events.add(event);
+        return true;
+    }
+
     // Apply every staged side effect serially on the calling (owning) thread, then clear. Must be called
     // after the parallel chunk-tick phase has joined and with staging disabled on this thread.
     @SuppressWarnings("unchecked")
@@ -105,21 +122,57 @@ public final class RegionTickStaging {
         }
         final List<Buffer> buffers = new ArrayList<>(ACTIVE);
         ACTIVE.clear();
-        for (int b = 0, blen = buffers.size(); b < blen; ++b) {
+        final int blen = buffers.size();
+        // Dispatch deferred Bukkit events first, on this (the owning/main) thread, now that the workers have
+        // joined — so plugin handlers run single-threaded exactly as under serial ticking. A handler that
+        // throws must not abort the rest of the replay. If a handler cancels a block event, record the target
+        // position so the staged write it gated is skipped below — honouring the plugin's veto.
+        final java.util.Set<Long> vetoed = new java.util.HashSet<>();
+        for (int b = 0; b < blen; ++b) {
+            final List<org.bukkit.event.Event> events = buffers.get(b).events;
+            for (int i = 0, len = events.size(); i < len; ++i) {
+                final org.bukkit.event.Event event = events.get(i);
+                try {
+                    org.bukkit.Bukkit.getPluginManager().callEvent(event);
+                } catch (final Throwable t) {
+                    LOGGER.error("Deferred event dispatch failed", t);
+                }
+                if (event instanceof org.bukkit.event.Cancellable cancellable && cancellable.isCancelled()) {
+                    org.bukkit.block.Block block = null;
+                    if (event instanceof org.bukkit.event.block.BlockFromToEvent fromTo) {
+                        block = fromTo.getToBlock();
+                    } else if (event instanceof org.bukkit.event.block.BlockEvent blockEvent) {
+                        block = blockEvent.getBlock();
+                    }
+                    if (block != null) {
+                        vetoed.add(BlockPos.asLong(block.getX(), block.getY(), block.getZ()));
+                    }
+                }
+            }
+        }
+        int vetoedWrites = 0;
+        for (int b = 0; b < blen; ++b) {
             final List<StagedWrite> writes = buffers.get(b).writes;
             for (int i = 0, len = writes.size(); i < len; ++i) {
                 final StagedWrite w = writes.get(i);
-                w.level().setBlock(w.pos(), w.state(), w.flags(), w.updateLimit());
+                if (vetoed.isEmpty() || !vetoed.contains(w.pos().asLong())) {
+                    w.level().setBlock(w.pos(), w.state(), w.flags(), w.updateLimit());
+                } else {
+                    vetoedWrites++;
+                }
             }
         }
-        for (int b = 0, blen = buffers.size(); b < blen; ++b) {
+        if (VETO_DEBUG && vetoedWrites > 0) {
+            LOGGER.info("Loom parallel veto: skipped {} staged writes from cancelled events this phase", vetoedWrites);
+        }
+        for (int b = 0; b < blen; ++b) {
             final List<StagedTick> ticks = buffers.get(b).ticks;
             for (int i = 0, len = ticks.size(); i < len; ++i) {
                 final StagedTick t = ticks.get(i);
                 t.ticks().schedule(t.tick());
             }
         }
-        for (int b = 0, blen = buffers.size(); b < blen; ++b) {
+        for (int b = 0; b < blen; ++b) {
             final List<StagedSpawn> spawns = buffers.get(b).spawns;
             for (int i = 0, len = spawns.size(); i < len; ++i) {
                 final StagedSpawn s = spawns.get(i);
