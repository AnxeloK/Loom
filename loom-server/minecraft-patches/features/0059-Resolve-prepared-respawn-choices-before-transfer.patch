+    private org.bukkit.event.player.PlayerRespawnEvent callRespawnEvent(
+        final TeleportTransition transition,
+        final boolean isBedSpawn,
+        final boolean isAnchorSpawn,
+        final org.bukkit.event.player.PlayerRespawnEvent.RespawnReason respawnReason
+    ) {
+        final org.bukkit.event.player.PlayerRespawnEvent event = new org.bukkit.event.player.PlayerRespawnEvent(
+            this.getBukkitEntity(),
+            org.bukkit.craftbukkit.util.CraftLocation.toBukkit(
+                transition.position(), transition.newLevel(), transition.yRot(), transition.xRot()
+            ),
+            isBedSpawn, isAnchorSpawn, transition.missingRespawnBlock(), respawnReason
+        );
+        this.level().getCraftServer().getPluginManager().callEvent(event);
+        return event;
+    }
 
-        return new RespawnResult(
-            teleportTransition.withChangedLocation(location),
-            isBedSpawn,
-            isAnchorSpawn
+    private @Nullable RespawnResult finishRespawnDecision(
+        final TeleportTransition transition,
+        final boolean isBedSpawn,
+        final boolean isAnchorSpawn,
+        final @Nullable Runnable consumeAnchorCharge,
+        final org.bukkit.Location selected
+    ) {
+        if (this.connection.isDisconnected() || this.connection.player != this
+            || this.server.getPlayerList().getPlayer(this.getUUID()) != this) {
+            return null;
+        }
+        final org.bukkit.Location original = org.bukkit.craftbukkit.util.CraftLocation.toBukkit(
+            transition.position(), transition.newLevel(), transition.yRot(), transition.xRot()
         );
+        if (original.equals(selected) && consumeAnchorCharge != null) {
+            consumeAnchorCharge.run();
+        }
+        return new RespawnResult(transition.withChangedLocation(selected), isBedSpawn, isAnchorSpawn);
     }
 
