+    private CompletableFuture<@Nullable RespawnResult> completeRespawnResultAsync(
+        final TeleportTransition transition,
+        final boolean isBedSpawn,
+        final boolean isAnchorSpawn,
+        final @Nullable Runnable consumeAnchorCharge,
+        final org.bukkit.event.player.PlayerRespawnEvent.RespawnReason respawnReason
+    ) {
+        final org.bukkit.event.player.PlayerRespawnEvent event = this.callRespawnEvent(
